{% extends 'front/layout.html.twig' %}

{% set active_nav = 'forum' %}
{% block title %}Edit Post — Forum{% endblock %}

{% block extra_styles %}
<style>
  .forum-edit-shell { padding: 30px 0 56px; background: var(--pg-bg,#f4f6fb); }
  .forum-form-card { max-width: 780px; margin: 0 auto; background:#fff; border:1px solid #dbe5ef; border-radius:16px; box-shadow:0 8px 22px rgba(15,23,42,.08); padding:28px 28px 24px; }
  .forum-form-title { font-size:1.4rem; font-weight:800; color:var(--pg-navy,#111827); }
  .btn-pg-primary { background:var(--pg-gold,#f9c23c); color:#111; border:none; border-radius:20px; font-weight:700; padding:9px 22px; font-size:.9rem; transition:background .18s; }
  .btn-pg-primary:hover { background:var(--pg-gold-dark,#e6a800); color:#111; }
  .btn-pg-cancel { background:#fff; border:1px solid #dbe5ef; color:#374151; border-radius:20px; font-weight:600; padding:9px 20px; font-size:.9rem; text-decoration:none; transition:background .18s; }
  .btn-pg-cancel:hover { background:#f4f6fb; color:#111; }
  .blacklist-banner { background:#fff5f5; border:1px solid #fca5a5; border-radius:12px; padding:12px 16px; margin-bottom:16px; }
  .blacklist-banner .banned-word { display:inline-block; background:#fee2e2; color:#991b1b; border-radius:999px; padding:2px 10px; font-size:.8rem; font-weight:700; margin:2px; }
  .policy-info { background:#fffbeb; border:1px solid #fcd34d; border-radius:10px; padding:10px 14px; font-size:.83rem; color:#92400e; margin-bottom:18px; }
  .current-image-preview { border-radius:12px; max-height:200px; object-fit:cover; border:1px solid #dbe5ef; margin-bottom:10px; }
</style>
{% endblock %}

{% block body %}
<section class="forum-edit-shell">
  <div class="container">
    <div class="forum-form-card">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="forum-form-title mb-0"><i class="fa fa-edit mr-2" style="color:var(--pg-gold,#f9c23c);"></i>Edit Post</h1>
        <a href="{{ path('forum_show', {id: post.id}) }}" class="btn-pg-cancel"><i class="fa fa-arrow-left mr-1"></i> Back</a>
      </div>

      {% if bad_words is defined and bad_words|length > 0 %}
        <div class="blacklist-banner">
          <strong><i class="fa fa-ban mr-1" style="color:#dc2626;"></i>Forbidden words detected:</strong>
          {% for word in bad_words %}
            <span class="banned-word">{{ word }}</span>
          {% endfor %}
          <div class="mt-1" style="font-size:.82rem; color:#7f1d1d;">Please remove these words from your title or content and resubmit.</div>
        </div>
      {% endif %}

      <div class="policy-info">
        <i class="fa fa-info-circle mr-1"></i>
        Posts are reviewed against our community word policy. Profanity and offensive language will be rejected automatically.
      </div>

      {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
      {% endfor %}

      {{ form_start(form) }}
      {{ form_errors(form) }}

      <div class="form-group mb-3">
        <label class="font-weight-600 mb-1">Title</label>
        {{ form_widget(form.title, {attr: {class: 'form-control'}}) }}
        {{ form_errors(form.title) }}
      </div>

      <div class="form-group mb-3">
        <label class="font-weight-600 mb-1">Content</label>
        {{ form_widget(form.content, {attr: {class: 'form-control', rows: 7}}) }}
        {{ form_errors(form.content) }}
      </div>

      {% if post.imageName %}
        <div class="mb-2">
          <img src="{{ vich_uploader_asset(post, 'imageFile') }}" alt="Current image" class="current-image-preview">
        </div>
      {% endif %}
      <div class="form-group mb-4">
        <label class="font-weight-600 mb-1">Image <small class="text-muted font-weight-normal">(optional — replace existing)</small></label>
        {{ form_widget(form.imageFile) }}
        {{ form_errors(form.imageFile) }}
      </div>

      {% if form.status is defined %}
        <div class="form-group mb-3">
          {{ form_label(form.status) }}
          {{ form_widget(form.status) }}
          {{ form_errors(form.status) }}
        </div>
        {% if form.allowedViewerIds is defined %}
          <div class="form-group mb-3 js-allowed-viewers-wrap" style="display:none;">
            {{ form_label(form.allowedViewerIds) }}
            {{ form_widget(form.allowedViewerIds) }}
            {{ form_errors(form.allowedViewerIds) }}
          </div>
        {% endif %}
      {% endif %}

      <div class="d-flex gap-2 justify-content-end">
        <a href="{{ path('forum_show', {id: post.id}) }}" class="btn-pg-cancel">Cancel</a>
        <button type="submit" class="btn-pg-primary"><i class="fa fa-save mr-1"></i>Save changes</button>
      </div>

      {{ form_end(form) }}
    </div>
  </div>
</section>
{% endblock %}
