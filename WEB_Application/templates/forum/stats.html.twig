{% extends 'front/layout.html.twig' %}

{% set active_nav = 'forum' %}
{% block title %}Forum Statistics{% endblock %}

{% block extra_styles %}
<style>
  .stats-shell { padding: 30px 0 64px; background: var(--pg-bg,#f4f6fb); min-height: 72vh; }
  .stats-container { max-width: 900px; margin: 0 auto; }
  .stats-card { background:#fff; border:1px solid #dbe5ef; border-radius:16px; box-shadow:0 6px 18px rgba(15,23,42,.07); padding:18px 22px; margin-bottom:18px; }
  .stats-title { font-size:1.3rem; font-weight:800; color:var(--pg-navy,#111827); }
  .kpi-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:14px; margin-bottom:18px; }
  .kpi-box { background:#f8faff; border:1px solid #dbe5ef; border-radius:12px; padding:14px 12px; text-align:center; }
  .kpi-box .kpi-val { font-size:2rem; font-weight:900; color:var(--pg-navy,#111827); line-height:1; }
  .kpi-box .kpi-label { font-size:.76rem; color:#6b7280; text-transform:uppercase; letter-spacing:.07em; margin-top:4px; }
  .kpi-box.gold .kpi-val { color:var(--pg-gold-dark,#e6a800); }
  .kpi-box.teal .kpi-val { color:var(--pg-teal,#0f766e); }
  .kpi-box.red .kpi-val { color:#dc2626; }
  .kpi-box.amber .kpi-val { color:#d97706; }
  .status-bar { display:flex; border-radius:10px; overflow:hidden; height:20px; margin:10px 0; }
  .status-bar-seg { transition:width .4s; }
  .top-post-row { display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid #f0f2f7; }
  .top-post-row:last-child { border-bottom:none; }
  .top-post-rank { width:26px; height:26px; border-radius:50%; background:var(--pg-gold,#f9c23c); color:#111; font-weight:800; font-size:.8rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .top-post-title { flex:1; font-weight:600; font-size:.9rem; color:var(--pg-navy,#111827); }
  .top-post-meta { font-size:.8rem; color:#6b7280; }
  .btn-back { background:#fff; border:1px solid #dbe5ef; color:#374151; border-radius:20px; padding:7px 18px; font-size:.88rem; font-weight:600; text-decoration:none; }
  .btn-back:hover { background:#f4f6fb; color:#111; text-decoration:none; }
  .btn-new { background:var(--pg-gold,#f9c23c); color:#111; border:none; border-radius:20px; font-weight:700; padding:7px 18px; font-size:.88rem; text-decoration:none; }
  .btn-new:hover { background:var(--pg-gold-dark,#e6a800); color:#111; text-decoration:none; }
</style>
{% endblock %}

{% block body %}
<section class="stats-shell">
  <div class="container">
    <div class="stats-container">

      <div class="stats-card d-flex justify-content-between align-items-center mb-4">
        <h1 class="stats-title mb-0"><i class="fa fa-bar-chart mr-2" style="color:var(--pg-gold,#f9c23c);"></i>Forum Statistics</h1>
        <div class="d-flex gap-2">
          <a href="{{ path('forum_index') }}" class="btn-back"><i class="fa fa-arrow-left mr-1"></i> Forum</a>
          <a href="{{ path('forum_new') }}" class="btn-new"><i class="fa fa-plus mr-1"></i> New Post</a>
        </div>
      </div>

      {% set total = (countsByStatus.OPEN|default(0)) + (countsByStatus.CLOSED|default(0)) + (countsByStatus.IN_PROGRESS|default(0)) + (countsByStatus.DENIED|default(0)) + (countsByStatus.HIDDEN|default(0)) %}

      <div class="kpi-grid">
        <div class="kpi-box teal"><div class="kpi-val">{{ countsByStatus.OPEN|default(0) }}</div><div class="kpi-label">Open posts</div></div>
        <div class="kpi-box amber"><div class="kpi-val">{{ countsByStatus.IN_PROGRESS|default(0) }}</div><div class="kpi-label">Pending review</div></div>
        <div class="kpi-box"><div class="kpi-val">{{ countsByStatus.CLOSED|default(0) }}</div><div class="kpi-label">Closed posts</div></div>
        <div class="kpi-box red"><div class="kpi-val">{{ countsByStatus.DENIED|default(0) }}</div><div class="kpi-label">Denied posts</div></div>
        <div class="kpi-box gold"><div class="kpi-val">{{ totalComments }}</div><div class="kpi-label">Total comments</div></div>
      </div>

      {% if total > 0 %}
        <div class="stats-card mb-4">
          <h5 style="font-weight:700;color:var(--pg-navy,#111827);">Post Status Distribution</h5>
          <div class="status-bar">
            {% set pctOpen    = total > 0 ? (countsByStatus.OPEN|default(0) / total * 100)|round(1) : 0 %}
            {% set pctPending = total > 0 ? (countsByStatus.IN_PROGRESS|default(0) / total * 100)|round(1) : 0 %}
            {% set pctClosed  = total > 0 ? (countsByStatus.CLOSED|default(0) / total * 100)|round(1) : 0 %}
            {% set pctDenied  = total > 0 ? (countsByStatus.DENIED|default(0) / total * 100)|round(1) : 0 %}
            <div class="status-bar-seg" style="width:{{ pctOpen }}%;background:#0f766e;" title="Open: {{ pctOpen }}%"></div>
            <div class="status-bar-seg" style="width:{{ pctPending }}%;background:#f59e0b;" title="Pending: {{ pctPending }}%"></div>
            <div class="status-bar-seg" style="width:{{ pctClosed }}%;background:#6b7280;" title="Closed: {{ pctClosed }}%"></div>
            <div class="status-bar-seg" style="width:{{ pctDenied }}%;background:#dc2626;" title="Denied: {{ pctDenied }}%"></div>
          </div>
          <div class="d-flex flex-wrap gap-3 mt-2" style="font-size:.82rem;">
            <span><span style="display:inline-block;width:10px;height:10px;background:#0f766e;border-radius:2px;margin-right:4px;"></span>Open {{ pctOpen }}%</span>
            <span><span style="display:inline-block;width:10px;height:10px;background:#f59e0b;border-radius:2px;margin-right:4px;"></span>Pending {{ pctPending }}%</span>
            <span><span style="display:inline-block;width:10px;height:10px;background:#6b7280;border-radius:2px;margin-right:4px;"></span>Closed {{ pctClosed }}%</span>
            <span><span style="display:inline-block;width:10px;height:10px;background:#dc2626;border-radius:2px;margin-right:4px;"></span>Denied {{ pctDenied }}%</span>
          </div>
        </div>
      {% endif %}

      <div class="stats-card">
        <h5 style="font-weight:700;color:var(--pg-navy,#111827);" class="mb-3"><i class="fa fa-trophy mr-2" style="color:var(--pg-gold,#f9c23c);"></i>Most Commented Posts</h5>
        {% for row in topCommentedPosts %}
          <div class="top-post-row">
            <div class="top-post-rank">{{ loop.index }}</div>
            <div class="top-post-title">
              <a href="{{ path('forum_show', {id: row.post.id}) }}" style="color:inherit;text-decoration:none;">{{ row.post.title }}</a>
            </div>
            <div class="top-post-meta"><i class="fa fa-comment-o mr-1"></i>{{ row.nbComments }}</div>
          </div>
        {% else %}
          <p class="text-muted">No data yet.</p>
        {% endfor %}
      </div>

    </div>
  </div>
</section>
{% endblock %}
