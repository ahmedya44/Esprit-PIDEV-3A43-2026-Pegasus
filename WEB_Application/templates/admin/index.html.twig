{% extends 'back/layout.html.twig' %}

{% block title %}Admin Users{% endblock %}

{% block body %}
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Admin Users</h1>
      <p class="text-muted mb-0">Manage admin accounts and privileges.</p>
    </div>
    <a class="btn btn-primary" href="{{ path('app_admin_new') }}">Create Admin</a>
  </div>

  <div class="card">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
          <thead>
            <tr>
              <th>ID</th>
              <th>Admin</th>
              <th>Phone</th>
              <th>Status</th>
              <th>Role Scope</th>
              <th>Created</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
          {% for admin in admins %}
            <tr>
              <td class="fw-semibold">#{{ admin.id }}</td>
              <td>
                <div class="fw-semibold">{{ admin.username ?: 'Unnamed' }}</div>
                <div class="text-muted small">{{ admin.email }}</div>
              </td>
              <td>{{ admin.phone ?: 'N/A' }}</td>
              <td>
                {% set status = admin.status ?: 'unknown' %}
                <span class="badge {{ status == 'active' ? 'bg-success' : 'bg-secondary' }}">{{ status|title }}</span>
              </td>
              <td>
                {{ admin.superAdmin ? 'Super Admin' : 'Standard Admin' }}
              </td>
              <td>{{ admin.createdAt ? admin.createdAt|date('Y-m-d H:i') : 'N/A' }}</td>
              <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_show', {'id': admin.id}) }}">View</a>
                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_edit', {'id': admin.id}) }}">Edit</a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7" class="text-center text-muted py-4">No admins found.</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
{% endblock %}
