{% extends 'back/layout.html.twig' %}

{% block title %}Edit Admin{% endblock %}

{% block body %}
  <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Edit Admin</h1>
      <p class="text-muted mb-0">Update account details and permissions.</p>
    </div>
    <a class="btn btn-outline-secondary" href="{{ path('app_admin_index') }}">Back to list</a>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      {{ include('admin/_form.html.twig', {'button_label': 'Update'}) }}
    </div>
  </div>

  <div class="card border-danger">
    <div class="card-body">
      <h2 class="h6 text-danger mb-2">Danger zone</h2>
      <p class="text-muted mb-3">Delete this admin if this account is no longer needed.</p>
      {{ include('admin/_delete_form.html.twig') }}
    </div>
  </div>
{% endblock %}
