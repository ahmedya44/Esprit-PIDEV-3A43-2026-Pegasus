{% extends 'back/layout.html.twig' %}

{% block title %}Quizzes Dashboard{% endblock %}

{% block body %}
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Quizzes Dashboard</h1>
      <p class="text-muted mb-0">Create, manage, and track quiz performance.</p>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small mb-1">Create</div>
        <h2 class="h5">New Final Quiz</h2>
        <p class="text-muted">Create the final quiz for a course.</p>
        <a href="{{ path('admin_quizzes_new') }}" class="btn btn-primary btn-sm"><i class="fas fa-plus me-1"></i>Create Quiz</a>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small mb-1">Manage</div>
        <h2 class="h5">Edit or Delete</h2>
        <p class="text-muted">Manage quizzes already created.</p>
        <a href="{{ path('admin_quizzes_index') }}" class="btn btn-outline-primary btn-sm"><i class="fas fa-list me-1"></i>Manage Quizzes</a>
      </div></div>
    </div>
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body">
        <div class="text-muted small mb-1">Statistics</div>
        <h2 class="h5">{{ totalQuizzes }} Quizzes</h2>
        <p class="text-muted">View pass rates and attempts.</p>
        <a href="{{ path('admin_quizzes_stats') }}" class="btn btn-outline-success btn-sm"><i class="fas fa-chart-bar me-1"></i>View Stats</a>
      </div></div>
    </div>
  </div>
{% endblock %}
