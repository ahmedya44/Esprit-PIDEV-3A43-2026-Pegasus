{% extends 'back/layout.html.twig' %}

{% block title %}Edit Quiz{% endblock %}

{% block body %}
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Edit Quiz</h1>
      <p class="text-muted mb-0">Update quiz configuration and course link.</p>
    </div>
    <a href="{{ path('admin_quizzes_index') }}" class="btn btn-outline-secondary">Back</a>
  </div>

  {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endfor %}
  {% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endfor %}

  <div class="card">
    <div class="card-body">
      {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
      {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger">{{ form_errors(form) }}</div>
      {% endif %}
      <div class="row g-3">
        <div class="col-md-8">
          <label class="form-label fw-semibold">Course</label>
          {{ form_widget(form.course, { attr: { class: 'form-select' } }) }}
          <div class="text-danger small mt-1">{{ form_errors(form.course) }}</div>
        </div>
        <div class="col-md-8">
          <label class="form-label fw-semibold">Title</label>
          {{ form_widget(form.title, { attr: { class: 'form-control' } }) }}
          <div class="text-danger small mt-1">{{ form_errors(form.title) }}</div>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-semibold">Passing score (%)</label>
          {{ form_widget(form.passingScore, { attr: { class: 'form-control', min: 0, max: 100 } }) }}
          <div class="text-danger small mt-1">{{ form_errors(form.passingScore) }}</div>
        </div>
      </div>
      <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Update</button>
        <form id="delete-quiz-form" method="post" action="{{ url('admin_quizzes_delete', { id: quiz.id }) }}" data-confirm-title="Delete quiz" data-confirm-message="Are you sure you want to delete this quiz?" style="display:inline-block;">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quiz.id) }}">
          <button class="btn btn-danger" type="submit"><i class="fas fa-trash me-1"></i>Delete</button>
        </form>
      </div>
      {{ form_end(form) }}
    </div>
  </div>
{% endblock %}
