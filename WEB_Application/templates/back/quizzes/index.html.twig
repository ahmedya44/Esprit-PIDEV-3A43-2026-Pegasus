{% extends 'back/layout.html.twig' %}

{% block title %}Quizzes{% endblock %}

{% block body %}
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Quizzes</h1>
      <p class="text-muted mb-0">Manage final quizzes and grading thresholds.</p>
    </div>
    <a href="{{ path('admin_quizzes_new') }}" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Create Quiz</a>
  </div>

  {% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endfor %}
  {% for message in app.flashes('error') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">{{ message }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endfor %}

  <div class="card">
    <div class="card-body">
      {% if quizzes is empty %}
        <div class="text-center py-5">
          <h5 class="text-muted">No quizzes found.</h5>
          <a href="{{ path('admin_quizzes_new') }}" class="btn btn-primary mt-2">Create your first quiz</a>
        </div>
      {% else %}
        <div class="table-responsive">
          <table class="table table-striped align-middle mb-0">
            <thead><tr><th>ID</th><th>Title</th><th>Course</th><th>Passing Score</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            {% for quiz in quizzes %}
              <tr>
                <td>#{{ quiz.id }}</td>
                <td class="fw-semibold">{{ quiz.title }}</td>
                <td>{{ quiz.course ? quiz.course.title : '-' }}</td>
                <td>{{ quiz.passingScore }}%</td>
                <td class="text-end">
                  <div class="d-inline-flex gap-1">
                    <a href="{{ path('admin_quizzes_edit', { id: quiz.id }) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                    <form method="post" action="{{ url('admin_quizzes_delete', { id: quiz.id }) }}" data-confirm-title="Delete quiz" data-confirm-message="Are you sure you want to delete this quiz?" style="display:inline-block;">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quiz.id) }}">
                      <button class="btn btn-sm btn-danger" type="submit"><i class="fas fa-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
