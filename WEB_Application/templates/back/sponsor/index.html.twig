{% extends 'back/layout.html.twig' %}

{% block title %}Sponsors Management{% endblock %}

{% block body %}
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Sponsors Management</h1>
      <p class="text-muted mb-0">Select an event to view sponsor reservations.</p>
    </div>
  </div>

  <div class="card">
    <div class="card-body table-responsive">
      <table class="table table-striped align-middle mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>Image</th>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
        {% for evenement in evenements %}
          <tr>
            <td>#{{ evenement.id }}</td>
            <td>
              {% if evenement.image %}
                <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="{{ evenement.titre }}" style="width:48px;height:48px;border-radius:8px;object-fit:cover;">
              {% else %}
                <span class="text-muted small">No image</span>
              {% endif %}
            </td>
            <td class="fw-semibold">{{ evenement.titre }}</td>
            <td>{{ evenement.date ? evenement.date|date('Y-m-d') : '-' }}</td>
            <td>{{ evenement.lieu }}</td>
            <td class="text-end">
              <a href="{{ path('app_admin_sponsor_list', {id: evenement.id}) }}" class="btn btn-sm btn-primary">
                <i class="fas fa-handshake me-1"></i>View Sponsors
              </a>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="text-center text-muted py-4">No events found.</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
