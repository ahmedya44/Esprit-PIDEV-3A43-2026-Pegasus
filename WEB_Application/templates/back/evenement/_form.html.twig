{{ form_start(form) }}
  <div class="row g-3">
    <div class="col-md-6">
      <label class="form-label">{{ form_label(form.titre) }}</label>
      {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
      <div class="text-danger small">{{ form_errors(form.titre) }}</div>
    </div>
    <div class="col-md-3">
      <label class="form-label">{{ form_label(form.date) }}</label>
      {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
      <div class="text-danger small">{{ form_errors(form.date) }}</div>
    </div>
    <div class="col-md-3">
      <label class="form-label">{{ form_label(form.heure) }}</label>
      {{ form_widget(form.heure, {'attr': {'class': 'form-control'}}) }}
      <div class="text-danger small">{{ form_errors(form.heure) }}</div>
    </div>
    <div class="col-md-6">
      <label class="form-label">{{ form_label(form.lieu) }}</label>
      {{ form_widget(form.lieu, {'attr': {'class': 'form-control'}}) }}
      <div class="text-danger small">{{ form_errors(form.lieu) }}</div>
    </div>
    <div class="col-md-3">
      <label class="form-label">{{ form_label(form.capacite_max) }}</label>
      {{ form_widget(form.capacite_max, {'attr': {'class': 'form-control'}}) }}
      <div class="text-danger small">{{ form_errors(form.capacite_max) }}</div>
    </div>
    <div class="col-md-3">
      <label class="form-label">{{ form_label(form.prix) }}</label>
      {{ form_widget(form.prix, {'attr': {'class': 'form-control'}}) }}
      <div class="text-danger small">{{ form_errors(form.prix) }}</div>
    </div>
    <div class="col-12">
      <label class="form-label">{{ form_label(form.description) }}</label>
      {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
      <div class="text-danger small">{{ form_errors(form.description) }}</div>
    </div>
    <div class="col-12">
      <label class="form-label">{{ form_label(form.image) }}</label>
      {{ form_widget(form.image, {'attr': {'class': 'form-control'}}) }}
      <div class="text-danger small">{{ form_errors(form.image) }}</div>
    </div>
  </div>

  <div class="mt-4 d-flex gap-2">
    <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
    <a href="{{ path('app_evenement_index') }}" class="btn btn-outline-secondary">Cancel</a>
  </div>
{{ form_end(form) }}
