<form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" data-confirm-title="Delete event" data-confirm-message="Are you sure you want to delete this event? This action cannot be undone.">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
  <button class="btn btn-danger btn-sm" type="submit">Delete Event</button>
</form>
