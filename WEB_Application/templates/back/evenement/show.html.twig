{% extends 'back/layout.html.twig' %}

{% block title %}Event Details{% endblock %}

{% block body %}
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Event Details</h1>
      <p class="text-muted mb-0">Complete information for this event.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="{{ path('app_evenement_index') }}" class="btn btn-outline-secondary">Back to list</a>
      <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-primary">Edit</a>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6"><strong>ID:</strong> #{{ evenement.id }}</div>
        <div class="col-md-6"><strong>Title:</strong> {{ evenement.titre }}</div>
        <div class="col-md-6"><strong>Date:</strong> {{ evenement.date ? evenement.date|date('Y-m-d') : '-' }}</div>
        <div class="col-md-6"><strong>Time:</strong> {{ evenement.heure ? evenement.heure|date('H:i') : '-' }}</div>
        <div class="col-md-6"><strong>Location:</strong> {{ evenement.lieu }}</div>
        <div class="col-md-6"><strong>Capacity:</strong> {{ evenement.capaciteMax }}</div>
        <div class="col-md-6"><strong>Price:</strong> {{ evenement.prix }}</div>
        <div class="col-12"><strong>Description:</strong><br>{{ evenement.description }}</div>
        <div class="col-12">
          <strong>Image:</strong><br>
          {% if evenement.image %}
            <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="{{ evenement.titre }}" style="max-width:320px;border-radius:12px;">
          {% else %}
            <span class="text-muted">No image</span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div class="card border-danger">
    <div class="card-body">
      <h2 class="h6 text-danger mb-2">Danger zone</h2>
      {{ include('back/evenement/_delete_form.html.twig') }}
    </div>
  </div>
{% endblock %}
