{% extends 'back/layout.html.twig' %}
{% block title %}Role Requests{% endblock %}

{% block body %}
<div class="page-header">
  <h4 class="page-title">Role Requests</h4>
</div>

{% for type, messages in app.flashes %}
  {% for msg in messages %}
    <div class="alert alert-{{ type == 'success' ? 'success' : (type == 'error' ? 'danger' : 'warning') }} alert-dismissible fade show py-2">
      {{ msg }}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  {% endfor %}
{% endfor %}

{# ── Pending requests ─────────────────────────────────────────── #}
<div class="card mb-4">
  <div class="card-header"><h5 class="card-title mb-0">Pending Requests <span class="badge bg-warning text-dark ms-1">{{ pending|length }}</span></h5></div>
  <div class="card-body p-0">
    {% if pending is empty %}
      <p class="p-3 text-muted mb-0">No pending requests.</p>
    {% else %}
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr><th>User</th><th>Email</th><th>Requested Role</th><th>Submitted</th><th>Actions</th></tr>
          </thead>
          <tbody>
            {% for r in pending %}
            <tr>
              <td>{{ r.user ? r.user.username : '—' }}</td>
              <td class="small text-muted">{{ r.user ? r.user.email : '—' }}</td>
              <td>
                {% if r.requestedRole == 'ROLE_ARTISTE' %}
                  <span class="badge bg-info text-dark">Artiste</span>
                {% elseif r.requestedRole == 'ROLE_SPONSOR' %}
                  <span class="badge bg-primary">Sponsor</span>
                {% else %}
                  {{ r.requestedRole }}
                {% endif %}
              </td>
              <td class="small text-muted">{{ r.createdAt|date('d M Y, H:i') }}</td>
              <td>
                <form method="post" action="{{ path('admin_role_requests_approve', {id: r.id}) }}" class="d-inline" onsubmit="return confirm('Approve this role request?')">
                  <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ r.id) }}">
                  <button type="submit" class="btn btn-success btn-sm">Approve</button>
                </form>
                <button type="button" class="btn btn-danger btn-sm ms-1" data-bs-toggle="modal" data-bs-target="#rejectModal{{ r.id }}">Reject</button>

                {# Reject modal #}
                <div class="modal fade" id="rejectModal{{ r.id }}" tabindex="-1">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <form method="post" action="{{ path('admin_role_requests_reject', {id: r.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ r.id) }}">
                        <div class="modal-header"><h5 class="modal-title">Reject Request</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                        <div class="modal-body">
                          <p>Reject role request from <strong>{{ r.user ? r.user.username : '?' }}</strong>?</p>
                          <div class="mb-3">
                            <label class="form-label">Reason (optional)</label>
                            <textarea name="reason" class="form-control" rows="3" placeholder="Explain why the request was rejected…"></textarea>
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-danger btn-sm">Reject</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
</div>

{# ── All requests ─────────────────────────────────────────────── #}
<div class="card">
  <div class="card-header"><h5 class="card-title mb-0">All Requests (last 50)</h5></div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-sm mb-0">
        <thead class="table-light">
          <tr><th>User</th><th>Role</th><th>Status</th><th>Submitted</th><th>Reviewed by</th><th>Note</th></tr>
        </thead>
        <tbody>
          {% for r in all %}
          <tr>
            <td>{{ r.user ? r.user.username : '—' }}</td>
            <td><span class="badge bg-secondary">{{ r.requestedRole }}</span></td>
            <td>
              {% if r.status == 'pending' %}
                <span class="badge bg-warning text-dark">Pending</span>
              {% elseif r.status == 'approved' %}
                <span class="badge bg-success">Approved</span>
              {% else %}
                <span class="badge bg-danger">Rejected</span>
              {% endif %}
            </td>
            <td class="small text-muted">{{ r.createdAt|date('d M Y') }}</td>
            <td class="small text-muted">{{ r.reviewedBy ? r.reviewedBy.username : '—' }}</td>
            <td class="small text-muted">{{ r.rejectionReason ?? '—' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
