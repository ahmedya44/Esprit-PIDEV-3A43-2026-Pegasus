{% extends 'back/layout.html.twig' %}

{% block title %}Market Categories{% endblock %}

{% block body %}
<div class="page-header">
  <h3 class="fw-bold mb-3">Market Categories</h3>
</div>

<div class="card">
  <div class="card-header d-flex align-items-center justify-content-between">
    <div>
      <h4 class="card-title mb-1">Categories</h4>
      <p class="card-category mb-0">Organize products for easier browsing.</p>
    </div>
    <a class="btn btn-primary btn-round" href="{{ path('app_categorie_new') }}"><i class="fas fa-plus me-1"></i> New Category</a>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Name</th>
            <th>Description</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for categorie in categories %}
            <tr>
              <td class="fw-bold">{{ categorie.nom }}</td>
              <td>{{ categorie.description|default('No description') }}</td>
              <td class="text-end">
                <a class="btn btn-info btn-sm" href="{{ path('app_categorie_show', {id: categorie.id}) }}"><i class="fas fa-eye"></i></a>
                <a class="btn btn-secondary btn-sm" href="{{ path('app_categorie_edit', {id: categorie.id}) }}"><i class="fas fa-edit"></i></a>
              </td>
            </tr>
          {% else %}
            <tr><td colspan="3" class="text-center text-muted py-5">No categories yet.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
