<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <title>Packs de Sponsoring</title>
  <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
  <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />
  <style>
    body { background: #f8f9fa; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .top-nav { background: white; border-bottom: 1px solid #e5e7eb; padding: 16px 0; box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
    .top-nav a { color: #374151; font-weight: 600; text-decoration: none; }
    .top-nav a:hover { color: #7c3aed; }
    .top-nav .brand { font-size: 22px; font-weight: 800; color: #7c3aed; }
    .page-wrapper { min-height: calc(100vh - 60px); padding: 40px 0 80px; }
    .pack-card { background: white; border: 1px solid #e5e7eb; border-radius: 20px; padding: 28px; transition: all 0.3s ease; height: 100%; }
    .pack-card:hover { box-shadow: 0 12px 40px rgba(0,0,0,0.1); transform: translateY(-4px); }
    .pack-price { background: linear-gradient(135deg, #f59e0b, #d97706); color: white; border-radius: 50px; padding: 5px 16px; font-weight: 700; font-size: 15px; white-space: nowrap; }
    .pack-name { color: #111827; font-weight: 700; font-size: 18px; }
    .pack-desc { color: #6b7280; font-size: 14px; margin: 12px 0 20px; min-height: 50px; }
    .btn-action { border: none; border-radius: 50px; color: white !important; font-weight: 600; font-size: 13px; padding: 9px 20px; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; transition: all 0.3s ease; text-decoration: none !important; box-shadow: 0 3px 10px rgba(0,0,0,0.15); }
    .btn-action:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.2); color: white !important; }
    .btn-add { background: linear-gradient(135deg, #a855f7, #7c3aed); }
    .btn-edit { background: linear-gradient(135deg, #3b82f6, #2563eb); }
    .btn-delete { background: linear-gradient(135deg, #ef4444, #dc2626); }
    .btn-back-link { border: 1.5px solid #d1d5db; border-radius: 50px; color: #374151 !important; padding: 10px 24px; font-size: 14px; font-weight: 600; text-decoration: none !important; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease; }
    .btn-back-link:hover { background: #f3f4f6; color: #111827 !important; }
    .page-title { color: #111827; font-size: 28px; font-weight: 800; }
    .page-subtitle { color: #6b7280; font-size: 15px; margin-top: 4px; }
    .empty-state { text-align: center; padding: 80px 0; color: #9ca3af; }
    .empty-state i { font-size: 60px; color: #f59e0b; opacity: 0.4; display: block; margin-bottom: 20px; }
  </style>
</head>
<body>
  <div class="top-nav">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="brand" href="{{ path('front_home') }}">Pegasus</a>
      <div>
        <a href="{{ path('front_evenements_index') }}" class="mr-4">Evenements</a>
        {% if app.user %}
          <a href="{{ path('app_logout') }}">Logout</a>
        {% else %}
          <a href="{{ path('app_login') }}">Login</a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="page-wrapper">
    <div class="container">

      <div class="d-flex flex-wrap justify-content-between align-items-center mb-5 mt-2" style="gap: 16px;">
        <div>
          <div class="page-title"><i class="fa fa-star mr-2" style="color: #f59e0b;"></i> Packs de Sponsoring</div>
          <div class="page-subtitle">Gerez vos offres pour les sponsors</div>
        </div>
        <div class="d-flex align-items-center" style="gap: 10px;">
          <a href="{{ path('front_sponsoring_pack_new') }}" class="btn-action btn-add" style="font-size: 14px; padding: 11px 24px;">
            <i class="fa fa-plus"></i> Nouveau Pack
          </a>
          <a href="{{ path('front_sponsoring_reservations') }}" class="btn-back-link" style="background: #fffbeb; color: #d97706 !important; border-color: #fde68a;">
            <i class="fa fa-inbox"></i> Demandes Recues
          </a>
          <a href="{{ path('front_evenements_index') }}" class="btn-back-link">
            <i class="fa fa-arrow-left"></i> Evenements</a>
        </div>
      </div>

      {% for label, messages in app.flashes %}
        {% for message in messages %}
          <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} alert-dismissible fade show" style="border-radius: 12px;">
            {{ message }}
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
          </div>
        {% endfor %}
      {% endfor %}

      {% if packs is empty %}
        <div class="empty-state">
          <i class="fa fa-star-o"></i>
          <p class="h5 font-weight-bold" style="color: #374151;">Aucun pack de sponsoring cree</p>
          <p class="mb-4">Commencez par creer votre premier pack</p>
          <a href="{{ path('front_sponsoring_pack_new') }}" class="btn-action btn-add" style="font-size: 15px; padding: 13px 30px; display: inline-flex;">
            <i class="fa fa-plus"></i> Creer un Pack
          </a>
        </div>
      {% else %}
        <div class="row">
          {% for pack in packs %}
            <div class="col-md-4 mb-4">
              <div class="pack-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <div class="pack-name">{{ pack.nomPack }}</div>
                  <span class="pack-price ml-2">{{ pack.prix }} DT</span>
                </div>
                <div class="pack-desc">{{ pack.description ?? 'Aucune description.' }}</div>
                <div class="d-flex" style="gap: 8px;">
                  <a href="{{ path('front_sponsoring_pack_edit', {'id': pack.id}) }}" class="btn-action btn-edit">
                    <i class="fa fa-edit"></i> Modifier
                  </a>
                  <form method="post" action="{{ path('front_sponsoring_pack_delete', {'id': pack.id}) }}" onsubmit="return confirm('Supprimer ce pack ?');" style="margin: 0;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pack.id) }}">
                    <button class="btn-action btn-delete">
                      <i class="fa fa-trash"></i> Supprimer
                    </button>
                  </form>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

    </div>
  </div>

  <script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
  <script src="{{ asset('front/js/bootstrap.js') }}"></script>
</body>
</html>



