<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

  <link rel="shortcut icon" href="{{ asset('front/images/favicon.png') }}" type="">
  <title>Course Builder</title>

  <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
  <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/style.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/responsive.css') }}" rel="stylesheet" />

  <style>
    .form-shell { padding: 60px 0; }
    .glass-card{ background: rgba(255,255,255,.92); border-radius: 22px; box-shadow: 0 12px 35px rgba(0,0,0,.10); border: 1px solid rgba(0,0,0,.06); overflow: hidden; }
    .glass-head{ padding: 18px 22px; border-bottom: 1px solid rgba(0,0,0,.08); display:flex; align-items:center; justify-content:space-between; gap:12px; }
    .glass-head h3{ margin:0; font-weight:900; letter-spacing:.3px; }
    .glass-body{ padding: 22px; }
    .btn-feane{ background:#ffbe33; border: none; color:#111; font-weight:900; border-radius: 14px; padding: 10px 16px; }
    .btn-soft{ background:#2b2f33; border:none; color:#fff; font-weight:800; border-radius:14px; padding:10px 16px; }
    .chip{ display:inline-block; padding:6px 10px; border-radius:999px; background:rgba(0,0,0,.06); font-weight:800; font-size:12px; }
    .muted{ color: rgba(0,0,0,.55); }
    .section-card{ border:1px solid rgba(0,0,0,.08); border-radius:18px; padding:14px; background:#fff; }
    .video-row{ display:flex; justify-content:space-between; gap:10px; padding:10px 12px; border-radius:14px; border:1px solid rgba(0,0,0,.08); background:rgba(0,0,0,.02); }
    .video-title{ font-weight:900; }
  </style>
</head>

<body class="sub_page">

  <div class="hero_area">
    <div class="bg-box">
      <img src="{{ asset('front/images/hero-bg.jpg') }}" alt="">
    </div>

    <header class="header_section">
      <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
          <a class="navbar-brand" href="{{ path('front_home') }}"><span>Pegasus</span></a>
          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent">
            <span class=""></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mx-auto">
              
              <li class="nav-item active"><a class="nav-link" href="{{ path('artist_dashboard', {tab:'courses'}) }}">Artist Dashboard</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('artist_dashboard', { tab: 'courses' }) }}">Courses</a></li>
            </ul>
          </div>
        </nav>
      </div>
    </header>
  </div>

  <section class="food_section layout_padding form-shell">
    <div class="container">

      <div class="heading_container heading_center mb-4">
        <h2>Course Builder</h2>
        <p class="text-muted mb-0">Build your course with sections and videos.</p>
      </div>

      {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <strong>Success!</strong> {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      {% endfor %}
      {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <strong>Error!</strong> {{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      {% endfor %}

      <div class="glass-card mb-4">
        <div class="glass-head">
          <div>
            <h3 class="h5 mb-1">{{ course.title }}</h3>
            <div class="muted">
              <span class="chip">{{ course.status }}</span>
              {% if course.thumbnailUrl %}
                <span class="chip">Thumbnail set</span>
              {% else %}
                <span class="chip">No thumbnail</span>
              {% endif %}
            </div>
          </div>
          <div class="d-flex gap-2">
            <a class="btn-soft" href="{{ path('artist_dashboard', {tab:'courses'}) }}">Back</a>
            <a class="btn-feane" href="{{ path('artist_course_sections_new', {id: course.id}) }}">+ Add Section</a>
          </div>
        </div>

        <div class="glass-body">
          {% if sections is empty %}
            <div class="text-center muted">
              <p class="mb-2"><strong>No sections yet.</strong></p>
              <p class="mb-0">Click “Add Section” to start building the course.</p>
            </div>
          {% else %}
            <div class="d-flex flex-column gap-3">
              {% for section in sections %}
                <div class="section-card">
                  <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                      <div class="video-title">Section {{ section.orderIndex }} - {{ section.title }}</div>
                      <div class="muted">Videos: {{ section.courseVideos|length }}</div>
                    </div>

                    <div class="d-flex gap-2">
                      <a class="btn-feane" href="{{ path('artist_course_videos_new', {id: section.id}) }}">+ Add Video</a>

                      <form method="post" action="{{ path('artist_course_sections_delete', {id: section.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_section_' ~ section.id) }}">
                        <button class="btn-soft" type="submit" onclick="return confirm('Delete this section?')">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>

                  <div class="mt-3 d-flex flex-column gap-2">
                    {% set videos = section.courseVideos|sort((a,b) => a.orderIndex <=> b.orderIndex) %}
                    {% if videos is empty %}
                      <div class="muted">No videos in this section yet.</div>
                    {% else %}
                      {% for video in videos %}
                        <div class="video-row">
                          <div>
                            <div class="video-title">Video {{ video.orderIndex }} - {{ video.title }}</div>
                            <div class="muted">
                              {{ video.durationSec }} sec
                              {% if video.isPreview %} • <strong>Preview</strong>{% endif %}
                            </div>
                          </div>

                          <div class="d-flex gap-2">
                            <a class="btn-soft" href="{{ video.videoUrl }}" target="_blank">Open</a>

                            <form method="post" action="{{ path('artist_course_videos_delete', {id: video.id}) }}">
                              <input type="hidden" name="_token" value="{{ csrf_token('delete_video_' ~ video.id) }}">
                              <button class="btn-soft" type="submit" onclick="return confirm('Delete this video?')">
                                Delete
                              </button>
                            </form>
                          </div>
                        </div>
                      {% endfor %}
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  </section>

  <script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
  <script src="{{ asset('front/js/bootstrap.js') }}"></script>
  <script src="{{ asset('front/js/custom.js') }}"></script>
</body>
</html>


