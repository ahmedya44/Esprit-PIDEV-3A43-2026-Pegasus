{% extends 'base_front.html.twig' %}

{% block title %}Edit {{ produit.nom }} - Pegasus{% endblock %}

{% block body %}
<section class="market-shell">
  <div class="container">
    {% include 'produit/_shop_nav.html.twig' with {shop_active: 'mine'} %}

    <div class="market-panel">
      <div class="market-hero">
        <div>
          <div class="market-eyebrow">Product management</div>
          <h1 class="market-title">Edit product</h1>
          <p class="market-copy">Update the product details, stock, image, and review status.</p>
        </div>
        {% if from == 'admin' %}
          <a href="{{ path('admin_produit_attente') }}" class="btn btn-outline-secondary">Back to review</a>
        {% elseif from == 'artiste' %}
          <a href="{{ path('app_produit_mes_produits') }}" class="btn btn-outline-secondary">My products</a>
        {% else %}
          <a href="{{ path('app_produit_index') }}" class="btn btn-outline-secondary">Marketplace</a>
        {% endif %}
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="market-table-card p-4">
            {{ form_start(form, {attr: {class: 'market-form'}}) }}
              <input type="hidden" name="_from" value="{{ from }}">
              {% for field in form %}
                {% if field.vars.name != '_token' %}
                  <div class="form-group mb-3">
                    {{ form_label(field, null, {label_attr: {class: 'form-label font-weight-bold'}}) }}
                    {{ form_widget(field, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(field) }}
                  </div>
                {% endif %}
              {% endfor %}
              {{ form_rest(form) }}
              <button type="submit" class="btn btn-warning">Save changes</button>
            {{ form_end(form) }}
            <div class="mt-3">
              {{ include('produit/_delete_form.html.twig') }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
