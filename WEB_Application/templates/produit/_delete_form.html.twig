<form method="post" action="{{ path('app_produit_delete', {id: produit.id}) }}" onsubmit="return confirm('Delete this product?');" style="display:inline-flex;margin:0;">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
  <button type="submit" class="market-icon-btn" title="Delete">
    <i class="fa fa-trash" aria-hidden="true"></i>
  </button>
</form>
