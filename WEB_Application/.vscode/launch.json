{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Pegasus (start Symfony and open browser)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8000",
      "webRoot": "${workspaceFolder}/WEB_Application/public",
      "preLaunchTask": "symfony: start",
      "runtimeArgs": [
        "--new-window"
      ]
    }
  ]
}
