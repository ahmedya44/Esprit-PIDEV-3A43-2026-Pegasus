<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

  <link rel="shortcut icon" href="{{ asset('front/images/favicon.png') }}" type="">
  <title>{{ course.title }}</title>

  <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
  <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/style.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/responsive.css') }}" rel="stylesheet" />

  <style>
    .form-shell { padding: 60px 0; }

    .glass-card{
      background: rgba(255,255,255,.92);
      border-radius: 22px;
      box-shadow: 0 12px 35px rgba(0,0,0,.10);
      border: 1px solid rgba(0,0,0,.06);
      overflow: hidden;
    }
    .glass-head{
      padding: 18px 22px;
      border-bottom: 1px solid rgba(0,0,0,.08);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }
    .glass-head h3{ margin:0; font-weight:900; letter-spacing:.3px; }
    .glass-body{ padding: 22px; }

    .btn-feane{
      background:#ffbe33;
      border: none;
      color:#111;
      font-weight:900;
      border-radius: 14px;
      padding: 10px 16px;
    }
    .btn-feane:hover{ filter:brightness(.95); }

    .btn-soft{
      background:#2b2f33;
      border:none;
      color:#fff;
      font-weight:800;
      border-radius:14px;
      padding:10px 16px;
    }
    .muted{ color: rgba(0,0,0,.55); }
    .chip{
      display:inline-block;
      padding:6px 10px;
      border-radius:999px;
      background:rgba(0,0,0,.06);
      font-weight:800;
      font-size:12px;
      margin-right:8px;
    }
    .thumb{
      border-radius:18px;
      width:100%;
      height:260px;
      object-fit:cover;
      border:1px solid rgba(0,0,0,.08);
      background:#f3f3f3;
    }
    .content-list li { margin-bottom: 8px; }
  </style>
</head>

<body class="sub_page">

  <div class="hero_area">
    <div class="bg-box">
      <img src="{{ asset('front/images/hero-bg.jpg') }}" alt="">
    </div>

    <header class="header_section">
      <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
          <a class="navbar-brand" href="{{ path('front_home') }}"><span>Feane</span></a>

          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent">
            <span class=""></span>
          </button>

          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mx-auto">
              <li class="nav-item"><a class="nav-link" href="{{ path('front_home') }}">Home</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_menu') }}">Menu</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_about') }}">About</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_book') }}">Book Table</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('artist_dashboard', {tab:'courses'}) }}">Artist Dashboard</a></li>
              <li class="nav-item active"><a class="nav-link" href="{{ path('app_courses') }}">Courses</a></li>
            </ul>
          </div>
        </nav>
      </div>
    </header>
  </div>

  <section class="food_section layout_padding form-shell">
    <div class="container">

      <div class="heading_container heading_center mb-4">
        <h2>{{ course.title }}</h2>
        <p class="text-muted mb-0">Discover what you'll learn before you start.</p>
      </div>

      <div class="glass-card">
        <div class="glass-head">
          <h3 class="h5 mb-0">Course Overview</h3>
          <a class="btn-soft" href="{{ path('app_courses') }}">â† Back to Courses</a>
        </div>

        <div class="glass-body">
          <div class="row g-4 align-items-start">
            <div class="col-lg-5">
              {% set thumb = course.thumbnailUrl|default('') %}
              {% if thumb %}
                {% set thumbSrc = (thumb starts with('http://') or thumb starts with('https://') or thumb starts with('/')) ? thumb : asset(thumb) %}
                <img class="thumb" src="{{ thumbSrc }}" alt="{{ course.title|e }}" onerror="this.onerror=null;this.src='{{ asset('front/images/f1.png') }}';">
              {% else %}
                <img class="thumb" src="{{ asset('front/images/f1.png') }}" alt="{{ course.title|e }}">
              {% endif %}
            </div>

            <div class="col-lg-7">
              <div class="mb-3">
                <span class="chip">Sections: {{ sections|length }}</span>
                <span class="chip">Videos: {{ totalVideos }}</span>
              </div>

              <h4 class="mb-2">About this course</h4>
              <p class="muted mb-4">{{ course.description }}</p>

              <div class="d-flex gap-2 flex-wrap mb-4">
                <a class="btn-feane" href="{{ path('course_learn', {id: course.id}) }}">â–¶ Start Course</a>
                <a class="btn-soft" href="{{ path('app_courses') }}">Cancel</a>
              </div>

              <h5 class="mb-2">Content</h5>
              {% if sections is empty %}
                <p class="muted mb-0">This course has no sections yet.</p>
              {% else %}
                <ul class="content-list mb-0">
                  {% for section in sections %}
                    <li>
                      <strong>Section {{ section.orderIndex }}:</strong> {{ section.title }}
                      <span class="muted">({{ section.courseVideos|length }} videos)</span>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
  <script src="{{ asset('front/js/bootstrap.js') }}"></script>
  <script src="{{ asset('front/js/custom.js') }}"></script>
</body>
</html>

