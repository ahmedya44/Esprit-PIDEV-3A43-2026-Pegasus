{% extends 'front/layout.html.twig' %}

{% set active_nav = 'courses' %}
{% block title %}{{ course.title }}{% endblock %}

{% block extra_styles %}
<style>
  .course-show-shell { padding: 44px 0 72px; }
  .course-card { background:#fff; border:1px solid #dbe5ef; border-radius:20px; box-shadow:0 12px 32px rgba(15,23,42,.09); overflow:hidden; }
  .course-head { padding:20px 24px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .course-head h3 { margin:0; font-weight:800; color:var(--pg-text,#111827); }
  .course-body { padding:24px; }
  .btn-feane { background:var(--pg-gold,#f9c23c); border:none; color:#111; font-weight:800; border-radius:20px; padding:9px 18px; display:inline-block; text-decoration:none; transition:background .18s; }
  .btn-feane:hover { background:var(--pg-gold-dark,#e6a800); color:#111; }
  .btn-soft { background:var(--pg-navy-2,#1f2937); border:none; color:#fff; font-weight:700; border-radius:20px; padding:9px 18px; display:inline-block; text-decoration:none; transition:opacity .18s; }
  .btn-soft:hover { opacity:.85; color:#fff; }
  .muted { color: var(--pg-text-muted,#6b7280); }
  .chip { display:inline-block; padding:5px 12px; border-radius:999px; background:#f1f5f9; border:1px solid #dbe5ef; font-weight:700; font-size:12px; margin-right:8px; color:#374151; }
  .thumb { border-radius:16px; width:100%; height:260px; object-fit:cover; border:1px solid #dbe5ef; background:#f8faff; }
  .content-list li { margin-bottom:8px; color:#4b5563; }
</style>
{% endblock %}

{% block body %}
<section class="course-show-shell">
  <div class="container">
    <div class="heading_container heading_center mb-4">
      <h2>{{ course.title }}</h2>
      <p class="text-muted mb-0">Discover what you'll learn before you start.</p>
    </div>

    <div class="course-card">
      <div class="course-head">
        <h3 class="h5 mb-0">Course Overview</h3>
        <a class="btn-soft" href="{{ path('app_courses') }}">? Back to Courses</a>
      </div>

      <div class="course-body">
        <div class="row g-4 align-items-start">
          <div class="col-lg-5">
            {% set thumb = course.thumbnailUrl|default('') %}
            {% if thumb %}
              {% set thumbSrc = (thumb starts with('http://') or thumb starts with('https://') or thumb starts with('/')) ? thumb : asset(thumb) %}
              <img class="thumb" src="{{ thumbSrc }}" alt="{{ course.title|e }}" onerror="this.onerror=null;this.src='{{ asset('front/images/f1.png') }}';">
            {% else %}
              <img class="thumb" src="{{ asset('front/images/f1.png') }}" alt="{{ course.title|e }}">
            {% endif %}
          </div>

          <div class="col-lg-7">
            <div class="mb-3">
              <span class="chip">Sections: {{ sections|length }}</span>
              <span class="chip">Videos: {{ totalVideos }}</span>
            </div>

            <h4 class="mb-2">About this course</h4>
            <p class="muted mb-4">{{ course.description }}</p>

            <div class="d-flex gap-2 flex-wrap mb-4">
              <a class="btn-feane" href="{{ path('course_learn', {id: course.id}) }}">? Start Course</a>
              <a class="btn-soft" href="{{ path('app_courses') }}">Cancel</a>
            </div>

            <h5 class="mb-2">Content</h5>
            {% if sections is empty %}
              <p class="muted mb-0">This course has no sections yet.</p>
            {% else %}
              <ul class="content-list mb-0">
                {% for section in sections %}
                  <li><strong>Section {{ section.orderIndex }}:</strong> {{ section.title }} <span class="muted">({{ section.courseVideos|length }} videos)</span></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
