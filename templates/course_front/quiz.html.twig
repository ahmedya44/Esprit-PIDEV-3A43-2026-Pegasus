{% extends 'front/layout.html.twig' %}

{% set active_nav = 'courses' %}
{% block title %}Final Quiz - {{ course.title }}{% endblock %}

{% block extra_styles %}
<style>
  .quiz-shell { padding: 44px 0 72px; }
  .quiz-card { background: #fff; border-radius: 20px; box-shadow: 0 12px 32px rgba(15,23,42,.09); border: 1px solid #dbe5ef; overflow: hidden; }
  .quiz-head { padding: 18px 24px; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: center; gap: 10px; background: #fff; }
  .quiz-head h3 { font-weight: 800; color: var(--pg-text,#111827); }
  .quiz-body { padding: 24px; }
  .btn-feane { background: var(--pg-gold,#f9c23c); border: none; color: #111; font-weight: 800; border-radius: 20px; padding: 10px 20px; text-decoration: none; display: inline-block; transition:background .18s; }
  .btn-feane:hover { background: var(--pg-gold-dark,#e6a800); color:#111; }
  .btn-soft { background: var(--pg-navy-2,#1f2937); border: none; color: #fff; font-weight: 700; border-radius: 20px; padding: 10px 20px; text-decoration: none; display: inline-block; transition:opacity .18s; }
  .btn-soft:hover { opacity:.85; color:#fff; }
  .q-card { border: 1px solid #dbe5ef; border-radius: 14px; padding: 16px 18px; background: #f8faff; margin-bottom: 14px; }
  .q-card .form-check-input:checked { background-color: var(--pg-gold,#f9c23c); border-color: var(--pg-gold,#f9c23c); }
  .muted { color: var(--pg-text-muted,#6b7280); font-weight: 600; }
</style>
{% endblock %}

{% block body %}
<section class="quiz-shell">
  <div class="container">
    <div class="quiz-card">
      <div class="quiz-head">
        <div>
          <h3 class="h5 mb-0">{{ quiz.title }}</h3>
          <div class="muted">Final quiz for: {{ course.title }}</div>
        </div>
        <a class="btn-soft" href="{{ path('course_learn', {id: course.id}) }}">? Back to Course</a>
      </div>

      <div class="quiz-body">
        <div class="mb-3">
          <span class="badge bg-dark">Passing score: {{ quiz.passingScore }}%</span>
          {% if quiz.timeLimitMin %}<span class="badge bg-secondary">Time: {{ quiz.timeLimitMin }} min</span>{% endif %}
          {% if quiz.attemptLimit %}<span class="badge bg-secondary">Attempts: {{ quiz.attemptLimit }}</span>{% endif %}
        </div>

        {% if questions is empty %}
          <div class="alert alert-warning mb-0">This quiz has no questions yet.</div>
        {% else %}
          {% if result %}
            <div class="alert {{ result.passed ? 'alert-success' : 'alert-danger' }}">
              <strong>{{ result.passed ? 'Passed' : 'Failed' }}</strong> -
              Score: {{ result.score }}% ({{ result.earnedPoints }}/{{ result.totalPoints }} points),
              Required: {{ result.passing }}%.
            </div>
            {% if result.passed and app.user %}
              <div class="mb-3">
                <a href="{{ path('course_certificate', {id: course.id}) }}" class="btn btn-warning">
                  <i class="fa fa-download me-1"></i> Download Certificate
                </a>
              </div>
            {% endif %}
          {% elseif bestAttempt is defined and bestAttempt and app.user %}
            <div class="mb-3">
              <a href="{{ path('course_certificate', {id: course.id}) }}" class="btn btn-outline-warning btn-sm">
                <i class="fa fa-download me-1"></i> Download Previous Certificate
              </a>
            </div>
          {% endif %}

          <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('course_quiz_' ~ quiz.id) }}">

            {% for q in questions %}
              <div class="q-card">
                <div class="fw-bold mb-2">Q{{ loop.index }}. {{ q.questionText }} <span class="muted">({{ q.points }} pts)</span></div>
                {% set choices = q.quizChoices|sort((a,b) => a.id <=> b.id) %}
                {% for c in choices %}
                  <div class="form-check mb-1">
                    <input class="form-check-input" type="radio" name="answers[{{ q.id }}]" id="choice_{{ c.id }}" value="{{ c.id }}">
                    <label class="form-check-label" for="choice_{{ c.id }}">{{ c.label }}</label>
                  </div>
                {% endfor %}
              </div>
            {% endfor %}

            <div class="d-flex gap-2">
              <button class="btn-feane" type="submit">Submit Quiz</button>
              <a class="btn-soft" href="{{ path('course_learn', {id: course.id}) }}">Cancel</a>
            </div>
          </form>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% endblock %}
