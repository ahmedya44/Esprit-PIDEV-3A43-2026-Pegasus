{% extends 'front/layout.html.twig' %}

{% set active_nav = 'courses' %}
{% block title %}Learn - {{ course.title }}{% endblock %}

{% block extra_styles %}
<style>
  .learn-shell { padding: 44px 0 72px; }
  .learn-card { background:#fff; border:1px solid #dbe5ef; border-radius:20px; box-shadow:0 12px 32px rgba(15,23,42,.09); overflow:hidden; }
  .learn-head { padding:18px 24px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .learn-head h3 { margin:0; font-weight:800; color:var(--pg-text,#111827); }
  .learn-body { padding:22px; }
  .btn-feane { background:var(--pg-gold,#f9c23c); border:none; color:#111; font-weight:800; border-radius:20px; padding:9px 18px; display:inline-block; text-decoration:none; cursor:pointer; transition:background .18s; }
  .btn-feane:hover { background:var(--pg-gold-dark,#e6a800); color:#111; }
  .btn-soft { background:var(--pg-navy-2,#1f2937); border:none; color:#fff; font-weight:700; border-radius:20px; padding:9px 18px; display:inline-block; text-decoration:none; transition:opacity .18s; }
  .btn-soft:hover { opacity:.85; color:#fff; }
  .sidebar { max-height:70vh; overflow:auto; border:1px solid #dbe5ef; border-radius:16px; background:#f8faff; padding:16px; }
  .video-link { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 14px; border-radius:12px; border:1px solid #dbe5ef; background:#fff; margin-bottom:8px; text-decoration:none; color:#111827; font-weight:600; font-size:.875rem; transition:border-color .18s, background .18s; }
  .video-link:hover { border-color:#f9c23c; background:#fef9c3; color:#111; }
  .video-link.active { border-color:var(--pg-gold,#f9c23c); background:rgba(249,194,60,.14); font-weight:800; }
  .video-link.locked { opacity:.50; cursor:not-allowed; }
  .muted { color:var(--pg-text-muted,#6b7280); font-weight:600; }
  .badge-preview { background:var(--pg-gold,#f9c23c); color:#111; font-weight:800; }
  .badge-done { background:#059669; color:#fff; font-weight:700; }
  .player-wrap { border-radius:16px; overflow:hidden; border:1px solid #dbe5ef; background:#0f172a; width:100%; }
  .ratio iframe { width:100%!important; height:100%!important; }
</style>
{% endblock %}

{% block body %}
<section class="learn-shell">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h2 class="mb-0">{{ course.title }}</h2>
        <div class="text-muted">Course player</div>
      </div>
      <a class="btn-soft" href="{{ path('course_show', {id: course.id}) }}">? Back</a>
    </div>

    <div class="row g-3">
      <div class="col-lg-4">
        <div class="sidebar">
          <h5 class="mb-3">Sections</h5>

          {% for section in sections %}
            <div class="mb-3">
              <div style="font-weight:900;">Section {{ section.orderIndex }} � {{ section.title }}</div>
              <div class="muted mb-2">Videos: {{ section.courseVideos|length }}</div>

              {% set videos = section.courseVideos|sort((a,b) => a.orderIndex <=> b.orderIndex) %}
              {% if videos is empty %}
                <div class="muted">No videos yet.</div>
              {% else %}
                {% for video in videos %}
                  {% set isUnlocked = unlockedIds[video.id ~ ''] is defined and unlockedIds[video.id ~ ''] %}
                  {% set isDone = completed[video.id ~ ''] is defined %}
                  {% set isActive = selectedVideo and video.id == selectedVideo.id %}

                  {% if isUnlocked %}
                    <a class="video-link {% if isActive %}active{% endif %}" href="{{ path('course_learn', {id: course.id}) ~ '?v=' ~ video.id }}">
                      <span>
                        {{ video.orderIndex }}. {{ video.title }}
                        {% if video.isPreview %}<span class="badge badge-preview ms-2">Preview</span>{% endif %}
                      </span>
                      {% if isDone %}<span class="badge badge-done">Done</span>{% endif %}
                    </a>
                  {% else %}
                    <div class="video-link locked"><span>{{ video.orderIndex }}. {{ video.title }}</span><span class="badge bg-dark">Locked</span></div>
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      <div class="col-lg-8">
        <div class="learn-card">
          <div class="learn-head">
            <h3 class="h5 mb-0">Lesson</h3>
            {% if selectedVideo %}<span class="muted">{{ selectedVideo.durationSec }} sec</span>{% endif %}
          </div>

          <div class="learn-body">
            {% if not selectedVideo %}
              <p class="muted mb-0">No video available yet.</p>
            {% else %}
              <h4 class="mb-2">{{ selectedVideo.title }}</h4>
              <p class="muted mb-3">{% if selectedVideo.isPreview %}Preview video{% else %}Lesson video{% endif %}</p>

              {% set url = selectedVideo.videoUrl %}
              {% set ytId = null %}
              {% set vimeoId = null %}

              {% if 'youtu.be/' in url %}
                {% set ytId = url|split('youtu.be/')|last|split('?')|first %}
              {% elseif 'youtube.com/watch' in url and ('v=' in url) %}
                {% set ytId = url|split('v=')|last|split('&')|first %}
              {% elseif 'youtube.com/embed/' in url %}
                {% set ytId = url|split('youtube.com/embed/')|last|split('?')|first %}
              {% endif %}

              {% if ytId is null and 'vimeo.com/' in url %}
                {% set vimeoId = url|split('vimeo.com/')|last|split('?')|first %}
              {% endif %}

              {% set lowerUrl = url|lower %}
              {% set isFileVideo = lowerUrl ends with '.mp4' or lowerUrl ends with '.webm' or lowerUrl ends with '.ogg' %}

              <div class="player-wrap mb-3">
                {% if ytId %}
                  <div class="ratio ratio-16x9"><iframe src="https://www.youtube-nocookie.com/embed/{{ ytId }}" title="{{ selectedVideo.title|e }}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
                {% elseif vimeoId %}
                  <div class="ratio ratio-16x9"><iframe src="https://player.vimeo.com/video/{{ vimeoId }}" title="{{ selectedVideo.title|e }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>
                {% elseif isFileVideo %}
                  <video controls style="width:100%; height:auto; display:block;"><source src="{{ url }}" type="video/{{ lowerUrl ends with '.mp4' ? 'mp4' : (lowerUrl ends with '.webm' ? 'webm' : 'ogg') }}">Your browser does not support the video tag.</video>
                {% else %}
                  <div style="padding:16px; background:rgba(255,255,255,.92);">
                    <p class="muted mb-3">This link can�t be embedded automatically.</p>
                    <a class="btn-feane" href="{{ url }}" target="_blank">Open Video ?</a>
                  </div>
                {% endif %}
              </div>

              {% if selectedCompleted %}
                <div class="muted">? Completed. You can go to the next lesson from the left menu.</div>
              {% else %}
                <button class="btn-feane" id="markDoneBtn" type="button">? Mark lesson as completed</button>
                <div class="muted mt-2">This will unlock the next lesson.</div>
              {% endif %}

              <hr>
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="muted">Course progress: <strong>{{ completedCount }}/{{ allVideoCount }}</strong> lessons completed</div>
                {% if courseQuiz %}
                  {% if courseCompleted %}
                    <a class="btn-feane" href="{{ path('course_quiz', {id: course.id}) }}">?? Take Final Quiz</a>
                  {% else %}
                    <button class="btn-soft" type="button" disabled title="Complete all lessons first">?? Quiz Locked</button>
                  {% endif %}
                {% else %}
                  <span class="muted">No final quiz available for this course yet.</span>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block extra_scripts %}
  {% if selectedVideo and not selectedCompleted %}
  <script>
    const btn = document.getElementById('markDoneBtn');
    if (btn) {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.textContent = "Saving...";

        await fetch("{{ path('course_video_complete', {courseId: course.id, videoId: selectedVideo.id}) }}", {
          method: "POST",
          headers: {"X-Requested-With": "XMLHttpRequest"}
        });

        location.reload();
      });
    }
  </script>
  {% endif %}
{% endblock %}
