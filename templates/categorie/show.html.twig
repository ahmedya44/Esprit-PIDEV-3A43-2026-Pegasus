{% extends 'back/layout.html.twig' %}

{% block title %}Category{% endblock %}

{% block body %}
<div class="page-header"><h3 class="fw-bold mb-3">{{ categorie.nom }}</h3></div>
<div class="card">
  <div class="card-body">
    <p class="text-muted">{{ categorie.description|default('No description') }}</p>
    <div class="d-flex gap-2">
      <a class="btn btn-secondary" href="{{ path('app_categorie_edit', {id: categorie.id}) }}">Edit</a>
      <a class="btn btn-link" href="{{ path('app_categorie_index') }}">Back to categories</a>
      {{ include('categorie/_delete_form.html.twig') }}
    </div>
  </div>
</div>
{% endblock %}
