<div
    class="gif-picker"
    data-gif-picker
    data-endpoint="{{ endpoint }}"
    data-input-id="{{ field.vars.id }}"
    data-auto-submit-on-pick="{{ auto_submit_on_pick|default(false) ? '1' : '0' }}"
>
    {{ form_widget(field) }}
    {{ form_errors(field) }}

    <div class="input-group mb-2">
        <input type="search" class="form-control js-gif-query" placeholder="Rechercher un GIF (ex: art, painting, dance)...">
        <button type="button" class="btn btn-outline-secondary js-gif-search-btn">Rechercher</button>
    </div>

    <div class="d-flex align-items-center gap-2 mb-2 js-gif-selected-wrap" style="display:none;">
        <img src="" alt="GIF selectionne" class="js-gif-selected-img rounded" style="max-height: 90px;">
        <button type="button" class="btn btn-sm btn-outline-danger js-gif-clear">Retirer</button>
    </div>

    <div class="gif-picker-grid js-gif-results"></div>
</div>
