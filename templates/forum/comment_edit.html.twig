{% extends 'front/layout.html.twig' %}

{% set active_nav = 'forum' %}

{% block title %}Modifier commentaire - Forum{% endblock %}
{% block extra_styles %}
<style>
  .gif-picker-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 8px;
    max-height: 290px;
    overflow: auto;
    border: 1px solid #eef1f6;
    border-radius: 10px;
    padding: 8px;
    background: #fafbff;
  }
  .gif-picker-item {
    border: 1px solid #dde3ef;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    background: #fff;
    padding: 0;
  }
  .gif-picker-item.is-active {
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px rgba(59,130,246,.18);
  }
  .gif-picker-item img {
    width: 100%;
    height: 90px;
    object-fit: cover;
    display: block;
  }
</style>
{% endblock %}

{% block body %}
<section class="forum-shell">
    <div class="container">
        <div class="forum-card">
            <h2 class="mb-4">Modifier le commentaire</h2>

            {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="form-group">
                {{ form_label(form.content, 'Commentaire') }}
                {{ form_widget(form.content) }}
                {{ form_errors(form.content) }}
            </div>
            <div class="form-group">
                <label class="form-label d-block">GIF</label>
                {% include 'forum/_gif_picker.html.twig' with {
                    field: form.gifUrl,
                    endpoint: path('forum_gif_search')
                } %}
            </div>
            {% if commentaire.gifUrl %}
                <div class="mb-3">
                    <img src="{{ commentaire.gifUrl }}" alt="GIF commentaire {{ commentaire.id }}" class="img-fluid rounded" style="max-height: 240px;">
                </div>
            {% endif %}
            <a href="{{ path('forum_show', {id: post.id}) }}" class="btn btn-outline-dark">Annuler</a>
            <button type="submit" class="btn btn-warning">Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </div>
</section>
{% endblock %}
{% block extra_scripts %}
<script>
  (function () {
    function initGifPicker(root) {
      var endpoint = root.dataset.endpoint || '';
      var inputId = root.dataset.inputId || '';
      var hiddenInput = inputId ? document.getElementById(inputId) : null;
      var queryInput = root.querySelector('.js-gif-query');
      var searchBtn = root.querySelector('.js-gif-search-btn');
      var grid = root.querySelector('.js-gif-results');
      var selectedWrap = root.querySelector('.js-gif-selected-wrap');
      var selectedImg = root.querySelector('.js-gif-selected-img');
      var clearBtn = root.querySelector('.js-gif-clear');
      if (!endpoint || !hiddenInput || !queryInput || !searchBtn || !grid || !selectedWrap || !selectedImg || !clearBtn) return;

      var timer = null;

      function setSelected(url) {
        hiddenInput.value = url || '';
        if (url) {
          selectedImg.src = url;
          selectedWrap.style.display = '';
        } else {
          selectedImg.src = '';
          selectedWrap.style.display = 'none';
        }
        grid.querySelectorAll('.gif-picker-item').forEach(function (node) {
          node.classList.toggle('is-active', node.dataset.url === url);
        });
      }

      function render(items) {
        grid.innerHTML = '';
        if (!Array.isArray(items) || items.length === 0) {
          grid.innerHTML = '<small class="text-muted">Aucun GIF trouve.</small>';
          return;
        }
        items.forEach(function (item) {
          var button = document.createElement('button');
          button.type = 'button';
          button.className = 'gif-picker-item';
          button.dataset.url = item.url || '';
          button.title = item.title || 'GIF';
          button.innerHTML = '<img src="' + (item.preview || item.url || '') + '" alt="' + (item.title || 'GIF') + '">';
          button.addEventListener('click', function () { setSelected(button.dataset.url || ''); });
          grid.appendChild(button);
        });
        if (hiddenInput.value) setSelected(hiddenInput.value);
      }

      function search() {
        var q = (queryInput.value || '').trim();
        fetch(endpoint + '?q=' + encodeURIComponent(q) + '&limit=18', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) { render(data && data.items ? data.items : []); })
          .catch(function () { render([]); });
      }

      queryInput.addEventListener('input', function () {
        if (timer) clearTimeout(timer);
        timer = setTimeout(search, 300);
      });
      queryInput.addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          search();
        }
      });
      searchBtn.addEventListener('click', search);
      clearBtn.addEventListener('click', function () { setSelected(''); });

      setSelected(hiddenInput.value || '');
      search();
    }

    document.querySelectorAll('[data-gif-picker]').forEach(initGifPicker);
  })();
</script>
{% endblock %}
