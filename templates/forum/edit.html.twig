{% extends 'front/layout.html.twig' %}

{% set active_nav = 'forum' %}

{% block title %}Modifier sujet - Forum{% endblock %}
{% block extra_styles %}
<style>
  .status-3d-select {
    border-radius: 12px;
    border: 1px solid #d9deea;
    background: linear-gradient(155deg, #ffffff, #eef2fb);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.08);
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .status-3d-select:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12);
  }
  .status-3d-select:focus {
    border-color: #3b82f6;
    box-shadow: 0 0 0 .2rem rgba(59, 130, 246, .15), 0 16px 26px rgba(15, 23, 42, .12);
    transform: perspective(700px) rotateX(3deg);
  }
  .viewer3d-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, .42);
    backdrop-filter: blur(2px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2100;
    padding: 20px;
  }
  .viewer3d-backdrop.is-open { display: flex; }
  .viewer3d-modal {
    width: min(470px, 100%);
    border-radius: 16px;
    border: 1px solid #dbe3f4;
    background: linear-gradient(165deg, #ffffff, #eef3ff);
    box-shadow: 0 24px 52px rgba(15, 23, 42, .28);
    transform: perspective(900px) rotateX(10deg) translateY(16px) scale(.96);
    opacity: 0;
    transition: transform .22s ease, opacity .22s ease;
    overflow: hidden;
  }
  .viewer3d-backdrop.is-open .viewer3d-modal {
    transform: perspective(900px) rotateX(0deg) translateY(0) scale(1);
    opacity: 1;
  }
  .viewer3d-head { padding: 14px 16px; border-bottom: 1px solid #e7ecf8; font-weight: 700; }
  .viewer3d-body { padding: 16px; }
  .viewer3d-tags {
    min-height: 42px;
    border: 1px solid #dbe3f4;
    border-radius: 10px;
    background: #fff;
    padding: 6px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }
  .viewer3d-tag {
    background: #e8efff;
    color: #1e3a8a;
    border-radius: 999px;
    padding: 3px 10px;
    font-size: .84rem;
    font-weight: 600;
  }
  .viewer3d-actions { display: flex; justify-content: flex-end; gap: 8px; padding: 0 16px 16px; }
</style>
{% endblock %}

{% block body %}
<section class="forum-shell">
    <div class="container">
        <div class="forum-card">
            <h2 class="mb-4">Modifier le sujet</h2>

            {{ form_start(form) }}
            {{ form_errors(form) }}
            <div class="form-group">
                {{ form_label(form.title, 'Titre') }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>
            <div class="form-group">
                {{ form_label(form.content, 'Contenu') }}
                {{ form_widget(form.content) }}
                {{ form_errors(form.content) }}
            </div>
            <div class="form-group">
                {{ form_label(form.status, 'Visibilite du post') }}
                {{ form_widget(form.status) }}
                {{ form_errors(form.status) }}
            </div>
            <div class="form-group js-allowed-viewers-wrap" style="display:none;">
                {{ form_label(form.allowedViewerIds) }}
                {{ form_widget(form.allowedViewerIds) }}
                {{ form_errors(form.allowedViewerIds) }}
                <small class="form-text text-muted">Visible uniquement pour le proprietaire, admin et les IDs saisis.</small>
            </div>
            {% if post.imageName %}
                <div class="mb-3">
                    <img src="{{ vich_uploader_asset(post, 'imageFile') }}" alt="Image du sujet" class="img-fluid rounded" style="max-height: 240px;">
                </div>
            {% endif %}
            <div class="form-group">
                {{ form_label(form.imageFile) }}
                {{ form_widget(form.imageFile) }}
                {{ form_errors(form.imageFile) }}
            </div>
            <a href="{{ path('forum_show', {id: post.id}) }}" class="btn btn-outline-dark">Annuler</a>
            <button type="submit" class="btn btn-warning">Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </div>
</section>
<div class="viewer3d-backdrop" id="viewer3d-backdrop-edit" aria-hidden="true">
    <div class="viewer3d-modal" role="dialog" aria-modal="true" aria-labelledby="viewer3d-title-edit">
        <div class="viewer3d-head" id="viewer3d-title-edit">Visibilite restreinte</div>
        <div class="viewer3d-body">
            <p class="mb-2">Ce post sera cache. Saisis les IDs des utilisateurs autorises a le voir.</p>
            <div class="viewer3d-tags" id="viewer3d-tags-edit"></div>
            <input type="text" class="form-control" id="viewer3d-input-edit" placeholder="Saisir un ID puis Entrée">
            <small class="text-muted d-block mt-2">Entrée ajoute un ID. Entrée sur vide confirme.</small>
        </div>
        <div class="viewer3d-actions">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="viewer3d-cancel-edit">Annuler</button>
            <button type="button" class="btn btn-primary btn-sm" id="viewer3d-save-edit">Valider</button>
        </div>
    </div>
</div>
{% endblock %}
{% block extra_scripts %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var statusField = document.getElementById('{{ form.status.vars.id }}');
    var idsField = document.getElementById('{{ form.allowedViewerIds.vars.id }}');
    var wrap = document.querySelector('.js-allowed-viewers-wrap');
    var postForm = statusField ? statusField.form : null;
    var lastStatus = statusField ? statusField.value : null;
    var submitting = false;
    var lastPromptAt = 0;
    var backdrop = document.getElementById('viewer3d-backdrop-edit');
    var tags = document.getElementById('viewer3d-tags-edit');
    var modalInput = document.getElementById('viewer3d-input-edit');
    var cancelBtn = document.getElementById('viewer3d-cancel-edit');
    var saveBtn = document.getElementById('viewer3d-save-edit');
    var onResolve = null;

    var draftIds = [];

    if (!statusField || !idsField || !wrap || !postForm || !backdrop || !tags || !modalInput || !cancelBtn || !saveBtn) {
      return;
    }

    function parseIds(raw) {
      var parts = String(raw || '').split(/[^0-9]+/);
      var out = [];
      var seen = {};
      parts.forEach(function (p) {
        if (!p) return;
        var n = parseInt(p, 10);
        if (!Number.isFinite(n) || n <= 0) return;
        if (seen[n]) return;
        seen[n] = true;
        out.push(String(n));
      });
      return out;
    }

    function renderTags() {
      tags.innerHTML = '';
      draftIds.forEach(function (id) {
        var chip = document.createElement('span');
        chip.className = 'viewer3d-tag';
        chip.textContent = '#' + id;
        tags.appendChild(chip);
      });
    }

    function addDraftIdFromInput() {
      var values = parseIds(modalInput.value);
      if (values.length === 0) {
        return false;
      }
      values.forEach(function (id) {
        if (draftIds.indexOf(id) === -1) {
          draftIds.push(id);
        }
      });
      modalInput.value = '';
      renderTags();
      return true;
    }

    function commitDraftToField() {
      idsField.value = draftIds.join(', ');
    }

    function syncVisibility() {
      var isHidden = statusField.value === 'HIDDEN';
      wrap.style.display = isHidden ? '' : 'none';
      if (!isHidden) {
        idsField.value = '';
      }
    }

    function closeModal(saved) {
      backdrop.classList.remove('is-open');
      backdrop.setAttribute('aria-hidden', 'true');
      if (saved) {
        addDraftIdFromInput();
        commitDraftToField();
      }
      if (typeof onResolve === 'function') {
        onResolve(saved);
      }
      onResolve = null;
    }

    function openPrompt(callback) {
      var now = Date.now();
      if (now - lastPromptAt < 180) {
        return;
      }
      lastPromptAt = now;
      onResolve = callback || null;
      draftIds = parseIds(idsField.value);
      renderTags();
      modalInput.value = '';
      backdrop.classList.add('is-open');
      backdrop.setAttribute('aria-hidden', 'false');
      window.setTimeout(function () { modalInput.focus(); }, 20);
    }

    function maybePromptAllowedViewers(force, callback) {
      var currentStatus = statusField.value;
      var enteringHidden = currentStatus === 'HIDDEN' && lastStatus !== 'HIDDEN';
      var needsIds = currentStatus === 'HIDDEN' && idsField.value.trim() === '';
      if (enteringHidden || (force && needsIds)) {
        openPrompt(function (saved) {
          if (typeof callback === 'function') {
            callback(saved);
          }
        });
        lastStatus = currentStatus;
        syncVisibility();
        return;
      }

      lastStatus = currentStatus;
      syncVisibility();
    }

    document.addEventListener('click', function (event) {
      var option = event.target.closest('.nice-select .option');
      if (!option) {
        return;
      }
      if (String(option.getAttribute('data-value')).toUpperCase() !== 'HIDDEN') {
        return;
      }
      window.setTimeout(function () {
        maybePromptAllowedViewers(false, null);
      }, 0);
    });

    cancelBtn.addEventListener('click', function () { closeModal(false); });
    saveBtn.addEventListener('click', function () { closeModal(true); });
    backdrop.addEventListener('click', function (event) {
      if (event.target === backdrop) {
        closeModal(false);
      }
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && backdrop.classList.contains('is-open')) {
        closeModal(false);
      }
    });
    modalInput.addEventListener('keydown', function (event) {
      if (event.key === 'Enter') {
        event.preventDefault();
        if (modalInput.value.trim() === '') {
          closeModal(true);
          return;
        }
        addDraftIdFromInput();
      }
    });

    statusField.addEventListener('input', function () { maybePromptAllowedViewers(false, null); });
    statusField.addEventListener('change', function () { maybePromptAllowedViewers(false, null); });
    postForm.addEventListener('submit', function (event) {
      if (submitting) {
        return;
      }
      if (statusField.value !== 'HIDDEN') {
        return;
      }
      if (idsField.value.trim() !== '') {
        return;
      }

      event.preventDefault();
      maybePromptAllowedViewers(true, function (saved) {
        if (!saved || idsField.value.trim() === '') {
          return;
        }
        submitting = true;
        postForm.submit();
      });
    });

    syncVisibility();
  });
</script>
{% endblock %}
