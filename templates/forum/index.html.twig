{% extends 'front/layout.html.twig' %}

{% set active_nav = 'forum' %}
{% block title %}Forum Feed{% endblock %}

{% block extra_styles %}
<style>
  .feed-shell { min-height: 72vh; padding: 30px 0 56px; background: var(--pg-bg,#f4f6fb); }
  .feed-container { max-width: 860px; margin: 0 auto; }
  .feed-card {
    background: #fff;
    border: 1px solid #dbe5ef;
    border-radius: 16px;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.07);
    padding: 16px 18px;
    transition: transform .18s ease, box-shadow .18s ease, opacity .18s ease;
  }
  .feed-card.is-opening {
    transform: perspective(900px) rotateX(6deg) translateY(-4px) scale(0.985);
    box-shadow: 0 16px 36px rgba(15, 23, 42, 0.18);
    opacity: .92;
  }
  .feed-toolbar { position: sticky; top: 14px; z-index: 10; }
  .feed-title { font-size: 1.3rem; font-weight: 800; color: var(--pg-navy,#111827); }
  .post-title { font-size: 1.05rem; font-weight: 700; line-height: 1.35; margin: 0; color: var(--pg-navy,#111827); }
  .post-meta { color: var(--pg-text-muted,#6b7280); font-size: 0.84rem; }
  .post-content { color: #374151; line-height: 1.6; }
  .post-image { width: 100%; max-height: 400px; object-fit: cover; border-radius: 12px; border: 1px solid #dbe5ef; }
  .rating-display-stars { --rating: 0; position: relative; display: inline-block; font-size: 0.95rem; line-height: 1; vertical-align: middle; top: -1px; }
  .rating-display-stars::before { content: "\2605\2605\2605\2605\2605"; color: #d0d5dd; }
  .rating-display-stars::after {
    content: "\2605\2605\2605\2605\2605";
    color: var(--pg-gold,#f9c23c);
    position: absolute; top: 0; left: 0;
    width: calc((var(--rating) / 5) * 100%);
    overflow: hidden; white-space: nowrap;
  }
  .btn-forum-primary { background: var(--pg-gold,#f9c23c); color: #111; border: none; border-radius: 20px; font-weight: 700; padding: 7px 16px; font-size: .875rem; text-decoration:none; transition: background .18s; display:inline-flex; align-items:center; gap:5px; }
  .btn-forum-primary:hover { background: var(--pg-gold-dark,#e6a800); color: #111; text-decoration:none; }
  .btn-forum-soft { background: #fff; border: 1px solid #dbe5ef; color: #374151; border-radius: 20px; font-weight: 600; padding: 7px 16px; font-size: .875rem; text-decoration:none; transition: background .18s; display:inline-flex; align-items:center; gap:5px; }
  .btn-forum-soft:hover { background: #f4f6fb; color:#111; text-decoration:none; }
  .btn-view-post { border:1px solid var(--pg-teal,#0f766e); color:var(--pg-teal,#0f766e); background:#fff; border-radius:20px; padding:5px 14px; font-size:.83rem; font-weight:600; text-decoration:none; transition:background .18s; }
  .btn-view-post:hover { background:var(--pg-teal,#0f766e); color:#fff; text-decoration:none; }
</style>
{% endblock %}

{% block body %}
<section class="feed-shell">
  <div class="container">
    <div class="feed-container">
      <div class="feed-card feed-toolbar mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h1 class="feed-title mb-0">Forum</h1>
          <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('forum_stats') }}" class="btn-forum-soft"><i class="fa fa-bar-chart"></i> Stats</a>
            {% if app.user %}
              <a href="{{ path('forum_my_posts') }}" class="btn-forum-soft"><i class="fa fa-folder-open"></i> My Posts</a>
              <a href="{{ path('forum_new') }}" class="btn-forum-primary"><i class="fa fa-plus"></i> New Post</a>
            {% endif %}
          </div>
        </div>

        <form method="get" class="row g-2" data-live-search-form="1" data-live-delay="280">
          <div class="col-md-7">
            <input type="search" name="q" value="{{ q }}" class="form-control" placeholder="Search posts..." data-live-search-input="1">
          </div>
          <div class="col-md-3">
            <select name="sort" class="form-control">
              <option value="newest" {% if sort == 'newest' %}selected{% endif %}>Newest first</option>
              <option value="oldest" {% if sort == 'oldest' %}selected{% endif %}>Oldest first</option>
              <option value="comments" {% if sort == 'comments' %}selected{% endif %}>Most comments</option>
              <option value="title_az" {% if sort == 'title_az' %}selected{% endif %}>Title A–Z</option>
              <option value="title_za" {% if sort == 'title_za' %}selected{% endif %}>Title Z–A</option>
            </select>
          </div>
          <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100">Search</button>
          </div>
        </form>
      </div>

      {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">{{ message }}</div>
      {% endfor %}
      {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
      {% endfor %}

      {% if pagination|length > 0 %}
        {% for post in pagination %}
          {% set rating = ratingSummaries[post.id] ?? {avg: 0, count: 0} %}
          <article class="feed-card mb-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <p class="mb-1 post-title">{{ post.title }}</p>
                <div class="post-meta">
                  <i class="fa fa-user-circle mr-1"></i>{{ post.authorName }}
                  &nbsp;&middot;&nbsp;
                  <i class="fa fa-clock-o mr-1"></i>{{ post.createdAt|date('d M Y, H:i') }}
                </div>
              </div>
              {% if post.status == 'IN_PROGRESS' %}
                <span class="badge" style="background:#fef3c7;color:#92400e;border-radius:999px;font-size:.72rem;">Pending review</span>
              {% elseif post.status == 'DENIED' %}
                <span class="badge" style="background:#fee2e2;color:#991b1b;border-radius:999px;font-size:.72rem;">Denied</span>
              {% elseif post.status == 'CLOSED' %}
                <span class="badge badge-warning" style="border-radius:999px; font-size:.72rem;">Closed</span>
              {% endif %}
            </div>

            {% set cleanPostContent = post.content|striptags|replace({'&nbsp;': ' '})|trim %}
            <div class="post-content mb-2">{{ cleanPostContent|slice(0, 280) }}{% if cleanPostContent|length > 280 %}...{% endif %}</div>

            {% if post.imageName %}
              <div class="mb-2">
                <img src="{{ vich_uploader_asset(post, 'imageFile') }}" alt="{{ post.title }}" class="post-image">
              </div>
            {% endif %}

            <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
              <small class="text-muted">
                <i class="fa fa-comment-o mr-1"></i>{{ post.commentaires|length }} comment{{ post.commentaires|length != 1 ? 's' : '' }}
                &nbsp;&middot;&nbsp;
                {% if rating.count > 0 %}
                  <span class="rating-display-stars" style="--rating: {{ rating.avg|number_format(2, '.', '') }};"></span>
                  {{ rating.avg|number_format(1, '.', '') }}/5
                  ({{ rating.count }})
                {% else %}
                  No rating yet
                {% endif %}
              </small>
              <a href="{{ path('forum_show', {id: post.id}) }}" class="btn-view-post js-open-post">Read post</a>
            </div>
          </article>
        {% endfor %}

        <div class="mt-3 d-flex justify-content-center">{{ knp_pagination_render(pagination) }}</div>
      {% else %}
        <div class="feed-card"><div class="alert alert-info mb-0">No posts found.</div></div>
      {% endif %}
    </div>
  </div>
</section>
{% endblock %}

{% block extra_scripts %}
<script>
  (function () {
    document.querySelectorAll('.js-open-post').forEach(function (link) {
      link.addEventListener('click', function (event) {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        var card = link.closest('.feed-card');
        if (card) card.classList.add('is-opening');
        window.setTimeout(function () { window.location.href = link.href; }, 140);
      });
    });
  })();
</script>
{% endblock %}
