<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <title>{% block title %}Backoffice{% endblock %}</title>
  <meta content="width=device-width, initial-scale=1.0, shrink-to-fit=no" name="viewport" />
  <link rel="icon" href="{{ asset('back/img/kaiadmin/favicon.ico') }}" type="image/x-icon" />

  <script src="{{ asset('back/js/plugin/webfont/webfont.min.js') }}"></script>
  <script>
    WebFont.load({
      google: { families: ["Public Sans:300,400,500,600,700"] },
      custom: {
        families: [
          "Font Awesome 5 Solid",
          "Font Awesome 5 Regular",
          "Font Awesome 5 Brands",
          "simple-line-icons",
        ],
        urls: ["{{ asset('back/css/fonts.min.css') }}"],
      },
      active: function () { sessionStorage.fonts = true; },
    });
  </script>

  <link rel="stylesheet" href="{{ asset('back/css/bootstrap.min.css') }}" />
  <link rel="stylesheet" href="{{ asset('back/css/plugins.min.css') }}" />
  <link rel="stylesheet" href="{{ asset('back/css/kaiadmin.min.css') }}" />
  <style>
    .confirm3d-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(8, 10, 14, 0.45);
      backdrop-filter: blur(2px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 3000;
      padding: 20px;
    }
    .confirm3d-backdrop.is-open { display: flex; }
    .confirm3d-modal {
      width: min(460px, 100%);
      background: linear-gradient(160deg, #ffffff, #f7f8fb);
      border: 1px solid #e5e7ef;
      border-radius: 18px;
      box-shadow: 0 28px 60px rgba(15, 23, 42, 0.25);
      transform: perspective(850px) rotateX(9deg) translateY(8px) scale(0.96);
      opacity: 0;
      transition: transform .22s ease, opacity .22s ease;
      overflow: hidden;
    }
    .confirm3d-backdrop.is-open .confirm3d-modal {
      transform: perspective(850px) rotateX(0deg) translateY(0) scale(1);
      opacity: 1;
    }
    .confirm3d-head {
      padding: 14px 18px;
      font-weight: 700;
      color: #111827;
      border-bottom: 1px solid #eceef4;
      background: #ffffff;
    }
    .confirm3d-body {
      padding: 16px 18px;
      color: #374151;
      line-height: 1.45;
    }
    .confirm3d-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding: 14px 18px 18px;
    }
  </style>
  {% block extra_styles %}{% endblock %}
</head>
<body>
  <div class="wrapper">
    <div class="sidebar" data-background-color="dark">
      <div class="sidebar-logo">
        <div class="logo-header" data-background-color="dark">
          <a href="{{ path('back_dashboard') }}" class="logo">
            <img src="{{ asset('back/img/kaiadmin/logo_light.svg') }}" alt="navbar brand" class="navbar-brand" height="20" />
          </a>
          <div class="nav-toggle">
            <button class="btn btn-toggle toggle-sidebar"><i class="gg-menu-right"></i></button>
            <button class="btn btn-toggle sidenav-toggler"><i class="gg-menu-left"></i></button>
          </div>
        </div>
      </div>
      <div class="sidebar-wrapper scrollbar scrollbar-inner">
        <div class="sidebar-content">
          <ul class="nav nav-secondary">
            <li class="nav-item">
              <a href="{{ path('back_dashboard') }}"><i class="fas fa-home"></i><p>Dashboard</p></a>
            </li>
            <li class="nav-section">
              <span class="sidebar-mini-icon"><i class="fa fa-ellipsis-h"></i></span>
              <h4 class="text-section">Forum</h4>
            </li>
            <li class="nav-item">
              <a href="{{ path('admin_forum_posts_index') }}"><i class="fas fa-comments"></i><p>Sujets</p></a>
            </li>
            <li class="nav-item">
              <a href="{{ path('admin_forum_comments_index') }}"><i class="fas fa-comment-dots"></i><p>Commentaires</p></a>
            </li>
            <li class="nav-item">
              <a href="{{ path('front_home') }}"><i class="fas fa-globe"></i><p>Voir le site</p></a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="main-panel">
      <div class="container">
        <div class="page-inner">
          {% block body %}{% endblock %}
        </div>
      </div>
    </div>
  </div>

  <div id="confirm3d" class="confirm3d-backdrop" aria-hidden="true">
    <div class="confirm3d-modal" role="dialog" aria-modal="true" aria-labelledby="confirm3d-title">
      <div class="confirm3d-head" id="confirm3d-title">Confirmation</div>
      <div class="confirm3d-body" id="confirm3d-message">Voulez-vous continuer ?</div>
      <div class="confirm3d-actions">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="confirm3d-cancel">Annuler</button>
        <button type="button" class="btn btn-danger btn-sm" id="confirm3d-ok">Supprimer</button>
      </div>
    </div>
  </div>

  <script src="{{ asset('back/js/core/jquery-3.7.1.min.js') }}"></script>
  <script src="{{ asset('back/js/core/popper.min.js') }}"></script>
  <script src="{{ asset('back/js/core/bootstrap.min.js') }}"></script>
  <script src="{{ asset('back/js/plugin/jquery-scrollbar/jquery.scrollbar.min.js') }}"></script>
  <script src="{{ asset('back/js/kaiadmin.min.js') }}"></script>

  <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
  <script>
    document.querySelectorAll('textarea.js-ckeditor').forEach(function (el) {
      if (el.dataset.ckeditorReady) {
        return;
      }

      ClassicEditor.create(el).then(function () {
        el.dataset.ckeditorReady = '1';
      }).catch(function () {
        // Keep native textarea if CDN is unavailable.
      });
    });
  </script>
  <script>
    (function () {
      var backdrop = document.getElementById('confirm3d');
      if (!backdrop) return;
      var title = document.getElementById('confirm3d-title');
      var message = document.getElementById('confirm3d-message');
      var cancelBtn = document.getElementById('confirm3d-cancel');
      var okBtn = document.getElementById('confirm3d-ok');
      var pendingForm = null;

      function closeModal() {
        backdrop.classList.remove('is-open');
        backdrop.setAttribute('aria-hidden', 'true');
        pendingForm = null;
      }

      document.addEventListener('click', function (event) {
        var form = event.target.closest('form[data-confirm-message]');
        if (!form) return;
        if (form.dataset.confirmBypass === '1') return;
        event.preventDefault();
        pendingForm = form;
        title.textContent = form.dataset.confirmTitle || 'Confirmation';
        message.textContent = form.dataset.confirmMessage || 'Voulez-vous continuer ?';
        backdrop.classList.add('is-open');
        backdrop.setAttribute('aria-hidden', 'false');
      });

      cancelBtn.addEventListener('click', closeModal);
      backdrop.addEventListener('click', function (event) {
        if (event.target === backdrop) closeModal();
      });
      okBtn.addEventListener('click', function () {
        if (!pendingForm) return closeModal();
        pendingForm.dataset.confirmBypass = '1';
        pendingForm.submit();
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeModal();
      });
    })();
  </script>
  <script>
    (function () {
      var focusStorageKey = 'live_search_focus_state';

      function submitForm(form) {
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
          return;
        }
        form.submit();
      }

      function clearFocusState() {
        sessionStorage.removeItem(focusStorageKey);
      }

      function rememberFocusState(form, input) {
        if (!input || !input.name) {
          clearFocusState();
          return;
        }

        var state = {
          path: window.location.pathname,
          action: form.getAttribute('action') || '',
          fieldName: input.name,
          selectionStart: typeof input.selectionStart === 'number' ? input.selectionStart : null,
          selectionEnd: typeof input.selectionEnd === 'number' ? input.selectionEnd : null
        };

        sessionStorage.setItem(focusStorageKey, JSON.stringify(state));
      }

      function restoreFocusState() {
        var raw = sessionStorage.getItem(focusStorageKey);
        if (!raw) {
          return;
        }

        clearFocusState();

        var state = null;
        try {
          state = JSON.parse(raw);
        } catch (e) {
          return;
        }

        if (!state || state.path !== window.location.pathname || !state.fieldName) {
          return;
        }

        var forms = Array.prototype.slice.call(document.querySelectorAll('form[data-live-search-form="1"]'));
        for (var i = 0; i < forms.length; i++) {
          var form = forms[i];
          var action = form.getAttribute('action') || '';
          if (action !== state.action) {
            continue;
          }

          var candidates = form.querySelectorAll('[data-live-search-input="1"]');
          for (var j = 0; j < candidates.length; j++) {
            var candidate = candidates[j];
            if (candidate.name !== state.fieldName) {
              continue;
            }

            try {
              candidate.focus({ preventScroll: true });
            } catch (e) {
              candidate.focus();
            }

            if (
              typeof candidate.setSelectionRange === 'function'
              && typeof state.selectionStart === 'number'
              && typeof state.selectionEnd === 'number'
            ) {
              var max = candidate.value.length;
              var start = Math.max(0, Math.min(state.selectionStart, max));
              var end = Math.max(0, Math.min(state.selectionEnd, max));
              candidate.setSelectionRange(start, end);
            }

            return;
          }
        }
      }

      restoreFocusState();

      document.querySelectorAll('form[data-live-search-form="1"]').forEach(function (form) {
        var delay = parseInt(form.getAttribute('data-live-delay') || '300', 10);
        var timer = null;

        function scheduleSubmit(input) {
          if (timer) {
            clearTimeout(timer);
          }
          timer = setTimeout(function () {
            rememberFocusState(form, input);
            submitForm(form);
          }, delay);
        }

        form.querySelectorAll('[data-live-search-input="1"]').forEach(function (input) {
          input.addEventListener('input', function () {
            scheduleSubmit(input);
          });
          input.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
              event.preventDefault();
              if (timer) {
                clearTimeout(timer);
              }
              rememberFocusState(form, input);
              submitForm(form);
            }
          });
        });

        form.querySelectorAll('[data-live-search-filter="1"]').forEach(function (filter) {
          filter.addEventListener('change', function () {
            if (timer) {
              clearTimeout(timer);
            }
            clearFocusState();
            submitForm(form);
          });
        });
      });
    })();
  </script>
  {% block extra_scripts %}{% endblock %}
</body>
</html>
