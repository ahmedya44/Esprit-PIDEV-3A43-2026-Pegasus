  <script>
    (function () {
      var endpoint = '{{ path('forum_ai_autocomplete') }}';
      var csrfToken = '{{ csrf_token('forum_ai_autocomplete') }}';

      function normalizePlainText(value) {
        return String(value || '')
          .replace(/<[^>]*>/g, ' ')
          .replace(/&nbsp;/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function getFieldText(field) {
        if (field._ckeditorInstance) {
          return normalizePlainText(field._ckeditorInstance.getData());
        }
        return normalizePlainText(field.value);
      }

      function setFieldText(field, value) {
        if (field._ckeditorInstance) {
          field._ckeditorInstance.setData(value);
          field._ckeditorInstance.editing.view.focus();
          return;
        }
        field.value = value;
        field.focus();
        field.setSelectionRange(field.value.length, field.value.length);
        field.dispatchEvent(new Event('input', { bubbles: true }));
      }

      function bindAutocomplete(field) {
        var fieldType = field.getAttribute('data-ai-field');
        if (!fieldType || field.dataset.aiBound === '1') {
          return;
        }
        field.dataset.aiBound = '1';

        var box = document.createElement('div');
        box.className = 'ai-suggest-box';
        box.innerHTML = '<div class="ai-suggest-title">Suggestions IA</div><div class="ai-suggest-items"></div>';
        var list = box.querySelector('.ai-suggest-items');
        field.parentNode.appendChild(box);

        var timer = null;
        var lastQuery = '';
        var lastRequestedText = '';
        var lastRequestedAt = 0;
        var lastSuggestions = [];
        var inflightController = null;
        var requestCache = new Map();

        function closeBox() {
          box.classList.remove('is-open');
          list.innerHTML = '';
        }

        function renderSuggestions(suggestions) {
          list.innerHTML = '';
          if (!Array.isArray(suggestions) || suggestions.length === 0) {
            closeBox();
            return;
          }

          suggestions.forEach(function (text) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'ai-suggest-item';
            btn.textContent = text;
            btn.addEventListener('mousedown', function (event) {
              event.preventDefault();
              setFieldText(field, text);
              closeBox();
            });
            list.appendChild(btn);
          });

          box.classList.add('is-open');
        }

        function renderFromLocal(text) {
          if (!Array.isArray(lastSuggestions) || lastSuggestions.length === 0) {
            closeBox();
            return;
          }

          var lowered = text.toLowerCase();
          var filtered = lastSuggestions.filter(function (item) {
            return String(item).toLowerCase().indexOf(lowered) === 0;
          });

          if (filtered.length === 0) {
            closeBox();
            return;
          }

          renderSuggestions(filtered);
        }

        function collectContext() {
          var form = field.form;
          if (!form) {
            return '';
          }

          if (fieldType === 'post_title') {
            var c = form.querySelector('[data-ai-field="post_content"]');
            return c ? getFieldText(c) : '';
          }
          if (fieldType === 'post_content') {
            var t = form.querySelector('[data-ai-field="post_title"]');
            return t ? getFieldText(t) : '';
          }

          var p = form.querySelector('[data-ai-field="post_title"]');
          return p ? getFieldText(p) : '';
        }

        function requestSuggestions() {
          var text = getFieldText(field);
          if (text.length < 1) {
            closeBox();
            return;
          }
          if (text === lastQuery) {
            renderFromLocal(text);
            return;
          }
          lastQuery = text;

          var context = collectContext();
          var cacheKey = fieldType + '|' + text + '|' + context;
          if (requestCache.has(cacheKey)) {
            var cached = requestCache.get(cacheKey);
            lastSuggestions = Array.isArray(cached) ? cached : [];
            renderSuggestions(lastSuggestions);
            return;
          }

          var now = Date.now();
          var minGapMs = 1200;
          var grewEnough = Math.abs(text.length - lastRequestedText.length) >= 3;
          var isFirstLetter = text.length === 1;
          if (!isFirstLetter && (now - lastRequestedAt) < minGapMs && !grewEnough) {
            renderFromLocal(text);
            return;
          }

          if (inflightController) {
            inflightController.abort();
          }
          inflightController = new AbortController();

          fetch(endpoint, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken,
              'X-Requested-With': 'XMLHttpRequest'
            },
            signal: inflightController.signal,
            body: JSON.stringify({
              field: fieldType,
              text: text,
              context: context
            })
          })
            .then(function (response) { return response.ok ? response.json() : null; })
            .then(function (data) {
              inflightController = null;
              if (!data || !Array.isArray(data.suggestions)) {
                closeBox();
                return;
              }
              lastRequestedAt = Date.now();
              lastRequestedText = text;
              lastSuggestions = data.suggestions;
              requestCache.set(cacheKey, data.suggestions);
              renderSuggestions(data.suggestions);
            })
            .catch(function (error) {
              inflightController = null;
              if (error && error.name === 'AbortError') {
                return;
              }
              closeBox();
            });
        }

        function schedule() {
          if (timer) {
            clearTimeout(timer);
          }
          timer = setTimeout(requestSuggestions, 350);
        }

        field.addEventListener('input', schedule);
        field.addEventListener('blur', function () {
          setTimeout(closeBox, 180);
        });
        box.addEventListener('mousedown', function (event) {
          event.preventDefault();
        });

        if (field._ckeditorInstance) {
          field._ckeditorInstance.model.document.on('change:data', schedule);
        } else {
          field.addEventListener('ckeditor:ready', function (event) {
            var editor = event.detail && event.detail.editor ? event.detail.editor : field._ckeditorInstance;
            if (editor) {
              editor.model.document.on('change:data', schedule);
            }
          });
        }
      }

      document.querySelectorAll('[data-ai-autocomplete="1"]').forEach(bindAutocomplete);
    })();
  </script>
  <script>
    (function () {
      var backdrop = document.getElementById('confirm3d');
      if (!backdrop) return;
      var title = document.getElementById('confirm3d-title');
      var message = document.getElementById('confirm3d-message');
      var cancelBtn = document.getElementById('confirm3d-cancel');
      var okBtn = document.getElementById('confirm3d-ok');
      var pendingForm = null;

      function closeModal() {
        backdrop.classList.remove('is-open');
        backdrop.setAttribute('aria-hidden', 'true');
        pendingForm = null;
      }

      document.addEventListener('click', function (event) {
        var form = event.target.closest('form[data-confirm-message]');
        if (!form) return;
        if (form.dataset.confirmBypass === '1') return;
        event.preventDefault();
        pendingForm = form;
        title.textContent = form.dataset.confirmTitle || 'Confirmation';
        message.textContent = form.dataset.confirmMessage || 'Voulez-vous continuer ?';
        backdrop.classList.add('is-open');
        backdrop.setAttribute('aria-hidden', 'false');
      });

      cancelBtn.addEventListener('click', closeModal);
      backdrop.addEventListener('click', function (event) {
        if (event.target === backdrop) closeModal();
      });
      okBtn.addEventListener('click', function () {
        if (!pendingForm) return closeModal();
        pendingForm.dataset.confirmBypass = '1';
        pendingForm.submit();
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') closeModal();
      });
    })();
  </script>
  <script>
    (function () {
      var focusStorageKey = 'live_search_focus_state';

      function submitForm(form) {
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
          return;
        }
        form.submit();
      }

      function clearFocusState() {
        sessionStorage.removeItem(focusStorageKey);
      }

      function rememberFocusState(form, input) {
        if (!input || !input.name) {
          clearFocusState();
          return;
        }

        var state = {
          path: window.location.pathname,
          action: form.getAttribute('action') || '',
          fieldName: input.name,
          selectionStart: typeof input.selectionStart === 'number' ? input.selectionStart : null,
          selectionEnd: typeof input.selectionEnd === 'number' ? input.selectionEnd : null
        };

        sessionStorage.setItem(focusStorageKey, JSON.stringify(state));
      }

      function restoreFocusState() {
        var raw = sessionStorage.getItem(focusStorageKey);
        if (!raw) {
          return;
        }

        clearFocusState();

        var state = null;
        try {
          state = JSON.parse(raw);
        } catch (e) {
          return;
        }

        if (!state || state.path !== window.location.pathname || !state.fieldName) {
          return;
        }

        var forms = Array.prototype.slice.call(document.querySelectorAll('form[data-live-search-form="1"]'));
        for (var i = 0; i < forms.length; i++) {
          var form = forms[i];
          var action = form.getAttribute('action') || '';
          if (action !== state.action) {
            continue;
          }

          var candidates = form.querySelectorAll('[data-live-search-input="1"]');
          for (var j = 0; j < candidates.length; j++) {
            var candidate = candidates[j];
            if (candidate.name !== state.fieldName) {
              continue;
            }

            try {
              candidate.focus({ preventScroll: true });
            } catch (e) {
              candidate.focus();
            }

            if (
              typeof candidate.setSelectionRange === 'function'
              && typeof state.selectionStart === 'number'
              && typeof state.selectionEnd === 'number'
            ) {
              var max = candidate.value.length;
              var start = Math.max(0, Math.min(state.selectionStart, max));
              var end = Math.max(0, Math.min(state.selectionEnd, max));
              candidate.setSelectionRange(start, end);
            }

            return;
          }
        }
      }

      restoreFocusState();

      document.querySelectorAll('form[data-live-search-form="1"]').forEach(function (form) {
        var delay = parseInt(form.getAttribute('data-live-delay') || '300', 10);
        var timer = null;

        function scheduleSubmit(input) {
          if (timer) {
            clearTimeout(timer);
          }
          timer = setTimeout(function () {
            rememberFocusState(form, input);
            submitForm(form);
          }, delay);
        }

        form.querySelectorAll('[data-live-search-input="1"]').forEach(function (input) {
          input.addEventListener('input', function () {
            scheduleSubmit(input);
          });
          input.addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
              event.preventDefault();
              if (timer) {
                clearTimeout(timer);
              }
              rememberFocusState(form, input);
              submitForm(form);
            }
          });
        });

        form.querySelectorAll('[data-live-search-filter="1"]').forEach(function (filter) {
          filter.addEventListener('change', function () {
            if (timer) {
              clearTimeout(timer);
            }
            clearFocusState();
            submitForm(form);
          });
        });
      });
    })();
  </script>
  {% block extra_scripts %}{% endblock %}
</body>
</html>
