{% extends 'back/layout.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Admin Dashboard</h1>
      <p class="text-muted mb-0">Central workspace for platform operations.</p>
    </div>
    <a class="btn btn-primary" href="{{ path('back_users') }}">Open User Management</a>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small mb-1">User Operations</div>
          <h2 class="h5 mb-2">Accounts & Roles</h2>
          <p class="text-muted mb-3">Manage all users, status updates, and admin roles.</p>
          <a class="btn btn-sm btn-outline-primary" href="{{ path('back_users') }}">Manage Users</a>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small mb-1">Content Operations</div>
          <h2 class="h5 mb-2">Courses & Quizzes</h2>
          <p class="text-muted mb-3">Control educational content and quiz delivery.</p>
          <a class="btn btn-sm btn-outline-primary" href="{{ path('back_content') }}">Manage Content</a>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small mb-1">Events Operations</div>
          <h2 class="h5 mb-2">Events & Participants</h2>
          <p class="text-muted mb-3">Track events, participant activity, and sponsors.</p>
          <a class="btn btn-sm btn-outline-primary" href="{{ path('app_evenement_index') }}">Open Events</a>
        </div>
      </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
      <div class="card h-100">
        <div class="card-body">
          <div class="text-muted small mb-1">Community Operations</div>
          <h2 class="h5 mb-2">Forum & Gallery</h2>
          <p class="text-muted mb-3">Moderate discussions and curate creative assets.</p>
          <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_forum_posts_index') }}">Open Forum Admin</a>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-3">
    <div class="col-12 col-lg-7">
      <div class="card h-100">
        <div class="card-header">
          <h3 class="card-title mb-0">Quick Actions</h3>
        </div>
        <div class="card-body">
          <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('app_admin_new') }}">Create Admin</a>
            <a class="btn btn-outline-secondary" href="{{ path('app_evenement_new') }}">Create Event</a>
            <a class="btn btn-outline-secondary" href="{{ path('admin_forum_post_new') }}">Create Forum Post</a>
            <a class="btn btn-outline-secondary" href="{{ path('back_art_index') }}">Manage Gallery</a>
            <a class="btn btn-outline-secondary" href="{{ path('app_admin_sponsor_index') }}">Review Sponsors</a>
          </div>
        </div>
      </div>
    </div>
    <div class="col-12 col-lg-5">
      <div class="card h-100">
        <div class="card-header">
          <h3 class="card-title mb-0">Navigation Map</h3>
        </div>
        <div class="card-body">
          <ul class="list-unstyled mb-0">
            <li class="mb-2"><a href="{{ path('back_dashboard') }}">Dashboard</a></li>
            <li class="mb-2"><a href="{{ path('back_users') }}">Users</a></li>
            <li class="mb-2"><a href="{{ path('app_evenement_index') }}">Events</a></li>
            <li class="mb-2"><a href="{{ path('back_content') }}">Courses & Quizzes</a></li>
            <li class="mb-2"><a href="{{ path('admin_forum_stats_index') }}">Forum Stats</a></li>
            <li class="mb-2"><a href="{{ path('app_participant_stats') }}">Participant Stats</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
