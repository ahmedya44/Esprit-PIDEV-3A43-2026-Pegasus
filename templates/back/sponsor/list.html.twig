{% extends 'back/base.html.twig' %}

{% block title %}Sponsors - {{ evenement.titre }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h3 class="fw-bold mb-3">Sponsors : {{ evenement.titre }}</h3>
        <ul class="breadcrumbs">
            <li class="nav-home">
                <a href="{{ path('back_dashboard') }}">
                    <i class="icon-home"></i>
                </a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_admin_sponsor_index') }}">Sponsors</a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a href="#">Détails</a>
            </li>
        </ul>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center">
                        <h4 class="card-title">Liste des Sponsoring pour "{{ evenement.titre }}"</h4>
                        <a href="{{ path('app_admin_sponsor_index') }}" class="btn btn-secondary btn-round ms-auto">
                            <i class="fa fa-arrow-left"></i> Retour
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mt-3">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Sponsor (User)</th>
                                    <th>Pack</th>
                                    <th>Prix Pack</th>
                                    <th>Date Réservation</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reservation in reservations %}
                                <tr>
                                    <td>{{ reservation.id }}</td>
                                    <td>
                                        <strong>{{ reservation.user.email }}</strong><br>
                                        <small class="text-muted">Type: {{ reservation.user.type }}</small>
                                    </td>
                                    <td>
                                        <span class="badge badge-primary">{{ reservation.sponsoringPack.nomPack }}</span>
                                    </td>
                                    <td>{{ reservation.sponsoringPack.prix }} DT</td>
                                    <td>{{ reservation.dateReservation|date('d/m/Y H:i') }}</td>
                                    <td>
                                        {% if reservation.statut == 'acceptée' %}
                                            <span class="badge badge-success">Acceptée</span>
                                        {% elseif reservation.statut == 'refusée' %}
                                            <span class="badge badge-danger">Refusée</span>
                                        {% else %}
                                            <span class="badge badge-warning">En attente</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="6" class="text-center">Aucun sponsor pour cet événement.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
