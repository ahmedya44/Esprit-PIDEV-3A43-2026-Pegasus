<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
  <title>Backoffice Login</title>
  <link rel="icon" href="{{ asset('back/img/kaiadmin/favicon.ico') }}" type="image/x-icon" />
  <link rel="stylesheet" href="{{ asset('back/css/bootstrap.min.css') }}" />
  <link rel="stylesheet" href="{{ asset('back/css/kaiadmin.min.css') }}" />
  <style>
    body {
      min-height: 100vh;
      background: linear-gradient(120deg, #0f172a, #1f2937);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .login-card {
      width: 100%;
      max-width: 420px;
      background: #ffffff;
      border-radius: 12px;
      padding: 28px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
    }

    .login-title {
      margin-bottom: 4px;
      font-weight: 700;
      color: #111827;
    }

    .login-subtitle {
      margin-bottom: 20px;
      color: #6b7280;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="login-card">
    <h3 class="login-title">Backoffice Login</h3>
    <p class="login-subtitle">Only administrator accounts are allowed.</p>

    {% for message in app.flashes('success') %}
      <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
      <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {% if error %}
      <div class="alert alert-danger">
        {{ error.messageKey|trans(error.messageData, 'security') }}
      </div>
    {% endif %}

    <form method="post" action="{{ path('app_back_login') }}">
      <div class="form-group mb-3">
        <label for="back_login_email">Email</label>
        <input type="email" id="back_login_email" name="email" class="form-control" value="{{ last_username }}" required autofocus>
      </div>
      <div class="form-group mb-3">
        <label for="back_login_password">Password</label>
        <input type="password" id="back_login_password" name="password" class="form-control" required>
      </div>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
      <button type="submit" class="btn btn-primary w-100">Sign In to Backoffice</button>
    </form>
  </div>
</body>
</html>
