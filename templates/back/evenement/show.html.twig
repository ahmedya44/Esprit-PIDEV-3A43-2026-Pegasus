{% extends 'back/base.html.twig' %}

{% block title %}Evenement{% endblock %}

{% block body %}
    <div class="page-header">
        <h3 class="fw-bold mb-3">Evenements</h3>
        <ul class="breadcrumbs">
            <li class="nav-home">
                <a href="{{ path('back_dashboard') }}">
                    <i class="icon-home"></i>
                </a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_evenement_index') }}">Evenements</a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a href="#">Détails</a>
            </li>
        </ul>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Détails de l'Evenement</div>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width: 200px;">Id</th>
                                <td>{{ evenement.id }}</td>
                            </tr>
                            <tr>
                                <th>Titre</th>
                                <td>{{ evenement.titre }}</td>
                            </tr>
                            <tr>
                                <th>Date</th>
                                <td>{{ evenement.date ? evenement.date|date('Y-m-d') : '' }}</td>
                            </tr>
                            <tr>
                                <th>Heure</th>
                                <td>{{ evenement.heure ? evenement.heure|date('H:i') : '' }}</td>
                            </tr>
                            <tr>
                                <th>Lieu</th>
                                <td>{{ evenement.lieu }}</td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>{{ evenement.description }}</td>
                            </tr>
                            <tr>
                                <th>Image</th>
                                <td>
                                    {% if evenement.image %}
                                        <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="" style="max-width: 300px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                                    {% else %}
                                        <span class="text-muted">Aucune image</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>Capacite_max</th>
                                <td>{{ evenement.capaciteMax }}</td>
                            </tr>
                            <tr>
                                <th>Prix</th>
                                <td>{{ evenement.prix }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-action">
                    <a href="{{ path('app_evenement_index') }}" class="btn btn-secondary">Retour à la liste</a>
                    <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-primary">Modifier</a>
                    {{ include('back/evenement/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
