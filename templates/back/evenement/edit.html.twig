{% extends 'back/layout.html.twig' %}

{% block title %}Edit Event{% endblock %}

{% block body %}
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h1 class="h3 mb-1">Edit Event</h1>
      <p class="text-muted mb-0">Update event details and media.</p>
    </div>
    <a href="{{ path('app_evenement_index') }}" class="btn btn-outline-secondary">Back to list</a>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      {{ include('back/evenement/_form.html.twig', {'button_label': 'Update'}) }}
    </div>
  </div>

  <div class="card border-danger">
    <div class="card-body">
      <h2 class="h6 text-danger mb-2">Danger zone</h2>
      {{ include('back/evenement/_delete_form.html.twig') }}
    </div>
  </div>
{% endblock %}
