{% extends 'back/base.html.twig' %}

{% block title %}Evenement index{% endblock %}

{% block body %}
    <div class="page-header">
        <h3 class="fw-bold mb-3">Evenements</h3>
        <ul class="breadcrumbs">
            <li class="nav-home">
                <a href="{{ path('back_dashboard') }}">
                    <i class="icon-home"></i>
                </a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a href="#">Gestion</a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_evenement_index') }}">Evenements</a>
            </li>
        </ul>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex align-items-center flex-wrap gap-3">
                        <h4 class="card-title mb-0">Liste des Evenements</h4>
                        <div class="flex-grow-1" style="max-width: 350px;">
                            <input type="text" id="searchEventAdmin" class="form-control form-control-sm" placeholder="Rechercher (titre, lieu, prix)..." style="border-radius: 20px;">
                        </div>
                        <div style="min-width: 150px;">
                            <select id="sortEventAdmin" class="form-select form-select-sm" style="border-radius: 20px;">
                                <option value="">Trier par...</option>
                                <option value="title_asc">Titre (A-Z)</option>
                                <option value="title_desc">Titre (Z-A)</option>
                                <option value="date_desc">Date (Récent)</option>
                                <option value="date_asc">Date (Ancien)</option>
                                <option value="price_asc">Prix (Croissant)</option>
                                <option value="price_desc">Prix (Décroissant)</option>
                            </select>
                        </div>
                        <a href="{{ path('app_evenement_export_pdf') }}" class="btn btn-danger btn-round ms-2">
                            <i class="fa fa-file-pdf"></i>
                            Export PDF
                        </a>
                        <a href="{{ path('app_evenement_new') }}" class="btn btn-primary btn-round ms-2">
                            <i class="fa fa-plus"></i>
                            Ajouter un Evenement
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Image</th>
                                    <th>Titre</th>
                                    <th>Date</th>
                                    <th>Heure</th>
                                    <th>Lieu</th>
                                    <th>Prix</th>
                                    <th>Statut</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for evenement in evenements %}
                                <tr>
                                    <td>{{ evenement.id }}</td>
                                    <td>
                                        {% if evenement.image %}
                                            <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px;">
                                        {% else %}
                                            <span class="text-muted">No image</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ evenement.titre }}</td>
                                    <td>{{ evenement.date ? evenement.date|date('Y-m-d') : '' }}</td>
                                    <td>{{ evenement.heure ? evenement.heure|date('H:i') : '' }}</td>
                                    <td>{{ evenement.lieu }}</td>
                                    <td>{{ evenement.prix }}</td>
                                    <td>
                                        {% if evenement.statut == 'en attente' %}
                                            <span class="badge badge-warning">En attente</span>
                                        {% else %}
                                            <span class="badge badge-success">Acceptée</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="form-button-action d-flex align-items-center flex-wrap" style="gap: 5px;">
                                            {% if evenement.statut == 'en attente' %}
                                                <form action="{{ path('app_evenement_accept', {'id': evenement.id}) }}" method="post" style="margin: 0;" onsubmit="return confirm('Accepter cet événement ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ evenement.id) }}">
                                                    <button type="submit" class="btn btn-success btn-sm" title="Accepter"><i class="fa fa-check"></i></button>
                                                </form>
                                                <form action="{{ path('app_evenement_reject', {'id': evenement.id}) }}" method="post" style="margin: 0;" onsubmit="return confirm('Refuser et supprimer cet événement ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ evenement.id) }}">
                                                    <button type="submit" class="btn btn-danger btn-sm" title="Rejeter"><i class="fa fa-times"></i></button>
                                                </form>
                                            {% endif %}
                                            
                                            <a href="{{ path('app_participant_list', {'id': evenement.id}) }}" class="btn btn-link btn-warning btn-lg" data-bs-toggle="tooltip" title="Participants">
                                                <i class="fa fa-users"></i>
                                            </a>
                                            <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-link btn-primary btn-lg" data-bs-toggle="tooltip" title="Voir">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                            <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-link btn-info btn-lg" data-bs-toggle="tooltip" title="Modifier">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            {{ include('back/evenement/_delete_form.html.twig') }}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="10">Aucun enregistrement trouvé</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchEventAdmin');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll('.table tbody tr');
                
                rows.forEach(row => {
                    // Ignorer les lignes de message "Aucun enregistrement" (qui n'ont généralement qu'une cellule)
                    if (row.cells.length > 2) {
                        let textContext = row.innerText.toLowerCase();
                        if(textContext.includes(filter)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    }
                });
            });
        }

        const sortSelect = document.getElementById('sortEventAdmin');
        if (sortSelect) {
            sortSelect.addEventListener('change', function() {
                let tbody = document.querySelector('.table tbody');
                let rows = Array.from(tbody.querySelectorAll('tr')).filter(row => row.cells.length > 2);
                let sortValue = this.value;

                if (!sortValue) return;

                rows.sort(function(a, b) {
                    let valA, valB;
                    
                    if (sortValue.startsWith('title')) {
                        valA = a.cells[2].innerText.trim().toLowerCase();
                        valB = b.cells[2].innerText.trim().toLowerCase();
                        return sortValue.endsWith('asc') ? valA.localeCompare(valB) : valB.localeCompare(valA);
                    } else if (sortValue.startsWith('date')) {
                        // Supposons que la date est au format d/m/Y ou Y-m-d
                        valA = new Date(a.cells[3].innerText.trim());
                        valB = new Date(b.cells[3].innerText.trim());
                        return sortValue.endsWith('asc') ? valA - valB : valB - valA;
                    } else if (sortValue.startsWith('price')) {
                        valA = parseFloat(a.cells[6].innerText.replace(/[^\d.]/g, '')) || 0;
                        valB = parseFloat(b.cells[6].innerText.replace(/[^\d.]/g, '')) || 0;
                        return sortValue.endsWith('asc') ? valA - valB : valB - valA;
                    }
                    return 0;
                });

                rows.forEach(row => tbody.appendChild(row));
            });
        }
    });
</script>
{% endblock %}
