{% extends 'back/base.html.twig' %}

{% block title %}Evenement index{% endblock %}

{% block body %}
    <style>
        .custom-card {
            background-color: white;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            margin-bottom: 24px;
        }
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }
        .header-title {
            font-size: 24px;
            font-weight: bold;
            color: #0f172a;
            margin: 0;
        }
        .header-subtitle {
            font-size: 13px;
            color: #64748b;
            margin-top: 4px;
        }
        .header-actions {
            display: flex;
            gap: 16px;
            align-items: center;
        }
        .btn-export {
            background-color: #0f172a;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 600;
            font-size: 13px;
            text-decoration: none;
            transition: background-color 0.2s;
        }
        .btn-export:hover {
            background-color: #1e293b;
            color: white;
        }
        .search-input {
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            padding: 8px 16px;
            font-size: 13px;
            width: 250px;
            outline: none;
        }
        .search-input:focus {
            border-color: #94a3b8;
        }
        .custom-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        .custom-table th {
            background-color: #f8fafc;
            color: #334155;
            font-weight: 600;
            font-size: 12px;
            padding: 12px 16px;
            text-align: center;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }
        .custom-table th:first-child { border-top-left-radius: 8px; }
        .custom-table th:last-child { border-top-right-radius: 8px; }
        .custom-table td {
            padding: 16px;
            font-size: 12px;
            color: #334155;
            border-bottom: 1px solid #e2e8f0;
            text-align: center;
            vertical-align: middle;
        }
        .custom-table tr:hover td { background-color: #f8fafc; }
        .desc-col {
            text-align: left !important;
            max-width: 350px;
            white-space: normal;
            line-height: 1.5;
            font-size: 11px;
            color: #475569;
        }
        .status-pill {
            padding: 4px 12px;
            border-radius: 20px;
            color: white;
            font-weight: 700;
            font-size: 10px;
            display: inline-block;
        }
        .btn-action {
            color: white;
            font-weight: bold;
            border-radius: 4px;
            border: none;
            padding: 4px 12px;
            font-size: 11px;
            cursor: pointer;
            transition: opacity 0.2s;
        }
        .btn-action:hover { opacity: 0.9; }
    </style>

    <div class="custom-card">
        <div class="header-container">
            <div>
                <h1 class="header-title">Events</h1>
                <div class="header-subtitle">Manage and oversee all Pegasus events.</div>
            </div>
            <div class="header-actions">
                <a href="{{ path('app_evenement_export_pdf') }}" class="btn-export">Exporter PDF</a>
                <input type="text" id="searchEventAdmin" class="search-input" placeholder="Rechercher par titre...">
            </div>
        </div>

        <div style="overflow-x: auto;">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Titre</th>
                        <th>Date</th>
                        <th>Heure</th>
                        <th>Lieu</th>
                        <th style="text-align: left;">Description</th>
                        <th>Image</th>
                        <th>Cap...</th>
                        <th>Prix</th>
                        <th>Statut</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for evenement in evenements %}
                    <tr>
                        <td>{{ evenement.titre }}</td>
                        <td>{{ evenement.date ? evenement.date|date('Y-m-d') : '' }}</td>
                        <td>{{ evenement.heure ? evenement.heure|date('H:i:s') : '' }}</td>
                        <td>{{ evenement.lieu }}</td>
                        <td class="desc-col">{{ evenement.description }}</td>
                        <td>
                            {% if evenement.image %}
                                <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="" style="max-width: 60px; max-height: 40px; object-fit: contain; border-radius: 4px;">
                            {% endif %}
                        </td>
                        <td>{{ evenement.capaciteMax }}</td>
                        <td>{{ evenement.prix|number_format(1, '.', '') }}</td>
                        <td>
                            {% set badge_color = '#3498db' %}
                            {% set statut_text = evenement.statut|upper %}
                            {% if evenement.statut|lower in ['acceptée', 'available', 'active', 'confirmé'] %}
                                {% set badge_color = '#27ae60' %}
                                {% if evenement.statut|lower == 'confirmé' %}
                                    {% set badge_color = '#3498db' %}
                                {% endif %}
                            {% elseif evenement.statut|lower in ['refusée', 'annulé', 'cancelled', 'full'] %}
                                {% set badge_color = '#e74c3c' %}
                            {% elseif evenement.statut|lower == 'en attente' %}
                                {% set badge_color = '#f39c12' %}
                                {% set statut_text = 'EN ATTEN...' %}
                            {% endif %}
                            <span class="status-pill" style="background-color: {{ badge_color }};">{{ statut_text }}</span>
                        </td>
                        <td>
                            <div style="display: flex; gap: 4px; justify-content: center;">
                                <form action="{{ path('app_evenement_accept', {'id': evenement.id}) }}" method="post" style="margin: 0;" onsubmit="return confirm('Accepter cet événement ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ evenement.id) }}">
                                    <button type="submit" class="btn-action" style="background-color: #27ae60;">Accepter</button>
                                </form>
                                <form action="{{ path('app_evenement_reject', {'id': evenement.id}) }}" method="post" style="margin: 0;" onsubmit="return confirm('Refuser cet événement ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ evenement.id) }}">
                                    <button type="submit" class="btn-action" style="background-color: #e67e22;">Refuser</button>
                                </form>
                                <form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Supprimer l\'événement : {{ evenement.titre|escape('js') }} ?\nCette action est irréversible.');" style="margin: 0;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                                    <button class="btn-action" style="background-color: #e74c3c;">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchEventAdmin');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll('.custom-table tbody tr');
                
                rows.forEach(row => {
                    let textContext = row.cells[0].innerText.toLowerCase();
                    if(textContext.includes(filter)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        }
    });
</script>
{% endblock %}
