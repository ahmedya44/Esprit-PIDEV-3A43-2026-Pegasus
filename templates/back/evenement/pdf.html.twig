<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des Événements</title>
    <style>
        body { font-family: Arial, sans-serif; }
        h1 { text-align: center; color: #a855f7; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; font-size: 12px; }
        th { background-color: #f3f4f6; color: #374151; }
        .statut { text-transform: capitalize; font-weight: bold; }
        .date { white-space: nowrap; }
    </style>
</head>
<body>
    <h1>Liste des Événements Pegasus</h1>
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Date</th>
                <th>Heure</th>
                <th>Lieu</th>
                <th>Prix</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for evenement in evenements %}
            <tr>
                <td>{{ evenement.id }}</td>
                <td>{{ evenement.titre }}</td>
                <td>{{ evenement.date ? evenement.date|date('d/m/Y') : '' }}</td>
                <td>{{ evenement.heure ? evenement.heure|date('H:i') : '' }}</td>
                <td>{{ evenement.lieu }}</td>
                <td>{{ evenement.prix }} DT</td>
                <td><span class="statut">{{ evenement.statut }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <div style="margin-top: 30px; font-size: 10px; color: #666; text-align: center;">
        Généré le {{ "now"|date('d/m/Y H:i') }}
    </div>
</body>
</html>
