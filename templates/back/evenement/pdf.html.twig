<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Liste des Événements</title>
    <style>
        body { font-family: Arial, sans-serif; }
        h1 { text-align: center; color: #a855f7; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; font-size: 12px; }
        th { background-color: #f3f4f6; color: #374151; }
        .statut { text-transform: capitalize; font-weight: bold; }
        .date { white-space: nowrap; }
    </style>
</head>
<body>
    <h1>PEGASUS - RAPPORT D'ÉVÉNEMENTS</h1>
    <table>
        <thead>
            <tr>
                <th>Titre</th>
                <th>Date</th>
                <th>Heure</th>
                <th>Lieu</th>
                <th>Capacité</th>
                <th>Prix</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for evenement in evenements %}
            <tr>
                <td>{{ evenement.titre }}</td>
                <td>{{ evenement.date ? evenement.date|date('d/m/Y') : '' }}</td>
                <td>{{ evenement.heure ? evenement.heure|date('H:i') : '' }}</td>
                <td>{{ evenement.lieu }}</td>
                <td style="text-align: center;">{{ evenement.capaciteMax }}</td>
                <td style="text-align: right;">{{ evenement.prix }} DT</td>
                <td style="text-align: center;">
                    <span class="statut" style="color: {% if evenement.statut|lower == 'refusée' %}#e74c3c{% elseif evenement.statut|lower in ['acceptée', 'active', 'available'] %}#27ae60{% elseif evenement.statut|lower == 'confirmé' %}#3498db{% else %}#f39c12{% endif %}">
                        {{ evenement.statut|upper }}
                    </span>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <div style="margin-top: 30px; font-size: 10px; color: #666; text-align: center;">
        Généré le {{ "now"|date('d/m/Y H:i') }}
    </div>
</body>
</html>
