{% extends 'back/layout.html.twig' %}

{% block title %}Backoffice - Gallery{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Gallery Management</h1>
</div>

{% for type, messages in app.flashes %}
  {% for message in messages %}
    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  {% endfor %}
{% endfor %}

<div class="row mb-4">
  <div class="col-md-3 mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Total</div>
        <div class="h4 mb-0">{{ total_arts }}</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Published</div>
        <div class="h4 mb-0">{{ published_arts }}</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Pending</div>
        <div class="h4 mb-0">{{ pending_arts }}</div>
      </div>
    </div>
  </div>
  <div class="col-md-3 mb-3">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="text-muted small">Archived</div>
        <div class="h4 mb-0">{{ archived_arts }}</div>
      </div>
    </div>
  </div>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Status</th>
            <th>Views</th>
            <th>Created</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for art in arts %}
            <tr>
              <td>
                {% if art.imageUrl %}
                  {% set imageSrc = art.imageUrl starts with('http') ? art.imageUrl : asset('images/products/' ~ art.imageUrl) %}
                  <img src="{{ imageSrc }}" alt="{{ art.title }}" style="width:50px;height:50px;object-fit:cover;border-radius:8px;">
                {% else %}
                  <span class="text-muted">No image</span>
                {% endif %}
              </td>
              <td>{{ art.title }}</td>
              <td>
                <span class="badge bg-secondary">{{ art.status }}</span>
              </td>
              <td>{{ views_by_art[art.id]|default(0) }}</td>
              <td>{{ art.createdAt ? art.createdAt|date('Y-m-d H:i') : '-' }}</td>
              <td class="text-end">
                <a href="{{ path('back_art_edit', {id: art.id}) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                <form method="post" action="{{ path('back_art_update_status', {id: art.id}) }}" class="d-inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('update_status' ~ art.id) }}">
                  <select name="status" class="form-select form-select-sm d-inline-block" style="width: 140px;">
                    <option value="published" {% if art.status == 'published' %}selected{% endif %}>Published</option>
                    <option value="active" {% if art.status == 'active' %}selected{% endif %}>Active</option>
                    <option value="en attente" {% if art.status == 'en attente' %}selected{% endif %}>Pending</option>
                    <option value="archived" {% if art.status == 'archived' %}selected{% endif %}>Archived</option>
                  </select>
                  <button type="submit" class="btn btn-sm btn-outline-success">Save</button>
                </form>
                <form method="post" action="{{ path('back_art_delete', {id: art.id}) }}" class="d-inline" onsubmit="return confirm('Delete this artwork?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ art.id) }}">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="text-center text-muted">No artworks found.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
