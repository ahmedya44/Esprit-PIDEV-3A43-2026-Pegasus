{% extends 'back/layout.html.twig' %}

{% block title %}Backoffice - Edit Artwork{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Edit Artwork</h1>
  <a href="{{ path('back_art_index') }}" class="btn btn-outline-secondary">Back to list</a>
</div>

<div class="card shadow-sm">
  <div class="card-body">
    {{ form_start(form) }}
      {{ form_row(form.title) }}
      {{ form_row(form.description) }}
      {{ form_row(form.titleEn) }}
      {{ form_row(form.descriptionEn) }}
      {{ form_row(form.imageFile) }}
      {{ form_row(form.aiGeneratedImage) }}
      {{ form_row(form.isAiGenerated) }}
      <button type="submit" class="btn btn-primary">Save</button>
    {{ form_end(form) }}
  </div>
</div>
{% endblock %}

