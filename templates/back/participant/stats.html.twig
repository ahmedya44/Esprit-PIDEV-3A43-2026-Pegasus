{% extends 'back/base.html.twig' %}

{% block title %}Statistiques des Participations{% endblock %}

{% block body %}
    <div class="page-header">
        <h3 class="fw-bold mb-3">Statistiques</h3>
        <ul class="breadcrumbs">
            <li class="nav-home">
                <a href="{{ path('back_dashboard') }}">
                    <i class="icon-home"></i>
                </a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_participant_index') }}">Participants</a>
            </li>
            <li class="separator">
                <i class="icon-arrow-right"></i>
            </li>
            <li class="nav-item">
                <a href="#">Statistiques</a>
            </li>
        </ul>
    </div>

    <div class="row">
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-primary bubble-shadow-small">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Total Événements</p>
                                <h4 class="card-title">{{ totalEvenements }}</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-success bubble-shadow-small">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Participations</p>
                                <h4 class="card-title">{{ totalParticipations }}</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-warning bubble-shadow-small">
                                <i class="fas fa-money-bill-wave"></i>
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Revenu Total Est.</p>
                                <h4 class="card-title">{{ totalRevenue|number_format(2) }} DT</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="card card-stats card-round">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-icon">
                            <div class="icon-big text-center icon-info bubble-shadow-small">
                                <i class="fas fa-hourglass-start"></i>
                            </div>
                        </div>
                        <div class="col col-stats ms-3 ms-sm-0">
                            <div class="numbers">
                                <p class="card-category">Évènements à venir</p>
                                <h4 class="card-title">{{ upcomingEventsCount }}</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Participations par Événement</div>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="barChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Répartition des Statuts</div>
                </div>
                <div class="card-body">
                    <div class="chart-container">
                        <canvas id="pieChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if topEvent %}
    <div class="row">
        <div class="col-md-12">
            <div class="card bg-primary-gradient text-white">
                <div class="card-body text-center p-5">
                    <i class="fas fa-trophy fa-4x mb-3 text-warning"></i>
                    <h2>Événement le plus populaire</h2>
                    <h1 class="display-4 fw-bold">{{ topEvent.titre }}</h1>
                    <p class="lead">{{ topEvent.participations|length }} participants inscrits !</p>
                    <a href="{{ path('app_participant_list', {id: topEvent.id}) }}" class="btn btn-light btn-round">Voir la liste</a>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('back/js/plugin/chart.js/chart.min.js') }}"></script>
    <script>
        // Bar Chart
        var barChart = document.getElementById("barChart").getContext("2d");
        new Chart(barChart, {
            type: "bar",
            data: {
                labels: {{ labels|json_encode|raw }},
                datasets: [{
                    label: "Nombre de Participants",
                    backgroundColor: "rgb(23, 125, 255)",
                    borderColor: "rgb(23, 125, 255)",
                    data: {{ data|json_encode|raw }},
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    yAxes: [{
                        ticks: { beginAtZero: true }
                    }]
                }
            },
        });

        // Pie Chart
        var pieChart = document.getElementById("pieChart").getContext("2d");
        new Chart(pieChart, {
            type: "doughnut",
            data: {
                labels: ["Acceptés", "En attente", "Refusés"],
                datasets: [{
                    backgroundColor: ["#28a745", "#ffc107", "#dc3545"],
                    data: [
                        {{ statusCounts['acceptée'] }},
                        {{ statusCounts['en attente'] }},
                        {{ statusCounts['refusée'] }}
                    ],
                }],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                legend: {
                    position: 'bottom',
                }
            },
        });
    </script>
{% endblock %}
