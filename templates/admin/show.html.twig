{% extends 'back/layout.html.twig' %}

{% block title %}Admin Details{% endblock %}

{% block body %}
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
      <h1 class="h3 mb-1">Admin Details</h1>
      <p class="text-muted mb-0">Full profile and permission information.</p>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-outline-secondary" href="{{ path('app_admin_index') }}">Back to list</a>
      <a class="btn btn-primary" href="{{ path('app_admin_edit', {'id': admin.id}) }}">Edit</a>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6"><strong>ID:</strong> #{{ admin.id }}</div>
        <div class="col-md-6"><strong>Email:</strong> {{ admin.email }}</div>
        <div class="col-md-6"><strong>Username:</strong> {{ admin.username ?: 'N/A' }}</div>
        <div class="col-md-6"><strong>Phone:</strong> {{ admin.phone ?: 'N/A' }}</div>
        <div class="col-md-6"><strong>Status:</strong> {{ admin.status ?: 'N/A' }}</div>
        <div class="col-md-6"><strong>Super Admin:</strong> {{ admin.superAdmin ? 'Yes' : 'No' }}</div>
        <div class="col-md-6"><strong>Created:</strong> {{ admin.createdAt ? admin.createdAt|date('Y-m-d H:i:s') : 'N/A' }}</div>
        <div class="col-12"><strong>Roles:</strong> <code>{{ admin.roles ? admin.roles|json_encode : '[]' }}</code></div>
        <div class="col-12"><strong>Avatar URL:</strong> {{ admin.avatarUrl ?: 'N/A' }}</div>
      </div>
    </div>
  </div>

  <div class="card border-danger">
    <div class="card-body">
      <h2 class="h6 text-danger mb-2">Danger zone</h2>
      {{ include('admin/_delete_form.html.twig') }}
    </div>
  </div>
{% endblock %}
