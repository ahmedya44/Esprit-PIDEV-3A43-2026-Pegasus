<form method="post" action="{{ path('app_admin_delete', {'id': admin.id}) }}" data-confirm-title="Delete admin" data-confirm-message="Are you sure you want to delete this admin account? This action cannot be undone.">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ admin.id) }}">
  <button class="btn btn-danger">Delete Admin</button>
</form>
