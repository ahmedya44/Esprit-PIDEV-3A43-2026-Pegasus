{% extends 'admin/base.html.twig' %}

{% block title %}Nouveau Pack{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0"><i class="fa fa-plus mr-2"></i> Nouveau Pack de Sponsoring</h2>
        <a href="{{ path('admin_sponsoring_pack_index') }}" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left mr-1"></i> Retour
        </a>
    </div>
    <div class="card shadow-sm" style="max-width: 700px;">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.nomPack) }}
                    {{ form_widget(form.nomPack) }}
                    <div class="text-danger">{{ form_errors(form.nomPack) }}</div>
                </div>
                <div class="form-group">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    <div class="text-danger">{{ form_errors(form.description) }}</div>
                </div>
                <div class="form-group">
                    {{ form_label(form.prix) }}
                    {{ form_widget(form.prix) }}
                    <div class="text-danger">{{ form_errors(form.prix) }}</div>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save mr-1"></i> Enregistrer
                </button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
