{% extends 'back/layout.html.twig' %}

{% block title %}Admin - Sujet: {{ translatedPost.title }}{% endblock %}
{% block extra_styles %}
<style>
  .admin-icon-actions {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .admin-icon-btn {
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
{% endblock %}

{% block body %}
<div class="container mt-5">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="row mb-4">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    {% set cleanPostTitle = translatedPost.title|striptags|replace({'&nbsp;': ' '})|trim %}
                    <h1 class="h4 mb-0">{{ cleanPostTitle }}</h1>
                    {% if post.status == 'OPEN' %}
                        <span class="badge bg-success">Ouvert</span>
                    {% elseif post.status == 'CLOSED' %}
                        <span class="badge bg-warning text-dark">Ferme</span>
                    {% else %}
                        <span class="badge bg-secondary">Cache</span>
                    {% endif %}
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <span class="text-muted me-2">Afficher en :</span>
                        <a
                            href="{{ path('admin_forum_post_show', {id: post.id}) }}"
                            class="btn btn-sm {{ activeLocale is null ? 'btn-primary' : 'btn-outline-secondary' }} me-1 mb-1"
                        >
                            Original
                        </a>
                        {% for locale, label in translatableLocales %}
                            <a
                                href="{{ path('admin_forum_post_show', {id: post.id, lang: locale}) }}"
                                class="btn btn-sm {{ activeLocale == locale ? 'btn-primary' : 'btn-outline-secondary' }} me-1 mb-1"
                            >
                                {{ label }} ({{ locale }})
                            </a>
                        {% endfor %}
                    </div>
                    <p class="text-muted small mb-3">
                        <strong>Auteur:</strong> {{ post.authorName }} ({{ post.authorEmail }})<br>
                        <strong>Cree:</strong> {{ post.createdAt|format_datetime('medium', 'short') }}
                        {% if post.updatedAt %}
                            <br><strong>Modifie:</strong> {{ post.updatedAt|format_datetime('medium', 'short') }}
                        {% endif %}
                    </p>
                    {% if post.imageName %}
                        <div class="mb-3">
                            <img src="{{ vich_uploader_asset(post, 'imageFile') }}" alt="Image du sujet {{ cleanPostTitle }}" class="img-fluid rounded" style="max-height: 420px;">
                        </div>
                    {% endif %}
                    {% set cleanPostContent = translatedPost.content|striptags|replace({'&nbsp;': ' '})|trim %}
                    <div class="post-content">{{ cleanPostContent|nl2br }}</div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><h5 class="mb-0">Moderation</h5></div>
                <div class="card-body d-flex gap-2 flex-wrap">
                    <form method="post" action="{{ path('admin_forum_post_status', {id: post.id, status: 'OPEN'}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('status_' ~ post.id ~ '_OPEN') }}">
                        <button type="submit" class="btn btn-success {% if post.status == 'OPEN' %}active{% endif %}">Passer en Ouvert</button>
                    </form>
                    <form method="post" action="{{ path('admin_forum_post_status', {id: post.id, status: 'CLOSED'}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('status_' ~ post.id ~ '_CLOSED') }}">
                        <button type="submit" class="btn btn-warning {% if post.status == 'CLOSED' %}active{% endif %}">Passer en Ferme</button>
                    </form>
                    <form method="post" action="{{ path('admin_forum_post_status', {id: post.id, status: 'HIDDEN'}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('status_' ~ post.id ~ '_HIDDEN') }}">
                        <button type="submit" class="btn btn-secondary {% if post.status == 'HIDDEN' %}active{% endif %}">Passer en Cache</button>
                    </form>
                </div>
            </div>

            <h3 class="h5 mb-3">Commentaires ({{ post.commentaires|length }})</h3>

            {% if post.commentaires %}
                <div class="comments-list mb-4">
                    {% for commentaire in post.commentaires %}
                        {% set translatedComment = translatedComments[commentaire.id] ?? commentaire %}
                        {% set cleanCommentContent = translatedComment.content|striptags|replace({'&nbsp;': ' '})|trim %}
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>{{ commentaire.authorName }}</strong>
                                    <small class="text-muted">({{ commentaire.authorEmail }})</small><br>
                                    <small class="text-muted">{{ commentaire.createdAt|format_datetime('medium', 'short') }}</small>
                                </div>
                                <div>
                                    <div class="admin-icon-actions">
                                        <a href="{{ path('admin_forum_comment_edit', {id: commentaire.id}) }}" class="btn btn-sm btn-outline-primary admin-icon-btn" title="Modifier">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <a href="{{ path('admin_forum_comment_edit', {id: commentaire.id, lang: activeLocale}) }}" class="btn btn-sm btn-outline-info admin-icon-btn" title="Traduire">
                                            <i class="fas fa-language"></i>
                                        </a>
                                        <form method="post" action="{{ path('admin_forum_comment_delete', {id: commentaire.id}) }}" class="d-inline" data-confirm-title="Supprimer le commentaire" data-confirm-message="Supprimer ce commentaire ?">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ commentaire.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger admin-icon-btn" title="Supprimer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div>{{ cleanCommentContent|nl2br }}</div>
                                {% if commentaire.gifUrl %}
                                    <div class="mt-2">
                                        <img src="{{ commentaire.gifUrl }}" alt="GIF commentaire {{ commentaire.id }}" class="img-fluid rounded" style="max-height: 240px;">
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-info mb-4">Aucun commentaire.</div>
            {% endif %}
        </div>

        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header"><h5 class="mb-0">Actions</h5></div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('admin_forum_post_edit', {id: post.id}) }}" class="list-group-item list-group-item-action">Modifier</a>
                    <form method="post" action="{{ path('admin_forum_post_delete', {id: post.id}) }}" style="display:contents;" data-confirm-title="Supprimer le sujet" data-confirm-message="Supprimer ce sujet et ses commentaires ?">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                        <button type="submit" class="list-group-item list-group-item-action text-danger border-top">Supprimer</button>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h5 class="mb-0">Informations</h5></div>
                <div class="card-body">
                    <small>
                        <strong>ID:</strong> {{ post.id }}<br>
                        <strong>Cree:</strong> {{ post.createdAt|format_datetime('short', 'short') }}<br>
                        {% if post.updatedAt %}<strong>Modifie:</strong> {{ post.updatedAt|format_datetime('short', 'short') }}<br>{% endif %}
                        <strong>Commentaires:</strong> {{ post.commentaires|length }}<br>
                        <strong>Statut:</strong> {{ post.status }}
                    </small>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4 d-flex gap-2">
        <a href="{{ path('admin_forum_posts_index', {lang: activeLocale}) }}" class="btn btn-secondary">Retour a la liste</a>
        <a href="{{ path('admin_forum_stats_index') }}" class="btn btn-outline-info">Voir les statistiques</a>
    </div>
</div>
{% endblock %}
