{% extends 'back/layout.html.twig' %}

{% block title %}Admin Forum - Statistiques{% endblock %}

{% block body %}
<div class="container-fluid mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Statistiques du forum</h1>
        <a href="{{ path('admin_forum_posts_index') }}" class="btn btn-secondary">Retour aux sujets</a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-success">
                <div class="card-body">
                    <h6 class="text-success">Posts ouverts</h6>
                    <div class="display-6">{{ countsByStatus.OPEN|default(0) }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning">
                <div class="card-body">
                    <h6 class="text-warning">Posts fermes</h6>
                    <div class="display-6">{{ countsByStatus.CLOSED|default(0) }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-secondary">
                <div class="card-body">
                    <h6 class="text-secondary">Posts caches</h6>
                    <div class="display-6">{{ countsByStatus.HIDDEN|default(0) }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info">
                <div class="card-body">
                    <h6 class="text-info">Total commentaires</h6>
                    <div class="display-6">{{ totalComments }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Top 5 des sujets les plus commentes</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Nombre de commentaires</th>
                            <th>Date de creation</th>
                            <th>Statut</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in topCommentedPosts %}
                            {% set translatedPost = row.post %}
                            <tr>
                                <td>{{ translatedPost.title }}</td>
                                <td>{{ row.nbComments }}</td>
                                <td>{{ row.post.createdAt|date('Y-m-d H:i') }}</td>
                                <td>{{ row.post.status }}</td>
                                <td>
                                    <a href="{{ path('admin_forum_post_show', {id: row.post.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Aucune donnee disponible.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

