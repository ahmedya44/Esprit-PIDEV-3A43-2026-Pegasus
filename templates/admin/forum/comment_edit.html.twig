{% extends 'back/layout.html.twig' %}

{% block title %}Admin - Modifier commentaire{% endblock %}
{% block extra_styles %}
<style>
  .gif-picker-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 8px;
    max-height: 290px;
    overflow: auto;
    border: 1px solid #eef1f6;
    border-radius: 10px;
    padding: 8px;
    background: #fafbff;
  }
  .gif-picker-item {
    border: 1px solid #dde3ef;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    background: #fff;
    padding: 0;
  }
  .gif-picker-item.is-active {
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px rgba(59,130,246,.18);
  }
  .gif-picker-item img {
    width: 100%;
    height: 90px;
    object-fit: cover;
    display: block;
  }
</style>
{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="h3 mb-4">Modifier le commentaire</h1>

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="card mb-3">
                <div class="card-body">
                    {{ form_start(form) }}
                    {{ form_errors(form) }}

                    <div class="mb-3">
                        {{ form_label(form.content, 'Contenu du commentaire') }}
                        {{ form_widget(form.content) }}
                        {% if form.content.vars.errors %}
                            <div class="text-danger small mt-1">
                                {% for error in form.content.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                    <div class="mb-3">
                        <label class="form-label d-block">GIF</label>
                        {% include 'forum/_gif_picker.html.twig' with {
                            field: form.gifUrl,
                            endpoint: path('forum_gif_search')
                        } %}
                    </div>
                    {% if commentaire.gifUrl %}
                        <div class="mb-3">
                            <img src="{{ commentaire.gifUrl }}" alt="GIF commentaire {{ commentaire.id }}" class="img-fluid rounded" style="max-height: 220px;">
                        </div>
                    {% endif %}

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ path('admin_forum_post_show', {id: post.id, lang: activeLocale}) }}" class="btn btn-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h5 class="mb-0">Traduire le commentaire</h5></div>
                <div class="card-body">
                    <form method="post" action="{{ path('admin_forum_comment_translate', {id: commentaire.id}) }}" class="row g-2">
                        <input type="hidden" name="_token" value="{{ csrf_token('translate_comment_' ~ commentaire.id) }}">
                        <input type="hidden" name="return_lang" value="{{ activeLocale }}">
                        <div class="col-md-4">
                            <label class="form-label">Langue cible</label>
                            <select name="target_locale" class="form-select" required>
                                {% for locale, label in translatableLocales %}
                                    <option value="{{ locale }}">{{ label }} ({{ locale }})</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Contenu traduit</label>
                            <textarea name="translated_content" rows="4" class="form-control js-ckeditor" placeholder="Laisser vide pour traduction automatique API"></textarea>
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-outline-primary">Enregistrer la traduction</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% block extra_scripts %}
<script>
  (function () {
    function initGifPicker(root) {
      var endpoint = root.dataset.endpoint || '';
      var inputId = root.dataset.inputId || '';
      var hiddenInput = inputId ? document.getElementById(inputId) : null;
      var queryInput = root.querySelector('.js-gif-query');
      var searchBtn = root.querySelector('.js-gif-search-btn');
      var grid = root.querySelector('.js-gif-results');
      var selectedWrap = root.querySelector('.js-gif-selected-wrap');
      var selectedImg = root.querySelector('.js-gif-selected-img');
      var clearBtn = root.querySelector('.js-gif-clear');
      if (!endpoint || !hiddenInput || !queryInput || !searchBtn || !grid || !selectedWrap || !selectedImg || !clearBtn) return;

      var timer = null;

      function setSelected(url) {
        hiddenInput.value = url || '';
        if (url) {
          selectedImg.src = url;
          selectedWrap.style.display = '';
        } else {
          selectedImg.src = '';
          selectedWrap.style.display = 'none';
        }
        grid.querySelectorAll('.gif-picker-item').forEach(function (node) {
          node.classList.toggle('is-active', node.dataset.url === url);
        });
      }

      function render(items) {
        grid.innerHTML = '';
        if (!Array.isArray(items) || items.length === 0) {
          grid.innerHTML = '<small class="text-muted">Aucun GIF trouve.</small>';
          return;
        }
        items.forEach(function (item) {
          var button = document.createElement('button');
          button.type = 'button';
          button.className = 'gif-picker-item';
          button.dataset.url = item.url || '';
          button.title = item.title || 'GIF';
          button.innerHTML = '<img src="' + (item.preview || item.url || '') + '" alt="' + (item.title || 'GIF') + '">';
          button.addEventListener('click', function () { setSelected(button.dataset.url || ''); });
          grid.appendChild(button);
        });
        if (hiddenInput.value) setSelected(hiddenInput.value);
      }

      function search() {
        var q = (queryInput.value || '').trim();
        fetch(endpoint + '?q=' + encodeURIComponent(q) + '&limit=18', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) { render(data && data.items ? data.items : []); })
          .catch(function () { render([]); });
      }

      queryInput.addEventListener('input', function () {
        if (timer) clearTimeout(timer);
        timer = setTimeout(search, 300);
      });
      queryInput.addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          search();
        }
      });
      searchBtn.addEventListener('click', search);
      clearBtn.addEventListener('click', function () { setSelected(''); });

      setSelected(hiddenInput.value || '');
      search();
    }

    document.querySelectorAll('[data-gif-picker]').forEach(initGifPicker);
  })();
</script>
{% endblock %}
