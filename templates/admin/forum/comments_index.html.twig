{% extends 'back/layout.html.twig' %}

{% block title %}Admin Forum - Commentaires{% endblock %}

{% block body %}
<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="h3">Forum - Gestion des commentaires</h1>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-8">
                    <input type="search" name="search" class="form-control" placeholder="Rechercher par email..." value="{{ search }}" oninput="this.form.requestSubmit()">
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-secondary w-100">Rechercher</button>
                </div>
            </form>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% if comments %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Contenu</th>
                        <th>Auteur</th>
                        <th>Email</th>
                        <th>Sujet</th>
                        <th>Cree</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for comment in comments %}
                        {% set translatedComment = comment|translate_object(app.request.locale) %}
                        {% set translatedPost = comment.post|translate_object(app.request.locale) %}
                        <tr>
                            <td><small>{{ translatedComment.content|slice(0, 50) }}{% if translatedComment.content|length > 50 %}...{% endif %}</small></td>
                            <td>{{ comment.authorName }}</td>
                            <td><small><a href="?search={{ comment.authorEmail }}">{{ comment.authorEmail }}</a></small></td>
                            <td>
                                <a href="{{ path('admin_forum_post_show', {id: comment.post.id}) }}" class="text-decoration-none">
                                    {{ translatedPost.title|slice(0, 30) }}{% if translatedPost.title|length > 30 %}...{% endif %}
                                </a>
                            </td>
                            <td><small>{{ comment.createdAt|format_datetime('short', 'short') }}</small></td>
                            <td>
                                <a href="{{ path('admin_forum_comment_edit', {id: comment.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form method="post" action="{{ path('admin_forum_comment_delete', {id: comment.id}) }}" style="display:inline;" onsubmit="return confirm('Etes-vous sur ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if totalPages > 1 %}
            <nav aria-label="Page navigation">
                <ul class="pagination">
                    {% if currentPage > 1 %}
                        <li class="page-item"><a class="page-link" href="?page=1&search={{ search }}">Premiere</a></li>
                        <li class="page-item"><a class="page-link" href="?page={{ currentPage - 1 }}&search={{ search }}">Precedente</a></li>
                    {% endif %}

                    {% for page in 1..totalPages %}
                        <li class="page-item {% if page == currentPage %}active{% endif %}">
                            <a class="page-link" href="?page={{ page }}&search={{ search }}">{{ page }}</a>
                        </li>
                    {% endfor %}

                    {% if currentPage < totalPages %}
                        <li class="page-item"><a class="page-link" href="?page={{ currentPage + 1 }}&search={{ search }}">Suivante</a></li>
                        <li class="page-item"><a class="page-link" href="?page={{ totalPages }}&search={{ search }}">Derniere</a></li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    {% else %}
        <div class="alert alert-info">Aucun commentaire trouve.</div>
    {% endif %}

    <div class="mt-4">
        <a href="{{ path('admin_forum_posts_index') }}" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour aux sujets
        </a>
    </div>
</div>
{% endblock %}
