{% extends 'back/layout.html.twig' %}

{% block title %}Admin Forum - Sujets{% endblock %}
{% block extra_styles %}
<style>
  .admin-icon-actions {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .admin-icon-btn {
    width: 32px;
    height: 32px;
    padding: 0;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="h3">Forum - Gestion des sujets</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="{{ path('admin_forum_stats_index') }}" class="btn btn-outline-info me-2">Statistiques</a>
            <a href="{{ path('admin_forum_post_new') }}" class="btn btn-primary">Nouveau sujet</a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3" data-live-search-form="1" data-live-delay="280">
                <div class="col-md-5">
                    <input type="search" name="q" class="form-control" placeholder="Rechercher titre ou contenu..." value="{{ q }}" data-live-search-input="1">
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select" data-live-search-filter="1">
                        <option value="">Tous les statuts</option>
                        <option value="OPEN" {% if status == 'OPEN' %}selected{% endif %}>Ouvert</option>
                        <option value="CLOSED" {% if status == 'CLOSED' %}selected{% endif %}>Ferme</option>
                        <option value="HIDDEN" {% if status == 'HIDDEN' %}selected{% endif %}>Cache</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-secondary w-100">Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
    {% endfor %}

    {% if pagination|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Titre</th>
                        <th>Auteur</th>
                        <th>Statut</th>
                        <th>Commentaires</th>
                        <th>Cree</th>
                        <th>Modifie</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for post in pagination %}
                        {% set translatedPost = post %}
                        {% set cleanTitle = translatedPost.title|striptags|replace({'&nbsp;': ' '})|trim %}
                        <tr>
                            <td>
                                <a href="{{ path('admin_forum_post_show', {id: post.id}) }}" class="text-decoration-none">
                                    {{ cleanTitle|slice(0, 55) }}{% if cleanTitle|length > 55 %}...{% endif %}
                                </a>
                            </td>
                            <td>{{ post.authorName }}</td>
                            <td>
                                {% if post.status == 'OPEN' %}
                                    <span class="badge bg-success">Ouvert</span>
                                {% elseif post.status == 'CLOSED' %}
                                    <span class="badge bg-warning text-dark">Ferme</span>
                                {% else %}
                                    <span class="badge bg-secondary">Cache</span>
                                {% endif %}
                            </td>
                            <td>{{ post.commentaires|length }}</td>
                            <td><small>{{ post.createdAt|date('Y-m-d H:i') }}</small></td>
                            <td>
                                {% if post.updatedAt %}
                                    <small>{{ post.updatedAt|date('Y-m-d H:i') }}</small>
                                {% else %}
                                    <small class="text-muted">-</small>
                                {% endif %}
                            </td>
                            <td>
                                <div class="admin-icon-actions">
                                    <a href="{{ path('admin_forum_post_show', {id: post.id}) }}" class="btn btn-sm btn-outline-primary admin-icon-btn" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="{{ path('admin_forum_post_edit', {id: post.id}) }}" class="btn btn-sm btn-outline-warning admin-icon-btn" title="Modifier">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                    <form method="post" action="{{ path('admin_forum_post_delete', {id: post.id}) }}" class="d-inline" data-confirm-title="Supprimer le sujet" data-confirm-message="Supprimer ce sujet ?">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger admin-icon-btn" title="Supprimer">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-3 d-flex justify-content-center">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <div class="alert alert-info">Aucun sujet trouve.</div>
    {% endif %}

    <div class="mt-4">
        <a href="{{ path('admin_forum_comments_index') }}" class="btn btn-outline-secondary">Gerer les commentaires</a>
    </div>
</div>
{% endblock %}

