{% extends 'back/layout.html.twig' %}

{% block title %}Admin Forum - Sujets{% endblock %}

{% block body %}
<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1 class="h3">Forum - Gestion des sujets</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="{{ path('admin_forum_stats_index') }}" class="btn btn-outline-info me-2">Statistiques</a>
            <a href="{{ path('admin_forum_post_new') }}" class="btn btn-primary">Nouveau sujet</a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-5">
                    <input type="search" name="q" class="form-control" placeholder="Rechercher titre ou contenu..." value="{{ q }}" oninput="this.form.requestSubmit()">
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select" onchange="this.form.requestSubmit()">
                        <option value="">Tous les statuts</option>
                        <option value="OPEN" {% if status == 'OPEN' %}selected{% endif %}>Ouvert</option>
                        <option value="CLOSED" {% if status == 'CLOSED' %}selected{% endif %}>Ferme</option>
                        <option value="HIDDEN" {% if status == 'HIDDEN' %}selected{% endif %}>Cache</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-secondary w-100">Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="alert">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
    {% endfor %}

    {% if pagination|length > 0 %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Titre</th>
                        <th>Auteur</th>
                        <th>Statut</th>
                        <th>Commentaires</th>
                        <th>Cree</th>
                        <th>Modifie</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for post in pagination %}
                        {% set translatedPost = post|translate_object(app.request.locale) %}
                        <tr>
                            <td>
                                <a href="{{ path('admin_forum_post_show', {id: post.id}) }}" class="text-decoration-none">
                                    {{ translatedPost.title|slice(0, 55) }}{% if translatedPost.title|length > 55 %}...{% endif %}
                                </a>
                            </td>
                            <td>{{ post.authorName }}</td>
                            <td>
                                {% if post.status == 'OPEN' %}
                                    <span class="badge bg-success">Ouvert</span>
                                {% elseif post.status == 'CLOSED' %}
                                    <span class="badge bg-warning text-dark">Ferme</span>
                                {% else %}
                                    <span class="badge bg-secondary">Cache</span>
                                {% endif %}
                            </td>
                            <td>{{ post.commentaires|length }}</td>
                            <td><small>{{ post.createdAt|format_datetime('short', 'short') }}</small></td>
                            <td>
                                {% if post.updatedAt %}
                                    <small>{{ post.updatedAt|format_datetime('short', 'short') }}</small>
                                {% else %}
                                    <small class="text-muted">-</small>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('admin_forum_post_show', {id: post.id}) }}" class="btn btn-sm btn-outline-primary">Voir</a>
                                <a href="{{ path('admin_forum_post_edit', {id: post.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                                <form method="post" action="{{ path('admin_forum_post_delete', {id: post.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce sujet ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-3 d-flex justify-content-center">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <div class="alert alert-info">Aucun sujet trouve.</div>
    {% endif %}

    <div class="mt-4">
        <a href="{{ path('admin_forum_comments_index') }}" class="btn btn-outline-secondary">Gerer les commentaires</a>
    </div>
</div>
{% endblock %}
