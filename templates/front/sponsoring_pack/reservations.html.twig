<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <title>Demandes de Sponsoring</title>
  <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
  <link href="https://fonts.googleapis.com/css?family=Poppins:400,600,700&display=swap" rel="stylesheet" />
  <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/style.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/responsive.css') }}" rel="stylesheet" />
  <style>
    body { background: #f8f9fa; }
    .page-wrapper {
        min-height: 100vh;
        background: #f8f9fa;
        padding: 40px 0 80px;
    }
    .top-nav {
        background: white;
        box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        padding: 15px 0;
        margin-bottom: 40px;
    }
    .nav-btn {
        color: #4b5563;
        font-weight: 600;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }
    .nav-btn:hover {
        background: #f3f4f6;
        color: #111827;
        text-decoration: none;
    }
    .nav-btn.active {
        color: #f59e0b;
        background: #fffbeb;
    }
    .reservation-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        padding: 20px;
        margin-bottom: 20px;
        transition: transform 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .reservation-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.05);
    }
    .status-badge {
        padding: 6px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .status-attente { background: #fef3c7; color: #d97706; }
    .status-acceptee { background: #d1fae5; color: #059669; }
    .btn-action {
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: opacity 0.2s;
    }
    .btn-action:hover { opacity: 0.9; }
    .btn-accept { background: #10b981; color: white; }
    .btn-reject { background: #ef4444; color: white; }
  </style>
</head>
<body>
  
  <div class="top-nav">
      <div class="container d-flex justify-content-between align-items-center">
          <h4 class="mb-0" style="color: #111827; font-weight: 700;">
              <i class="fa fa-handshake-o mr-2" style="color: #f59e0b;"></i> Sponsoring
          </h4>
          <div>
              <a href="{{ path('front_evenements_index') }}" class="nav-btn"><i class="fa fa-arrow-left mr-2"></i>Retour aux événements</a>
              <a href="{{ path('front_sponsoring_pack_index') }}" class="nav-btn"><i class="fa fa-cubes mr-2"></i>Mes Packs</a>
              <a href="{{ path('front_sponsoring_reservations') }}" class="nav-btn active"><i class="fa fa-inbox mr-2"></i>Demandes</a>
          </div>
      </div>
  </div>

  <div class="page-wrapper">
    <div class="container">
      
      <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
          <h2 style="color: #111827; font-weight: 800; font-size: 32px; margin-bottom: 10px;">Demandes de Sponsoring</h2>
          <p style="color: #6b7280; font-size: 16px;">Gérez les sponsors qui souhaitent financer vos événements.</p>
        </div>
      </div>

      {% for label, messages in app.flashes %}
          {% for message in messages %}
              <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} alert-dismissible fade show mb-4" role="alert" style="border-radius: 12px;">
                  {{ message }}
                  <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                  </button>
              </div>
          {% endfor %}
      {% endfor %}

      {% if reservations is empty %}
        <div class="text-center py-5" style="background: white; border-radius: 20px; border: 1px dashed #d1d5db;">
            <i class="fa fa-inbox fa-4x mb-3" style="color: #d1d5db;"></i>
            <h4 style="color: #4b5563;">Aucune demande pour le moment</h4>
            <p style="color: #9ca3af;">Les réservations de sponsors apparaîtront ici.</p>
        </div>
      {% else %}
        {% for reservation in reservations %}
          <div class="reservation-card">
            <div class="d-flex align-items-center w-100 justify-content-between flex-wrap">
                <div class="d-flex align-items-center mb-2 mb-md-0">
                    <div style="width: 50px; height: 50px; border-radius: 10px; background: #f3f4f6; display: flex; align-items: center; justify-content: center; margin-right: 20px;">
                        <i class="fa fa-user" style="color: #9ca3af; font-size: 24px;"></i>
                    </div>
                    <div>
                        <h5 class="mb-1" style="color: #111827; font-weight: 700;">{{ reservation.user.email }}</h5>
                        <div style="color: #6b7280; font-size: 14px;">
                            <span class="mr-3"><i class="fa fa-calendar-o mr-1"></i> {{ reservation.evenement.titre }}</span>
                            <span class="mr-3"><i class="fa fa-cube mr-1"></i> {{ reservation.sponsoringPack.nomPack }} ({{ reservation.sponsoringPack.prix }} DT)</span>
                            <span><i class="fa fa-clock-o mr-1"></i> {{ reservation.dateReservation|date('d/m/Y H:i') }}</span>
                        </div>
                    </div>
                </div>
                
                <div class="d-flex align-items-center">
                    {% if reservation.statut == 'en attente' %}
                        <span class="status-badge status-attente mr-4"><i class="fa fa-hourglass-half mr-1"></i> En attente</span>
                        
                        <form method="post" action="{{ path('front_sponsoring_reservations_accept', {'id': reservation.id}) }}" class="mr-2" style="margin: 0;" onsubmit="return confirm('Accepter ce sponsor ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ reservation.id) }}">
                            <button type="submit" class="btn-action btn-accept"><i class="fa fa-check mr-2"></i>Accepter</button>
                        </form>
                        
                        <form method="post" action="{{ path('front_sponsoring_reservations_reject', {'id': reservation.id}) }}" style="margin: 0;" onsubmit="return confirm('Rejeter et supprimer définitivement cette demande ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ reservation.id) }}">
                            <button type="submit" class="btn-action btn-reject"><i class="fa fa-times mr-2"></i>Rejeter</button>
                        </form>
                    {% else %}
                        <span class="status-badge status-acceptee"><i class="fa fa-check-circle mr-1"></i> Acceptée</span>
                        <!-- Option to cancel an accepted reservation if needed -->
                        <form method="post" action="{{ path('front_sponsoring_reservations_reject', {'id': reservation.id}) }}" class="ml-4" style="margin: 0;" onsubmit="return confirm('Annuler cette réservation acceptée ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ reservation.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;"><i class="fa fa-trash"></i></button>
                        </form>
                    {% endif %}
                </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}

    </div>
  </div>

  <footer class="footer_section" style="background: #111827; padding: 20px 0; text-align: center; color: white;">
    <div class="container">
      <p class="mb-0">&copy; <span id="displayYear"></span> Tous droits réservés.</p>
    </div>
  </footer>

  <script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
  <script src="{{ asset('front/js/bootstrap.js') }}"></script>
  <script>
    document.getElementById('displayYear').innerHTML = new Date().getFullYear();
  </script>
</body>
</html>
