{% extends 'base_front.html.twig' %}

{% block title %}Modifier Pack Sponsoring{% endblock %}

{% block body %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;800&display=swap');

    body {
        background-color: #f1f3f5 !important;
        font-family: 'Outfit', sans-serif;
    }
    .form-container {
        max-width: 600px;
        margin: 50px auto;
        background: white;
        padding: 40px;
        border-radius: 30px;
        box-shadow: 0 15px 50px rgba(0,0,0,0.05);
    }
    .page-title {
        font-weight: 800;
        font-size: 1.8rem;
        color: #1e272e;
        margin-bottom: 30px;
        text-align: center;
    }
    .form-group label {
        font-weight: 700;
        color: #2d3436;
        margin-bottom: 10px;
        display: block;
    }
    .form-control {
        border-radius: 12px;
        padding: 12px 15px;
        border: 1px solid #dfe6e9;
        margin-bottom: 20px;
        font-size: 0.95rem;
    }
    .form-control:focus {
        border-color: #3498db;
        box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
    }
    .btn-save {
        background-color: #3498db;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 15px;
        width: 100%;
        font-weight: 700;
        font-size: 1rem;
        transition: all 0.3s;
        margin-top: 20px;
    }
    .btn-save:hover {
        background-color: #2980b9;
        transform: translateY(-2px);
    }
    .btn-cancel {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: #b2bec3;
        font-weight: 600;
        text-decoration: none;
    }
</style>

<div class="container">
    <div class="form-container">
        <h1 class="page-title">Modifier le Pack</h1>

        {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.nomPack) }}
                {{ form_widget(form.nomPack) }}
                {{ form_errors(form.nomPack) }}
            </div>

            <div class="form-group">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-group">
                {{ form_label(form.prix) }}
                {{ form_widget(form.prix) }}
                {{ form_errors(form.prix) }}
            </div>

            <button class="btn-save">Mettre à jour le Pack</button>
        {{ form_end(form) }}

        <a href="{{ path('front_sponsoring_pack_index') }}" class="btn-cancel">Annuler</a>
    </div>
</div>
{% endblock %}
