<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <title>Nouveau Pack de Sponsoring</title>
  <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
  <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/style.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/responsive.css') }}" rel="stylesheet" />
  <style>
    body { background: #f8f9fa; }

    .page-wrapper {
        min-height: 100vh;
        background: #f8f9fa;
        padding: 40px 0 80px;
    }
    .top-nav {
        background: white;
        border-bottom: 1px solid #e5e7eb;
        padding: 16px 0;
        margin-bottom: 0;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .top-nav a { color: #374151; font-weight: 600; text-decoration: none; }
    .top-nav a:hover { color: #7c3aed; }
    .top-nav .brand { font-size: 22px; font-weight: 800; color: #7c3aed; }

    .form-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 24px;
        padding: 48px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.08);
    }
    .field-label { display: block; color: #374151; font-weight: 600; font-size: 13px; margin-bottom: 8px; letter-spacing: 0.5px; text-transform: uppercase; }
    .field-label i { margin-right: 6px; color: #7c3aed; }
    .sp-input { width: 100%; background: #f9fafb !important; border: 1.5px solid #d1d5db !important; color: #111827 !important; border-radius: 12px !important; padding: 14px 18px !important; font-size: 15px !important; transition: all 0.3s ease; }
    .sp-input::placeholder { color: #9ca3af !important; }
    .sp-input:focus { background: white !important; border-color: #7c3aed !important; box-shadow: 0 0 0 4px rgba(124,58,237,0.1) !important; color: #111827 !important; }
    textarea.sp-input { resize: vertical; min-height: 130px; }
    .divider { height: 1px; background: #e5e7eb; margin: 28px 0; }
    .btn-submit { width: 100%; border: none; border-radius: 50px; background: linear-gradient(135deg, #a855f7, #7c3aed); color: white; font-weight: 700; font-size: 16px; padding: 16px; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 6px 20px rgba(124,58,237,0.3); display: flex; align-items: center; justify-content: center; gap: 10px; }
    .btn-submit:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(124,58,237,0.45); }
    .btn-back-link { border: 1.5px solid #d1d5db; border-radius: 50px; color: #374151 !important; padding: 10px 24px; font-size: 14px; font-weight: 600; text-decoration: none !important; display: inline-flex; align-items: center; gap: 8px; transition: all 0.3s ease; }
    .btn-back-link:hover { background: #f3f4f6; color: #111827 !important; }
    .page-title { color: #111827; font-size: 28px; font-weight: 800; }
    .page-subtitle { color: #6b7280; font-size: 15px; margin-top: 4px; }
    .text-danger { color: #ef4444 !important; font-size: 12px; margin-top: 5px; }
</style>
</head>
<body>

  <div class="top-nav">
    <div class="container d-flex justify-content-between align-items-center">
      <a class="brand" href="{{ path('front_home') }}">🎵 Feane</a>
      <div>
        <a href="{{ path('front_evenements_index') }}" class="mr-4">Événements</a>
        {% if app.user %}
          <a href="{{ path('app_logout') }}">Logout</a>
        {% else %}
          <a href="{{ path('app_login') }}">Login</a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="page-wrapper">
    <div class="container">

      {# Page Header #}
      <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
          <div class="page-title"><i class="fa fa-plus mr-2" style="color: #a855f7;"></i> Nouveau Pack</div>
          <div class="page-subtitle">Définissez votre offre de sponsoring pour les artistes</div>
        </div>
        <a href="{{ path('front_sponsoring_pack_index') }}" class="btn-back-link">
          <i class="fa fa-arrow-left"></i> Retour
        </a>
      </div>

      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
          <div class="form-card">

            {{ form_start(form, {'attr': {'id': 'pack-form', 'novalidate': 'novalidate'}}) }}

              {# Nom du Pack #}
              <div class="mb-4">
                <label class="field-label"><i class="fa fa-tag"></i> Nom du Pack</label>
                {{ form_widget(form.nomPack, {'attr': {'class': 'sp-input', 'placeholder': 'Ex: Pack Gold, Pack Platine...'}}) }}
                <div class="text-danger">{{ form_errors(form.nomPack) }}</div>
              </div>

              {# Description #}
              <div class="mb-4">
                <label class="field-label"><i class="fa fa-align-left"></i> Description</label>
                {{ form_widget(form.description, {'attr': {'class': 'sp-input', 'placeholder': 'Listez les avantages inclus : logo affiché, stand, citation sur réseaux...'}}) }}
                <div class="text-danger">{{ form_errors(form.description) }}</div>
              </div>

              {# Prix #}
              <div class="mb-5">
                <label class="field-label"><i class="fa fa-money"></i> Prix (DT)</label>
                {{ form_widget(form.prix, {'attr': {'class': 'sp-input', 'placeholder': '500'}}) }}
                <div class="text-danger">{{ form_errors(form.prix) }}</div>
              </div>

              <div class="divider"></div>

              <button type="submit" class="btn-submit">
                <i class="fa fa-save"></i> Créer le Pack
              </button>

            {{ form_end(form) }}

          </div>
        </div>
      </div>

    </div>
  </div>

  <script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
  <script src="{{ asset('front/js/bootstrap.js') }}"></script>
</body>
</html>
