<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Gestion des Packs Sponsoring</title>
    
    <!-- bootstrap core css -->
    <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
    <!-- font awesome style -->
    <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;800&display=swap');

        body {
            background-color: #f1f3f5 !important;
            font-family: 'Outfit', sans-serif;
            margin: 0;
            padding: 20px;
        }
        .container-fluid {
            padding: 20px 40px;
        }
        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        .btn-back {
            background-color: #1e272e;
            color: white;
            border-radius: 6px;
            padding: 8px 18px;
            font-weight: 700;
            text-decoration: none;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .btn-back:hover {
            background-color: #2c3e50;
            color: white;
            text-decoration: none;
        }
        .page-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: #1e272e;
            margin: 0;
            margin-left: 15px;
        }
        .btn-add-pack-top {
            background-color: #2ecc71;
            color: white;
            border-radius: 6px;
            padding: 10px 22px;
            font-weight: 700;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .btn-add-pack-top:hover {
            background-color: #27ae60;
            color: white;
            text-decoration: none;
        }
        
        .dashboard-content {
            display: flex;
            gap: 30px;
            align-items: flex-start;
        }
        .packs-section {
            flex: 1;
        }
        .sidebar-section {
            width: 380px;
            display: none; /* Hidden by default */
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 800;
            color: #1e272e;
            margin-bottom: 25px;
        }
        .modern-card {
            background: white;
            border-radius: 25px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.03);
            margin-bottom: 30px;
            border: 1px solid #f1f2f6;
        }
        .pack-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            margin-bottom: 50px;
            padding: 10px 0;
            justify-content: center;
        }
        .pack-premium-card {
            background: white;
            border-radius: 30px;
            padding: 35px;
            box-shadow: 0 15px 45px rgba(0,0,0,0.04);
            text-align: center;
            border: 1px solid #f1f2f6;
            transition: transform 0.3s;
            max-width: 400px;
            width: 100%;
        }
        .pack-premium-card:hover {
            transform: translateY(-5px);
        }
        .pack-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .pack-name-display {
            font-weight: 800;
            font-size: 1.25rem;
            color: #1e272e;
            text-align: left;
        }
        .price-tag {
            background: #e67e22;
            color: white;
            border: none;
            border-radius: 12px;
            padding: 5px 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            font-weight: 700;
            white-space: nowrap;
        }
        .pack-desc-display {
            color: #b2bec3;
            font-size: 0.95rem;
            margin-bottom: 30px;
            text-align: left;
            min-height: 50px;
            line-height: 1.5;
        }
        .sponsor-green-badge {
            padding: 10px 25px;
            border-radius: 15px;
            font-weight: 700;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
        }
        .pack-btns-row {
            display: flex;
            gap: 12px;
            justify-content: center;
        }
        .btn-pack-blue {
            background-color: #3498db;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 12px 25px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.95rem;
            flex: 1;
        }
        .btn-pack-red {
            background-color: #e74c3c;
            color: white;
            border: none;
            border-radius: 15px;
            padding: 12px 25px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.95rem;
            flex: 1;
        }
        .btn-pack-blue:hover, .btn-pack-red:hover {
            opacity: 0.9;
            color: white;
            text-decoration: none;
        }

        /* Sidebar Form Styles */
        .sidebar-card {
            background: white;
            border-radius: 25px;
            padding: 30px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.03);
            border: 1px solid #f1f2f6;
        }
        .sidebar-title {
            color: #2ecc71;
            font-weight: 800;
            font-size: 1.4rem;
            margin-bottom: 25px;
        }
        .form-label-custom {
            font-weight: 700;
            color: #1e272e;
            margin-bottom: 8px;
            display: block;
            font-size: 0.9rem;
        }
        .form-control-custom {
            width: 100%;
            border-radius: 10px;
            padding: 10px 15px;
            border: 1px solid #dfe6e9;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }
        .btn-form-cancel {
            background-color: #95a5a6;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 20px;
            font-weight: 700;
            font-size: 0.9rem;
        }
        .btn-form-save {
            background-color: #2ecc71;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 20px;
            font-weight: 700;
            font-size: 0.9rem;
        }

        /* Table refinement */
        .premium-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        .premium-table thead tr {
            background-color: #2c3e50;
        }
        .premium-table th {
            color: white;
            padding: 18px 15px;
            text-align: left;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: capitalize;
        }
        .premium-table td {
            padding: 22px 15px;
            border-bottom: 1px solid #f1f2f6;
            color: #2d3436;
            font-size: 0.9rem;
            font-weight: 500;
        }
        .col-sponsor { font-weight: 800 !important; }
        .col-email { color: #3498db; }
        .col-pack { color: #2ecc71; font-weight: 700; }
        .col-price { color: #e67e22; font-weight: 800; }
        .btn-table-del {
            background-color: #e74c3c;
            color: white;
            border: none;
            border-radius: 6px;
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .btn-table-del:hover {
            background-color: #c0392b;
            transform: scale(1.05);
        }
        .btn-export-pdf {
            background-color: #3498db;
            color: white;
            border-radius: 8px;
            padding: 8px 18px;
            font-weight: 700;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }
        .btn-export-pdf:hover {
            background-color: #2980b9;
            color: white;
            text-decoration: none;
        }
    </style>
</head>
<body>

<div class="container-fluid">
    <div class="header-row">
        <div style="display: flex; align-items: center;">

            <a href="javascript:history.back()" class="btn-back">
                <i class="fa fa-arrow-left"></i> Retour
            </a>
            <h1 class="page-title">Gestion des Packs Sponsoring</h1>
        </div>
        <div>
            <a href="#" class="btn-add-pack-top" id="toggle_new_pack_btn">
                Ajouter un Pack +
            </a>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="packs-section">
            <div class="section-title">Packs disponibles</div>
            <div class="pack-grid">
                {% for pack in packs %}
                    <div class="pack-premium-card">
                        <div class="pack-title-row">
                            <div class="pack-name-display">{{ pack.nomPack|slice(0, 15) }}...</div>
                            <div class="price-tag">{{ pack.prix }} TND</div>
                        </div>
                        <div class="pack-desc-display">
                            {{ pack.description|slice(0, 80) }}{{ pack.description|length > 80 ? '...' : '' }}
                        </div>
                        
                        <div class="text-center">
                            {% set resForThisPack = null %}
                            {% for res in reservations %}
                                {% if res.sponsoringPack.id == pack.id %}
                                    {% set resForThisPack = res %}
                                {% endif %}
                            {% endfor %}

                            {% if resForThisPack %}
                                <div class="sponsor-green-badge" style="background:#f1f2f6; color:#7f8c8d;">
                                    <i class="fa fa-handshake-o"></i> Sponsor : {{ resForThisPack.user.userIdentifier|split('@')|first }}
                                </div>
                            {% else %}
                                <div class="sponsor-green-badge" style="background:#f1f2f6; color:#b2bec3;">
                                    <i class="fa fa-circle-o"></i> Libre
                                </div>
                            {% endif %}
                        </div>

                        <div class="pack-btns-row">
                            <a href="{{ path('front_sponsoring_pack_edit', {'id': pack.id}) }}" class="btn-pack-blue">
                                <i class="fa fa-pencil-square-o"></i> Modifier
                            </a>
                            <form method="post" action="{{ path('front_sponsoring_pack_delete', {'id': pack.id}) }}" onsubmit="return confirm('Supprimer ce pack ?');" style="flex:1">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ pack.id) }}">
                                <button class="btn-pack-red" style="width:100%">
                                    <i class="fa fa-trash-o"></i> Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="sidebar-section" id="new_pack_sidebar">
            <div class="sidebar-card">
                <h2 class="sidebar-title">Nouveau Pack</h2>
                
                {{ form_start(form) }}
                    <label class="form-label-custom">Nom du pack :</label>
                    {{ form_widget(form.nomPack, {'attr': {'class': 'form-control-custom', 'placeholder': 'Ex: Pack Or', 'id': 'nom_pack_input'}}) }}

                    <label class="form-label-custom">Prix (TND) :</label>
                    {{ form_widget(form.prix, {'attr': {'class': 'form-control-custom', 'placeholder': 'Ex: 5000'}}) }}

                    <label class="form-label-custom">Description :</label>
                    {{ form_widget(form.description, {'attr': {'class': 'form-control-custom', 'placeholder': 'Avantages du pack...', 'rows': '4'}}) }}

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn-form-cancel" id="cancel_new_pack_btn">Annuler</button>
                        <button type="submit" class="btn-form-save">Enregistrer</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="modern-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="section-title mb-0" style="display: flex; align-items: center; gap: 10px;">
                <i class="fa fa-clipboard"></i> Liste des Sponsors
            </h3>
            {% if eventId %}
            <a href="{{ path('front_sponsoring_export_pdf', {'eventId': eventId}) }}" class="btn-export-pdf">
                <i class="fa fa-file-pdf-o"></i> Exporter PDF
            </a>
            {% endif %}
        </div>

        <div class="table-responsive">
            <table class="premium-table">
                <thead>
                    <tr>
                        <th style="width: 15%">Sponsor</th>
                        <th style="width: 25%">Email</th>
                        <th style="width: 15%">Téléphone</th>
                        <th style="width: 25%">Pack réservé</th>
                        <th style="width: 10%">Prix</th>
                        <th style="width: 10%">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for res in reservations %}
                        <tr>
                            <td class="col-sponsor">{{ res.user.userIdentifier|split('@')|first }}</td>
                            <td class="col-email">{{ res.user.email }}</td>
                            <td>{{ res.user.numTel|default('-') }}</td>
                            <td class="col-pack">{{ res.sponsoringPack.nomPack }}</td>
                            <td class="col-price">{{ res.sponsoringPack.prix }} TND</td>
                            <td>
                                <form action="{{ path('front_sponsoring_reservations_reject', {'id': res.id}) }}" method="POST" onsubmit="return confirm('Rejeter cette demande ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ res.id) }}">
                                    <button class="btn-table-del">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                Aucun sponsor pour le moment.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
<script src="{{ asset('front/js/bootstrap.js') }}"></script>

<script>
    $(document).ready(function() {
        const sidebar = $('#new_pack_sidebar');
        const toggleBtn = $('#toggle_new_pack_btn');
        const cancelBtn = $('#cancel_new_pack_btn');
        const nameInput = $('#nom_pack_input');

        toggleBtn.on('click', function(e) {
            e.preventDefault();
            sidebar.fadeIn(300);
            nameInput.focus();
        });

        cancelBtn.on('click', function() {
            sidebar.fadeOut(300);
        });
    });
</script>

</body>
</html>
