            }, 300);
        }

        function shareInspiration() {
            if (!currentInspiration) return;
            
            const shareText = `"${currentInspiration}" - Citation quotidienne Pegasus 🎨`;
            const shareUrl = window.location.href;
            
            // Partager sur Twitter
            const twitterUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(shareUrl)}`;
            window.open(twitterUrl, '_blank', 'width=600,height=400');
            
            // Alternative: copier dans le presse-papiers
            if (navigator.share) {
                navigator.share({
                    title: 'Citation Pegasus',
                    text: shareText,
                    url: shareUrl
                });
            } else {
                // Fallback: copier dans le presse-papiers
                navigator.clipboard.writeText(shareText).then(() => {
                    alert('Citation copiée dans le presse-papiers ! 📋');
                });
            }
        }

