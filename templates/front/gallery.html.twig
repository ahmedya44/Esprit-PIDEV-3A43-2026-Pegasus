        async function loadViewCount(artId, element) {
            try {
                const response = await fetch('/api/art/' + artId + '/views');
                const data = await response.json();
                
                if (response.ok) {
                    element.textContent = data.viewsCount;
                }
            } catch (error) {
                console.error('Erreur lors du chargement des vues:', error);
            }
        }

        // Enregistrer une vue quand on clique sur le bouton œil
        async function recordView(artId) {
            try {
                // Enregistrer la vue
                await fetch('/art/' + artId + '/view', { method: 'POST' });
                
                // Mettre à jour immédiatement le compteur
                const viewElement = document.querySelector('.view-count[data-art-id="' + artId + '"]');
                if (viewElement) {
                    const currentCount = parseInt(viewElement.textContent) || 0;
                    viewElement.textContent = currentCount + 1;
                }
            } catch (error) {
                console.error('Erreur lors de l\'enregistrement de la vue:', error);
            }
        }
