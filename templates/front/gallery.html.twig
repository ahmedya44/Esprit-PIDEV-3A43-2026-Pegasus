{% extends 'front/layout.html.twig' %}

{% set active_nav = 'gallery' %}

{% block title %}Gallery{% endblock %}

{% block extra_styles %}
<style>
  .gallery-widget {
    border: 1px solid #d9d9d9;
    border-radius: 14px;
    background: linear-gradient(145deg, #f2f2f2, #e8e8e8);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.08);
    padding: 18px;
    margin-bottom: 20px;
  }
  .gallery-widget-title {
    font-weight: 700;
    margin-bottom: 10px;
    color: #222831;
  }
  .gallery-inspiration {
    font-style: italic;
    color: #3a3a3a;
    min-height: 28px;
  }
  .gallery-chat-messages {
    max-height: 280px;
    overflow-y: auto;
    border: 1px solid #d0d0d0;
    border-radius: 10px;
    padding: 10px;
    background: #f7f7f7;
    margin-bottom: 10px;
  }
  .gallery-chat-msg {
    margin-bottom: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    line-height: 1.4;
  }
  .gallery-chat-msg.bot {
    background: #ffffff;
    color: #2d2d2d;
    border: 1px solid #dddddd;
  }
  .gallery-chat-msg.user {
    background: #2f2f2f;
    color: #fff;
    text-align: right;
  }
  .gallery-orange-outline {
    border: 1px solid #ffbe33 !important;
    color: #ffbe33 !important;
    background: transparent !important;
  }
  .gallery-orange-outline:hover {
    background: #ffbe33 !important;
    color: #222 !important;
  }
  .gallery-pill-count {
    font-size: .78rem;
    border-radius: 999px;
    padding: 2px 8px;
    border: 1px solid #ffbe33;
    color: #ffbe33;
  }
  .gallery-icon-btn {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ffbe33;
    color: #ffbe33;
    background: transparent;
    cursor: pointer;
  }
  .gallery-icon-btn:hover {
    background: #ffbe33 !important;
    color: #222 !important;
  }
  .gallery-icon-btn.is-active {
    background: #ffbe33 !important;
    color: #222 !important;
  }
</style>
{% endblock %}

{% block body %}
<section class="forum-shell">
  <div class="container">
    <div class="forum-card">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-1">Gallery</h1>
          <p class="text-muted mb-0">Browse and share artworks.</p>
        </div>
        <div class="d-flex gap-2">
          <a href="{{ path('favorites_page') }}" class="btn btn-outline-dark">My Favorites</a>
          <a href="{{ path('front_gallery_new') }}" class="btn btn-warning">Add Artwork</a>
        </div>
      </div>

      {% for type, messages in app.flashes %}
        {% for message in messages %}
          <div class="alert alert-{{ type == 'error' ? 'danger' : type }} mb-3">{{ message }}</div>
        {% endfor %}
      {% endfor %}

      <div class="gallery-widget">
        <div class="gallery-widget-title">Citation du jour</div>
        <div class="gallery-inspiration" id="daily-inspiration">Loading...</div>
        <div class="mt-2 d-flex gap-2">
          <button type="button" class="btn btn-sm gallery-orange-outline" id="share-inspiration-btn">Share</button>
          <button type="button" class="btn btn-sm gallery-orange-outline" id="refresh-inspiration-btn">Another one</button>
        </div>
      </div>

      <div class="gallery-widget">
        <div class="gallery-widget-title">Assistant Artistique Pegasus (Machine Learning)</div>
        <div class="gallery-chat-messages" id="ml-chat-messages">
          <div class="gallery-chat-msg bot">Bonjour. Posez-moi une question sur l'art.</div>
        </div>
        <div class="input-group mb-2">
          <input type="text" class="form-control" id="ml-chat-input" placeholder="Ask about art...">
          <button type="button" class="btn gallery-orange-outline" id="ml-chat-send-btn">Send</button>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qui est Picasso ?">Picasso</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qu'est-ce que le cubisme ?">Cubisme</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Comment debuter en peinture ?">Peinture</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qui est Van Gogh ?">Van Gogh</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qu'est-ce que l'impressionnisme ?">Impressionnisme</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qu'est-ce que le surrealisme ?">Surrealisme</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qu'est-ce que l'art abstrait ?">Art abstrait</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Comment travailler la perspective ?">Perspective</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qu'est-ce que la composition en art ?">Composition</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qui est Claude Monet ?">Monet</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qu'est-ce que la Renaissance ?">Renaissance</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qui est Leonardo da Vinci ?">Da Vinci</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qu'est-ce que l'aquarelle ?">Aquarelle</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Comment choisir les couleurs ?">Couleurs</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qu'est-ce que la sculpture ?">Sculpture</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qui est Salvador Dali ?">Dali</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qu'est-ce que le pop art ?">Pop art</button>
          <button type="button" class="btn btn-sm gallery-orange-outline js-ml-suggest" data-question="Qu'est-ce que la photographie artistique ?">Photographie</button>
        </div>
      </div>

      <form method="get" class="row g-2 mb-4">
        <div class="col-md-8">
          <input type="text" name="search" class="form-control" placeholder="Search artworks..." value="{{ search }}">
        </div>
        <div class="col-md-2">
          <select name="sort" class="form-control">
            <option value="recent" {% if sortBy == 'recent' %}selected{% endif %}>Recent</option>
            <option value="oldest" {% if sortBy == 'oldest' %}selected{% endif %}>Oldest</option>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-dark w-100">Search</button>
        </div>
      </form>

      <div class="row">
        {% for art in arts %}
          {% set imageSrc = art.imageUrl ? ((art.imageUrl starts with('http') or art.imageUrl starts with('/')) ? art.imageUrl : asset('images/products/' ~ art.imageUrl)) : '' %}
          <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
              {% if imageSrc %}
                <a href="{{ path('art_detail', {id: art.id}) }}" onclick="recordView({{ art.id }}); return true;">
                  <img src="{{ imageSrc }}" class="card-img-top" alt="{{ art.title }}" style="height:220px;object-fit:cover;">
                </a>
              {% endif %}
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">{{ art.title }}</h5>
                <p class="card-text text-muted">{{ art.description|slice(0, 120) }}{% if art.description|length > 120 %}...{% endif %}</p>
                <div class="mb-2 d-flex gap-2 align-items-center">
                  <button type="button" class="gallery-icon-btn js-favorite-btn" data-art-id="{{ art.id }}" data-art-title="{{ art.title|e('html_attr') }}" aria-label="Favorite">
                    <i class="fa fa-heart"></i>
                  </button>
                  <span class="gallery-pill-count"><i class="fa fa-heart-o"></i> <span class="js-fav-count" data-art-id="{{ art.id }}">0</span></span>
                  <button type="button" class="gallery-icon-btn js-like-btn" data-art-id="{{ art.id }}" aria-label="Like">
                    <i class="fa fa-thumbs-up"></i>
                  </button>
                  <span class="gallery-pill-count"><i class="fa fa-thumbs-up"></i> <span class="js-like-count" data-art-id="{{ art.id }}">0</span></span>
                </div>
                <div class="mt-auto d-flex gap-2">
                  <a href="{{ path('art_detail', {id: art.id}) }}" class="btn btn-sm btn-outline-info">Details</a>
                  <a href="{{ path('front_gallery_edit', {id: art.id}) }}" class="btn btn-sm btn-outline-primary">Edit</a>
                  <form method="post" action="{{ path('front_gallery_delete', {id: art.id}) }}" class="d-inline" onsubmit="return confirm('Delete this artwork?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ art.id) }}">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        {% else %}
          <div class="col-12">
            <div class="alert alert-light border text-center mb-0">
              No artworks found.
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block extra_scripts %}
<script>
  function recordView(artId) {
    fetch('/art/' + artId + '/view', { method: 'POST' }).catch(function () {});
  }

  (function () {
    var inspirationEl = document.getElementById('daily-inspiration');
    var refreshBtn = document.getElementById('refresh-inspiration-btn');
    var shareBtn = document.getElementById('share-inspiration-btn');

    function loadDailyInspiration(isRandom) {
      if (!inspirationEl) return;
      inspirationEl.textContent = 'Loading...';
      var url = isRandom ? '/api/random-inspiration' : '/api/daily-inspiration';
      fetch(url)
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data || !data.inspiration) {
            inspirationEl.textContent = 'No inspiration available right now.';
            return;
          }
          inspirationEl.textContent = data.inspiration;
        })
        .catch(function () {
          inspirationEl.textContent = 'Unable to load inspiration.';
        });
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', function () { loadDailyInspiration(true); });
    }
    if (shareBtn) {
      shareBtn.addEventListener('click', function () {
        var text = inspirationEl ? inspirationEl.textContent : '';
        if (!text) return;
        navigator.clipboard.writeText(text).catch(function () {});
      });
    }
    loadDailyInspiration(false);
  })();

  (function () {
    var messagesEl = document.getElementById('ml-chat-messages');
    var inputEl = document.getElementById('ml-chat-input');
    var sendBtn = document.getElementById('ml-chat-send-btn');

    function addMessage(text, type) {
      if (!messagesEl) return;
      var item = document.createElement('div');
      item.className = 'gallery-chat-msg ' + type;
      item.textContent = text;
      messagesEl.appendChild(item);
      messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function ask(question) {
      if (!question) return;
      addMessage(question, 'user');
      fetch('/api/ml-chatbot', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: question })
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data || !data.response) {
            addMessage('Service unavailable right now.', 'bot');
            return;
          }
          addMessage(data.response, 'bot');
        })
        .catch(function () {
          addMessage('Network error. Please retry.', 'bot');
        });
    }

    if (sendBtn && inputEl) {
      sendBtn.addEventListener('click', function () {
        var q = inputEl.value.trim();
        if (!q) return;
        inputEl.value = '';
        ask(q);
      });
      inputEl.addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          sendBtn.click();
        }
      });
    }

    document.querySelectorAll('.js-ml-suggest').forEach(function (btn) {
      btn.addEventListener('click', function () {
        ask(btn.getAttribute('data-question') || '');
      });
    });
  })();

  (function () {
    function getLikeState() {
      try {
        return JSON.parse(localStorage.getItem('gallery_likes') || '{}');
      } catch (e) {
        return {};
      }
    }

    function setLikeState(state) {
      localStorage.setItem('gallery_likes', JSON.stringify(state));
    }

    function getFavoriteState() {
      try {
        return JSON.parse(localStorage.getItem('gallery_favorites') || '{}');
      } catch (e) {
        return {};
      }
    }

    function setFavoriteState(state) {
      localStorage.setItem('gallery_favorites', JSON.stringify(state));
    }

    function renderLikes() {
      var likes = getLikeState();
      document.querySelectorAll('.js-like-count').forEach(function (el) {
        var id = String(el.getAttribute('data-art-id'));
        el.textContent = likes[id] ? '1' : '0';
      });
      document.querySelectorAll('.js-like-btn').forEach(function (btn) {
        var id = String(btn.getAttribute('data-art-id'));
        var active = !!likes[id];
        btn.classList.toggle('is-active', active);
        btn.setAttribute('title', active ? 'Liked' : 'Like');
      });
    }

    function renderFavorites() {
      var fav = getFavoriteState();
      document.querySelectorAll('.js-fav-count').forEach(function (el) {
        var id = String(el.getAttribute('data-art-id'));
        el.textContent = fav[id] ? '1' : '0';
      });
      document.querySelectorAll('.js-favorite-btn').forEach(function (btn) {
        var id = String(btn.getAttribute('data-art-id'));
        var active = !!fav[id];
        btn.classList.toggle('is-active', active);
        btn.setAttribute('title', active ? 'Favorited' : 'Favorite');
      });
    }

    document.querySelectorAll('.js-like-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = String(btn.getAttribute('data-art-id'));
        var likes = getLikeState();
        likes[id] = !likes[id];
        setLikeState(likes);
        renderLikes();
      });
    });

    document.querySelectorAll('.js-favorite-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var id = String(btn.getAttribute('data-art-id'));
        var title = String(btn.getAttribute('data-art-title') || '');
        var fav = getFavoriteState();
        var willAdd = !fav[id];
        var url = willAdd ? '/api/favorites/add' : '/api/favorites/remove';
        var payload = willAdd ? { art_id: parseInt(id, 10), art_title: title } : { art_id: parseInt(id, 10) };

        fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) {
            if (!data || data.success !== true) {
              return;
            }
            fav[id] = willAdd;
            setFavoriteState(fav);
            renderFavorites();
          })
          .catch(function () {});
      });
    });

    renderLikes();
    renderFavorites();
  })();
</script>
{% endblock %}
