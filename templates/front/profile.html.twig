<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <meta name="keywords" content="" />
  <meta name="description" content="" />
  <meta name="author" content="" />
  <link rel="shortcut icon" href="{{ asset('front/images/favicon.png') }}" type="">

  <title>Feane - Profile</title>

  <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
  <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-nice-select/1.1.0/css/nice-select.min.css" />
  <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/style.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/responsive.css') }}" rel="stylesheet" />

  <style>
    .profile_section {
      padding: 70px 0;
    }

    .profile_card {
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 2px 14px rgba(0, 0, 0, 0.1);
      padding: 24px;
    }

    .profile_title {
      margin-bottom: 18px;
      font-weight: 700;
    }

    .avatar_wrap {
      display: flex;
      justify-content: center;
      margin-bottom: 10px;
    }

    .avatar_box {
      position: relative;
      width: 120px;
      height: 120px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid #ffbe33;
      background: #f7f7f7;
    }

    .avatar_img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      cursor: pointer;
    }

    .preset_avatar_block {
      display: none;
      margin-bottom: 20px;
      padding: 18px;
      border: 1px solid #f0e2c1;
      border-radius: 10px;
      background: #fffaf0;
    }

    .preset_avatar_block.is_open {
      display: block;
    }

    .avatar_hint {
      text-align: center;
      color: #666;
      font-size: 14px;
      margin-bottom: 16px;
    }

    .choice_title {
      font-weight: 700;
      margin-bottom: 10px;
      color: #222831;
    }

    .preset_avatar_grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
      gap: 10px;
      margin-bottom: 12px;
    }

    .preset_avatar_btn {
      padding: 0;
      border: 2px solid transparent;
      border-radius: 50%;
      background: transparent;
      cursor: pointer;
    }

    .preset_avatar_btn:hover {
      border-color: #ffbe33;
    }

    .preset_avatar_img {
      width: 66px;
      height: 66px;
      border-radius: 50%;
      object-fit: cover;
      display: block;
    }

    .style_preview_grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-top: 12px;
    }

    .style_preview_card {
      border: 1px solid #ececec;
      border-radius: 10px;
      padding: 12px;
      background: #fff;
      text-align: center;
    }

    .style_preview_img {
      width: 100%;
      max-width: 160px;
      aspect-ratio: 1 / 1;
      border-radius: 10px;
      object-fit: cover;
      margin-bottom: 8px;
      border: 1px solid #f0f0f0;
    }

    .style_name {
      text-transform: capitalize;
      margin-bottom: 8px;
      font-weight: 600;
      color: #222831;
    }

    .action_btn {
      min-width: 150px;
      border-radius: 30px;
      font-weight: 600;
    }

    .upload_block {
      background: #fff;
      border: 1px solid #ececec;
      border-radius: 10px;
      padding: 12px;
      margin-top: 14px;
    }

    .upload_block .form-control {
      border-radius: 8px;
    }

    .choice_divider {
      margin: 16px 0;
      border-color: #ead8ac;
    }

    .profile_item {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding: 10px 0;
      border-bottom: 1px solid #f0f0f0;
    }

    .profile_item:last-child {
      border-bottom: none;
    }

    .profile_label {
      color: #666;
      font-weight: 600;
    }

    .profile_value {
      color: #1a1a1a;
      text-align: right;
      word-break: break-word;
    }

    .passkey_block {
      border: 1px solid #ececec;
      border-radius: 10px;
      padding: 14px;
      background: #fafafa;
      margin-bottom: 18px;
    }

    .passkey_list {
      margin-top: 12px;
      display: grid;
      gap: 10px;
    }

    .passkey_item {
      background: #fff;
      border: 1px solid #ececec;
      border-radius: 10px;
      padding: 12px;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
    }

    .passkey_meta {
      font-size: 13px;
      color: #666;
      margin-top: 2px;
    }
  </style>
</head>

<body class="sub_page">

  <div class="hero_area">
    <div class="bg-box">
      <img src="{{ asset('front/images/hero-bg.jpg') }}" alt="">
    </div>
    <header class="header_section">
      <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
          <a class="navbar-brand" href="{{ path('front_home') }}">
            <span>Feane</span>
          </a>

          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class=""> </span>
          </button>

          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav  mx-auto ">
              <li class="nav-item"><a class="nav-link" href="{{ path('front_home') }}">Home</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_menu') }}">Menu</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_about') }}">About</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_book') }}">Book Table</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_gallery') }}">Gallery</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('forum_index') }}">Forum</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_evenements_index') }}">Events</a></li>
            </ul>
            <div class="user_option">
              <a href="{{ path('front_profile') }}" class="user_link profile_link">
                <i class="fa fa-user" aria-hidden="true"></i>
                <span class="profile_name">{{ app.user.username }}</span>
              </a>
              <a href="{{ path('app_logout') }}" class="auth_btn auth_btn--danger">Logout</a>
            </div>
          </div>
        </nav>
      </div>
    </header>
  </div>

  <section class="profile_section">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="profile_card">
            <h3 class="profile_title">My Profile</h3>

            {% for message in app.flashes('success') %}
              <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('danger') %}
              <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}

            <div class="avatar_wrap">
              <form id="avatarForm" method="post" enctype="multipart/form-data">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_avatar_update') }}">
                <div class="avatar_box">
                  {% set raw_avatar = profile_user.avatarUrl|default('') %}
                  {% set avatar_src = raw_avatar ? ((raw_avatar starts with('http://') or raw_avatar starts with('https://') or raw_avatar starts with('/')) ? raw_avatar : asset(raw_avatar)) : asset('front/images/client1.jpg') %}
                  <img id="avatarImageTrigger" class="avatar_img" src="{{ avatar_src }}" alt="Profile picture" title="Change picture" onerror="this.onerror=null;this.src='{{ asset('front/images/client1.jpg') }}';">
                </div>
              </form>
            </div>
            <div class="avatar_hint">Click the picture to change your avatar</div>

            <div class="preset_avatar_block" id="avatarChoices">
              <div class="choice_title">Choose one of the existing avatars</div>
              <div class="preset_avatar_grid">
                {% for avatar_path in preset_avatars %}
                  <form method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_avatar_update') }}">
                    <input type="hidden" name="preset_avatar" value="{{ avatar_path }}">
                    <button type="submit" class="preset_avatar_btn" title="Use this avatar">
                      <img src="{{ asset(avatar_path) }}" alt="Preset avatar" class="preset_avatar_img">
                    </button>
                  </form>
                {% endfor %}
              </div>

              <div class="upload_block">
                <form method="post" enctype="multipart/form-data">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_avatar_update') }}">
                  <div class="form-group mb-2">
                    <label>Or upload from your computer</label>
                    <input type="file" name="avatar" class="form-control" accept="image/png,image/jpeg,image/webp" required>
                  </div>
                  <button type="submit" class="btn btn-warning btn-sm action_btn">Upload Avatar</button>
                </form>
              </div>

              <hr class="choice_divider">
              <div class="choice_title">Generate a stylized avatar</div>

              <div class="upload_block">
                <form method="post" enctype="multipart/form-data">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_avatar_update') }}">
                  <div class="form-group mb-2">
                    <label>Upload your photo</label>
                    <input type="file" name="stylize_source" class="form-control" accept="image/png,image/jpeg,image/webp" required>
                  </div>
                  <div class="form-group mb-2">
                    <label>Style</label>
                    <select name="stylize_style" class="form-control" required>
                      <option value="anime">Anime</option>
                      <option value="comic">Comic</option>
                      <option value="pixar">Pixar-like</option>
                    </select>
                  </div>
                  <button type="submit" class="btn btn-dark btn-sm action_btn">Generate Style</button>
                </form>
              </div>

              {% if stylized_avatar_options is not empty %}
                <div class="choice_title" style="margin-top: 16px;">Generated styles</div>
                <div class="style_preview_grid">
                  {% for style_name, style_path in stylized_avatar_options %}
                    <div class="style_preview_card">
                      <img src="{{ asset(style_path) }}" alt="{{ style_name }} avatar" class="style_preview_img">
                      <div class="style_name">{{ style_name }}</div>
                      <form method="post">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_avatar_update') }}">
                        <input type="hidden" name="stylized_avatar" value="{{ style_path }}">
                        <button type="submit" class="btn btn-success btn-sm action_btn">Use This Style</button>
                      </form>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>

            <div style="margin-bottom: 24px;">
              <a href="{{ path('front_profile_edit') }}" class="btn btn-warning">Modify Profile</a>
            </div>

            <div class="passkey_block">
              <div class="d-flex flex-wrap justify-content-between align-items-center">
                <div>
                  <strong>Passkey Login</strong>
                  <div style="font-size: 13px; color: #666;">Registered passkeys: {{ passkey_count|default(0) }}</div>
                </div>
                <div class="d-flex gap-2 mt-2 mt-sm-0">
                  <button type="button" class="btn btn-dark btn-sm" id="registerPasskeyBtn">Add This Device</button>
                  <button type="button" class="btn btn-outline-dark btn-sm" id="registerPhonePasskeyBtn">Add iPhone/Android</button>
                </div>
              </div>

              {% if passkeys is not empty %}
                <div class="passkey_list">
                  {% for passkey in passkeys %}
                    <div class="passkey_item">
                      <div>
                        <div><strong>{{ passkey.label ?: 'Unnamed device' }}</strong></div>
                        <div class="passkey_meta">
                          Last used:
                          {{ passkey.lastUsedAt ? passkey.lastUsedAt|date('Y-m-d H:i') : 'Never' }}
                          {% if passkey.transports %}
                            | Transport: {{ passkey.transports }}
                          {% endif %}
                        </div>
                      </div>
                      <form method="post" action="{{ path('app_passkey_remove', {id: passkey.id}) }}" onsubmit="return confirm('Remove this passkey?');">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('remove_passkey_' ~ passkey.id) }}">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                      </form>
                    </div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>

            <div class="profile_item">
              <span class="profile_label">Username</span>
              <span class="profile_value">{{ profile_user.username }}</span>
            </div>
            <div class="profile_item">
              <span class="profile_label">Email</span>
              <span class="profile_value">{{ profile_user.email }}</span>
            </div>
            <div class="profile_item">
              <span class="profile_label">Phone</span>
              <span class="profile_value">{{ profile_user.phone ?: 'Not set' }}</span>
            </div>
            <div class="profile_item">
              <span class="profile_label">Account Type</span>
              <span class="profile_value">{{ account_type }}</span>
            </div>
            <div class="profile_item">
              <span class="profile_label">Account Status</span>
              <span class="profile_value">{{ profile_user.status.value }}</span>
            </div>
            <div class="profile_item">
              <span class="profile_label">Created At</span>
              <span class="profile_value">{{ profile_user.createdAt ? profile_user.createdAt|date('Y-m-d H:i') : 'N/A' }}</span>
            </div>

            {% for label, value in extra_fields %}
              <div class="profile_item">
                <span class="profile_label">{{ label }}</span>
                <span class="profile_value">{{ value }}</span>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>

  <script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
  <script src="{{ asset('front/js/bootstrap.js') }}"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
  <script src="{{ asset('front/js/custom.js') }}"></script>
  <script>
    function ensurePasskeyCompatibleOrigin() {
      if (window.location.hostname === '127.0.0.1') {
        const target = window.location.href.replace('://127.0.0.1', '://localhost');
        window.location.replace(target);
        return false;
      }
      return true;
    }

    function base64UrlToArrayBuffer(base64url) {
      const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
      const pad = '='.repeat((4 - (base64.length % 4)) % 4);
      const binary = atob(base64 + pad);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i += 1) {
        bytes[i] = binary.charCodeAt(i);
      }
      return bytes.buffer;
    }

    function arrayBufferToBase64Url(buffer) {
      const bytes = new Uint8Array(buffer);
      let binary = '';
      bytes.forEach((b) => { binary += String.fromCharCode(b); });
      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    async function registerPasskey(mode) {
      if (!ensurePasskeyCompatibleOrigin()) {
        return;
      }

      if (!window.PublicKeyCredential || !navigator.credentials) {
        alert('Passkeys are not supported on this browser.');
        return;
      }

      try {
        const optionsRes = await fetch('{{ path('app_passkey_register_options') }}', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mode: mode || 'device' })
        });
        const optionsData = await optionsRes.json();
        if (!optionsRes.ok) {
          throw new Error(optionsData.error || 'Could not start passkey registration.');
        }

        const publicKey = optionsData.publicKey;
        publicKey.challenge = base64UrlToArrayBuffer(publicKey.challenge);
        if (publicKey.user && publicKey.user.id) {
          publicKey.user.id = base64UrlToArrayBuffer(publicKey.user.id);
        }
        if (Array.isArray(publicKey.excludeCredentials)) {
          publicKey.excludeCredentials = publicKey.excludeCredentials.map((cred) => ({
            ...cred,
            id: base64UrlToArrayBuffer(cred.id)
          }));
        }

        const credential = await navigator.credentials.create({ publicKey: publicKey });
        if (!credential) {
          throw new Error('No passkey credential returned.');
        }

        const verifyPayload = {
          id: credential.id,
          rawId: arrayBufferToBase64Url(credential.rawId),
          type: credential.type,
          response: {
            clientDataJSON: arrayBufferToBase64Url(credential.response.clientDataJSON),
            attestationObject: arrayBufferToBase64Url(credential.response.attestationObject)
          },
          transports: credential.response.getTransports ? credential.response.getTransports() : []
        };

        const defaultLabel = mode === 'phone' ? 'My iPhone/Android' : 'My device';
        const labelInput = prompt('Device label (optional). Example: ' + defaultLabel);
        if (labelInput && labelInput.trim().length > 0) {
          verifyPayload.label = labelInput.trim().slice(0, 120);
        }

        const verifyRes = await fetch('{{ path('app_passkey_register_verify') }}', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(verifyPayload)
        });
        const verifyData = await verifyRes.json();
        if (!verifyRes.ok || !verifyData.ok) {
          throw new Error(verifyData.error || 'Passkey registration failed.');
        }

        alert('Passkey registered successfully.');
        window.location.reload();
      } catch (error) {
        alert(error.message || 'Passkey registration failed.');
      }
    }

    const registerPasskeyBtn = document.getElementById('registerPasskeyBtn');
    if (registerPasskeyBtn) {
      registerPasskeyBtn.addEventListener('click', function () { registerPasskey('device'); });
    }

    const registerPhonePasskeyBtn = document.getElementById('registerPhonePasskeyBtn');
    if (registerPhonePasskeyBtn) {
      registerPhonePasskeyBtn.addEventListener('click', function () { registerPasskey('phone'); });
    }

    document.getElementById('avatarImageTrigger').addEventListener('click', function () {
      var choices = document.getElementById('avatarChoices');
      if (!choices) {
        return;
      }
      choices.classList.toggle('is_open');
      if (choices.classList.contains('is_open')) {
        choices.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  </script>
</body>

</html>
