{% extends 'front/layout.html.twig' %}

{% block title %}Pegasus | Profile{% endblock %}
{% set active_nav = 'home' %}

{% block extra_styles %}
  <style>
    .profile-shell { padding: 44px 0 72px; }
    .profile-grid { display: grid; gap: 18px; }
    .profile-card {
      background: #fff;
      border: 1px solid #dbe5ef;
      border-radius: 20px;
      box-shadow: 0 10px 28px rgba(15, 23, 42, 0.09);
      padding: 24px;
    }
    .profile-head h1 { font-size: 1.7rem; margin: 0; color: var(--pg-text,#111827); font-weight: 800; }
    .profile-head p { margin: 8px 0 0; color: var(--pg-text-muted,#6b7280); font-size: 0.9rem; }
    .avatar-wrap { display: flex; flex-direction: column; align-items: center; margin-top: 16px; }
    .avatar-box { width: 120px; height: 120px; border-radius: 50%; overflow: hidden; border: 3px solid var(--pg-gold,#f9c23c); background: #f8faff; cursor: pointer; }
    .avatar-img { width: 100%; height: 100%; object-fit: cover; }
    .avatar-hint { margin-top: 10px; color: var(--pg-text-muted,#6b7280); font-size: 0.85rem; }
    .profile-actions { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 10px; }
    .pbtn { border-radius: 20px; padding: 9px 18px; font-weight: 700; border: 1px solid transparent; display: inline-flex; align-items: center; gap: 8px; font-size: .875rem; transition: all .18s; }
    .pbtn--primary { background: var(--pg-gold,#f9c23c); color: #111; border-color: var(--pg-gold,#f9c23c); }
    .pbtn--primary:hover { background: var(--pg-gold-dark,#e6a800); color: #111; }
    .pbtn--soft { background: #fff; border-color: #dbe5ef; color: #374151; }
    .pbtn--soft:hover { background: #f4f6fb; }
    .pbtn--danger { background: #fff; border-color: #fca5a5; color: #991b1b; }
    .pbtn--danger:hover { background: #fee2e2; }
    .flash { border-radius: 12px; padding: 10px 14px; font-size: 0.9rem; margin-top: 10px; }
    .flash-success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .flash-danger { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
    .kv { display: grid; gap: 10px; margin-top: 4px; }
    .kv-item { display: flex; justify-content: space-between; gap: 10px; border-bottom: 1px solid #f1f5f9; padding-bottom: 10px; }
    .kv-item:last-child { border-bottom: none; }
    .kv-label { font-weight: 600; color: var(--pg-text-muted,#6b7280); font-size: .875rem; }
    .kv-value { color: var(--pg-text,#111827); text-align: right; word-break: break-word; font-weight: 500; }
    .section-title { font-size: 1.05rem; font-weight: 700; color: var(--pg-text,#111827); margin: 0 0 12px; display: flex; align-items: center; gap: 8px; }
    .section-title::before { content:''; display:inline-block; width:3px; height:16px; background:var(--pg-gold,#f9c23c); border-radius:2px; }
    .choice-block { display: none; margin-top: 14px; border: 1px solid #fde68a; border-radius: 14px; padding: 16px; background: #fef9c3; }
    .choice-block.is_open { display: block; }
    .choice-title { font-weight: 700; color: #92660a; margin: 0 0 8px; }
    .avatar-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 10px; }
    .avatar-btn { padding: 0; border: 2px solid transparent; border-radius: 999px; background: transparent; transition: border-color .18s; }
    .avatar-btn:hover { border-color: var(--pg-gold,#f9c23c); }
    .avatar-pic { width: 68px; height: 68px; border-radius: 50%; object-fit: cover; display: block; }
    .mini-form { background: #f8faff; border: 1px solid #dbe5ef; border-radius: 12px; padding: 14px; margin-top: 10px; }
    .mini-form .form-control { border-radius: 10px; border-color: #dbe5ef; }
    .style-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-top: 10px; }
    .style-card { background: #fff; border: 1px solid #dbe5ef; border-radius: 12px; padding: 12px; text-align: center; }
    .style-img { width: 100%; max-width: 160px; aspect-ratio: 1 / 1; border-radius: 10px; object-fit: cover; margin-bottom: 8px; border: 1px solid #dbe5ef; }
    .passkey-item { background: #f8faff; border: 1px solid #dbe5ef; border-radius: 12px; padding: 12px; display: flex; justify-content: space-between; gap: 10px; align-items: center; margin-top: 8px; }
    .passkey-meta { color: var(--pg-text-muted,#6b7280); font-size: 0.82rem; }
  </style>
{% endblock %}

{% block body %}
  <section class="profile-shell">
    <div class="container">
      <div class="profile-grid">
        <div class="profile-card">
          <div class="profile-head">
            <h1>My Profile</h1>
            <p>Manage your account details, avatar, and passkeys.</p>
          </div>

          {% for message in app.flashes('success') %}<div class="flash flash-success">{{ message }}</div>{% endfor %}
          {% for message in app.flashes('danger') %}<div class="flash flash-danger">{{ message }}</div>{% endfor %}

          <div class="avatar-wrap">
            {% set raw_avatar = profile_user.avatarUrl|default('') %}
            {% set avatar_src = raw_avatar ? ((raw_avatar starts with('http://') or raw_avatar starts with('https://') or raw_avatar starts with('/')) ? raw_avatar : asset(raw_avatar)) : asset('front/images/client1.jpg') %}
            <div class="avatar-box" id="avatarImageTrigger" title="Change picture">
              <img class="avatar-img" src="{{ avatar_src }}" alt="Profile picture" onerror="this.onerror=null;this.src='{{ asset('front/images/client1.jpg') }}';">
            </div>
            <div class="avatar-hint">Click avatar to open customization</div>
          </div>

          <div class="choice-block" id="avatarChoices">
            <p class="choice-title">Choose an existing avatar</p>
            <div class="avatar-grid">
              {% for avatar_path in preset_avatars %}
                <form method="post">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_avatar_update') }}">
                  <input type="hidden" name="preset_avatar" value="{{ avatar_path }}">
                  <button type="submit" class="avatar-btn" title="Use this avatar"><img src="{{ asset(avatar_path) }}" alt="Preset avatar" class="avatar-pic"></button>
                </form>
              {% endfor %}
            </div>

            <div class="mini-form">
              <form method="post" enctype="multipart/form-data">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_avatar_update') }}">
                <label>Or upload from your computer</label>
                <input type="file" name="avatar" class="form-control mb-2" accept="image/png,image/jpeg,image/webp" required>
                <button type="submit" class="pbtn pbtn--soft">Upload Avatar</button>
              </form>
            </div>

            <hr>
            <p class="choice-title">Generate a stylized avatar</p>
            <div class="mini-form">
              <form method="post" enctype="multipart/form-data">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_avatar_update') }}">
                <label>Upload your photo</label>
                <input type="file" name="stylize_source" class="form-control mb-2" accept="image/png,image/jpeg,image/webp" required>
                <label>Style</label>
                <select name="stylize_style" class="form-control mb-2" required>
                  <option value="anime">Anime</option>
                  <option value="comic">Comic</option>
                  <option value="pixar">Pixar-like</option>
                </select>
                <button type="submit" class="pbtn pbtn--primary">Generate Style</button>
              </form>
            </div>

            {% if stylized_avatar_options is not empty %}
              <p class="choice-title" style="margin-top:12px;">Generated styles</p>
              <div class="style-grid">
                {% for style_name, style_path in stylized_avatar_options %}
                  <div class="style-card">
                    <img src="{{ asset(style_path) }}" alt="{{ style_name }} avatar" class="style-img">
                    <div style="font-weight:600; text-transform:capitalize; margin-bottom:8px;">{{ style_name }}</div>
                    <form method="post">
                      <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_avatar_update') }}">
                      <input type="hidden" name="stylized_avatar" value="{{ style_path }}">
                      <button type="submit" class="pbtn pbtn--soft">Use This Style</button>
                    </form>
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>

          <div class="profile-actions">
            <a href="{{ path('front_profile_edit') }}" class="pbtn pbtn--primary">Modify Profile</a>
            {% if not (is_granted('ROLE_ARTISTE') or is_granted('ROLE_SPONSOR') or is_granted('ROLE_ADMIN')) %}
            <a href="{{ path('role_request_new') }}" class="pbtn pbtn--soft">Request Role Change</a>
            {% endif %}
            <a href="{{ path('role_request_status') }}" class="pbtn pbtn--soft" style="font-size:.88rem;">My Role Requests</a>
          </div>
        </div>

        <div class="profile-card">
          <h2 class="section-title">Passkeys</h2>
          <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div style="color:#5f6f8a; font-size:0.9rem;">Registered passkeys: {{ passkey_count|default(0) }}</div>
            <div class="d-flex gap-2 mt-2 mt-sm-0">
              <button type="button" class="pbtn pbtn--primary" id="registerPasskeyBtn">Add This Device</button>
              <button type="button" class="pbtn pbtn--soft" id="registerPhonePasskeyBtn">Add iPhone/Android</button>
            </div>
          </div>

          {% if passkeys is not empty %}
            {% for passkey in passkeys %}
              <div class="passkey-item">
                <div>
                  <div><strong>{{ passkey.label ?: 'Unnamed device' }}</strong></div>
                  <div class="passkey-meta">
                    Last used: {{ passkey.lastUsedAt ? passkey.lastUsedAt|date('Y-m-d H:i') : 'Never' }}
                    {% if passkey.transports %} | Transport: {{ passkey.transports }}{% endif %}
                  </div>
                </div>
                <form method="post" action="{{ path('app_passkey_remove', {id: passkey.id}) }}" onsubmit="return confirm('Remove this passkey?');">
                  <input type="hidden" name="_csrf_token" value="{{ csrf_token('remove_passkey_' ~ passkey.id) }}">
                  <button type="submit" class="pbtn pbtn--danger">Remove</button>
                </form>
              </div>
            {% endfor %}
          {% endif %}
        </div>

        <div class="profile-card">
          <h2 class="section-title">Account Details</h2>
          <div class="kv">
            <div class="kv-item"><span class="kv-label">Username</span><span class="kv-value">{{ profile_user.username }}</span></div>
            <div class="kv-item"><span class="kv-label">Email</span><span class="kv-value">{{ profile_user.email }}</span></div>
            <div class="kv-item"><span class="kv-label">Phone</span><span class="kv-value">{{ profile_user.phone ?: 'Not set' }}</span></div>
            <div class="kv-item"><span class="kv-label">Account Type</span><span class="kv-value">{{ account_type }}</span></div>
            <div class="kv-item"><span class="kv-label">Account Status</span><span class="kv-value">{{ profile_user.status.value }}</span></div>
            <div class="kv-item"><span class="kv-label">Created At</span><span class="kv-value">{{ profile_user.createdAt ? profile_user.createdAt|date('Y-m-d H:i') : 'N/A' }}</span></div>
            {% for label, value in extra_fields %}
              <div class="kv-item"><span class="kv-label">{{ label }}</span><span class="kv-value">{{ value }}</span></div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>
{% endblock %}

{% block extra_scripts %}
  <script>
    function ensurePasskeyCompatibleOrigin() {
      if (window.location.hostname === '127.0.0.1') {
        const target = window.location.href.replace('://127.0.0.1', '://localhost');
        window.location.replace(target);
        return false;
      }
      return true;
    }

    function base64UrlToArrayBuffer(base64url) {
      const base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
      const pad = '='.repeat((4 - (base64.length % 4)) % 4);
      const binary = atob(base64 + pad);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i += 1) { bytes[i] = binary.charCodeAt(i); }
      return bytes.buffer;
    }

    function arrayBufferToBase64Url(buffer) {
      const bytes = new Uint8Array(buffer);
      let binary = '';
      bytes.forEach((b) => { binary += String.fromCharCode(b); });
      return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    }

    async function registerPasskey(mode) {
      if (!ensurePasskeyCompatibleOrigin()) { return; }
      if (!window.PublicKeyCredential || !navigator.credentials) {
        alert('Passkeys are not supported on this browser.');
        return;
      }

      try {
        const optionsRes = await fetch('{{ path('app_passkey_register_options') }}', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mode: mode || 'device' })
        });
        const optionsData = await optionsRes.json();
        if (!optionsRes.ok) throw new Error(optionsData.error || 'Could not start passkey registration.');

        const publicKey = optionsData.publicKey;
        publicKey.challenge = base64UrlToArrayBuffer(publicKey.challenge);
        if (publicKey.user && publicKey.user.id) publicKey.user.id = base64UrlToArrayBuffer(publicKey.user.id);
        if (Array.isArray(publicKey.excludeCredentials)) {
          publicKey.excludeCredentials = publicKey.excludeCredentials.map((cred) => ({ ...cred, id: base64UrlToArrayBuffer(cred.id) }));
        }

        const credential = await navigator.credentials.create({ publicKey: publicKey });
        if (!credential) throw new Error('No passkey credential returned.');

        const verifyPayload = {
          id: credential.id,
          rawId: arrayBufferToBase64Url(credential.rawId),
          type: credential.type,
          response: {
            clientDataJSON: arrayBufferToBase64Url(credential.response.clientDataJSON),
            attestationObject: arrayBufferToBase64Url(credential.response.attestationObject)
          },
          transports: credential.response.getTransports ? credential.response.getTransports() : []
        };

        const defaultLabel = mode === 'phone' ? 'My iPhone/Android' : 'My device';
        const labelInput = prompt('Device label (optional). Example: ' + defaultLabel);
        if (labelInput && labelInput.trim().length > 0) verifyPayload.label = labelInput.trim().slice(0, 120);

        const verifyRes = await fetch('{{ path('app_passkey_register_verify') }}', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(verifyPayload)
        });
        const verifyData = await verifyRes.json();
        if (!verifyRes.ok || !verifyData.ok) throw new Error(verifyData.error || 'Passkey registration failed.');

        alert('Passkey registered successfully.');
        window.location.reload();
      } catch (error) {
        alert(error.message || 'Passkey registration failed.');
      }
    }

    const registerPasskeyBtn = document.getElementById('registerPasskeyBtn');
    if (registerPasskeyBtn) registerPasskeyBtn.addEventListener('click', function () { registerPasskey('device'); });

    const registerPhonePasskeyBtn = document.getElementById('registerPhonePasskeyBtn');
    if (registerPhonePasskeyBtn) registerPhonePasskeyBtn.addEventListener('click', function () { registerPasskey('phone'); });

    const trigger = document.getElementById('avatarImageTrigger');
    if (trigger) {
      trigger.addEventListener('click', function () {
        var choices = document.getElementById('avatarChoices');
        if (!choices) return;
        choices.classList.toggle('is_open');
        if (choices.classList.contains('is_open')) choices.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }
  </script>
{% endblock %}
