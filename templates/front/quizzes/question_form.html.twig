<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

  <link rel="shortcut icon" href="{{ asset('front/images/favicon.png') }}" type="">
  <title>{{ mode == 'edit' ? 'Edit Question' : 'Add Question' }}</title>

  <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
  <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/style.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/responsive.css') }}" rel="stylesheet" />

  <style>
    .form-shell { padding: 60px 0; }

    .glass-card{
      background: rgba(255,255,255,.92);
      border-radius: 22px;
      box-shadow: 0 12px 35px rgba(0,0,0,.10);
      border: 1px solid rgba(0,0,0,.06);
      overflow: hidden;
    }

    .glass-head{
      padding: 18px 22px;
      border-bottom: 1px solid rgba(0,0,0,.08);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }

    .glass-head h3{
      margin:0;
      font-weight:900;
      letter-spacing:.3px;
    }

    .btn-feane{
      background:#f5b301;
      border:none;
      color:#111;
      font-weight:800;
      border-radius:14px;
      padding:10px 18px;
      display:inline-flex;
      gap:10px;
      align-items:center;
      box-shadow: 0 10px 18px rgba(245,179,1,.18);
    }
    .btn-feane:hover{ filter:brightness(.98); }

    .btn-soft{
      background:#1d1d1d;
      border:none;
      color:#fff;
      font-weight:700;
      border-radius:14px;
      padding:10px 18px;
      display:inline-flex;
      gap:10px;
      align-items:center;
    }
    .btn-soft:hover{ filter:brightness(1.05); color:#fff; }

    .hint{
      font-size: 13px;
      color: rgba(0,0,0,.55);
      margin-top: 6px;
    }

    .choice-item{
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 16px;
      padding: 14px 16px;
      margin-bottom: 10px;
      background: rgba(255,255,255,.75);
    }

    .remove-choice{
      border-radius: 12px;
      padding: 8px 12px;
      font-weight: 700;
    }

    .add-choice{
      border-radius: 12px;
      padding: 10px 14px;
      font-weight: 800;
    }

    .top-actions a{
      white-space:nowrap;
    }
  </style>
</head>

<body class="sub_page">

  <div class="hero_area">
    <div class="bg-box">
      <img src="{{ asset('front/images/hero-bg.jpg') }}" alt="">
    </div>

    <header class="header_section">
      <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
          <a class="navbar-brand" href="{{ path('front_home') }}"><span>Feane</span></a>

          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent">
            <span class=""></span>
          </button>

          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mx-auto">
              <li class="nav-item"><a class="nav-link" href="{{ path('front_home') }}">Home</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_menu') }}">Menu</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_about') }}">About</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_book') }}">Book Table</a></li>
              <li class="nav-item active"><a class="nav-link" href="{{ path('artist_dashboard', {tab:'quizzes'}) }}">Artist Dashboard</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('app_courses') }}">Courses</a></li>
            </ul>
          </div>
        </nav>
      </div>
    </header>
  </div>

  <section class="form-shell">
    <div class="container">
      <div class="heading_container heading_center mb-4">
        <h2>{{ mode == 'edit' ? 'Edit Question' : 'Add Question' }}</h2>
        <p class="text-muted mb-0">Quiz: <strong>{{ quiz.title }}</strong></p>
      </div>

      <div class="glass-card">
        <div class="glass-head">
          <h3>Question & Choices</h3>

          <div class="top-actions d-flex gap-2">
            <a class="btn-soft" href="{{ path('artist_quizzes_builder', {'id': quiz.id}) }}">
              ← Back to Builder
            </a>
          </div>
        </div>

        <div class="p-4">
          {{ form_start(form) }}

          {# show global errors (ex: "at least 2 choices") #}
          {{ form_errors(form) }}

          <div class="row">
            <div class="col-lg-8">
              {{ form_row(form.questionText) }}
            </div>
            <div class="col-lg-2">
              {{ form_row(form.points) }}
            </div>
            <div class="col-lg-2">
              {{ form_row(form.orderIndex) }}
            </div>
          </div>

          <hr class="my-4">

          <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Choices</h5>
            <button type="button" class="btn btn-outline-primary add-choice" id="add-choice-btn">
              + Add Choice
            </button>
          </div>
          <div class="hint mb-3">Minimum 2 choices. Select 1 correct choice.</div>

          <div id="choices"
               data-prototype="{{ form_widget(form.quizChoices.vars.prototype)|e('html_attr') }}">
            {% for choiceForm in form.quizChoices %}
              <div class="choice-item">
                <div class="row align-items-center">
                  <div class="col-lg-8">
                    {{ form_row(choiceForm.label) }}
                  </div>
                  <div class="col-lg-2">
                    {{ form_row(choiceForm.isCorrect) }}
                  </div>
                  <div class="col-lg-2 text-lg-right">
                    <button type="button" class="btn btn-sm btn-outline-danger remove-choice remove-choice-btn">
                      Remove
                    </button>
                  </div>
                </div>
                {{ form_errors(choiceForm) }}
              </div>
            {% endfor %}
          </div>

          <div class="d-flex gap-2 mt-4">
            <button class="btn-feane" type="submit">💾 {{ mode == 'edit' ? 'Save Changes' : 'Save Question' }}</button>
            <a class="btn-soft" href="{{ path('artist_quizzes_builder', {'id': quiz.id}) }}">Cancel</a>
          </div>

          {# IMPORTANT: render hidden fields (CSRF token) #}
          {{ form_rest(form) }}
          {{ form_end(form, { render_rest: false }) }}
        </div>
      </div>
    </div>
  </section>

  <script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
  <script src="{{ asset('front/js/bootstrap.js') }}"></script>

  <script>
  (function () {
    const holder = document.getElementById('choices');
    const addBtn = document.getElementById('add-choice-btn');
    if (!holder || !addBtn) return;

    let index = holder.querySelectorAll('.choice-item').length;
    const prototype = holder.getAttribute('data-prototype');

    function bindRemove(btn) {
      btn.addEventListener('click', () => {
        const item = btn.closest('.choice-item');
        if (item) item.remove();
      });
    }

    holder.querySelectorAll('.remove-choice-btn').forEach(bindRemove);

    addBtn.addEventListener('click', () => {
      const html = prototype.replace(/__name__/g, index);
      index++;

      const wrapper = document.createElement('div');
      wrapper.className = 'choice-item';
      wrapper.innerHTML = `
        <div class="row align-items-center">
          <div class="col-lg-8">${html}</div>
          <div class="col-lg-4 text-lg-right mt-2 mt-lg-0">
            <button type="button" class="btn btn-sm btn-outline-danger remove-choice-btn">Remove</button>
          </div>
        </div>
      `;

      holder.appendChild(wrapper);
      bindRemove(wrapper.querySelector('.remove-choice-btn'));
    });
  })();
  </script>
</body>
</html>