<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

  <link rel="shortcut icon" href="{{ asset('front/images/favicon.png') }}" type="">
  <title>Create Quiz</title>

  <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
  <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/style.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/responsive.css') }}" rel="stylesheet" />
  <style>
  .form-shell { padding: 60px 0; }

  .glass-card{
    background: rgba(255,255,255,.92);
    border-radius: 22px;
    box-shadow: 0 12px 35px rgba(0,0,0,.10);
    border: 1px solid rgba(0,0,0,.06);
    overflow: hidden;
  }

  .glass-head{
    padding: 18px 22px;
    border-bottom: 1px solid rgba(0,0,0,.08);
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
  }

  .glass-head h3{
    margin:0;
    font-weight:900;
    letter-spacing:.3px;
  }

  .glass-body{ padding: 22px; }

  .form-label{ font-weight:800; }
  .form-control, .form-select{
    border-radius: 14px !important;
    padding: 12px 14px;
    border: 1px solid rgba(0,0,0,.12);
    box-shadow: none !important;
  }
  .form-control:focus, .form-select:focus{
    border-color: #ffbe33;
  }

  .btn-feane{
    background:#ffbe33;
    border: none;
    color:#111;
    font-weight:900;
    border-radius: 14px;
    padding: 10px 16px;
  }
  .btn-feane:hover{ filter:brightness(.95); }

  .btn-soft{
    background:#2b2f33;
    border:none;
    color:#fff;
    font-weight:800;
    border-radius:14px;
    padding:10px 16px;
  }

  .hint{
    font-size: 13px;
    color: rgba(0,0,0,.55);
    margin-top: 6px;
  }
</style>
</head>

<body class="sub_page">

  <div class="hero_area">
    <div class="bg-box">
      <img src="{{ asset('front/images/hero-bg.jpg') }}" alt="">
    </div>

    <header class="header_section">
      <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
          <a class="navbar-brand" href="{{ path('front_home') }}"><span>Feane</span></a>

          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent">
            <span class=""></span>
          </button>

          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mx-auto">
              <li class="nav-item"><a class="nav-link" href="{{ path('front_home') }}">Home</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_menu') }}">Menu</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_about') }}">About</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('front_book') }}">Book Table</a></li>
              <li class="nav-item active"><a class="nav-link" href="{{ path('artist_dashboard', {tab:'quizzes'}) }}">Artist Dashboard</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ path('app_courses') }}">Courses</a></li>
            </ul>
          </div>
        </nav>
      </div>
    </header>
  </div>

  <section class="food_section layout_padding form-shell">
  <div class="container">

    <div class="heading_container heading_center mb-4">
      <h2>Create Final Quiz</h2>
      <p class="text-muted mb-0">Create the final quiz for a course (1 quiz per course).</p>
    </div>

    {% for message in app.flashes('success') %}
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    {% endfor %}

    <div class="glass-card">
      <div class="glass-head">
        <h3 class="h5 mb-0">Final Quiz Information</h3>
        <a class="btn-soft" href="{{ path('artist_dashboard', {tab:'quizzes'}) }}">â† Back</a>
      </div>

      <div class="glass-body">
        {{ form_start(form) }}

{{ form_errors(form) }} {# shows global errors #}

<div class="row g-3">
  <div class="col-lg-8">
    {{ form_row(form.course) }}
  </div>

  <div class="col-lg-4">
    {{ form_row(form.passingScore) }}
    <div class="hint">Example: 70 means 70%.</div>
  </div>

  <div class="col-12">
    {{ form_row(form.title) }}
  </div>

  <div class="col-lg-6">
    {{ form_row(form.timeLimitMin) }} {# âœ… correct name #}
  </div>

  <div class="col-lg-6">
    {{ form_row(form.attemptLimit) }}
  </div>
</div>

<div class="d-flex gap-2 mt-4">
  <button class="btn-feane" type="submit">ðŸ’¾ Save</button>
  <a class="btn-soft" href="{{ path('artist_dashboard', {tab:'quizzes'}) }}">Cancel</a>
</div>

{{ form_end(form) }}
      </div>
    </div>

  </div>
</section>

  <script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
  <script src="{{ asset('front/js/bootstrap.js') }}"></script>
  <script src="{{ asset('front/js/custom.js') }}"></script>
</body>
</html>
