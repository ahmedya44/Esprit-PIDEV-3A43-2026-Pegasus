{% extends 'front/layout.html.twig' %}

{% block title %}Pegasus | Creative Platform{% endblock %}
{% block body_class %}home_page{% endblock %}
{% set active_nav = 'home' %}

{% block extra_styles %}
<style>
/* ── Layout shell ───────────────────────────── */
.lp-shell { padding: 0; }

/* ── Hero ───────────────────────────────────── */
.lp-hero {
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #111827 100%);
  padding: 72px 0 80px;
  position: relative;
  overflow: hidden;
}
.lp-hero::before {
  content: '';
  position: absolute;
  top: -120px; right: -120px;
  width: 480px; height: 480px;
  background: radial-gradient(circle, rgba(249,194,60,.13) 0%, transparent 65%);
  border-radius: 50%;
  pointer-events: none;
}
.lp-hero::after {
  content: '';
  position: absolute;
  bottom: -80px; left: -80px;
  width: 320px; height: 320px;
  background: radial-gradient(circle, rgba(15,118,110,.10) 0%, transparent 65%);
  border-radius: 50%;
  pointer-events: none;
}

.lp-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #f9c23c;
  background: rgba(249,194,60,.10);
  border: 1px solid rgba(249,194,60,.28);
  border-radius: 999px;
  padding: 5px 14px;
  margin-bottom: 20px;
}
.lp-eyebrow::before { content: ''; display: inline-block; width: 6px; height: 6px; background: #f9c23c; border-radius: 50%; }

.lp-h1 {
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  font-weight: 900;
  line-height: 1.08;
  color: #f9fafb;
  margin-bottom: 20px;
}
.lp-h1 span { color: #f9c23c; }

.lp-lead {
  font-size: 1.05rem;
  color: #94a3b8;
  line-height: 1.7;
  max-width: 520px;
  margin-bottom: 32px;
}

.lp-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 999px;
  padding: 6px 14px;
  font-size: .82rem;
  color: #94a3b8;
  margin-bottom: 24px;
}
.lp-status-pill .dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34,197,94,.25);
}
.lp-status-pill.guest .dot { background: #6b7280; box-shadow: none; }

.lp-cta { display: flex; flex-wrap: wrap; gap: 12px; }

.lp-btn {
  border-radius: 24px;
  padding: 12px 26px;
  font-weight: 800;
  font-size: .9rem;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: transform .18s, box-shadow .18s, background .18s;
  text-decoration: none;
}
.lp-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(0,0,0,.25); }
.lp-btn-gold { background: #f9c23c; color: #111; border: none; }
.lp-btn-gold:hover { background: #e6a800; color: #111; }
.lp-btn-ghost { background: rgba(255,255,255,.07); color: rgba(255,255,255,.82); border: 1px solid rgba(255,255,255,.18); }
.lp-btn-ghost:hover { background: rgba(249,194,60,.12); color: #f9c23c; border-color: rgba(249,194,60,.4); }

/* Metrics panel */
.lp-metrics-panel {
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 20px;
  padding: 20px;
  backdrop-filter: blur(8px);
}
.lp-metrics-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}
.lp-metrics-spark {
  width: 32px; height: 32px;
  border-radius: 10px;
  background: linear-gradient(135deg, #f9c23c, #e6a800);
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; color: #111;
}
.lp-metrics-title { font-weight: 700; color: #f1f5f9; font-size: .95rem; }
.lp-metrics-sub { font-size: .75rem; color: #64748b; }

.lp-metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.lp-metric {
  border-radius: 14px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.lp-metric--gold { background: rgba(249,194,60,.12); border: 1px solid rgba(249,194,60,.22); }
.lp-metric--teal { background: rgba(15,118,110,.12); border: 1px solid rgba(15,118,110,.22); }
.lp-metric--rose { background: rgba(244,63,94,.08); border: 1px solid rgba(244,63,94,.18); }
.lp-metric--ink  { background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.10); }
.lp-metric-num { font-size: 1.8rem; font-weight: 900; color: #f1f5f9; line-height: 1; }
.lp-metric--gold .lp-metric-num { color: #f9c23c; }
.lp-metric--teal .lp-metric-num { color: #2dd4bf; }
.lp-metric--rose .lp-metric-num { color: #fb7185; }
.lp-metric-label { font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; font-weight: 700; color: #64748b; }

/* ── Section wrapper ────────────────────────── */
.lp-section { padding: 72px 0; }
.lp-section--alt { background: #f8faff; }
.lp-section--dark { background: #0f172a; }

.lp-kicker {
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #0f766e;
  margin-bottom: 6px;
}
.lp-kicker--gold { color: #92660a; }
.lp-kicker--rose { color: #be185d; }

.lp-section-title {
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 800;
  color: #111827;
  margin-bottom: 8px;
  line-height: 1.18;
}
.lp-section--dark .lp-section-title { color: #f1f5f9; }
.lp-section--dark .lp-kicker { color: #2dd4bf; }

.lp-section-sub { color: #6b7280; font-size: 1rem; margin-bottom: 0; }
.lp-section--dark .lp-section-sub { color: #64748b; }

.lp-section-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  font-size: .875rem;
  color: #111827;
  background: #fff;
  border: 1px solid #dbe5ef;
  border-radius: 20px;
  padding: 8px 18px;
  text-decoration: none;
  transition: background .18s, border-color .18s;
  white-space: nowrap;
}
.lp-section-link:hover { background: #fef9c3; border-color: #f9c23c; color: #92660a; }
.lp-section--dark .lp-section-link { background: rgba(255,255,255,.07); border-color: rgba(255,255,255,.14); color: #f1f5f9; }
.lp-section--dark .lp-section-link:hover { background: rgba(249,194,60,.15); border-color: rgba(249,194,60,.4); color: #f9c23c; }

/* ── Feature cards (01–04) ──────────────────── */
.lp-feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 18px;
}
.lp-feature-card {
  background: #fff;
  border: 1px solid #dbe5ef;
  border-radius: 18px;
  padding: 26px 22px;
  box-shadow: 0 6px 20px rgba(15,23,42,.06);
  transition: transform .2s, box-shadow .2s;
}
.lp-feature-card:hover { transform: translateY(-5px); box-shadow: 0 18px 40px rgba(15,23,42,.12); }

.lp-feature-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px; height: 44px;
  border-radius: 14px;
  font-size: 1rem;
  font-weight: 900;
  margin-bottom: 18px;
}
.fn-gold { background: #fef9c3; color: #92660a; border: 1px solid #f9c23c; }
.fn-teal { background: #ccfbf1; color: #0f766e; border: 1px solid #14b8a6; }
.fn-rose { background: #ffe4e6; color: #be185d; border: 1px solid #fb7185; }
.fn-ink  { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }

.lp-feature-title { font-size: 1.15rem; font-weight: 800; color: #111827; margin-bottom: 8px; }
.lp-feature-copy  { font-size: .875rem; color: #6b7280; line-height: 1.6; margin: 0; }

/* ── Why Pegasus detail cards ───────────────── */
.lp-detail-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
}
.lp-detail-card {
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 18px;
  padding: 28px 24px;
  transition: border-color .2s, background .2s;
}
.lp-detail-card:hover { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.16); }

.lp-detail-pill {
  display: inline-block;
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .1em;
  text-transform: uppercase;
  border-radius: 999px;
  padding: 4px 12px;
  margin-bottom: 14px;
}
.pill-teal { background: rgba(15,118,110,.18); color: #2dd4bf; border: 1px solid rgba(45,212,191,.25); }
.pill-gold { background: rgba(249,194,60,.15); color: #f9c23c;  border: 1px solid rgba(249,194,60,.30); }
.pill-rose { background: rgba(244,63,94,.12);  color: #fb7185;  border: 1px solid rgba(251,113,133,.25); }

.lp-detail-title { font-size: 1.1rem; font-weight: 800; color: #f1f5f9; margin-bottom: 10px; }
.lp-detail-copy  { font-size: .875rem; color: #94a3b8; line-height: 1.65; margin: 0; }

/* ── Preview grid (courses / gallery / events) ─ */
.lp-preview-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 18px;
}

/* Course preview card */
.lp-course-card {
  border-radius: 18px;
  overflow: hidden;
  background: #fff;
  border: 1px solid #dbe5ef;
  box-shadow: 0 6px 20px rgba(15,23,42,.07);
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: transform .2s, box-shadow .2s;
  color: inherit;
}
.lp-course-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(15,23,42,.13); color: inherit; }
.lp-course-thumb {
  height: 180px;
  background: #f0f4fb;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.lp-course-thumb img { width: 110px; height: 110px; object-fit: cover; border-radius: 50%; box-shadow: 0 8px 20px rgba(0,0,0,.15); }
.lp-course-body {
  background: #1f2937;
  padding: 16px;
  flex: 1;
  border-radius: 20px 0 0 0;
}
.lp-course-title { font-weight: 800; color: #f9fafb; margin-bottom: 4px; font-size: .95rem; }
.lp-course-price { font-weight: 900; color: #f9c23c; font-size: 1.3rem; }
.lp-course-desc { font-size: .8rem; color: #94a3b8; line-height: 1.5; margin-bottom: 10px; }

/* Art preview card */
.lp-art-card {
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
  border: 1px solid #dbe5ef;
  box-shadow: 0 6px 18px rgba(15,23,42,.07);
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: transform .2s, box-shadow .2s;
  color: inherit;
}
.lp-art-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(15,23,42,.13); color: inherit; }
.lp-art-media { width: 100%; height: 200px; object-fit: cover; }
.lp-art-body { padding: 14px; flex: 1; display: flex; flex-direction: column; }
.lp-art-title { font-weight: 700; color: #111827; margin-bottom: 4px; font-size: .95rem; }
.lp-art-desc  { font-size: .8rem; color: #6b7280; line-height: 1.5; margin: 0; }

/* Event preview card */
.lp-event-card {
  border-radius: 16px;
  overflow: hidden;
  background: rgba(255,255,255,.05);
  border: 1px solid rgba(255,255,255,.10);
  transition: transform .2s, background .2s;
  text-decoration: none;
  color: #f1f5f9;
}
.lp-event-card:hover { transform: translateY(-3px); background: rgba(255,255,255,.09); color: #f9c23c; }
.lp-event-img { width: 100%; height: 180px; object-fit: cover; }
.lp-event-body { padding: 16px; }
.lp-event-title { font-weight: 700; font-size: .95rem; margin-bottom: 6px; }
.lp-event-meta { font-size: .78rem; color: #64748b; display: flex; gap: 10px; flex-wrap: wrap; }
.lp-event-meta i { color: #f9c23c; }
.lp-event-price { margin-top: 10px; font-weight: 900; font-size: 1.1rem; color: #f9c23c; }

/* ── CTA band ───────────────────────────────── */
.lp-cta-band {
  background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
  padding: 64px 0;
  position: relative;
  overflow: hidden;
}
.lp-cta-band::before {
  content: '';
  position: absolute;
  top: -80px; right: -80px;
  width: 360px; height: 360px;
  background: radial-gradient(circle, rgba(249,194,60,.10) 0%, transparent 65%);
  border-radius: 50%;
}
.lp-cta-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 900; color: #f9fafb; margin-bottom: 10px; }
.lp-cta-sub { color: #94a3b8; font-size: 1rem; max-width: 520px; }

/* Empty state */
.lp-empty { text-align: center; padding: 48px 0; color: #9ca3af; font-size: .9rem; }
</style>
{% endblock %}

{% block body %}
<div class="lp-shell">

  {# ═══════════════════ HERO ═══════════════════ #}
  <section class="lp-hero">
    <div class="container">
      <div class="row align-items-center g-4">

        {# Left — headline + CTA #}
        <div class="col-lg-6">
          <div class="lp-eyebrow">Creative campus for art, learning and events</div>

          <h1 class="lp-h1">
            A smoother <span>Pegasus</span>,<br>alive with fresh previews.
          </h1>

          <p class="lp-lead">
            Explore new courses, gallery pieces and upcoming events from one polished home screen.
            Sign in when you are ready to open the full workspace.
          </p>

          {% if app.user %}
            <div class="lp-status-pill mb-4">
              <span class="dot"></span>
              Welcome back, <strong style="color:#f1f5f9;">{{ app.user.username }}</strong>
            </div>
            <div class="lp-cta">
              <a href="{{ path('front_gallery') }}" class="lp-btn lp-btn-gold"><i class="fa fa-image"></i> Open Gallery</a>
              <a href="{{ path('front_profile') }}" class="lp-btn lp-btn-ghost"><i class="fa fa-user"></i> Dashboard</a>
            </div>
          {% else %}
            <div class="lp-status-pill guest mb-4">
              <span class="dot"></span>
              You are not connected.
            </div>
            <div class="lp-cta">
              <a href="{{ path('app_login') }}" class="lp-btn lp-btn-gold"><i class="fa fa-sign-in"></i> Sign In</a>
              <a href="{{ path('app_register') }}" class="lp-btn lp-btn-ghost"><i class="fa fa-user-plus"></i> Create Account</a>
            </div>
          {% endif %}
        </div>

        {# Right — Live metrics panel #}
        <div class="col-lg-6">
          <div class="lp-metrics-panel">
            <div class="lp-metrics-header">
              <div class="lp-metrics-spark"><i class="fa fa-bolt"></i></div>
              <div>
                <div class="lp-metrics-title">Live Preview</div>
                <div class="lp-metrics-sub">Updated from your app data</div>
              </div>
            </div>
            <div class="lp-metric-grid">
              <div class="lp-metric lp-metric--gold">
                <span class="lp-metric-num">{{ course_count }}</span>
                <span class="lp-metric-label">Courses</span>
              </div>
              <div class="lp-metric lp-metric--teal">
                <span class="lp-metric-num">{{ art_count }}</span>
                <span class="lp-metric-label">Artworks</span>
              </div>
              <div class="lp-metric lp-metric--rose">
                <span class="lp-metric-num">{{ event_count }}</span>
                <span class="lp-metric-label">Events</span>
              </div>
              <div class="lp-metric lp-metric--ink">
                <span class="lp-metric-num" style="font-size:1.1rem;margin-top:4px;">Forum</span>
                <span class="lp-metric-label">Community</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {# ═══════════════════ FEATURE CARDS 01–04 ═══════════════════ #}
  <section class="lp-section">
    <div class="container">
      <div class="lp-feature-grid">
        <div class="lp-feature-card">
          <div class="lp-feature-num fn-gold">01</div>
          <div class="lp-feature-title">Learn</div>
          <p class="lp-feature-copy">Compact course previews, clean categories and quick entry to lessons and quizzes.</p>
        </div>
        <div class="lp-feature-card">
          <div class="lp-feature-num fn-teal">02</div>
          <div class="lp-feature-title">Discover</div>
          <p class="lp-feature-copy">Recent artworks from the gallery with visual cards, view counts, likes and comments.</p>
        </div>
        <div class="lp-feature-card">
          <div class="lp-feature-num fn-rose">03</div>
          <div class="lp-feature-title">Connect</div>
          <p class="lp-feature-copy">Events and forum stay one click away for registered members of all roles.</p>
        </div>
        <div class="lp-feature-card">
          <div class="lp-feature-num fn-ink">04</div>
          <div class="lp-feature-title">Grow</div>
          <p class="lp-feature-copy">Artists publish events and upload art; sponsors support them; learners earn certificates.</p>
        </div>
      </div>
    </div>
  </section>

  {# ═══════════════════ COURSES PREVIEW ═══════════════════ #}
  <section class="lp-section lp-section--alt">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
          <div class="lp-kicker lp-kicker--gold">Courses</div>
          <h2 class="lp-section-title mb-1">Fresh learning cards</h2>
          <p class="lp-section-sub">Dive into structured lessons with videos and quizzes.</p>
        </div>
        <a href="{{ path('app_courses') }}" class="lp-section-link">View all courses <i class="fa fa-arrow-right"></i></a>
      </div>

      {% if recent_courses is empty %}
        <div class="lp-empty"><i class="fa fa-graduation-cap fa-2x mb-2"></i><br>No courses published yet.</div>
      {% else %}
        <div class="lp-preview-grid">
          {% for course in recent_courses %}
            <a href="{{ path('course_show', {id: course.id}) }}" class="lp-course-card">
              <div class="lp-course-thumb">
                {% set thumb = course.thumbnailUrl|default('') %}
                {% if thumb %}
                  {% set thumbSrc = (thumb starts with('http://') or thumb starts with('https://') or thumb starts with('/')) ? thumb : asset(thumb) %}
                  <img src="{{ thumbSrc }}" alt="{{ course.title|e }}" onerror="this.onerror=null;this.src='{{ asset('front/images/f1.png') }}';">
                {% else %}
                  <img src="{{ asset('front/images/f1.png') }}" alt="{{ course.title|e }}">
                {% endif %}
              </div>
              <div class="lp-course-body">
                <div class="lp-course-title">{{ course.title }}</div>
                {% if course.description is defined and course.description %}
                  <div class="lp-course-desc">{{ course.description|striptags|u.truncate(80, '...') }}</div>
                {% endif %}
                <div class="lp-course-price">
                  {% if course.price is defined and course.price is not null %}{{ course.price }} DT{% else %}Free{% endif %}
                </div>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  {# ═══════════════════ GALLERY PREVIEW ═══════════════════ #}
  <section class="lp-section">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
          <div class="lp-kicker">Gallery</div>
          <h2 class="lp-section-title mb-1">Recent artwork pulse</h2>
          <p class="lp-section-sub">Artwork from our artists — browse, like and comment.</p>
        </div>
        <a href="{{ path('front_gallery') }}" class="lp-section-link">Open gallery <i class="fa fa-arrow-right"></i></a>
      </div>

      {% if recent_arts is empty %}
        <div class="lp-empty"><i class="fa fa-image fa-2x mb-2"></i><br>No artworks yet.</div>
      {% else %}
        <div class="lp-preview-grid">
          {% for art in recent_arts %}
            {% set imageSrc = art.imageUrl ? ((art.imageUrl starts with('http') or art.imageUrl starts with('/')) ? art.imageUrl : asset('images/products/' ~ art.imageUrl)) : asset('front/images/about-img.png') %}
            <a href="{{ path('art_detail', {id: art.id}) }}" class="lp-art-card">
              <img src="{{ imageSrc }}" alt="{{ art.title|e }}" class="lp-art-media" onerror="this.onerror=null;this.src='{{ asset('front/images/about-img.png') }}';">
              <div class="lp-art-body">
                <div class="lp-art-title">{{ art.title }}</div>
                {% if art.description is defined and art.description %}
                  <p class="lp-art-desc">{{ art.description|striptags|u.truncate(80, '...') }}</p>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>

  {# ═══════════════════ WHY PEGASUS (dark) ═══════════════════ #}
  <section class="lp-section lp-section--dark">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
          <div class="lp-kicker" style="color:#2dd4bf;">Why Pegasus</div>
          <h2 class="lp-section-title" style="color:#f1f5f9;">Designed for creators, learners and collectors</h2>
        </div>
        <a href="{{ path('front_gallery') }}" class="lp-section-link">Explore workspace <i class="fa fa-arrow-right"></i></a>
      </div>

      <div class="lp-detail-grid">
        <div class="lp-detail-card">
          <div class="lp-detail-pill pill-teal">01 – Discover</div>
          <div class="lp-detail-title">A clear hub for everything new</div>
          <p class="lp-detail-copy">Courses, artwork and events sit in one clean feed so the home page feels useful right away.</p>
        </div>
        <div class="lp-detail-card">
          <div class="lp-detail-pill pill-gold">02 – Learn</div>
          <div class="lp-detail-title">Fast access to fresh courses</div>
          <p class="lp-detail-copy">Learning cards show categories and content, then take users directly to the full course workspace with video and quiz.</p>
        </div>
        <div class="lp-detail-card">
          <div class="lp-detail-pill pill-rose">03 – Connect</div>
          <div class="lp-detail-title">Community actions stay close</div>
          <p class="lp-detail-copy">Gallery, forum, events and role-based dashboards make the app feel alive before users open a full section.</p>
        </div>
      </div>
    </div>
  </section>

  {# ═══════════════════ EVENTS PREVIEW ═══════════════════ #}
  {% if recent_events is not empty %}
  <section class="lp-section lp-section--dark" style="padding-top:0;">
    <div class="container">
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
          <div class="lp-kicker" style="color:#f9c23c;">Events</div>
          <h2 class="lp-section-title" style="color:#f1f5f9;">Upcoming highlights</h2>
        </div>
        <a href="{{ path('front_evenements_index') }}" class="lp-section-link">All events <i class="fa fa-arrow-right"></i></a>
      </div>
      <div class="lp-preview-grid">
        {% for ev in recent_events %}
          <a href="{{ path('front_evenements_show', {id: ev.id}) }}" class="lp-event-card">
            {% if ev.image %}
              <img src="{{ asset('uploads/evenements/' ~ ev.image) }}" class="lp-event-img" alt="{{ ev.titre }}">
            {% else %}
              <img src="{{ asset('front/images/about-img.png') }}" class="lp-event-img" alt="{{ ev.titre }}">
            {% endif %}
            <div class="lp-event-body">
              <div class="lp-event-title">{{ ev.titre }}</div>
              <div class="lp-event-meta">
                {% if ev.date %}<span><i class="fa fa-calendar"></i> {{ ev.date|date('d M Y') }}</span>{% endif %}
                <span><i class="fa fa-map-marker"></i> {{ ev.lieu }}</span>
              </div>
              <div class="lp-event-price">{{ ev.prix }} DT</div>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ═══════════════════ CTA BAND ═══════════════════ #}
  <section class="lp-cta-band">
    <div class="container">
      <div class="row align-items-center g-4">
        <div class="col-lg-8">
          <h2 class="lp-cta-title">Ready to unlock the full workspace?</h2>
          <p class="lp-cta-sub">Login opens gallery actions, courses, events, forum and role-based dashboards — all in one place.</p>
        </div>
        <div class="col-lg-4 text-lg-right">
          {% if app.user %}
            <a href="{{ path('front_profile') }}" class="lp-btn lp-btn-gold"><i class="fa fa-th-large"></i> Go to Dashboard</a>
          {% else %}
            <a href="{{ path('app_login') }}" class="lp-btn lp-btn-gold"><i class="fa fa-sign-in"></i> Sign In</a>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

</div>
{% endblock %}
