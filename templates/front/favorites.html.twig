{% extends 'front/layout.html.twig' %}

{% set active_nav = 'favorites' %}

{% block title %}My Favorites{% endblock %}

{% block extra_styles %}
<style>
  .fav-grid-card {
    border: 1px solid #dedede;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    height: 100%;
  }
  .fav-grid-card img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    background: #f1f1f1;
  }
  .fav-grid-body {
    padding: 14px;
  }
  .fav-grid-title {
    font-weight: 700;
    margin-bottom: 6px;
  }
  .fav-grid-desc {
    color: #666;
    font-size: .92rem;
    min-height: 42px;
  }
  .fav-icon-btn {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #ffbe33;
    color: #ffbe33;
    background: transparent;
    cursor: pointer;
  }
  .fav-icon-btn:hover,
  .fav-icon-btn.is-active {
    background: #ffbe33;
    color: #222;
  }
  .fav-empty {
    border: 1px dashed #d4d4d4;
    border-radius: 10px;
    padding: 20px;
    color: #6b7280;
    text-align: center;
    background: #fafafa;
  }
</style>
{% endblock %}

{% block body %}
<section class="forum-shell">
  <div class="container">
    <div class="forum-card">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-1">My Likes & Favorites</h1>
          <p class="text-muted mb-0">Arts you liked or added to favorites.</p>
        </div>
        <a href="{{ path('front_gallery') }}" class="btn btn-warning">Back to Gallery</a>
      </div>

      <h2 class="h5 mb-3">Favorites</h2>
      <div class="row" id="favorites-grid"></div>
      <div class="fav-empty mb-4" id="favorites-empty" style="display:none;">No favorite arts yet.</div>

      <h2 class="h5 mb-3">Liked</h2>
      <div class="row" id="likes-grid"></div>
      <div class="fav-empty" id="likes-empty" style="display:none;">No liked arts yet.</div>
    </div>
  </div>
</section>
{% endblock %}

{% block extra_scripts %}
<script>
  (function () {
    var arts = {{ artCatalog|json_encode|raw }};
    var artsById = {};
    arts.forEach(function (art) {
      artsById[String(art.id)] = art;
    });

    function getLikeState() {
      try { return JSON.parse(localStorage.getItem('gallery_likes') || '{}'); } catch (e) { return {}; }
    }
    function setLikeState(state) {
      localStorage.setItem('gallery_likes', JSON.stringify(state));
    }
    function getFavoriteState() {
      try { return JSON.parse(localStorage.getItem('gallery_favorites') || '{}'); } catch (e) { return {}; }
    }
    function setFavoriteState(state) {
      localStorage.setItem('gallery_favorites', JSON.stringify(state));
    }

    function imageSrc(raw) {
      if (!raw) return '';
      if (raw.indexOf('http') === 0 || raw.indexOf('/') === 0) return raw;
      return '/images/products/' + raw;
    }

    function createCard(art, flags) {
      var col = document.createElement('div');
      col.className = 'col-md-4 mb-4';

      var img = imageSrc(art.imageUrl);
      var safeTitle = String(art.title || 'Artwork');
      var safeDesc = String(art.description || '');
      if (safeDesc.length > 110) safeDesc = safeDesc.slice(0, 110) + '...';

      col.innerHTML = '' +
        '<div class="fav-grid-card">' +
          (img ? '<a href="/art/' + art.id + '"><img src="' + img + '" alt="' + safeTitle.replace(/"/g, '&quot;') + '"></a>' : '<div style="height:210px;background:#f1f1f1;"></div>') +
          '<div class="fav-grid-body">' +
            '<div class="fav-grid-title">' + safeTitle + '</div>' +
            '<div class="fav-grid-desc">' + safeDesc + '</div>' +
            '<div class="mt-3 d-flex justify-content-between align-items-center">' +
              '<div class="d-flex gap-2">' +
                '<button type="button" class="fav-icon-btn js-toggle-favorite ' + (flags.favorite ? 'is-active' : '') + '" data-art-id="' + art.id + '" data-art-title="' + safeTitle.replace(/"/g, '&quot;') + '" title="Favorite"><i class="fa fa-heart"></i></button>' +
                '<button type="button" class="fav-icon-btn js-toggle-like ' + (flags.like ? 'is-active' : '') + '" data-art-id="' + art.id + '" title="Like"><i class="fa fa-thumbs-up"></i></button>' +
              '</div>' +
              '<a class="btn btn-sm btn-outline-secondary" href="/art/' + art.id + '">Details</a>' +
            '</div>' +
          '</div>' +
        '</div>';

      return col;
    }

    function favoriteIdsFromServer() {
      return fetch('/api/favorites')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          if (!data || data.success !== true || !Array.isArray(data.favorites)) {
            return [];
          }
          return data.favorites.map(function (f) { return String(f.art_id); });
        })
        .catch(function () { return []; });
    }

    function render() {
      var likesState = getLikeState();
      var localFavState = getFavoriteState();

      favoriteIdsFromServer().then(function (serverFavIds) {
        var favSet = {};
        serverFavIds.forEach(function (id) { favSet[String(id)] = true; });
        Object.keys(localFavState).forEach(function (id) {
          if (localFavState[id]) favSet[String(id)] = true;
        });

        var likeSet = {};
        Object.keys(likesState).forEach(function (id) {
          if (likesState[id]) likeSet[String(id)] = true;
        });

        var favGrid = document.getElementById('favorites-grid');
        var likesGrid = document.getElementById('likes-grid');
        favGrid.innerHTML = '';
        likesGrid.innerHTML = '';

        var favIds = Object.keys(favSet).filter(function (id) { return !!artsById[id]; });
        var likeIds = Object.keys(likeSet).filter(function (id) { return !!artsById[id]; });

        favIds.forEach(function (id) {
          favGrid.appendChild(createCard(artsById[id], { favorite: true, like: !!likeSet[id] }));
        });
        likeIds.forEach(function (id) {
          likesGrid.appendChild(createCard(artsById[id], { favorite: !!favSet[id], like: true }));
        });

        document.getElementById('favorites-empty').style.display = favIds.length ? 'none' : 'block';
        document.getElementById('likes-empty').style.display = likeIds.length ? 'none' : 'block';

        bindActions();
      });
    }

    function bindActions() {
      document.querySelectorAll('.js-toggle-like').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = String(btn.getAttribute('data-art-id'));
          var likes = getLikeState();
          likes[id] = !likes[id];
          setLikeState(likes);
          render();
        });
      });

      document.querySelectorAll('.js-toggle-favorite').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = String(btn.getAttribute('data-art-id'));
          var title = String(btn.getAttribute('data-art-title') || 'Artwork');
          var fav = getFavoriteState();
          var willAdd = !fav[id];
          var url = willAdd ? '/api/favorites/add' : '/api/favorites/remove';
          var payload = willAdd ? { art_id: parseInt(id, 10), art_title: title } : { art_id: parseInt(id, 10) };

          fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
              if (!data || data.success !== true) return;
              fav[id] = willAdd;
              setFavoriteState(fav);
              render();
            })
            .catch(function () {});
        });
      });
    }

    render();
  })();
</script>
{% endblock %}
