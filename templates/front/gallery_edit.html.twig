{% extends 'front/layout.html.twig' %}

{% set active_nav = 'gallery' %}

{% block title %}Edit Artwork{% endblock %}

{% block body %}
<section class="forum-shell">
  <div class="container">
    <div class="forum-card" style="max-width: 900px; margin: 0 auto;">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Edit Artwork</h1>
        <a href="{{ path('front_gallery') }}" class="btn btn-sm btn-outline-secondary">Back</a>
      </div>

      {% if art.imageUrl %}
        {% set imageSrc = (art.imageUrl starts with('http') or art.imageUrl starts with('/')) ? art.imageUrl : asset('images/products/' ~ art.imageUrl) %}
        <div class="mb-3">
          <img src="{{ imageSrc }}" alt="{{ art.title }}" class="img-fluid rounded" style="max-height:220px;">
        </div>
      {% endif %}

      {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.description) }}
        {{ form_row(form.imageFile) }}
        {% do form.isAiGenerated.setRendered() %}
        {% do form.aiGeneratedImage.setRendered() %}
        {% do form.titleEn.setRendered() %}
        {% do form.descriptionEn.setRendered() %}
        <div class="d-flex gap-2 justify-content-end">
          <a href="{{ path('front_gallery') }}" class="btn btn-outline-dark">Cancel</a>
          <button type="submit" class="btn btn-warning">Update</button>
        </div>
      {{ form_end(form) }}
    </div>
  </div>
</section>
{% endblock %}
