<style>
    @keyframes pulse-opacity {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
    .pulse-effect {
        animation: pulse-opacity 1.5s infinite ease-in-out;
    }
    .premium-form-group ul {
        list-style: none;
        padding-left: 0;
        margin-top: 5px;
        color: #ff4d4d !important;
        font-weight: 600;
        font-size: 0.9rem;
    }
    .premium-form-group ul li {
        margin-bottom: 2px;
    }
</style>

<section class="glass-section layout_padding" style="border-radius: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.5);">
    <div class="form_container p-4">
        {{ form_start(form) }}
            <div class="row">
                <div class="col-md-6">
                    <div class="premium-form-group">
                        {{ form_label(form.titre, 'Titre de l\'événement') }}
                        <div class="input-group">
                            {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Soirée Jazz'}}) }}
                            <div class="input-group-append">
                                <button type="button" id="btn-generate-ai" class="btn btn-warning" style="border-radius: 0 15px 15px 0;">
                                    <i class="fa fa-magic"></i> IA
                                </button>
                            </div>
                        </div>
                        <small id="ai-loading" class="text-info d-none mt-1"><i class="fa fa-spinner fa-spin"></i> Génération en cours...</small>
                        {{ form_errors(form.titre) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="premium-form-group">
                        {{ form_label(form.lieu, 'Lieu') }}
                        {{ form_widget(form.lieu, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Salle Polyvalente'}}) }}
                        {{ form_errors(form.lieu) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="premium-form-group">
                        {{ form_label(form.date, 'Date') }}
                        {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.date) }}
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="premium-form-group">
                        {{ form_label(form.heure, 'Heure') }}
                        {{ form_widget(form.heure, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.heure) }}
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="premium-form-group">
                        {{ form_label(form.description, 'Description') }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Détails de l\'événement...'}}) }}
                        {{ form_errors(form.description) }}
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="premium-form-group">
                        {{ form_label(form.prix, 'Prix (DT)') }}
                        {{ form_widget(form.prix, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.prix) }}
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="premium-form-group">
                        {{ form_label(form.capacite_max, 'Capacité') }}
                        {{ form_widget(form.capacite_max, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.capacite_max) }}
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="premium-form-group">
                        {{ form_label(form.image, 'Image de l\'événement') }}
                        {{ form_widget(form.image) }}
                        {{ form_errors(form.image) }}
                    </div>
                </div>
            </div>
            <div class="btn_box mt-4">
                <button type="submit" class="premium-btn">
                    {{ button_label|default('Enregistrer') }}
                </button>
                <a href="{{ path('front_evenements_index') }}" class="btn btn-outline-light ml-3" style="border-radius: 45px; padding: 10px 45px;">
                    Annuler
                </a>
            </div>
        {{ form_end(form) }}
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const btnGenerate = document.getElementById('btn-generate-ai');
    const loadingInfo = document.getElementById('ai-loading');
    const titleInput = document.querySelector('input[name*="[titre]"]');
    const descInput = document.querySelector('textarea[name*="[description]"]');

    function typeWriter(text, element, speed = 20) {
        element.value = "";
        let i = 0;
        function type() {
            if (i < text.length) {
                element.value += text.charAt(i);
                i++;
                setTimeout(type, speed);
                // Scroll to bottom as it types
                element.scrollTop = element.scrollHeight;
            }
        }
        type();
    }

    if (btnGenerate) {
        btnGenerate.addEventListener('click', async function() {
            const title = titleInput.value;
            if (!title || title.trim().length < 3) {
                alert('Veuillez saisir un titre significatif (min. 3 caractères).');
                return;
            }

            // UI Feedback
            btnGenerate.disabled = true;
            btnGenerate.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';
            loadingInfo.classList.remove('d-none');
            descInput.placeholder = "L'IA réfléchit...";
            descInput.classList.add('pulse-effect'); // Optional CSS class if added later

            try {
                const response = await fetch('{{ path("ai_generate_description") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ title: title })
                });

                const data = await response.json();

                if (data.description) {
                    typeWriter(data.description, descInput);
                } else if (data.error) {
                    alert('Erreur : ' + data.error);
                }
            } catch (error) {
                console.error('AI Generation Error:', error);
                alert('Une erreur est survenue lors de la génération.');
            } finally {
                btnGenerate.disabled = false;
                btnGenerate.innerHTML = '<i class="fa fa-magic"></i> IA';
                loadingInfo.classList.add('d-none');
                descInput.classList.remove('pulse-effect');
                descInput.placeholder = "Détails de l'événement...";
            }
        });
    }
});
</script>

