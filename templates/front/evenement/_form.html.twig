<style>
    .modern-card {
        background: #ffffff;
        border-radius: 40px;
        box-shadow: 0 15px 50px rgba(0,0,0,0.08);
        padding: 50px;
        margin-top: 20px;
    }
    .form-horizontal-group {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
    }
    .form-horizontal-group label {
        width: 200px;
        font-weight: 700;
        color: #2d3436;
        margin-bottom: 0;
        font-size: 1.1rem;
    }
    .form-horizontal-group .input-wrapper {
        flex-grow: 1;
        position: relative;
    }
    .modern-input {
        width: 100%;
        border: 1px solid #dfe6e9;
        border-radius: 12px;
        padding: 12px 20px;
        font-size: 1rem;
        color: #2d3436;
        transition: all 0.3s;
    }
    .modern-input:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        outline: none;
    }
    .modern-input::placeholder {
        color: #b2bec3;
    }
    .multi-input-group {
        display: flex;
        gap: 20px;
    }
    .multi-input-group .input-wrapper {
        flex: 1;
    }
    
    .btn-submit-premium {
        background: #6c5ce7;
        color: white;
        border: none;
        border-radius: 25px;
        padding: 12px 35px;
        font-weight: 700;
        font-size: 1.1rem;
        box-shadow: 0 8px 20px rgba(108, 92, 231, 0.3);
        transition: all 0.3s;
        cursor: pointer;
    }
    .btn-submit-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(108, 92, 231, 0.4);
        background: #5b4cc4;
    }
    
    .btn-clear-premium {
        background: #dfe6e9;
        color: #636e72;
        border: none;
        border-radius: 25px;
        padding: 12px 35px;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.3s;
        margin: 0 15px;
        text-decoration: none;
    }
    .btn-clear-premium:hover {
        background: #b2bec3;
        color: #2d3436;
    }
    
    .btn-back-premium {
        background: transparent;
        color: #ff4757;
        border: 2px solid #ff4757;
        border-radius: 25px;
        padding: 10px 35px;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.3s;
        text-decoration: none;
    }
    .btn-back-premium:hover {
        background: #ff4757;
        color: white;
    }

    .ai-magic-btn {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: #fdcb6e;
        border: none;
        border-radius: 8px;
        padding: 5px 12px;
        font-weight: 700;
        cursor: pointer;
        z-index: 5;
    }
    
    .image-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }
    .image-input-wrapper .modern-input {
        padding-right: 60px;
    }
    .image-btn {
        position: absolute;
        right: 0;
        background: #2d3436;
        color: white;
        border: none;
        border-radius: 0 12px 12px 0;
        height: 100%;
        padding: 0 20px;
        display: flex;
        align-items: center;
    }

    /* AI Typing animation */
    @keyframes pulse-opacity {
        0% { opacity: 1; }
        50% { opacity: 0.5; }
        100% { opacity: 1; }
    }
    .pulse-effect {
        animation: pulse-opacity 1.5s infinite ease-in-out;
    }
    
    .error-list {
        list-style: none;
        padding: 0;
        margin: 5px 0 0 0;
        color: #ff4757;
        font-size: 0.85rem;
        font-weight: 600;
    }
</style>

<div class="modern-card">
    {{ form_start(form, {'attr': {'id': 'eventForm'}}) }}
        <!-- Titre -->
        <div class="form-horizontal-group">
            <label>Titre</label>
            <div class="input-wrapper">
                {{ form_widget(form.titre, {'attr': {'class': 'modern-input', 'placeholder': 'Nom de l\'événement'}}) }}
                <button type="button" id="btn-generate-ai" class="ai-magic-btn" title="Générer avec l'IA">
                    <i class="fa fa-magic"></i> IA
                </button>
                {% if form.titre.vars.errors|length > 0 %}
                    <div class="error-list">{{ form_errors(form.titre) }}</div>
                {% endif %}
            </div>
        </div>

        <!-- Date & Heure -->
        <div class="form-horizontal-group">
            <label>Date & Heure</label>
            <div class="input-wrapper multi-input-group">
                <div class="input-wrapper">
                    {{ form_widget(form.date, {'attr': {'class': 'modern-input', 'placeholder': 'Sélectionner'}}) }}
                </div>
                <div class="input-wrapper" style="max-width: 150px;">
                    {{ form_widget(form.heure, {'attr': {'class': 'modern-input', 'placeholder': 'HH:mm'}}) }}
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-offset-200">
                {{ form_errors(form.date) }}
                {{ form_errors(form.heure) }}
            </div>
        </div>

        <!-- Lieu -->
        <div class="form-horizontal-group">
            <label>Lieu</label>
            <div class="input-wrapper">
                {{ form_widget(form.lieu, {'attr': {'class': 'modern-input', 'placeholder': 'Localisation de l\'événement'}}) }}
                {{ form_errors(form.lieu) }}
            </div>
        </div>

        <!-- Logistique -->
        <div class="form-horizontal-group">
            <label>Logistique</label>
            <div class="input-wrapper multi-input-group">
                <div class="input-wrapper">
                    {{ form_widget(form.capacite_max, {'attr': {'class': 'modern-input', 'placeholder': 'Capacité (ex: 500)'}}) }}
                    {{ form_errors(form.capacite_max) }}
                </div>
                <div class="input-wrapper">
                    {{ form_widget(form.prix, {'attr': {'class': 'modern-input', 'placeholder': 'Prix (DT)'}}) }}
                    {{ form_errors(form.prix) }}
                </div>
            </div>
        </div>

        <!-- Affiche (Image) -->
        <div class="form-horizontal-group">
            <label>Affiche (Image)</label>
            <div class="input-wrapper image-input-wrapper">
                <div style="display:none">{{ form_widget(form.image) }}</div>
                <input type="text" id="fake-file-input" class="modern-input" placeholder="Sélectionner un fichier..." readonly>
                <button type="button" class="image-btn" onclick="document.querySelector('input[type=file]').click();">
                    <i class="fa fa-camera"></i>
                </button>
                {{ form_errors(form.image) }}
            </div>
        </div>

        <!-- Description -->
        <div class="form-horizontal-group" style="align-items: flex-start;">
            <label style="padding-top: 10px;">Description</label>
            <div class="input-wrapper">
                {{ form_widget(form.description, {'attr': {'class': 'modern-input', 'rows': 4, 'placeholder': 'Parlez-nous de l\'événement...'}}) }}
                {{ form_errors(form.description) }}
                <small id="ai-loading" class="text-info d-none mt-1"><i class="fa fa-spinner fa-spin"></i> L'IA réfléchit...</small>
            </div>
        </div>

        <!-- Buttons -->
        <div class="text-center mt-5 d-flex justify-content-center align-items-center">
            <button type="submit" class="btn-submit-premium">
                {{ button_label|default('Ajouter l\'Événement') }}
            </button>
            
            {% if is_edit|default(false) %}
                <a href="javascript:history.back()" class="btn-clear-premium" style="background: #dfe6e9; color: #636e72;">
                    Annuler
                </a>
            {% else %}
                <button type="reset" class="btn-clear-premium" onclick="document.getElementById('eventForm').reset();">
                    Vider
                </button>
                <a href="{{ path('front_evenements_index') }}" class="btn-back-premium">
                    Rentrer
                </a>
            {% endif %}
        </div>
    {{ form_end(form) }}
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // File input sync
    const realFileBtn = document.querySelector('input[type=file]');
    const fakeFileBtn = document.getElementById('fake-file-input');
    if (realFileBtn && fakeFileBtn) {
        realFileBtn.addEventListener('change', function() {
            if (realFileBtn.value) {
                fakeFileBtn.value = realFileBtn.value.match(/[\/\\]([\w\d\s\.\-\(\)]+)$/)[1];
            } else {
                fakeFileBtn.value = "Sélectionner un fichier...";
            }
        });
    }

    // AI Generation
    const btnGenerate = document.getElementById('btn-generate-ai');
    const loadingInfo = document.getElementById('ai-loading');
    const titleInput = document.querySelector('input[name*="[titre]"]');
    const descInput = document.querySelector('textarea[name*="[description]"]');

    function typeWriter(text, element, speed = 10) {
        element.value = "";
        let i = 0;
        function type() {
            if (i < text.length) {
                element.value += text.charAt(i);
                i++;
                setTimeout(type, speed);
                element.scrollTop = element.scrollHeight;
            }
        }
        type();
    }

    if (btnGenerate) {
        btnGenerate.addEventListener('click', async function() {
            const title = titleInput.value;
            if (!title || title.trim().length < 3) {
                alert('Veuillez saisir un titre pour que l\'IA puisse vous aider.');
                return;
            }

            btnGenerate.disabled = true;
            btnGenerate.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';
            loadingInfo.classList.remove('d-none');
            descInput.classList.add('pulse-effect');

            try {
                const response = await fetch('{{ path("ai_generate_description") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ title: title })
                });

                const data = await response.json();
                if (data.description) {
                    typeWriter(data.description, descInput);
                } else if (data.error) {
                    alert('Erreur : ' + data.error);
                }
            } catch (error) {
                console.error('AI Error:', error);
            } finally {
                btnGenerate.disabled = false;
                btnGenerate.innerHTML = '<i class="fa fa-magic"></i> IA';
                loadingInfo.classList.add('d-none');
                descInput.classList.remove('pulse-effect');
            }
        });
    }
});
</script>

