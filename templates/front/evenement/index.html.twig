  <!-- evenements section -->
  <section class="food_section glass-section layout_padding">
    <div class="container">
      {% for label, messages in app.flashes %}
          {% for message in messages %}
              <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show mb-4" role="alert" style="border-radius: 15px;">
                  {{ message }}
                  <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                  </button>
              </div>
          {% endfor %}
      {% endfor %}

      <div class="heading_container heading_center">
        <h2 class="neon-text">
          Nos Événements
        </h2>
        <p class="mt-2 text-light opacity-75">Explorez et gérez les événements de notre communauté.</p>
        
        {% if is_granted('ROLE_ARTISTE') %}
        <div class="mt-4 mb-4">
          <a href="{{ path('front_evenements_new') }}" class="premium-btn">
            <i class="fa fa-plus"></i> Ajouter un Événement
          </a>
        </div>
        {% endif %}

        <div class="row justify-content-center w-100 mt-2 mb-5">
            <div class="col-md-8 col-lg-6 mb-3 mb-md-0">
                <div class="search-container d-flex align-items-center" style="background-color: #ffffff !important; border-radius: 50px; padding: 5px 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); border: 2px solid #a855f7;">
                    <i class="fa fa-search" style="color: #a855f7; font-size: 18px;"></i>
                    <input type="text" id="eventSearch" class="form-control flex-grow-1" placeholder="Rechercher un événement par titre..." style="background: transparent !important; border: none !important; color: #333 !important; font-size: 16px; font-weight: 500; height: 45px; box-shadow: none !important;">
                </div>
            </div>
        </div>
      </div>

      <div class="filters-content mt-5">
        <div class="row grid">
          {% for evenement in evenements %}
          <div class="col-sm-6 col-lg-4 all mb-4">
            <div class="premium-card">
              <div class="img-box">
                <div class="premium-badge d-flex align-items-center" style="gap: 10px;">
                  <span>{{ evenement.type|default('Event')|capitalize }}</span>
                  {% if evenement.statut == 'en attente' %}
                    <span class="badge badge-warning" style="background-color: #f59e0b; color: white;">En attente</span>
                  {% endif %}
                </div>
                {% if evenement.image %}
                    <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="{{ evenement.titre }}">
                {% else %}
                    <img src="{{ asset('front/images/about-img.png') }}" alt="{{ evenement.titre }}">
                {% endif %}
              </div>
              <div class="premium-detail">
                <h5>{{ evenement.titre }}</h5>
                <p class="text-truncate opacity-75">{{ evenement.description }}</p>
                
                <div class="premium-info-item">
                  <i class="fa fa-calendar"></i>
                  <span>{{ evenement.date ? evenement.date|date('d/m/Y') : '' }}</span>
                </div>
                <div class="premium-info-item">
                  <i class="fa fa-map-marker"></i>
                  <span>{{ evenement.lieu }}</span>
                </div>
                
                <div class="options align-items-center">
                  <div class="premium-price">
                    {{ evenement.prix }} DT
                  </div>
                  
                  <div class="btn-group">
                    <a href="{{ path('front_evenements_show', {'id': evenement.id}) }}" class="premium-btn py-1 px-3 mr-1" title="Voir">
                      <i class="fa fa-eye"></i>
                    </a>
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ARTISTE') %}
                      <a href="{{ path('front_evenements_edit', {'id': evenement.id}) }}" class="btn text-info" title="Modifier">
                        <i class="fa fa-edit"></i>
                      </a>
                      <form method="post" action="{{ path('front_evenements_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Supprimer cet événement ?');" style="display:inline-block">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                        <button class="btn text-danger">
                          <i class="fa fa-trash"></i>
                        </button>
                      </form>
                    {% endif %}
                    {% if is_granted('ROLE_ARTISTE') and evenement.artiste == app.user %}
                      <a href="{{ path('front_evenements_participants', {'id': evenement.id}) }}" class="btn text-warning" title="Participants">
                        <i class="fa fa-users"></i>
                      </a>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% else %}
          <div class="col-12 text-center">
            <p>Aucun événement prévu pour le moment. Revenez bientôt !</p>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
