  <script>
    $(document).ready(function() {
        const $searchInput = $('#eventSearch');
        const $sortSelect = $('#eventSort');
        const $grid = $('.grid');

        function filterAndSort() {
            const filter = $searchInput.val().toLowerCase();
            const cards = $('.grid > div').get();

            // Filter
            cards.forEach(card => {
                const $card = $(card);
                const title = $card.find('.premium-detail h5').text().toLowerCase();
                const body = $card.find('.premium-detail p').text().toLowerCase();
                
                if (title.includes(filter) || body.includes(filter)) {
                    $card.show();
                } else {
                    $card.hide();
                }
            });

            // Sort
            const sortType = $sortSelect.val();
            const visibleCards = cards.filter(card => $(card).is(':visible'));

            visibleCards.sort((a, b) => {
                const $a = $(a);
                const $b = $(b);

                if (sortType.startsWith('date')) {
                    // Fallback to text content if fa-calendar span not found
                    let dateAStr = $a.find('.fa-calendar').parent().text().trim();
                    let dateBStr = $b.find('.fa-calendar').parent().text().trim();
                    
                    if (!dateAStr) return 1;
                    if (!dateBStr) return -1;

                    // Match YYYY-MM-DD or DD/MM/YYYY
                    const parseDate = (s) => {
                        const parts = s.match(/\d+/g);
                        if (!parts) return new Date(0);
                        if (parts[0].length === 4) return new Date(parts[0], parts[1]-1, parts[2]); // YYYY-MM-DD
                        return new Date(parts[2], parts[1]-1, parts[0]); // DD/MM/YYYY
                    };
                    
                    const valA = parseDate(dateAStr);
                    const valB = parseDate(dateBStr);
                    
                    return sortType === 'date_desc' ? valB - valA : valA - valB;
                } else if (sortType.startsWith('price')) {
                    const valA = parseFloat($a.find('div[style*="color: #27ae60"], .premium-price').text().replace(/[^\d.]/g, '')) || 0;
                    const valB = parseFloat($b.find('div[style*="color: #27ae60"], .premium-price').text().replace(/[^\d.]/g, '')) || 0;
                    return sortType === 'price_asc' ? valA - valB : valB - valA;
                } else if (sortType === 'title_asc') {
                    const valA = $a.find('h5').text().toLowerCase();
                    const valB = $b.find('h5').text().toLowerCase();
                    return valA.localeCompare(valB);
                }
                return 0;
            });

            // Re-append sorted cards to the grid
            $.each(visibleCards, function(i, card) {
                $grid.append(card);
            });
        }

        $searchInput.on('input', filterAndSort);
        $sortSelect.on('change', filterAndSort);
    });
  </script>

