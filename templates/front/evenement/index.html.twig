  <script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('eventSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                let filter = this.value.toLowerCase();
                let cards = document.querySelectorAll('.grid > div');
                
                cards.forEach(card => {
                    let title = card.querySelector('.premium-detail h5');
                    let text = card.querySelector('.premium-detail p');
                    
                    let titleText = title ? title.innerText.toLowerCase() : '';
                    let bodyText = text ? text.innerText.toLowerCase() : '';
                    
                    if (titleText.includes(filter) || bodyText.includes(filter)) {
                        card.style.display = '';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        }


    });
  </script>

