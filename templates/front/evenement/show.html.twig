{% extends 'front/layout.html.twig' %}

{% set active_nav = 'events' %}
{% block title %}Pegasus | Event Details{% endblock %}

{% block extra_styles %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
  .event-shell { padding: 44px 0 72px; }
  .event-card { background:#fff; border:1px solid #dbe5ef; border-radius:20px; box-shadow:0 12px 32px rgba(15,23,42,.10); padding:24px; }
  .event-title { font-size:1.9rem; font-weight:800; color:var(--pg-text,#111827); margin-bottom:10px; }
  .event-desc { color:#4b5563; line-height:1.7; font-size:.975rem; }
  .event-image { border-radius:16px; width:100%; object-fit:cover; max-height:420px; border:1px solid #dbe5ef; }
  .event-meta-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:10px; margin-top:16px; }
  .meta-box { background:#f8faff; border:1px solid #dbe5ef; border-radius:12px; padding:12px; color:#374151; }
  .meta-box small { display:block; color:var(--pg-gold,#f9c23c); text-transform:uppercase; font-size:.65rem; letter-spacing:.10em; font-weight:700; margin-bottom:4px; }
  .action-toolbar { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; align-items:center; }
  .btn-action { border:none; border-radius:20px; color:#fff!important; font-weight:700; font-size:13px; padding:9px 16px; display:inline-flex; align-items:center; gap:6px; white-space:nowrap; text-decoration:none!important; transition:opacity .18s; }
  .btn-action:hover { opacity:.88; }
  .btn-add{ background:var(--pg-teal,#0f766e); }
  .btn-edit{ background:#2563eb; }
  .btn-delete{ background:#dc2626; }
  .btn-participants,.btn-participate{ background:var(--pg-teal,#0f766e); }
  .btn-sponsor{ background:var(--pg-gold-dark,#e6a800); color:#111!important; }
  .btn-back{ border:1px solid #dbe5ef; color:#374151!important; background:#fff; border-radius:20px; padding:9px 16px; text-decoration:none!important; transition:background .18s; }
  .btn-back:hover{ background:#f4f6fb; }
  #map { height: 360px; width:100%; border-radius:16px; margin-top:14px; border:1px solid #dbe5ef; box-shadow:0 8px 22px rgba(15,23,42,.07); }
  .info-badge { display:inline-flex; align-items:center; gap:8px; border-radius:999px; background:#fef9c3; border:1px solid #f9c23c; color:#92660a; padding:7px 14px; font-size:13px; font-weight:600; }
</style>
{% endblock %}

{% block body %}
<section class="event-shell">
  <div class="container">
    {% for label, messages in app.flashes %}
      {% for message in messages %}
        <div class="alert alert-{{ label == 'error' ? 'danger' : label == 'warning' ? 'warning' : 'success' }} mb-3">{{ message }}</div>
      {% endfor %}
    {% endfor %}

    <div class="event-card">
      <div class="row align-items-start">
        <div class="col-md-6 mb-3 mb-md-0">
          {% if evenement.image %}
            <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="{{ evenement.titre }}" class="event-image">
          {% else %}
            <img src="{{ asset('front/images/about-img.png') }}" alt="{{ evenement.titre }}" class="event-image">
          {% endif %}
        </div>
        <div class="col-md-6">
          <h1 class="event-title">{{ evenement.titre }}</h1>
          <p class="event-desc">{{ evenement.description }}</p>

          <div class="event-meta-grid">
            <div class="meta-box"><small>Date</small>{{ evenement.date ? evenement.date|date('d F Y') : 'N/A' }}</div>
            <div class="meta-box"><small>Heure</small>{{ evenement.heure ? evenement.heure|date('H:i') : 'N/A' }}</div>
            <div class="meta-box"><small>Lieu</small>{{ evenement.lieu }}</div>
            <div class="meta-box"><small>Prix</small>{{ evenement.prix }} DT</div>
            <div class="meta-box"><small>Capacit�</small>{{ evenement.capaciteMax }} personnes</div>
          </div>

          <div class="action-toolbar">
            {% set currentUserId = app.user ? app.user.id : null %}
            {% set eventOwnerId = evenement.artiste ? evenement.artiste.id : null %}
            {% set isOwner = currentUserId is not null and eventOwnerId is not null and currentUserId == eventOwnerId %}

            {% if app.user %}
              {% if is_granted('ROLE_ARTISTE') %}
                <span class="info-badge"><i class="fa fa-info-circle"></i>{% if isOwner %} You organize this event {% else %} Artists cannot participate {% endif %}</span>
              {% else %}
                {% set isParticipating = false %}
                {% for participation in evenement.participations %}
                  {% if participation.user and participation.user.id == currentUserId %}{% set isParticipating = true %}{% endif %}
                {% endfor %}

                {% if isParticipating %}
                  <a href="{{ path('front_evenements_ticket', {'id': evenement.id}) }}" class="btn-action" style="background:#059669; text-decoration:none;"><i class="fa fa-download mr-2"></i>Download Ticket</a>
                  {% set daysRemaining = evenement.date.diff(date()).days %}
                  {% set isTooLate = daysRemaining < 3 and evenement.date > date() %}
                  {% if isTooLate %}
                    <span class="info-badge" style="background:#fff0f0;border-color:#f3cccc;color:#9a1b1b;"><i class="fa fa-lock"></i> Cancellation locked (-3 days)</span>
                  {% else %}
                    <form action="{{ path('front_evenements_unparticipate', {'id': evenement.id}) }}" method="POST" style="margin:0;"><button type="submit" class="btn-action btn-delete"><i class="fa fa-times mr-2"></i>Cancel participation</button></form>
                  {% endif %}
                {% else %}
                  <form action="{{ path('front_evenements_participate', {'id': evenement.id}) }}" method="POST" style="margin:0;"><button type="submit" class="btn-action btn-participate"><i class="fa fa-check mr-2"></i>Participate</button></form>
                {% endif %}
              {% endif %}
            {% else %}
              <a href="{{ path('app_login') }}" class="btn-action" style="background:#4f46e5;"><i class="fa fa-sign-in mr-2"></i>Login to participate</a>
            {% endif %}

            {% if is_granted('ROLE_SPONSOR') or not app.user %}
              <a href="{{ path('front_evenements_sponsor', {'id': evenement.id}) }}" class="btn-action btn-sponsor"><i class="fa fa-handshake-o mr-2"></i>Sponsor</a>
            {% endif %}

            {% if isOwner %}
              <a href="{{ path('front_evenements_new') }}" class="btn-action btn-add"><i class="fa fa-plus mr-2"></i>Add</a>
              <a href="{{ path('front_evenements_edit', {'id': evenement.id}) }}" class="btn-action btn-edit"><i class="fa fa-edit mr-2"></i>Edit</a>
              <form method="post" action="{{ path('front_evenements_delete', {'id': evenement.id}) }}" onsubmit="return confirm('�tes-vous s�r de vouloir supprimer cet �v�nement ?');" style="margin: 0;"><input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}"><button class="btn-action btn-delete"><i class="fa fa-trash mr-2"></i>Delete</button></form>
              <a href="{{ path('front_sponsoring_pack_index') }}" class="btn-action btn-sponsor"><i class="fa fa-star mr-2"></i>Sponsoring Packs</a>
              <a href="{{ path('front_evenements_participants', {'id': evenement.id}) }}" class="btn-action btn-participants"><i class="fa fa-users mr-2"></i>Participants</a>
            {% endif %}

            <a href="{{ path('front_evenements_index') }}" class="btn-back"><i class="fa fa-arrow-left mr-2"></i>Back</a>
          </div>
        </div>
      </div>

      <div class="mt-4">
        <h4 style="font-size:1rem;color:#2f4d8d;"><i class="fa fa-map-marker mr-2"></i>Location</h4>
        <div id="map"></div>
      </div>
    </div>
  </div>
</section>
{% endblock %}

{% block extra_scripts %}
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  const locationName = "{{ evenement.lieu|escape('js') }}";
  const map = L.map('map').setView([0, 0], 13);

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
  }).addTo(map);

  fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationName)}`)
    .then(response => response.json())
    .then(data => {
      if (data.length > 0) {
        const lat = data[0].lat;
        const lon = data[0].lon;
        map.setView([lat, lon], 15);
        L.marker([lat, lon]).addTo(map)
          .bindPopup(`<b>{{ evenement.titre|escape('js') }}</b><br>${locationName}`)
          .openPopup();
      } else {
        document.getElementById('map').innerHTML = `
          <iframe width="100%" height="100%" frameborder="0" style="border:0; border-radius: 14px;" src="https://maps.google.com/maps?q=${encodeURIComponent(locationName)}&t=&z=15&ie=UTF8&iwloc=&output=embed" allowfullscreen></iframe>`;
      }
    })
    .catch(() => {
      document.getElementById('map').innerHTML = "<div class='text-center p-5 text-muted'>Map loading error.</div>";
    });
</script>
{% endblock %}
