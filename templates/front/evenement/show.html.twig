<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Feane - {{ evenement.titre }}</title>
    
    <!-- bootstrap core css -->
    <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
    <!-- font awesome style -->
    <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />
    <!-- Custom styles for this template -->
    <link href="{{ asset('front/css/style.css') }}" rel="stylesheet" />

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap');

        body {
            background-color: #f8f9fa !important;
            font-family: 'Outfit', sans-serif;
            margin: 0;
            padding: 0;
            color: #2d3436;
        }
        .back-link {
            display: inline-flex;
            align-items: center;
            color: #6c5ce7;
            font-weight: 700;
            text-decoration: none;
            margin-bottom: 40px;
            font-size: 1rem;
            transition: all 0.3s;
            padding: 8px 16px;
            background: white;
            border-radius: 50px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
        .back-link:hover {
            color: #5b4cc4;
            transform: translateX(-5px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
            text-decoration: none;
        }
        .event-details-container {
            padding: 60px 0 100px 0;
        }
        .event-image {
            width: 100%;
            border-radius: 30px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.1);
            object-fit: cover;
            height: 500px;
            border: 8px solid white;
        }
        .event-title {
            font-size: 3.5rem;
            font-weight: 800;
            color: #2d3436;
            margin-bottom: 15px;
            letter-spacing: -2px;
            line-height: 1;
        }
        .event-description {
            font-size: 1.15rem;
            color: #636e72;
            margin-bottom: 40px;
            font-weight: 400;
            line-height: 1.7;
        }
        .info-card {
            background: #ffffff;
            border-radius: 30px;
            box-shadow: 0 15px 45px rgba(0,0,0,0.04);
            padding: 40px;
            margin-bottom: 40px;
            border: 1px solid #f1f2f6;
        }
        .info-item {
            margin-bottom: 30px;
        }
        .info-label {
            color: #a8b0b9;
            font-weight: 700;
            font-size: 0.8rem;
            text-transform: uppercase;
            margin-bottom: 8px;
            display: block;
            letter-spacing: 1.5px;
        }
        .info-value {
            color: #2d3436;
            font-weight: 800;
            font-size: 1.3rem;
        }
        
        .button-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }
        .btn-custom {
            border-radius: 16px;
            padding: 16px 20px;
            font-weight: 700;
            font-size: 1rem;
            border: none;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: white !important;
            text-decoration: none !important;
        }
        .btn-purple { background: #6c5ce7; box-shadow: 0 8px 20px rgba(108, 92, 231, 0.2); }
        .btn-red { background: #ff4757; box-shadow: 0 8px 20px rgba(255, 71, 87, 0.2); }
        .btn-orange { background: #f39c12; box-shadow: 0 8px 20px rgba(243, 156, 18, 0.2); }
        .btn-green { background: #2ecc71; box-shadow: 0 8px 20px rgba(46, 204, 113, 0.2); }
        
        .btn-custom:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.1);
        }

        .btn-participate {
            background: #6c5ce7;
            border-radius: 40px;
            padding: 18px 45px;
            font-weight: 800;
            font-size: 1.2rem;
            border: none;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: white !important;
            text-decoration: none !important;
            box-shadow: 0 10px 30px rgba(108, 92, 231, 0.2);
            text-transform: uppercase;
        }
        .btn-participate:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(108, 92, 231, 0.3);
        }
    </style>
</head>
<body>

<div class="container event-details-container">
    <a href="{{ is_granted('ROLE_SPONSOR') ? path('front_evenements_index') : path('front_evenements_index') }}" class="back-link" style="{{ is_granted('ROLE_SPONSOR') ? 'color: #f39c12;' : '' }}">
        ← {{ is_granted('ROLE_SPONSOR') ? 'Retour aux événements' : 'Retour au catalogue' }}
    </a>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} alert-dismissible fade show mb-5" role="alert" style="border-radius: 20px;">
                {{ message }}
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row align-items-start">
        <div class="col-lg-6">
            {% if evenement.image %}
                <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="{{ evenement.titre }}" class="event-image">
            {% else %}
                <img src="{{ asset('front/images/about-img.png') }}" alt="{{ evenement.titre }}" class="event-image">
            {% endif %}
        </div>
        <div class="col-lg-6 pl-lg-5">
            <h1 class="event-title">{{ evenement.titre }}</h1>
            <p class="event-description">{{ evenement.description }}</p>

            <div class="info-card">
                <div class="row">
                    <div class="col-6 info-item">
                        <span class="info-label">DATE</span>
                        <span class="info-value">{{ evenement.date ? evenement.date|date('Y-m-d') : 'N/A' }}</span>
                    </div>
                    <div class="col-6 info-item">
                        <span class="info-label">HEURE</span>
                        <span class="info-value">{{ evenement.heure ? evenement.heure|date('H:i:s') : 'N/A' }}</span>
                    </div>
                    <div class="col-6 info-item">
                        <span class="info-label">LIEU</span>
                        <span class="info-value">{{ evenement.lieu }}</span>
                    </div>
                    <div class="col-6 info-item">
                        <span class="info-label">PRIX</span>
                        <span class="info-value">{{ evenement.prix|number_format(2, ',', ' ') }} DT</span>
                    </div>
                    {% if is_granted('ROLE_SPONSOR') %}
                        <div class="col-12 info-item mb-0">
                            <span class="info-label">CAPACITÉ</span>
                            <span class="info-value">{{ evenement.capaciteMax }} Personnes</span>
                        </div>
                    {% else %}
                        <div class="col-12 info-item mb-0">
                            <span class="info-label">PLACES RESTANTES</span>
                            <span class="info-value">
                                {{ evenement.capaciteMax }} Places
                            </span>
                        </div>
                    {% endif %}
                </div>
            </div>

            {% set isParticipating = false %}
            {% if app.user %}
                {% for participation in evenement.participations %}
                    {% if participation.user == app.user %}
                        {% set isParticipating = true %}
                    {% endif %}
                {% endfor %}
            {% endif %}

            {% if is_granted('ROLE_ARTISTE') and evenement.artiste == app.user %}
                <div class="button-grid mb-4">
                    <a href="{{ path('front_evenements_edit', {'id': evenement.id}) }}" class="btn-custom btn-purple">
                        Modifier <i class="fa fa-edit"></i>
                    </a>
                    <form method="post" action="{{ path('front_evenements_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Supprimer cet événement ?');" style="margin:0">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                        <button class="btn-custom btn-red" style="width:100%">
                            Supprimer <i class="fa fa-trash"></i>
                        </button>
                    </form>
                    <a href="{{ path('front_evenements_sponsor', {'id': evenement.id}) }}" class="btn-custom btn-orange">
                        Pack Sponsoring <i class="fa fa-heart"></i>
                    </a>
                    <a href="{{ path('front_evenements_participants', {'id': evenement.id}) }}" class="btn-custom btn-green">
                        Espace Participant <i class="fa fa-user"></i>
                    </a>
                </div>
            {% elseif is_granted('ROLE_SPONSOR') %}
                <a href="{{ path('front_evenements_sponsor', {'id': evenement.id}) }}" class="btn-participate" style="background: #f39c12; width: 100%; border-radius: 50px;">
                    <i class="fa fa-handshake-o"></i> SPONSORISER CET ÉVÉNEMENT
                </a>
            {% else %}
                {% if app.user %}
                    {% if isParticipating %}
                        {% set now = date() %}
                        {% set eventDate = date(evenement.date) %}
                        {% set difference = eventDate.diff(now) %}
                        {% set daysRemaining = difference.invert ? difference.days : -difference.days %}

                        {% if daysRemaining >= 3 %}
                            <form action="{{ path('front_evenements_unparticipate', {'id': evenement.id}) }}" method="POST">
                                <button type="submit" class="btn-participate" style="background: #ff4757;">
                                    <i class="fa fa-times"></i> ANNULER MA PARTICIPATION
                                </button>
                            </form>
                        {% else %}
                            <div class="alert alert-info py-2 px-3 mb-0" style="border-radius: 50px; display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 0.9rem;">
                                <i class="fa fa-lock"></i> Participation confirmée (Annulation impossible à moins de 3j)
                            </div>
                        {% endif %}
                    {% else %}
                        <form action="{{ path('front_evenements_participate', {'id': evenement.id}) }}" method="POST">
                            <button type="submit" class="btn-participate">
                                <i class="fa fa-rocket"></i> PARTICIPER
                            </button>
                        </form>
                    {% endif %}
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn-participate">
                        <i class="fa fa-sign-in"></i> SE CONNECTER POUR PARTICIPER
                    </a>
                {% endif %}
            {% endif %}
        </div>
    </div>
    
    <div class="row mt-5 pt-5">
        <div class="col-12">
            <h4 class="info-label" style="font-size: 1.1rem; margin-bottom: 20px;">
                <i class="fa fa-map-marker mr-2"></i> Localisation
            </h4>
            <div id="map" style="height: 400px; width: 100%; border-radius: 40px; box-shadow: 0 15px 35px rgba(0,0,0,0.05); border: 1px solid #eee;"></div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
<script src="{{ asset('front/js/bootstrap.js') }}"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    // Leaflet Map Logic
    const locationName = "{{ evenement.lieu|escape('js') }}";
    const map = L.map('map').setView([0, 0], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationName)}`)
        .then(response => response.json())
        .then(data => {
            if (data.length > 0) {
                const lat = data[0].lat;
                const lon = data[0].lon;
                map.setView([lat, lon], 15);
                L.marker([lat, lon]).addTo(map)
                    .bindPopup(`<b>{{ evenement.titre|escape('js') }}</b><br>${locationName}`)
                    .openPopup();
            } else {
                document.getElementById('map').innerHTML = `
                    <iframe width="100%" height="100%" frameborder="0" style="border:0; border-radius: 40px;" 
                        src="https://maps.google.com/maps?q=${encodeURIComponent(locationName)}&output=embed">
                    </iframe>`;
            }
        })
        .catch(() => {
            document.getElementById('map').innerHTML = "<div class='text-center p-5 text-muted'>Erreur de chargement de la carte.</div>";
        });
</script>

</body>
</html>
