  <!-- details section -->
  <section class="about_section glass-section layout_padding">
    <div class="container">
      {% for label, messages in app.flashes %}
          {% for message in messages %}
              <div class="alert alert-{{ label == 'error' ? 'danger' : label == 'warning' ? 'warning' : 'success' }} alert-dismissible fade show mb-4" role="alert" style="border-radius: 15px;">
                  {{ message }}
                  <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                      <span aria-hidden="true">&times;</span>
                  </button>
              </div>
          {% endfor %}
      {% endfor %}
      <div class="row align-items-center">
        <div class="col-md-6">
          <div class="img-box">
            {% if evenement.image %}
                <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="{{ evenement.titre }}" class="img-fluid premium-card shadow-lg p-0">
            {% else %}
                <img src="{{ asset('front/images/about-img.png') }}" alt="{{ evenement.titre }}" class="img-fluid premium-card shadow-lg p-0">
            {% endif %}
          </div>
        </div>
        <div class="col-md-6">
          <div class="detail-box">
            <div class="heading_container">
              <h2 class="neon-text mb-4">
                {{ evenement.titre }}
              </h2>
            </div>
            <p class="mt-3 text-light opacity-75" style="font-size: 1.1rem; line-height: 1.8;">
              {{ evenement.description }}
            </p>
            
            <div class="premium-card mt-4 p-4" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">
              <div class="row">
                <div class="col-6 mb-4">
                  <div class="premium-info-item">
                    <i class="fa fa-calendar"></i>
                    <div>
                      <small class="d-block text-warning text-uppercase" style="font-size: 10px; letter-spacing: 1px;">Date</small>
                      <span class="font-weight-bold">{{ evenement.date ? evenement.date|date('d F Y') : 'N/A' }}</span>
                    </div>
                  </div>
                </div>
                <div class="col-6 mb-4">
                  <div class="premium-info-item">
                    <i class="fa fa-clock-o"></i>
                    <div>
                      <small class="d-block text-warning text-uppercase" style="font-size: 10px; letter-spacing: 1px;">Heure</small>
                      <span class="font-weight-bold">{{ evenement.heure ? evenement.heure|date('H:i') : 'N/A' }}</span>
                    </div>
                  </div>
                </div>
                <div class="col-6 mb-4">
                  <div class="premium-info-item">
                    <i class="fa fa-map-marker"></i>
                    <div>
                      <small class="d-block text-warning text-uppercase" style="font-size: 10px; letter-spacing: 1px;">Lieu</small>
                      <span class="font-weight-bold">{{ evenement.lieu }}</span>
                    </div>
                  </div>
                </div>
                <div class="col-6 mb-4">
                  <div class="premium-info-item">
                    <i class="fa fa-tag"></i>
                    <div>
                      <small class="d-block text-warning text-uppercase" style="font-size: 10px; letter-spacing: 1px;">Prix</small>
                      <span class="font-weight-bold">{{ evenement.prix }} DT</span>
                    </div>
                  </div>
                </div>
                <div class="col-6">
                  <div class="premium-info-item">
                    <i class="fa fa-users"></i>
                    <div>
                      <small class="d-block text-warning text-uppercase" style="font-size: 10px; letter-spacing: 1px;">Capacité</small>
                      <span class="font-weight-bold">{{ evenement.capaciteMax }} Personnes</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

<style>
    .action-toolbar {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
        align-items: center;
    }
    .btn-action {
        border: none;
        border-radius: 50px;
        color: white !important;
        font-weight: 600;
        font-size: 14px;
        padding: 10px 22px;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        text-decoration: none !important;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    .btn-action:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        color: white !important;
    }
    .btn-add        { background: linear-gradient(135deg, #a855f7, #7c3aed); }
    .btn-edit       { background: linear-gradient(135deg, #3b82f6, #2563eb); }
    .btn-delete     { background: linear-gradient(135deg, #ef4444, #dc2626); }
    .btn-participate { background: linear-gradient(135deg, #10b981, #059669); }
    .btn-sponsor    { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .btn-action.btn-participants { background: linear-gradient(135deg, #10b981, #059669); }
    .btn-back {
        border: 2px solid rgba(255,255,255,0.35);
        border-radius: 50px;
        color: rgba(255,255,255,0.85) !important;
        padding: 8px 22px;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none !important;
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
    }
    .btn-back:hover {
        background: rgba(255,255,255,0.1);
        border-color: white;
        color: white !important;
        transform: translateX(-4px);
    }
    .info-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 50px;
        background: rgba(59, 130, 246, 0.12);
        border: 1px solid rgba(59, 130, 246, 0.3);
        color: #60a5fa;
        padding: 8px 18px;
        font-size: 14px;
        white-space: nowrap;
    }
</style>

            <div class="action-toolbar">
              {% set currentUserId = app.user ? app.user.id : null %}
              {% set eventOwnerId = evenement.artiste ? evenement.artiste.id : null %}
              {% set isOwner = currentUserId is not null and eventOwnerId is not null and currentUserId == eventOwnerId %}

              {# Participation Logic #}
              {% if app.user %}
                {% if is_granted('ROLE_ARTISTE') %}
                  <span class="info-badge">
                    <i class="fa fa-info-circle"></i>
                    {% if isOwner %}
                      Vous organisez cet événement
                    {% else %}
                      Les artistes ne peuvent pas participer
                    {% endif %}
                  </span>
                {% else %}
                  {% set isParticipating = false %}
                  {% for participation in evenement.participations %}
                    {% if participation.user and participation.user.id == currentUserId %}
                      {% set isParticipating = true %}
                    {% endif %}
                  {% endfor %}

                  {% if isParticipating %}
                    {% set daysRemaining = evenement.date.diff(date()).days %}
                    {% set isTooLate = daysRemaining < 3 and evenement.date > date() %}
                    
                    {% if isTooLate %}
                      <span class="info-badge" style="background: rgba(239, 68, 68, 0.12); border-color: rgba(239, 68, 68, 0.3); color: #ef4444;">
                        <i class="fa fa-lock mr-2"></i> Annulation impossible (-3j)
                      </span>
                    {% else %}
                      <form action="{{ path('front_evenements_unparticipate', {'id': evenement.id}) }}" method="POST" style="margin:0;">
                        <button type="submit" class="btn-action btn-delete">
                          <i class="fa fa-times mr-2"></i> Annuler ma participation
                        </button>
                      </form>
                    {% endif %}
                  {% else %}
                    <form action="{{ path('front_evenements_participate', {'id': evenement.id}) }}" method="POST" style="margin:0;">
                      <button type="submit" class="btn-action btn-participants">
                        <i class="fa fa-check mr-2"></i> Participer
                      </button>
                    </form>
                  {% endif %}
                {% endif %}
              {% else %}
                <a href="{{ path('app_login') }}" class="btn-action" style="background: linear-gradient(135deg, #6366f1, #4f46e5);">
                  <i class="fa fa-sign-in mr-2"></i> Connectez-vous pour participer
                </a>
              {% endif %}

              {# Sponsor Button #}
              {% if is_granted('ROLE_SPONSOR') or not app.user %}
                <a href="{{ path('front_evenements_sponsor', {'id': evenement.id}) }}" class="btn-action btn-sponsor">
                  <i class="fa fa-handshake-o mr-2"></i> Sponsor
                </a>
              {% endif %}

              {# Artist Actions #}
              {% if isOwner %}
                <a href="{{ path('front_evenements_new') }}" class="btn-action btn-add">
                  <i class="fa fa-plus mr-2"></i> Ajouter
                </a>
                <a href="{{ path('front_evenements_edit', {'id': evenement.id}) }}" class="btn-action btn-edit">
                  <i class="fa fa-edit mr-2"></i> Modifier
                </a>
                <form method="post" action="{{ path('front_evenements_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');" style="margin: 0;">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                  <button class="btn-action btn-delete">
                    <i class="fa fa-trash mr-2"></i> Supprimer
                  </button>
                </form>
                <a href="{{ path('front_sponsoring_pack_index') }}" class="btn-action" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                  <i class="fa fa-star mr-2"></i> Packs Sponsoring
                </a>
                {% if isOwner %}
                  <a href="{{ path('front_evenements_participants', {'id': evenement.id}) }}" class="btn-action btn-participants">
                    <i class="fa fa-users mr-2"></i> Participants
                  </a>
                {% endif %}
              {% endif %}

              <a href="{{ path('front_evenements_index') }}" class="btn-back">
                <i class="fa fa-arrow-left mr-2"></i> Retour
              </a>

            </div>
          </div>
        </div>
      </div>
      
      <!-- Map Section -->
      <div class="row mt-5">
        <div class="col-md-12">
          <div class="heading_container mb-3">
            <h4 class="text-warning text-uppercase" style="font-size: 14px; letter-spacing: 2px;">
              <i class="fa fa-map-marker mr-2"></i> Localisation
            </h4>
          </div>
          <div id="map"></div>
        </div>
      </div>
    </div>
  </section>
  <!-- end details section -->

  <!-- footer section -->
  <footer class="footer_section">
    <div class="container">
      <div class="footer-info">
        <p>&copy; <span id="displayYear"></span> All Rights Reserved By <a href="https://html.design/">Free Html Templates</a></p>
      </div>
    </div>
  </footer>
  <!-- footer section -->

  <!-- jQery -->
  <script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
  <!-- bootstrap js -->
  <script src="{{ asset('front/js/bootstrap.js') }}"></script>
  
  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  
  <script>
    document.getElementById('displayYear').innerHTML = new Date().getFullYear();

    // Leaflet Map Logic
    const locationName = "{{ evenement.lieu|escape('js') }}";
    const map = L.map('map').setView([0, 0], 13); // Default view

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    // Geocoding using Nominatim
    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationName)}`)
        .then(response => response.json())
        .then(data => {
            if (data.length > 0) {
                const lat = data[0].lat;
                const lon = data[0].lon;
                map.setView([lat, lon], 15);
                L.marker([lat, lon]).addTo(map)
                    .bindPopup(`<b>{{ evenement.titre|escape('js') }}</b><br>${locationName}`)
                    .openPopup();
            } else {
                console.warn("Location not found on OpenStreetMap, falling back to Google Maps Embed");
                document.getElementById('map').innerHTML = `
                    <iframe 
                        width="100%" 
                        height="100%" 
                        frameborder="0" 
                        style="border:0; border-radius: 20px;" 
                        src="https://maps.google.com/maps?q=${encodeURIComponent(locationName)}&t=&z=15&ie=UTF8&iwloc=&output=embed" 
                        allowfullscreen>
                    </iframe>`;
            }
        })
        .catch(error => {
            console.error("Geocoding error:", error);
            document.getElementById('map').innerHTML = "<div class='text-center p-5 text-muted'>Erreur de chargement de la carte.</div>";
        });
  </script>

</body>

</html>
