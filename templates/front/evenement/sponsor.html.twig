<body style="background-color: #f4f7f9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 40px; color: #333;">

    <div style="max-width: 1200px; margin: 0 auto; position: relative;">
        <!-- Back Button -->
        <a href="{{ path('front_evenements_show', {'id': evenement.id}) }}" 
           style="position: absolute; left: 0; top: 0; background-color: #2c3e50; color: #fff; padding: 10px 18px; border-radius: 6px; text-decoration: none; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
            &larr; Retour aux événements
        </a>

        <!-- Header -->
        <div style="text-align: center; margin-bottom: 60px;">
            <h1 style="color: #2c3e50; font-size: 32px; font-weight: 700; margin: 0 0 10px 0;">Choisissez votre Pack Sponsoring</h1>
            <p style="color: #95a5a6; font-size: 18px; margin: 0;">Événement : {{ evenement.titre }}</p>
        </div>

        <!-- Description -->
        <div style="text-align: center; margin-bottom: 80px;">
            <p style="color: #7f8c8d; font-size: 15px; margin: 0;">Sponsorisez cet événement pour bénéficier d'une visibilité exceptionnelle.</p>
        </div>

        <!-- Packs Grid -->
        <div style="display: flex; justify-content: center; gap: 30px; flex-wrap: wrap;">
            {% if packs is empty %}
                <p style="color: #7f8c8d; font-size: 16px;">Aucun pack disponible pour le moment.</p>
            {% else %}
                {% for pack in packs %}
                    <div style="background-color: #fff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); width: 320px; padding: 60px 40px; text-align: center; border: 1px solid #e1e8ed;">
                        <h2 style="color: #2c3e50; font-size: 28px; font-weight: 700; margin: 0 0 15px 0;">{{ pack.nomPack }}</h2>
                        <div style="color: #28a745; font-size: 24px; font-weight: 700; margin-bottom: 50px;">
                            {{ pack.prix|number_format(0, '', '') }} TND
                        </div>
                        
                        <div style="color: #bdc3c7; font-size: 14px; line-height: 1.6; margin-bottom: 50px; min-height: 40px;">
                            {{ pack.description }}
                        </div>

                        {% set reservation = reservedPackIds[pack.id] ?? null %}
                        {% if reservation %}
                            {% set daysRemaining = (evenement.date.timestamp - "now"|date("U")) / (24 * 3600) %}
                            
                            {% if daysRemaining < 7 %}
                                <div style="color: #dc3545; font-size: 13px; font-weight: 600; font-style: italic; background-color: #fff5f5; padding: 15px; border-radius: 6px; border: 1px solid #ffc9c9; margin-bottom: 0;">
                                    L'annulation n'est plus possible à moins de 7 jours de l'événement.
                                </div>
                            {% else %}
                                <form action="{{ path('front_evenements_sponsor_cancel', {'id': evenement.id, 'packId': pack.id}) }}" method="post" style="margin: 0;" onsubmit="return confirm('Voulez-vous vraiment annuler cette réservation ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ pack.id) }}">
                                    <button type="submit" style="background-color: #dc3545; color: #fff; border: none; border-radius: 6px; font-size: 15px; font-weight: 600; padding: 14px 0; width: 100%; cursor: pointer; transition: background-color 0.2s;">
                                        Annuler la réservation
                                    </button>
                                </form>
                            {% endif %}
                        {% else %}
                            <form action="{{ path('front_evenements_sponsor_reserve', {'id': evenement.id, 'packId': pack.id}) }}" method="post" style="margin: 0;">
                                <input type="hidden" name="_token" value="{{ csrf_token('reserve' ~ pack.id) }}">
                                <button type="submit" style="background-color: #28a745; color: #fff; border: none; border-radius: 6px; font-size: 15px; font-weight: 600; padding: 14px 0; width: 100%; cursor: pointer; transition: background-color 0.2s;">
                                    Réserver ce pack
                                </button>
                            </form>
                        {% endif %}
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</body>
</html>t>
</body>
</html>

