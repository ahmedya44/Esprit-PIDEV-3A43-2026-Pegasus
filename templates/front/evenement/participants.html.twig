<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Participants Inscrits - {{ evenement.titre }}</title>
    
    <!-- bootstrap core css -->
    <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
    <!-- font awesome style -->
    <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;800&display=swap');

        body {
            background-color: #f1f3f5 !important;
            font-family: 'Outfit', sans-serif;
            margin: 0;
            padding: 20px;
        }
        .container-fluid {
            padding: 20px 40px;
        }
        .back-link {
            color: #6c5ce7;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.9rem;
            margin-bottom: 30px;
        }
        .back-link:hover {
            text-decoration: underline;
            color: #5b4cc4;
        }
        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
        }
        .title-section h1 {
            font-size: 2.2rem;
            font-weight: 800;
            color: #1e272e;
            margin: 0;
        }
        .event-name {
            font-size: 1.1rem;
            color: #7f8c8d;
            margin-top: 10px;
        }
        .event-name span {
            color: #6c5ce7;
            font-weight: 700;
            text-transform: uppercase;
        }
        .btn-pdf {
            background-color: #2ecc71;
            color: white;
            border: none;
            border-radius: 20px;
            padding: 10px 25px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(46, 204, 113, 0.2);
            transition: all 0.3s;
        }
        .btn-pdf:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(46, 204, 113, 0.3);
            color: white;
            text-decoration: none;
        }
        .table-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 25px rgba(0,0,0,0.03);
            margin-top: 20px;
        }
        .custom-table {
            width: 100%;
            border-collapse: collapse;
        }
        .custom-table thead {
            background-color: #e9ecef;
        }
        .custom-table th {
            padding: 12px 20px;
            text-align: center;
            font-weight: 700;
            color: #2d3436;
            border-right: 1px solid #dee2e6;
            font-size: 0.9rem;
        }
        .custom-table th:last-child {
            border-right: none;
        }
        .custom-table td {
            padding: 15px 20px;
            text-align: center;
            color: #636e72;
            border-bottom: 1px solid #f1f2f6;
            font-size: 0.95rem;
        }
        .no-content {
            padding: 100px 0;
            text-align: center;
            color: #b2bec3;
            font-size: 1rem;
        }
        .total-badge {
            background-color: #e8f8f0;
            color: #2ecc71;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 700;
            display: inline-block;
            margin-top: 20px;
            float: right;
        }
        .btn-action-delete {
            color: #ff4757;
            background: rgba(255, 71, 87, 0.1);
            padding: 5px 15px;
            border-radius: 15px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.85rem;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn-action-delete:hover {
            background: #ff4757;
            color: white;
        }
    </style>
</head>
<body>

<div class="container-fluid">
    <a href="{{ path('front_evenements_show', {'id': evenement.id}) }}" class="back-link">
        ← Retour aux Détails
    </a>

    <div class="header-row">
        <div class="title-section">
            <h1>Participants Inscrits 👥</h1>
            <div class="event-name">
                Événement : <span>{{ evenement.titre }}</span>
            </div>
        </div>
        <div>
            <a href="{{ path('front_evenements_participants_pdf', {'id': evenement.id}) }}" class="btn-pdf">
                <i class="fa fa-file-pdf-o"></i> Exporter PDF
            </a>
        </div>
    </div>

    <div class="table-card">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width: 20%;">Nom</th>
                    <th style="width: 20%;">Prénom</th>
                    <th style="width: 30%;">Email</th>
                    <th style="width: 20%;">Téléphone</th>
                    <th style="width: 10%;">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for participation in evenement.participations %}
                    <tr>
                        <td>{{ participation.user.nom|default('-') }}</td>
                        <td>{{ participation.user.prenom|default('-') }}</td>
                        <td>{{ participation.user.email }}</td>
                        <td>{{ participation.user.numTel|default('-') }}</td>
                        <td>
                            <form action="{{ path('front_evenements_participants_remove', {'id': participation.id}) }}" method="POST" onsubmit="return confirm('Retirer ce participant ?');" style="margin:0">
                                <input type="hidden" name="_token" value="{{ csrf_token('remove' ~ participation.id) }}">
                                <button type="submit" class="btn-action-delete">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="no-content">
                            Aucun contenu dans la table
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="total-badge">
        Total : {{ evenement.participations|length }} inscrits
    </div>
</div>

<script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
<script src="{{ asset('front/js/bootstrap.js') }}"></script>

</body>
</html>
