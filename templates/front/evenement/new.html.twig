{% extends 'front/layout.html.twig' %}

{% set active_nav = 'events' %}
{% block title %}Pegasus | Add Event{% endblock %}

{% block extra_styles %}
<style>
  .event-form-shell { background: linear-gradient(180deg, #f2f5fb 0%, #ffffff 100%); padding: 44px 0 72px; }
  .event-form-head h1 { font-family:"Poppins",sans-serif; font-size:1.8rem; margin:0; color:#17233a; font-weight:700; }
  .event-form-head p { margin:6px 0 0; color:#5f6f8a; }
</style>
{% endblock %}

{% block body %}
<section class="event-form-shell">
  <div class="container">
    <div class="event-form-head mb-4 text-center">
      <h1>Add Event</h1>
      <p>Fill event details to create a new premium event.</p>
    </div>
    <div class="row justify-content-center">
      <div class="col-lg-10">
        {{ include('front/evenement/_form.html.twig') }}
      </div>
    </div>
  </div>
</section>
{% endblock %}
