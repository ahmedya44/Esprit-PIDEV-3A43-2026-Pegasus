<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { font-family: sans-serif; color: #333; }
        .header { text-align: center; margin-bottom: 30px; border-bottom: 2px solid #6c5ce7; padding-bottom: 10px; }
        .header h1 { color: #6c5ce7; margin: 0; }
        .header p { color: #777; margin: 5px 0; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th { background-color: #f2f2f2; padding: 10px; text-align: left; border-bottom: 1px solid #ddd; }
        td { padding: 10px; border-bottom: 1px solid #eee; }
        .footer { margin-top: 30px; text-align: right; font-weight: bold; color: #2ecc71; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Liste des Participants</h1>
        <p>Événement : {{ evenement.titre }}</p>
        <p>Date de l'événement : {{ evenement.date|date('d/m/Y') }}</p>
    </div>

    <table>
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Date d'inscription</th>
            </tr>
        </thead>
        <tbody>
            {% for participation in evenement.participations %}
                <tr>
                    <td>{{ participation.user.nom|default('-') }}</td>
                    <td>{{ participation.user.prenom|default('-') }}</td>
                    <td>{{ participation.user.email }}</td>
                    <td>{{ participation.user.numTel|default('-') }}</td>
                    <td>{{ participation.createdAt|date('d/m/Y H:i') }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" style="text-align: center; padding: 50px;">Aucun participant inscrit.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="footer">
        Total : {{ evenement.participations|length }} participants inscrits
    </div>
</body>
</html>
