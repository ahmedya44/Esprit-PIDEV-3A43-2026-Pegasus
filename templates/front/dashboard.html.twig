{# templates/front/dashboard.html.twig #}
<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

  <link rel="shortcut icon" href="{{ asset('front/images/favicon.png') }}" type="">
  <title>Artist Dashboard</title>

  <link rel="stylesheet" type="text/css" href="{{ asset('front/css/bootstrap.css') }}" />
  <link href="{{ asset('front/css/font-awesome.min.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/style.css') }}" rel="stylesheet" />
  <link href="{{ asset('front/css/responsive.css') }}" rel="stylesheet" />

  <style>
    .artist-shell { padding: 60px 0; }
    .artist-card {
      background: #ffffff;
      border-radius: 18px;
      box-shadow: 0 10px 25px rgba(0,0,0,.08);
      overflow: hidden;
    }
    .artist-side a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 16px;
      border-radius: 14px;
      text-decoration: none;
      color: #222;
      background: #f6f6f6;
      margin-bottom: 12px;
      font-weight: 600;
      transition: .2s ease;
    }
    .artist-side a:hover { transform: translateY(-1px); background: #ffe6b3; }
    .artist-side a.active { background: #ffbe33; color: #111; }
    .artist-side .num {
      width: 30px; height: 30px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: rgba(0,0,0,.08);
      font-weight: 800;
    }

    .artist-main-head {
      padding: 18px 22px;
      border-bottom: 1px solid rgba(0,0,0,.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .artist-main-head h3 { margin: 0; font-weight: 800; }
    .artist-main-body { padding: 22px; }

    /* QUIZZES 3 CARDS */
    .dash-cards { display: grid; gap: 18px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    @media (max-width: 992px) { .dash-cards { grid-template-columns: 1fr; } }

    .dash-card {
      background: #fff;
      border: 1px solid rgba(0,0,0,.08);
      border-radius: 16px;
      padding: 18px;
      display: flex;
      gap: 14px;
      align-items: flex-start;
      box-shadow: 0 8px 18px rgba(0,0,0,.06);
    }
    .dash-ico {
      width: 56px; height: 56px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      font-size: 22px;
      color: #111;
      background: #ffbe33;
      flex: 0 0 auto;
    }
    .dash-card h4 { margin: 0; font-weight: 900; font-size: 20px; }
    .dash-card p { margin: 6px 0 12px; color: #666; font-size: 14px; }
    .dash-card .btn { border-radius: 12px; font-weight: 800; }
  </style>
</head>

<body class="sub_page">
  {% set tab = app.request.query.get('tab') ?? 'courses' %}
  {% set view = app.request.query.get('view') ?? 'cards' %}

  <div class="hero_area">
    <div class="bg-box">
      <img src="{{ asset('front/images/hero-bg.jpg') }}" alt="">
    </div>

    {# ===== HEADER (same as courses page) ===== #}
    <header class="header_section">
      <div class="container">
        <nav class="navbar navbar-expand-lg custom_nav-container ">
          <a class="navbar-brand" href="{{ path('front_home') }}">
            <span>Feane</span>
          </a>

          <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                  aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class=""></span>
          </button>

          <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mx-auto ">
              <li class="nav-item">
                <a class="nav-link" href="{{ path('front_home') }}">Home</a>
              </li>

              <li class="nav-item">
                <a class="nav-link" href="{{ path('front_menu') }}">Menu</a>
              </li>

              <li class="nav-item">
                <a class="nav-link" href="{{ path('front_about') }}">About</a>
              </li>

              <li class="nav-item">
                <a class="nav-link" href="{{ path('front_book') }}">Book Table</a>
              </li>

              <li class="nav-item">
                <a class="nav-link" href="{{ path('app_courses') }}">Courses</a>
              </li>

              {# Dashboard is active here #}
              {% if is_granted('ROLE_ARTISTE') %}
                <li class="nav-item active">
                  <a class="nav-link" href="{{ path('artist_dashboard') }}">
                    Artist Dashboard <span class="sr-only">(current)</span>
                  </a>
                </li>
              {% endif %}

              
            </ul>

            {# SAME user_option as courses page #}
            <div class="user_option">

              {% if app.user %}
                <a href="{{ path('front_profile') }}" class="user_link profile_link">
                  <i class="fa fa-user" aria-hidden="true"></i>
                  <span class="profile_name">{{ app.user.username }}</span>
                </a>
              {% else %}
                <a href="{{ path('app_login') }}" class="user_link">
                  <i class="fa fa-user" aria-hidden="true"></i>
                </a>
              {% endif %}

              <a class="cart_link" href="#">
                <svg version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
                    x="0px" y="0px" viewBox="0 0 456.029 456.029" style="enable-background:new 0 0 456.029 456.029;" xml:space="preserve">
                  <g><g>
                    <path d="M345.6,338.862c-29.184,0-53.248,23.552-53.248,53.248c0,29.184,23.552,53.248,53.248,53.248
                    c29.184,0,53.248-23.552,53.248-53.248C398.336,362.926,374.784,338.862,345.6,338.862z" />
                  </g></g>
                  <g><g>
                    <path d="M439.296,84.91c-1.024,0-2.56-0.512-4.096-0.512H112.64l-5.12-34.304C104.448,27.566,84.992,10.67,61.952,10.67H20.48
                    C9.216,10.67,0,19.886,0,31.15c0,11.264,9.216,20.48,20.48,20.48h41.472c2.56,0,4.608,2.048,5.12,4.608l31.744,216.064
                    c4.096,27.136,27.648,47.616,55.296,47.616h212.992c26.624,0,49.664-18.944,55.296-45.056l33.28-166.4
                    C457.728,97.71,450.56,86.958,439.296,84.91z" />
                  </g></g>
                  <g><g>
                    <path d="M215.04,389.55c-1.024-28.16-24.576-50.688-52.736-50.688c-29.696,1.536-52.224,26.112-51.2,55.296
                    c1.024,28.16,24.064,50.688,52.224,50.688h1.024C193.536,443.31,216.576,418.734,215.04,389.55z" />
                  </g></g>
                </svg>
              </a>

              <form class="form-inline" action="#" method="get">
                <button class="btn my-2 my-sm-0 nav_search-btn" type="submit">
                  <i class="fa fa-search" aria-hidden="true"></i>
                </button>
              </form>

              {% if app.user %}
                <a href="{{ path('app_logout') }}" class="auth_btn auth_btn--danger">
                  Logout
                </a>
              {% else %}
                <a href="{{ path('app_login') }}" class="auth_btn auth_btn--outline">
                  Sign In
                </a>
                <a href="{{ path('app_register') }}" class="auth_btn auth_btn--filled">
                  Sign Up
                </a>
              {% endif %}

              <a href="#" class="order_online">
                Order Online
              </a>

            </div>
          </div>
        </nav>
      </div>
    </header>
  </div>

  {# ===== DASHBOARD ===== #}
  <section class="food_section layout_padding artist-shell">
    <div class="container">
      <div class="heading_container heading_center mb-4">
        <h2>Artist Dashboard</h2>
        <p class="text-muted mb-0">Manage your courses and quizzes from here.</p>
      </div>

      <div class="row g-4">

        {# LEFT MENU #}
        <div class="col-lg-3">
          <div class="artist-card p-3 artist-side">
            <a href="{{ path('artist_dashboard', { tab: 'courses' }) }}"
               class="{% if tab == 'courses' %}active{% endif %}">
              <span class="num">1</span>
              <span><i class="fa fa-book"></i> Courses</span>
            </a>

            <a href="{{ path('artist_dashboard', { tab: 'quizzes' }) }}"
               class="{% if tab == 'quizzes' %}active{% endif %}">
              <span class="num">2</span>
              <span><i class="fa fa-question-circle"></i> Quizzes</span>
            </a>
          </div>
        </div>

        {# RIGHT CONTENT #}
        <div class="col-lg-9">
          <div class="artist-card">

            <div class="artist-main-head">
              <h3 class="h5">{% if tab == 'quizzes' %}Quizzes{% else %}Courses{% endif %}</h3>

              {% if tab == 'quizzes' %}
                <a href="{{ path('artist_quizzes_new') }}"
                   class="btn btn-warning btn-sm"
                   style="border-radius:12px; font-weight:700;">
                  + Create Quiz
                </a>
              {% else %}
                <a href="{{ path('artist_courses_new') }}"
                   class="btn btn-warning btn-sm"
                   style="border-radius:12px; font-weight:700;">
                  + Add Course
                </a>
              {% endif %}
            </div>

            <div class="artist-main-body">

              {# FLASH #}
              {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                  <strong>Success!</strong> {{ message }}
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              {% endfor %}
              {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <strong>Error!</strong> {{ message }}
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              {% endfor %}

              {% if tab == 'courses' %}

                {# ===== COURSES TABLE ===== #}
                <div class="table-responsive">
                  <table class="table align-middle bg-white" style="border-radius:14px; overflow:hidden;">
                    <thead style="background:#f7f7f7;">
                      <tr>
                        <th style="width:70px;">#</th>
                        <th>Course</th>
                        <th style="width:140px;">Status</th>
                        <th style="width:180px;">Created</th>
                        <th style="width:160px;" class="text-end">Actions</th>
                      </tr>
                    </thead>

                    <tbody>
                      {% for course in courses %}
                        <tr>
                          <td class="fw-bold">{{ course.id }}</td>

                          <td>
                            <div class="d-flex align-items-center gap-2">
                              {% if course.thumbnailUrl %}
                                <img src="{{ course.thumbnailUrl }}"
                                     alt=""
                                     style="width:44px;height:44px;object-fit:cover;border-radius:12px;">
                              {% endif %}

                              <div>
                                <div class="fw-bold">{{ course.title }}</div>
                                <div class="text-muted small">
                                  {{ course.description|default('')|slice(0,70) }}{% if course.description and course.description|length > 70 %}...{% endif %}
                                </div>
                              </div>
                            </div>
                          </td>

                          <td>
                            {% set st = course.status|default('DRAFT') %}
                            <span class="badge {% if st == 'PUBLISHED' %}badge-success{% else %}badge-warning{% endif %}">
                              {{ st }}
                            </span>
                          </td>

                          <td>{{ course.createdAt ? course.createdAt|date('Y-m-d H:i') : '-' }}</td>

                          <td class="text-end">
                            <a class="btn btn-sm btn-warning"
                               style="border-radius:10px;font-weight:700;"
                               href="{{ path('artist_courses_edit', { id: course.id }) }}">
                              Edit
                            </a>

                            <form method="post"
                                  action="{{ path('artist_courses_delete', { id: course.id }) }}"
                                  style="display:inline-block"
                                  onsubmit="return confirm('Delete this course?');">
                              <input type="hidden" name="_token" value="{{ csrf_token('delete_course_' ~ course.id) }}">
                              <button class="btn btn-sm btn-danger"
                                      style="border-radius:10px;font-weight:700;"
                                      type="submit">
                                Delete
                              </button>
                            </form>
                          </td>
                        </tr>
                      {% else %}
                        <tr>
                          <td colspan="5" class="text-center text-muted py-4">
                            No courses found. Click <b>Add Course</b> to create your first one.
                          </td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>

              {% else %}

                {# ===== QUIZZES TAB ===== #}

                {% if view == 'manage' %}

                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-bold">All Quizzes</div>

                    <a href="{{ path('artist_dashboard', { tab: 'quizzes' }) }}"
                       class="btn btn-sm btn-secondary"
                       style="border-radius:12px;font-weight:800;">
                      Back
                    </a>
                  </div>

                  <div class="table-responsive">
                    <table class="table align-middle bg-white" style="border-radius:14px; overflow:hidden;">
                      <thead style="background:#f7f7f7;">
                        <tr>
                          <th style="width:70px;">#</th>
                          <th>Quiz</th>
                          <th style="width:240px;">Course</th>
                          <th style="width:140px;">Passing</th>
                          <th style="width:160px;" class="text-end">Actions</th>
                        </tr>
                      </thead>

                      <tbody>
                        {% for quiz in quizzes %}
                          <tr>
                            <td class="fw-bold">{{ quiz.id }}</td>

                            <td>
                              <div class="fw-bold">{{ quiz.title }}</div>
                              <div class="text-muted small">
                                {% if quiz.timeLimit is defined and quiz.timeLimit %}⏱ {{ quiz.timeLimit }} min{% endif %}
                                {% if quiz.attemptLimit is defined and quiz.attemptLimit %} · 🎯 {{ quiz.attemptLimit }} attempts{% endif %}
                              </div>
                            </td>

                            <td>{{ quiz.course ? quiz.course.title : '-' }}</td>

                            <td>
                              {% if quiz.passingScore is defined and quiz.passingScore is not null %}
                                <span class="badge badge-success">{{ quiz.passingScore }}%</span>
                              {% else %}
                                <span class="badge badge-secondary">-</span>
                              {% endif %}
                            </td>

                            <td class="text-end">
                              <a class="btn btn-sm btn-warning"
                                 style="border-radius:10px;font-weight:700;"
                                 href="{{ path('artist_quizzes_edit', { id: quiz.id }) }}">
                                Edit
                              </a>

                              <form method="post"
                                    action="{{ path('artist_quizzes_delete', { id: quiz.id }) }}"
                                    style="display:inline-block"
                                    onsubmit="return confirm('Delete this quiz?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_quiz_' ~ quiz.id) }}">
                                <button class="btn btn-sm btn-danger"
                                        style="border-radius:10px;font-weight:700;"
                                        type="submit">
                                  Delete
                                </button>
                              </form>
                            </td>
                          </tr>
                        {% else %}
                          <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                              No quizzes found. Click <b>Create Quiz</b> to add your first final quiz.
                            </td>
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>

                {% elseif view == 'stats' %}

                  <div class="alert alert-info mb-0">
                    Stats view coming next ✅ (we’ll add pass rate, attempts, etc.)
                    <br>
                    <a class="btn btn-sm btn-secondary mt-3"
                       style="border-radius:12px;font-weight:800;"
                       href="{{ path('artist_dashboard', { tab: 'quizzes' }) }}">
                      Back
                    </a>
                  </div>

                {% else %}

                  <div class="dash-cards">

                    <div class="dash-card">
                      <div class="dash-ico"><i class="fa fa-plus"></i></div>
                      <div>
                        <div class="text-muted" style="font-weight:800;">Create</div>
                        <h4>New Final Quiz</h4>
                        <p>Create the final quiz for a course (1 quiz per course).</p>
                        <a href="{{ path('artist_quizzes_new') }}" class="btn btn-warning btn-sm">+ Create Quiz</a>
                      </div>
                    </div>

                    <div class="dash-card">
                      <div class="dash-ico" style="background:#4aa3ff;"><i class="fa fa-pencil"></i></div>
                      <div>
                        <div class="text-muted" style="font-weight:800;">Manage</div>
                        <h4>Edit / Delete</h4>
                        <p>Manage quizzes already created.</p>
                        <a href="{{ path('artist_dashboard', { tab: 'quizzes', view: 'manage' }) }}"
                           class="btn btn-primary btn-sm">
                          Manage Quizzes
                        </a>
                      </div>
                    </div>

                    <div class="dash-card">
                      <div class="dash-ico" style="background:#2ecc71;"><i class="fa fa-bar-chart"></i></div>
                      <div>
                        <div class="text-muted" style="font-weight:800;">Statistics</div>
                        <h4>{{ totalQuizzes is defined ? totalQuizzes : '—' }} quizzes</h4>
                        <p>View quiz stats, pass rates, and attempts.</p>
                        <a href="{{ path('artist_dashboard', { tab: 'quizzes', view: 'stats' }) }}"
                           class="btn btn-success btn-sm">
                          View Stats
                        </a>
                      </div>
                    </div>

                  </div>

                {% endif %}

              {% endif %}

            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <script src="{{ asset('front/js/jquery-3.4.1.min.js') }}"></script>
  <script src="{{ asset('front/js/bootstrap.js') }}"></script>
</body>
</html>