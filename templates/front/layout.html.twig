  <style>
    .forum-shell {
      padding: 40px 0 70px;
      background: #f5f5f5;
      min-height: 60vh;
    }
    .forum-card {
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
      padding: 24px;
    }
    .confirm3d-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(8, 10, 14, 0.45);
      backdrop-filter: blur(2px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
      padding: 20px;
    }
    .confirm3d-backdrop.is-open { display: flex; }
    .confirm3d-modal {
      width: min(460px, 100%);
      background: linear-gradient(160deg, #ffffff, #f7f8fb);
      border: 1px solid #e5e7ef;
      border-radius: 18px;
      box-shadow: 0 28px 60px rgba(15, 23, 42, 0.25);
      transform: perspective(850px) rotateX(9deg) translateY(8px) scale(0.96);
      opacity: 0;
      transition: transform .22s ease, opacity .22s ease;
      overflow: hidden;
    }
    .confirm3d-backdrop.is-open .confirm3d-modal {
      transform: perspective(850px) rotateX(0deg) translateY(0) scale(1);
      opacity: 1;
    }
    .confirm3d-head {
      padding: 14px 18px;
      font-weight: 700;
      color: #111827;
      border-bottom: 1px solid #eceef4;
      background: #ffffff;
    }
    .confirm3d-body {
      padding: 16px 18px;
      color: #374151;
      line-height: 1.45;
    }
    .confirm3d-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding: 14px 18px 18px;
    }
    .ai-suggest-box {
      margin-top: 8px;
      border: 1px solid #e6eaf5;
      border-radius: 10px;
      background: #fbfcff;
      padding: 8px;
      display: none;
    }
    .ai-suggest-box.is-open {
      display: block;
    }
    .ai-suggest-title {
      font-size: .8rem;
      color: #64748b;
      margin-bottom: 6px;
      font-weight: 600;
    }
    .ai-suggest-items {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .ai-suggest-item {
      border: 1px solid #d8deee;
      background: #fff;
      border-radius: 8px;
      padding: 7px 10px;
      text-align: left;
      font-size: .9rem;
      line-height: 1.35;
      cursor: pointer;
    }
    .ai-suggest-item:hover {
      background: #f1f6ff;
      border-color: #9fb2e6;
    }
  </style>

  {% block extra_styles %}{% endblock %}
</head>
