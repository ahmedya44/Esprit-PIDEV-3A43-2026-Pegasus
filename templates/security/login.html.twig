{% extends 'front/layout.html.twig' %}

{% set active_nav = 'forum' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<section class="forum-shell">
    <div class="container" style="max-width: 520px;">
        <div class="forum-card">
            <h1 class="h4 mb-3">Connexion</h1>

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post">
                <div class="form-group">
                    <label for="username">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" required autofocus>
                </div>
                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" name="_password" id="password" class="form-control" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-warning w-100" type="submit">Se connecter</button>
            </form>
        </div>
    </div>
</section>
{% endblock %}

