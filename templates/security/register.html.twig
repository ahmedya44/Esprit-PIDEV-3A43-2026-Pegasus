              {{ form_label(form.instagram, 'Instagram URL (optional)') }}
              {{ form_widget(form.instagram, {'attr': {'class': 'form-control', 'placeholder': 'https://instagram.com/your-account'}}) }}
              {% if form_errors(form.instagram) %}
