              {% if form_errors(form.bio) %}
                <div class="form-error">
                  {{ form_errors(form.bio) }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if form.styles is defined %}
            <div class="form-group">
              {{ form_label(form.styles, 'Styles (optional)') }}
              {{ form_widget(form.styles, {'attr': {'class': 'form-control', 'placeholder': 'e.g. Pop, Jazz, Electro'}}) }}
              {% if form_errors(form.styles) %}
                <div class="form-error">
                  {{ form_errors(form.styles) }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if form.facebook is defined %}
            <div class="form-group">
              {{ form_label(form.facebook, 'Facebook URL (optional)') }}
              {{ form_widget(form.facebook, {'attr': {'class': 'form-control', 'placeholder': 'https://facebook.com/your-page'}}) }}
              {% if form_errors(form.facebook) %}
                <div class="form-error">
                  {{ form_errors(form.facebook) }}
                </div>
              {% endif %}
