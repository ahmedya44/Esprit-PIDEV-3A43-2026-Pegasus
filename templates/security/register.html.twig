  <section class="auth_section layout_padding">
    <div class="container">
      <div class="auth_container">
        <h2>Create {{ selected_role_label is defined ? selected_role_label : 'User' }} Account</h2>
        {% if selected_role is defined %}
          <div class="auth_link" style="margin-top: -10px; margin-bottom: 15px;">
            <a href="{{ path('app_register') }}">Change account type</a>
          </div>
        {% endif %}

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
          {% if form_errors(form) %}
            <div class="alert alert-danger">
              {{ form_errors(form) }}
            </div>
          {% endif %}

          <div class="form-group">
            <label for="{{ form.email.vars.id }}">Email<span class="required-star">*</span></label>
            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Enter your email'}}) }}
            {% if form_errors(form.email) %}
              <div class="form-error">
                {{ form_errors(form.email) }}
              </div>
            {% endif %}
          </div>

          <div class="form-group">
            <label for="{{ form.username.vars.id }}">Username<span class="required-star">*</span></label>
            {{ form_widget(form.username, {'attr': {'class': 'form-control', 'placeholder': 'Choose a username'}}) }}
            {% if form_errors(form.username) %}
              <div class="form-error">
                {{ form_errors(form.username) }}
              </div>
            {% endif %}
          </div>

          <div class="form-group">
            <label for="{{ form.plainPassword.first.vars.id }}">Password<span class="required-star">*</span></label>
            <div class="password-field">
              {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control js-password-input', 'placeholder': 'Enter a password'}}) }}
              <button type="button" class="password-toggle js-password-toggle" aria-label="Show or hide password">
                <i class="fa fa-eye" aria-hidden="true"></i>
              </button>
            </div>
            {% if form_errors(form.plainPassword.first) %}
              <div class="form-error">
                {{ form_errors(form.plainPassword.first) }}
              </div>
            {% endif %}
            <small>Password must be at least 6 characters</small>
          </div>

          <div class="form-group">
            <label for="{{ form.plainPassword.second.vars.id }}">Confirm password<span class="required-star">*</span></label>
            <div class="password-field">
              {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control js-password-input', 'placeholder': 'Confirm your password'}}) }}
              <button type="button" class="password-toggle js-password-toggle" aria-label="Show or hide password">
                <i class="fa fa-eye" aria-hidden="true"></i>
              </button>
            </div>
            {% if form_errors(form.plainPassword.second) %}
              <div class="form-error">
                {{ form_errors(form.plainPassword.second) }}
              </div>
            {% endif %}
            {% if form_errors(form.plainPassword) %}
              <div class="form-error">
                {{ form_errors(form.plainPassword) }}
              </div>
            {% endif %}
          </div>

          <div class="form-group">
            {{ form_label(form.phone, 'Phone (optional)') }}
