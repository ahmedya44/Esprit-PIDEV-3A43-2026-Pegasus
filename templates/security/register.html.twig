              {{ form_label(form.portfolioUrl, 'Portfolio URL (optional)') }}
              {{ form_widget(form.portfolioUrl, {'attr': {'class': 'form-control', 'placeholder': 'https://your-portfolio.com'}}) }}
              {% if form_errors(form.portfolioUrl) %}
                <div class="form-error">
                  {{ form_errors(form.portfolioUrl) }}
                </div>
              {% endif %}
            </div>
          {% endif %}

          <button type="submit" class="btn-submit">Sign Up</button>
        {{ form_end(form) }}
