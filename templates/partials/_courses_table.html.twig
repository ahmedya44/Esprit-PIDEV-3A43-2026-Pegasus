{# templates/partials/_courses_table.html.twig #}

{# Optional: show header/breadcrumbs only if you want #}
{% if show_header|default(false) %}
  <div class="page-header">
    <h3 class="fw-bold mb-3">{{ title|default('Courses') }}</h3>
  </div>
{% endif %}

{# Flash messages #}
{% for message in app.flashes('success') %}
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <strong>Success!</strong> {{ message }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
{% endfor %}
{% for message in app.flashes('error') %}
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <strong>Error!</strong> {{ message }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
{% endfor %}

<div class="card">
  <div class="card-header d-flex align-items-center justify-content-between">
    <div class="card-title mb-0">{{ card_title|default('Your courses') }}</div>

    <a href="{{ new_path }}" class="btn btn-primary btn-sm">
      <i class="fa fa-plus me-1"></i>
      {{ new_label|default('Add Course') }}
    </a>
  </div>

  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle {% if table_id is defined %}{{ table_id }}{% endif %}" {% if table_dom_id is defined %}id="{{ table_dom_id }}"{% endif %}>
        <thead>
        <tr>
          <th style="width: 70px;">#</th>
          <th>Course</th>
          <th style="width: 140px;">Status</th>
          <th style="width: 180px;">Created</th>
          <th class="text-end" style="width: 160px;">Actions</th>
        </tr>
        </thead>

        <tbody>
        {% for course in courses %}
          <tr>
            <td>{{ course.id }}</td>

            <td>
              <div class="d-flex align-items-center gap-2">
                {% if course.thumbnailUrl %}
                  <img
                    src="{{ course.thumbnailUrl }}"
                    alt=""
                    style="width:44px;height:44px;object-fit:cover;border-radius:10px;"
                  >
                {% endif %}

                <div>
                  <div class="fw-bold">{{ course.title }}</div>
                  <div class="text-muted small">
                    {{ course.description|default('')|slice(0, 70) }}{% if course.description and course.description|length > 70 %}...{% endif %}
                  </div>
                </div>
              </div>
            </td>

            <td>
              {% set st = course.status|default('DRAFT') %}
              {% if st == 'PUBLISHED' %}
                <span class="badge badge-success">PUBLISHED</span>
              {% elseif st == 'HIDDEN' %}
                <span class="badge badge-secondary">HIDDEN</span>
              {% else %}
                <span class="badge badge-warning">DRAFT</span>
              {% endif %}
            </td>

            <td>{{ course.createdAt ? course.createdAt|date('Y-m-d H:i') : '-' }}</td>

            <td class="text-end">
              <a href="{{ edit_path(course) }}" class="btn btn-sm btn-primary">
                <i class="fa fa-edit"></i>
              </a>

              <form
                method="post"
                action="{{ delete_path(course) }}"
                style="display:inline-block"
                onsubmit="return confirm('Delete this course?');"
              >
                <input type="hidden" name="_token" value="{{ csrf_token('delete_course_' ~ course.id) }}">
                <button class="btn btn-sm btn-danger" type="submit">
                  <i class="fa fa-trash"></i>
                </button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="5" class="text-center text-muted py-4">
              No courses found. Click <b>Add Course</b> to create your first one.
            </td>
          </tr>
        {% endfor %}
        </tbody>

      </table>
    </div>
  </div>
</div>