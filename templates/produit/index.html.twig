{% extends 'front/layout.html.twig' %}

{% set active_nav = 'market' %}

{% block title %}Market{% endblock %}

{% block body %}
<section class="forum-shell">
  <div class="container">
    <div class="forum-card">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-1">Market</h1>
          <p class="text-muted mb-0">Browse all products.</p>
        </div>
        <a href="{{ path('app_produit_new') }}" class="btn btn-warning">Add Product</a>
      </div>

      {% for type, messages in app.flashes %}
        {% for message in messages %}
          <div class="alert alert-{{ type == 'error' ? 'danger' : type }} mb-3">{{ message }}</div>
        {% endfor %}
      {% endfor %}

      <form method="get" action="{{ path('app_produit_index') }}" class="row g-2 mb-4" data-live-search-form="1">
        <div class="col-md-5">
          <input type="text" name="search" value="{{ search }}" class="form-control" placeholder="Search products..." data-live-search-input="1">
        </div>
        <div class="col-md-3">
          <select name="categorie" class="form-control" data-live-search-filter="1">
            <option value="">All categories</option>
            {% for categorie in categories %}
              <option value="{{ categorie.id }}" {% if categorieId == categorie.id ~ '' %}selected{% endif %}>{{ categorie.nom }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-3">
          <select name="tri" class="form-control" data-live-search-filter="1">
            <option value="">Sort by...</option>
            <option value="prix_asc" {% if tri == 'prix_asc' %}selected{% endif %}>Price low to high</option>
            <option value="prix_desc" {% if tri == 'prix_desc' %}selected{% endif %}>Price high to low</option>
            <option value="nom_asc" {% if tri == 'nom_asc' %}selected{% endif %}>Name A-Z</option>
            <option value="nom_desc" {% if tri == 'nom_desc' %}selected{% endif %}>Name Z-A</option>
          </select>
        </div>
        <div class="col-md-1">
          <button type="submit" class="btn btn-dark w-100"><i class="fa fa-search"></i></button>
        </div>
      </form>

      <div class="row">
        {% for produit in produits %}
          <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
              {% if produit.image %}
                <img src="{{ asset('uploads/images/produits/' ~ produit.image) }}" class="card-img-top" alt="{{ produit.nom }}" style="height: 220px; object-fit: cover;">
              {% else %}
                <img src="{{ asset('front/images/f1.png') }}" class="card-img-top" alt="{{ produit.nom }}" style="height: 220px; object-fit: cover;">
              {% endif %}
              <div class="card-body d-flex flex-column">
                <h5 class="card-title">{{ produit.nom }}</h5>
                <p class="card-text text-muted">{{ produit.description ? produit.description|slice(0, 100) : 'No description' }}{% if produit.description and produit.description|length > 100 %}...{% endif %}</p>
                <div class="mt-auto d-flex justify-content-between align-items-center">
                  <strong>{{ produit.prix }} EUR</strong>
                  <a href="{{ path('app_produit_show', {'id': produit.id}) }}" class="btn btn-sm btn-outline-dark">Details</a>
                </div>
              </div>
            </div>
          </div>
        {% else %}
          <div class="col-12">
            <div class="alert alert-light border text-center mb-0">No products found.</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% endblock %}
