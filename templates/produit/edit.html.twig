{% extends 'front/layout.html.twig' %}

{% set active_nav = 'market' %}

{% block title %}Edit {{ produit.nom }}{% endblock %}

{% block body %}
<section class="forum-shell">
  <div class="container">
    <div class="forum-card" style="max-width: 900px; margin: 0 auto;">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Edit Product</h1>
        <a href="{{ path('app_produit_index') }}" class="btn btn-sm btn-outline-secondary">Back</a>
      </div>

      {{ include('produit/_form.html.twig', {'button_label': 'Update'}) }}

      <div class="mt-3 d-flex justify-content-end">
        {{ include('produit/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
</section>
{% endblock %}
