{% extends 'base_front.html.twig' %}

{% block title %}Order Summary - Pegasus{% endblock %}

{% block body %}
<section class="market-shell">
  <div class="container">
    {% include 'produit/_shop_nav.html.twig' with {shop_active: 'cart'} %}

    <div class="market-panel">
      <div class="market-hero">
        <div>
          <div class="market-eyebrow">Checkout</div>
          <h1 class="market-title">Order summary</h1>
          <p class="market-copy">Confirm the products and total before placing your order.</p>
        </div>
      </div>

      <div class="row">
        <div class="col-lg-8 mb-4 mb-lg-0">
          <div class="market-table-card">
            <div class="table-responsive">
              <table class="table mb-0">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>Unit price</th>
                    <th>Qty</th>
                    <th>Subtotal</th>
                  </tr>
                </thead>
                <tbody>
                  {% for ligne in lignes %}
                    <tr>
                      <td>
                        {% if ligne.produit.imageUrl %}
                          <img src="{{ ligne.produit.imageUrl }}" alt="{{ ligne.produit.nom }}" style="width: 52px; height: 52px; object-fit: cover; border-radius: 8px; margin-right: 10px;">
                        {% endif %}
                        <strong>{{ ligne.produit.nom }}</strong>
                      </td>
                      <td>{{ ligne.prixUnitaire|number_format(2, '.', ' ') }} DT</td>
                      <td>{{ ligne.quantite }}</td>
                      <td><strong>{{ (ligne.prixUnitaire * ligne.quantite)|number_format(2, '.', ' ') }} DT</strong></td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="market-table-card p-4">
            <h2 class="h5 font-weight-bold mb-3">Total</h2>
            <div class="d-flex justify-content-between mb-3">
              <span>Order total</span>
              <strong class="product-price">{{ panier.total|number_format(2, '.', ' ') }} DT</strong>
            </div>
            <form method="post" action="{{ path('app_commande_confirmer') }}" class="mb-2">
              <input type="hidden" name="_token" value="{{ csrf_token('commande') }}">
              <input type="hidden" name="panier_id" value="{{ panierId }}">
              <button type="submit" class="btn btn-warning w-100">Confirm order</button>
            </form>
            <a href="{{ path('app_panier_index') }}" class="btn btn-outline-secondary w-100">Back to cart</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% endblock %}
