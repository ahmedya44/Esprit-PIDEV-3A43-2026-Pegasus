<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="740.0" prefWidth="1180.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pegasus.controllers.back.CourseSectionsController"
            styleClass="course-builder-root">

    <top>
        <VBox spacing="14.0" styleClass="course-builder-header">
            <Label fx:id="lblCourseTitle" text="Course Builder" styleClass="course-builder-title" />
            <Label fx:id="lblCourseSubtitle" text="Organize sections and lessons for this course." styleClass="course-builder-subtitle" />

            <HBox spacing="12.0">
                <Label fx:id="lblSectionCount" text="0 section(s)" styleClass="course-builder-pill" />
                <Label fx:id="lblVideoCount" text="0 video lesson(s)" styleClass="course-builder-pill course-builder-pill-dark" />
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="24.0" style="-fx-padding: 0 28 28 28;">
            <VBox prefWidth="320.0" minWidth="290.0" spacing="18.0" styleClass="course-builder-sidebar">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Sections" styleClass="course-builder-card-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="+ Add Section" onAction="#openCreateSectionDialog" styleClass="artist-add-button compact-add-button" />
                </HBox>

                <Label text="Double-clicking a course opens this workspace. Build intro, content, and conclusion blocks here." wrapText="true" styleClass="course-builder-helper" />

                <ListView fx:id="lvSections" VBox.vgrow="ALWAYS" styleClass="section-list-view" />
            </VBox>

            <VBox spacing="20.0" styleClass="course-builder-card" HBox.hgrow="ALWAYS">
                <HBox styleClass="course-builder-card-header">
                    <VBox spacing="6.0">
                        <Label fx:id="lblSelectedSectionTitle" text="Choose a section" styleClass="course-builder-card-title" />
                        <Label fx:id="lblSelectedSectionMeta" text="Select a section from the left to manage its learning materials." styleClass="course-builder-card-subtitle" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox spacing="10.0">
                        <Button fx:id="btnEditSection" text="Edit Section" onAction="#openEditSectionDialog" styleClass="warning-button" disable="true" />
                        <Button fx:id="btnDeleteSection" text="Delete Section" onAction="#deleteSelectedSection" styleClass="delete-red-button" disable="true" />
                    </HBox>
                </HBox>

                <HBox spacing="14.0" styleClass="course-resource-strip">
                    <VBox HBox.hgrow="ALWAYS" styleClass="resource-card">
                        <Label text="Text Notes" styleClass="resource-card-title" />
                        <Label text="Great for introductions, study summaries, or quick lesson reminders." wrapText="true" styleClass="resource-card-copy" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" styleClass="resource-card">
                        <Label text="PDF Handouts" styleClass="resource-card-title" />
                        <Label text="Perfect for worksheets, references, and downloadable support materials." wrapText="true" styleClass="resource-card-copy" />
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" styleClass="resource-card resource-card-accent">
                        <Label text="Video Lessons" styleClass="resource-card-title" />
                        <Label fx:id="lblSelectedSectionHint" text="Use videos to anchor the main flow of this section." wrapText="true" styleClass="resource-card-copy" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label text="Lesson Videos" styleClass="course-builder-subsection-title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnAddVideo" text="+ Add Video" onAction="#openCreateVideoDialog" styleClass="artist-add-button compact-add-button" disable="true" />
                </HBox>

                <TableView fx:id="tvVideos" VBox.vgrow="ALWAYS" styleClass="artist-dashboard-table course-video-table">
                    <columns>
                        <TableColumn fx:id="colVideoTitle" prefWidth="320.0" text="Lesson" />
                        <TableColumn fx:id="colVideoDuration" prefWidth="150.0" text="Duration" />
                        <TableColumn fx:id="colVideoPreview" prefWidth="150.0" text="Access" />
                        <TableColumn fx:id="colVideoLink" prefWidth="320.0" text="Video URL" />
                        <TableColumn fx:id="colVideoActions" prefWidth="180.0" text="Actions" />
                    </columns>
                </TableView>

                <Label fx:id="lblEmptyVideos" text="Start by adding a video lesson to the selected section." styleClass="course-builder-empty" visible="false" managed="false" />
            </VBox>
        </HBox>
    </center>
</BorderPane>
