<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pegasus.controllers.back.BackEventController" prefWidth="1100" prefHeight="850"
            styleClass="root">

    <stylesheets>
        <java.net.URL value="@css/style-back.css"/>
    </stylesheets>

    <top>
        <VBox spacing="0">
            <HBox styleClass="top-nav" alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 12 20;">
                <children>
                    <Label text="Pegasus" styleClass="brand-label" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Button text="Home" styleClass="home-button" onAction="#goHome" />
                    <Button text="Gallery" styleClass="secondary-button" onAction="#goGallery" />
                    <Button text="Events" styleClass="gold-button" onAction="#goEvents" />
                    <Button text="Backoffice" styleClass="secondary-button" onAction="#goBackoffice" />
                </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar" style="-fx-padding: 20;">
                <Label text="Gestion des Evenements" style="-fx-font-size: 26px; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-family: 'Segoe UI';" />
                <Pane HBox.hgrow="ALWAYS" />
                <Button text="Retour Dashboard" onAction="#retourDashboard" styleClass="btn-danger" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="+ Ajouter" onAction="#ajouterEvenement" styleClass="btn-primary" />
                <Button text="Modifier" onAction="#modifierEvenement" styleClass="btn-warning" />
                <Button text="Supprimer" onAction="#supprimerEvenement" styleClass="btn-danger" />

                <Pane HBox.hgrow="ALWAYS" />

                <TextField fx:id="searchField" promptText="Rechercher par titre ou lieu..." styleClass="text-field" prefWidth="250" />
            </HBox>

            <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colTitre" text="Titre" prefWidth="250">
                        <cellValueFactory><PropertyValueFactory property="titre" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="date" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colHeure" text="Heure" prefWidth="100">
                        <cellValueFactory><PropertyValueFactory property="heure" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colLieu" text="Lieu" prefWidth="200">
                        <cellValueFactory><PropertyValueFactory property="lieu" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colCapacite" text="Capacite" prefWidth="100">
                        <cellValueFactory><PropertyValueFactory property="capacite_max" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colPrix" text="Prix" prefWidth="100">
                        <cellValueFactory><PropertyValueFactory property="prix" /></cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>
