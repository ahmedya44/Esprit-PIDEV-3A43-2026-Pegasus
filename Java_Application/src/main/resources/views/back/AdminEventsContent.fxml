<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pegasus.controllers.back.BackEventController">
    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="admin-toolbar">
        <VBox spacing="4.0">
            <Label text="Events" styleClass="admin-workspace-title" />
            <Label text="Manage and oversee all Pegasus events." styleClass="admin-workspace-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Exporter PDF" onAction="#exporterPDF" styleClass="admin-primary-button" />
        <TextField fx:id="searchField" promptText="Rechercher par titre..." prefWidth="280.0" styleClass="admin-search-field" />
    </HBox>

    <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS" prefHeight="560.0" styleClass="admin-table">
        <columns>
            <TableColumn text="Titre" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="titre" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Date" prefWidth="85">
                <cellValueFactory><PropertyValueFactory property="date" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Heure" prefWidth="75">
                <cellValueFactory><PropertyValueFactory property="heure" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Lieu" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="lieu" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colDescription" text="Description" prefWidth="350">
                <cellValueFactory><PropertyValueFactory property="description" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colImage" text="Image" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="image" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Capacité" prefWidth="80">
                <cellValueFactory><PropertyValueFactory property="capacite_max" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Prix" prefWidth="70">
                <cellValueFactory><PropertyValueFactory property="prix" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="100">
                <cellValueFactory><PropertyValueFactory property="statut" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="320" />
        </columns>
    </TableView>
</VBox>
