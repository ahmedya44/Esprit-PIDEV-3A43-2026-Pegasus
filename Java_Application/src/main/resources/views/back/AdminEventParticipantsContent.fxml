<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.SplitPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pegasus.controllers.back.BackParticipantController">
    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="admin-toolbar">
        <VBox spacing="4.0">
            <Label text="Participants by Event" styleClass="admin-workspace-title" />
            <Label text="Select an event to review registered users." styleClass="admin-workspace-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="searchEventField" promptText="Search events..." prefWidth="280.0" styleClass="admin-search-field" />
    </HBox>

    <SplitPane dividerPositions="0.38" VBox.vgrow="ALWAYS" styleClass="admin-split-pane">
        <items>
            <VBox spacing="12.0" styleClass="admin-workspace-shell">
                <Label text="Events" styleClass="admin-panel-title" />
                <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS" prefHeight="560.0" styleClass="admin-table admin-data-table">
                    <columns>
                        <TableColumn fx:id="colEventTitre" text="Event" prefWidth="260">
                            <cellValueFactory><PropertyValueFactory property="titre" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colEventDate" text="Date" prefWidth="120">
                            <cellValueFactory><PropertyValueFactory property="date" /></cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="12.0" styleClass="admin-workspace-shell">
                <Label fx:id="selectedEventLabel" text="Select an event" styleClass="admin-panel-title" />
                <TableView fx:id="participantsTable" VBox.vgrow="ALWAYS" prefHeight="560.0" styleClass="admin-table admin-data-table">
                    <columns>
                        <TableColumn fx:id="colUserNom" text="Name" prefWidth="150">
                            <cellValueFactory><PropertyValueFactory property="nom" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colUserPrenom" text="First name" prefWidth="150">
                            <cellValueFactory><PropertyValueFactory property="prenom" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colUserEmail" text="Email" prefWidth="250">
                            <cellValueFactory><PropertyValueFactory property="email" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colUserTel" text="Phone" prefWidth="150">
                            <cellValueFactory><PropertyValueFactory property="telephone" /></cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </VBox>
        </items>
    </SplitPane>
</VBox>
