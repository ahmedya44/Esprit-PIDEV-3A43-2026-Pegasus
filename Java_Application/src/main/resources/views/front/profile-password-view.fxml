<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="24.0" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.front.ProfilePasswordController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="28.0" styleClass="top-nav">
            <children>
                <Label styleClass="brand-label" text="Pegasus" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onBackToProfile" styleClass="secondary-button" text="BACK TO PROFILE" />
                <Button mnemonicParsing="false" onAction="#onLogout" styleClass="secondary-button" text="LOG OUT" />
            </children>
        </HBox>

        <VBox alignment="CENTER" maxWidth="760.0" prefWidth="760.0" spacing="12.0" styleClass="card">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <children>
                <Label styleClass="card-title" text="Reset Password" />
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label prefWidth="170.0" styleClass="form-label" text="New Password" />
                        <PasswordField fx:id="newPasswordField" prefWidth="440.0" styleClass="input-field" />
                        <TextField fx:id="newPasswordVisibleField" managed="false" prefWidth="440.0" styleClass="input-field" visible="false" />
                        <Button fx:id="toggleNewPasswordButton" mnemonicParsing="false" onAction="#onToggleNewPassword" prefWidth="88.0" styleClass="eye-button" text="Show" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label prefWidth="170.0" styleClass="form-label" text="Confirm Password" />
                        <PasswordField fx:id="confirmPasswordField" prefWidth="440.0" styleClass="input-field" />
                        <TextField fx:id="confirmPasswordVisibleField" managed="false" prefWidth="440.0" styleClass="input-field" visible="false" />
                        <Button fx:id="toggleConfirmPasswordButton" mnemonicParsing="false" onAction="#onToggleConfirmPassword" prefWidth="88.0" styleClass="eye-button" text="Show" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onSaveNewPassword" prefWidth="220.0" styleClass="gold-button" text="Update Password" />
                        <Button mnemonicParsing="false" onAction="#onBackToProfile" prefWidth="220.0" styleClass="secondary-button" text="Cancel" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
