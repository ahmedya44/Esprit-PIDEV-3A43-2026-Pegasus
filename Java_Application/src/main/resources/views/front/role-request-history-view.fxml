<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="24.0" styleClass="app-root"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pegasus.controllers.front.RoleRequestHistoryController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-nav">
            <children>
                <Label styleClass="brand-label" text="Pegasus" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onBackToProfile" styleClass="secondary-button" text="Back To Profile" />
            </children>
        </HBox>

        <VBox spacing="12.0" prefWidth="960.0">
            <padding>
                <Insets top="18.0" right="20.0" bottom="24.0" left="20.0" />
            </padding>
            <children>
                <Label styleClass="hero-title" text="Role Request History" />
                <Label fx:id="statusLabel" styleClass="subtitle" text="Loading..." />

                <ScrollPane fitToWidth="true" styleClass="app-scroll" prefHeight="560.0">
                    <content>
                        <VBox fx:id="historyContainer" spacing="12.0" fillWidth="true">
                            <padding>
                                <Insets top="6.0" right="4.0" bottom="8.0" left="4.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</VBox>
