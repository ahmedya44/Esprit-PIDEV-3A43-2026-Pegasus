<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>

<StackPane minHeight="620.0" prefWidth="1100.0"
           xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pegasus.controllers.front.CoursesContentController"
           styleClass="content-surface">

    <BorderPane fx:id="coursesPageContent">
        <top>
            <VBox spacing="14.0" style="-fx-padding: 28 28 16 28;">
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <VBox>
                        <Label text="Published Courses" styleClass="page-title" />
                        <Label text="Browse and explore all available courses" style="-fx-font-size: 14px; -fx-text-fill: #636e72; -fx-padding: 8 0 0 0;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtCourseSearch" promptText="Search courses..." styleClass="dashboard-search-field" />
                </HBox>
                <FlowPane fx:id="categoryFiltersContainer" hgap="12.0" vgap="10.0" styleClass="course-category-filters" />
            </VBox>
        </top>

        <center>
            <ScrollPane fx:id="coursesScrollPane" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                        style="-fx-padding: 0 28 28 28; -fx-background-color: transparent;">
                <content>
                    <FlowPane fx:id="coursesContainer"
                              hgap="24.0" vgap="24.0"
                              style="-fx-padding: 0; -fx-alignment: top-left;" />
                </content>
            </ScrollPane>
        </center>
    </BorderPane>

    <VBox fx:id="chatPanel" styleClass="fantasy-chat-panel" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets top="0.0" right="30.0" bottom="34.0" left="0.0" />
        </StackPane.margin>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="fantasy-chat-header">
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Pegasus Muse" styleClass="fantasy-chat-title" />
                <Label text="Art and fantasy image ideas" styleClass="fantasy-chat-subtitle" />
            </VBox>
            <Button text="X" onAction="#toggleChat" styleClass="fantasy-chat-close-button" />
        </HBox>

        <ScrollPane fx:id="chatMessagesScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="fantasy-chat-scroll">
            <content>
                <VBox fx:id="chatMessagesContainer" spacing="10.0" styleClass="fantasy-chat-messages" />
            </content>
        </ScrollPane>

        <HBox alignment="CENTER" spacing="10.0" styleClass="fantasy-chat-input-row">
            <TextField fx:id="chatPromptField" promptText="Describe a dragon, castle, spell..." onAction="#sendChatMessage" styleClass="fantasy-chat-input" HBox.hgrow="ALWAYS" />
            <Button fx:id="chatSendButton" text="Send" onAction="#sendChatMessage" styleClass="fantasy-chat-send-button" />
        </HBox>
    </VBox>

    <Button fx:id="chatBubbleButton" text="AI" onAction="#toggleChat"
            styleClass="fantasy-chat-bubble" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets top="0.0" right="34.0" bottom="34.0" left="0.0" />
        </StackPane.margin>
    </Button>

    <StackPane fx:id="coursePreviewOverlay"
               visible="false"
               managed="false"
               onMouseClicked="#hideCoursePreview"
               styleClass="course-preview-overlay">
        <VBox fx:id="coursePreviewCard"
              alignment="CENTER"
              spacing="18.0"
              maxWidth="760.0"
              onMouseClicked="#consumeMouseEvent"
              styleClass="course-preview-card">
            <StackPane fx:id="coursePreviewImageBox" prefHeight="250.0" maxWidth="660.0" styleClass="course-preview-image-box">
                <ImageView fx:id="coursePreviewImageView" fitHeight="250.0" fitWidth="660.0" preserveRatio="false" />
                <Label fx:id="coursePreviewImageFallback" text="Course preview" styleClass="course-preview-image-fallback" />
            </StackPane>

            <VBox alignment="CENTER" spacing="10.0" maxWidth="660.0">
                <Label fx:id="coursePreviewTitleLabel" text="Course title" textAlignment="CENTER" wrapText="true" styleClass="course-preview-title" />
                <Label fx:id="coursePreviewDescriptionLabel" text="Course description" textAlignment="CENTER" wrapText="true" styleClass="course-preview-copy" />
                <HBox alignment="CENTER" spacing="10.0">
                    <Label fx:id="coursePreviewCategoryLabel" text="Category" styleClass="course-preview-pill" />
                    <Label fx:id="coursePreviewStatusLabel" text="Published" styleClass="course-preview-pill dark" />
                </HBox>
            </VBox>

            <HBox alignment="CENTER" spacing="12.0">
                <Button text="Close" onAction="#hideCoursePreview" styleClass="course-preview-secondary-button" />
                <Button fx:id="coursePreviewStartButton" text="Start Course" onAction="#startPreviewedCourse" styleClass="course-preview-start-button" />
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
