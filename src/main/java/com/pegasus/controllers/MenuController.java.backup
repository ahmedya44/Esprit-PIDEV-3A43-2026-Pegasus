    private void initializeMenuItems() {
        menuItems.add(new MenuItem("Delicious Pizza", "Fresh mozzarella, tomato sauce, and basil", 12.99, "pizza.jpg"));
        menuItems.add(new MenuItem("Delicious Burger", "Beef patty with lettuce, tomato, and cheese", 10.99, "burger.jpg"));
        menuItems.add(new MenuItem("Delicious Pasta", "Creamy alfredo sauce with parmesan", 11.99, "pasta.jpg"));
        menuItems.add(new MenuItem("Crispy Fries", "Golden french fries with sea salt", 4.99, "fries.jpg"));
        menuItems.add(new MenuItem("Chicken Burger", "Grilled chicken with fresh vegetables", 9.99, "chicken_burger.jpg"));
        menuItems.add(new MenuItem("Veggie Pizza", "Bell peppers, mushrooms, and olives", 13.99, "veggie_pizza.jpg"));
        menuItems.add(new MenuItem("Spaghetti Carbonara", "Classic Italian pasta with bacon and eggs", 12.99, "carbonara.jpg"));
        menuItems.add(new MenuItem("Cheese Fries", "Loaded with melted cheese and bacon", 6.99, "cheese_fries.jpg"));
    }
    
    private void loadMenuItems(String category) {
        galleryGrid.getChildren().clear();
        
        try {
            // Charger TOUTES les oeuvres depuis la base de données
            allArtworks = serviceArt.getAllArts();
            
            // Filtrer et afficher les œuvres published
            displayFilteredArtworks(allArtworks);
            
        } catch (Exception e) {
            System.err.println("Erreur lors du chargement des oeuvres: " + e.getMessage());
            
            // En cas d'erreur, afficher les données de test
            for (MenuItem item : menuItems) {
                if (category.equals("All") || item.getCategory().equals(category)) {
                    galleryGrid.getChildren().add(createMenuItemCard(item));
                }
            }
        }
    }
    
    private List<MenuItem> filterMenuItems(String filter) {
        if (filter.equals("All")) {
            return menuItems;
        }
        
        List<MenuItem> filtered = new ArrayList<>();
        for (MenuItem item : menuItems) {
            if (item.getCategory().equalsIgnoreCase(filter)) {
                filtered.add(item);
            }
        }
        return filtered;
    }
    
    private VBox createArtworkCard(Art art) {
        VBox card = new VBox(10);
        card.setStyle("-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 15;");
        card.setPrefSize(250, 300);
        
        // Image simplifiée
        ImageView imageView = new ImageView();
        imageView.setFitWidth(220);
        imageView.setFitHeight(150);
        imageView.setPreserveRatio(true);
        
        String imageUrl = art.getImageUrl();
        // System.out.println("Loading image: " + imageUrl); // Disabled to avoid encoding issues
        
        if (imageUrl != null && !imageUrl.isEmpty()) {
            try {
                // Vérifier si c'est une URL valide
                if (imageUrl.startsWith("http://") || imageUrl.startsWith("https://")) {
                    // Si l'URL semble invalide, utiliser une URL de test
                    String testUrl = imageUrl;
                    if (imageUrl.contains("testttt") || imageUrl.length() < 10) {
                        testUrl = "https://picsum.photos/seed/test123/300/200.jpg";
                        // System.out.println("Invalid URL detected, using test URL: " + testUrl);
                    }
                    
                    // Charger l'image depuis URL sans background loading
                    Image image = new Image(testUrl, false); // false = chargement synchrone
                    
                    // Vérifier si l'image est valide
                    if (image.getWidth() > 0 && image.getHeight() > 0) {
                        imageView.setImage(image);
                        // System.out.println("Image loaded successfully: " + testUrl + " (size: " + image.getWidth() + "x" + image.getHeight() + ")");
                    } else {
                        // System.err.println("Invalid image: " + testUrl);
                        loadPlaceholderImage(imageView);
                    }
                } else {
                    // Image locale
                    try {
                        Image image = new Image(getClass().getResourceAsStream("/images/" + imageUrl));
                        imageView.setImage(image);
                        // System.out.println("Local image loaded: " + imageUrl);
                    } catch (Exception ex) {
                        // System.err.println("Local image not found: " + imageUrl);
                        loadPlaceholderImage(imageView);
                    }
                }
            } catch (Exception e) {
                // System.err.println("Exception loading image: " + e.getMessage());
                loadPlaceholderImage(imageView);
            }
        } else {
            loadPlaceholderImage(imageView);
        }
        
        Label titleLabel = new Label(art.getTitle());
        titleLabel.setStyle("-fx-font-size: 16px; -fx-font-weight: bold; -fx-wrap-text: true;");
        
        Label descLabel = new Label(art.getDescription());
        descLabel.setStyle("-fx-font-size: 12px; -fx-text-fill: #666; -fx-wrap-text: true;");
        descLabel.setMaxWidth(220);
        
        // Composant de like simplifié
        HBox likeContainer = createLikeComponent(art);
        
        // Widget de recommendation
        VBox recommendationContainer = createRecommendationWidget(art);
        
        // Widget Spotify
        VBox spotifyContainer = createSpotifyWidget(art);
        
        // Boutons d'action
        Button deleteButton = createDeleteButton(art);
        Button editButton = createEditButton(art);
        
        // Conteneur pour les boutons d'action
        HBox actionButtons = new HBox(5);
        actionButtons.setAlignment(javafx.geometry.Pos.CENTER);
        actionButtons.getChildren().addAll(editButton, deleteButton);
        
        card.getChildren().addAll(imageView, titleLabel, descLabel, likeContainer, recommendationContainer, spotifyContainer, actionButtons);
        return card;
    }
    
    private Node createMenuItemCard(MenuItem item) {
        VBox card = new VBox(10);
        card.setStyle("-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 15;");
        card.setPrefSize(250, 300);
        
        // Image placeholder
        ImageView imageView = new ImageView();
        imageView.setFitWidth(220);
        imageView.setFitHeight(150);
        imageView.setPreserveRatio(true);
        try {
            Image image = new Image(getClass().getResourceAsStream("/images/" + item.getImageName()));
            imageView.setImage(image);
        } catch (Exception e) {
            // Use placeholder if image not found
        }
        
        Label nameLabel = new Label(item.getName());
        nameLabel.setStyle("-fx-font-size: 16px; -fx-font-weight: bold; -fx-wrap-text: true;");
        
        Label descLabel = new Label(item.getDescription());
        descLabel.setStyle("-fx-font-size: 12px; -fx-text-fill: #666; -fx-wrap-text: true;");
        
        Label priceLabel = new Label("$" + item.getPrice());
        priceLabel.setStyle("-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;");
        
        Button addToCartButton = new Button("Add to Cart");
        addToCartButton.setStyle("-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 10;");
        addToCartButton.setOnAction(e -> handleAddToCart(item));
        
        card.getChildren().addAll(imageView, nameLabel, descLabel, priceLabel, addToCartButton);
        return card;
    }
    
    private String getStatusDisplay(String status) {
        switch (status) {
            case "pending": return "En attente";
            case "published": return "Publié";
            default: return "En attente";
        }
    }
    
    private String getStatusStyle(String status) {
        switch (status) {
            case "pending":
                return "-fx-background-color: #f39c12; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 5px 10px;";
            case "published":
                return "-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 5px 10px;";
            default:
                return "-fx-background-color: #f39c12; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 5px 10px;";
        }
    }
    
    private void loadPlaceholderImage(ImageView imageView) {
        try {
            // Essayer de charger une image placeholder
            Image placeholder = new Image(getClass().getResourceAsStream("/images/placeholder.jpg"));
            imageView.setImage(placeholder);
            // System.out.println("Placeholder image loaded");
        } catch (Exception e) {
            // Créer une image par défaut avec un rectangle coloré
            javafx.scene.shape.Rectangle placeholder = new javafx.scene.shape.Rectangle(220, 150, javafx.scene.paint.Color.LIGHTGRAY);
            imageView.setImage(null);
            // System.out.println("No image available, using empty placeholder");
        }
    }
    
