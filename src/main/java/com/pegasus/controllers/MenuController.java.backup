    @FXML
    private void handleSearch() {
        try {
            String searchTerm = searchField.getText().trim();
            
            if (searchTerm.isEmpty() || searchTerm.length() < 2) {
                displayFilteredArtworks(allArtworks);
                return;
            }
            
            // Recherche simple et sécurisée
            List<Art> filteredArtworks = new ArrayList<>();
            for (Art art : allArtworks) {
                if (art != null && "published".equals(art.getStatus())) {
                    String title = art.getTitle();
                    String desc = art.getDescription();
                    
                    if (title != null && title.toLowerCase().contains(searchTerm.toLowerCase())) {
                        filteredArtworks.add(art);
                    } else if (desc != null && desc.toLowerCase().contains(searchTerm.toLowerCase())) {
                        filteredArtworks.add(art);
                    }
                }
            }
            
            displayFilteredArtworks(filteredArtworks);
            
        } catch (Exception e) {
            System.err.println("Search error: " + e.getMessage());
            displayFilteredArtworks(allArtworks); // Retourner à la vue normale en cas d'erreur
        }
    }
    
    @FXML
    private void handleClearSearch() {
        searchField.clear();
        displayFilteredArtworks(allArtworks);
    }
    
    private void displayFilteredArtworks(List<Art> artworks) {
        try {
            galleryGrid.getChildren().clear();
            
            if (artworks == null || artworks.isEmpty()) {
                System.out.println("No artworks to display");
                return;
            }
            
            int displayedCount = 0;
            for (Art art : artworks) {
                if (art != null && "published".equals(art.getStatus())) {
                    try {
                        Node card = createArtworkCard(art);
                        if (card != null) {
                            galleryGrid.getChildren().add(card);
                            displayedCount++;
                        }
                    } catch (Exception e) {
                        System.err.println("Error creating card for artwork: " + e.getMessage());
                    }
                }
            }
            
            System.out.println("Displaying " + displayedCount + " published artworks out of " + artworks.size() + " total");
            
        } catch (Exception e) {
            System.err.println("Error displaying artworks: " + e.getMessage());
        }
    }
    
    @FXML
    private void handleSortRecent() {
        try {
            // Désactiver les autres boutons
            toggleOlder.setSelected(false);
            toggleLiked.setSelected(false);
            
            if (toggleRecent.isSelected()) {
                currentSortOrder = "recent";
                System.out.println("Sorting by most recent");
            } else {
                currentSortOrder = "default";
                System.out.println("Reset to default order");
            }
            
            // Appliquer le tri et réafficher
            applyCurrentSortAndDisplay();
            
        } catch (Exception e) {
            System.err.println("Error sorting by recent: " + e.getMessage());
        }
    }
    
    @FXML
    private void handleSortOlder() {
        try {
            // Désactiver les autres boutons
            toggleRecent.setSelected(false);
            toggleLiked.setSelected(false);
            
            if (toggleOlder.isSelected()) {
                currentSortOrder = "older";
                System.out.println("Sorting by oldest");
            } else {
                currentSortOrder = "default";
                System.out.println("Reset to default order");
            }
            
            // Appliquer le tri et réafficher
            applyCurrentSortAndDisplay();
            
        } catch (Exception e) {
            System.err.println("Error sorting by older: " + e.getMessage());
        }
    }
    
    @FXML
    private void handleSortLiked() {
        try {
            // Désactiver les autres boutons
            toggleRecent.setSelected(false);
            toggleOlder.setSelected(false);
            
            if (toggleLiked.isSelected()) {
                currentSortOrder = "liked";
                System.out.println("Sorting by most liked");
            } else {
                currentSortOrder = "default";
                System.out.println("Reset to default order");
            }
            
            // Appliquer le tri et réafficher
            applyCurrentSortAndDisplay();
            
        } catch (Exception e) {
            System.err.println("Error sorting by liked: " + e.getMessage());
        }
    }
    
    @FXML
    private void handleResetSort() {
        try {
            // Réinitialiser tout
            toggleRecent.setSelected(false);
            toggleOlder.setSelected(false);
            toggleLiked.setSelected(false);
            currentSortOrder = "default";
            
            System.out.println("Sort reset to default");
            displayFilteredArtworks(allArtworks);
            
        } catch (Exception e) {
            System.err.println("Error resetting sort: " + e.getMessage());
        }
    }
    
    private void applyCurrentSortAndDisplay() {
        try {
            List<Art> publishedArtworks = new ArrayList<>();
            
            // Filtrer seulement les œuvres publiées
            for (Art art : allArtworks) {
                if (art != null && "published".equals(art.getStatus())) {
                    publishedArtworks.add(art);
                }
            }
            
            // Appliquer le tri simplifié
            if ("recent".equals(currentSortOrder)) {
                publishedArtworks.sort((a, b) -> {
                    if (a.getCreatedAt() != null && b.getCreatedAt() != null) {
                        return b.getCreatedAt().compareTo(a.getCreatedAt());
                    }
                    return 0;
                });
            } else if ("older".equals(currentSortOrder)) {
                publishedArtworks.sort((a, b) -> {
                    if (a.getCreatedAt() != null && b.getCreatedAt() != null) {
                        return a.getCreatedAt().compareTo(b.getCreatedAt());
                    }
                    return 0;
                });
            } else if ("liked".equals(currentSortOrder)) {
                publishedArtworks.sort((a, b) -> Integer.compare(b.getLikes(), a.getLikes()));
            }
            
            displayFilteredArtworks(publishedArtworks);
            
        } catch (Exception e) {
            System.err.println("Error applying sort: " + e.getMessage());
            displayFilteredArtworks(allArtworks);
        }
    }
    
    private HBox createLikeComponent(Art art) {
        HBox likeContainer = new HBox(8);
        likeContainer.setAlignment(javafx.geometry.Pos.CENTER_LEFT);
        
        // Bouton LIKE simplifié
        Button likeButton = new Button("LIKE");
        likeButton.setStyle("-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #e74c3c; -fx-background-radius: 10; -fx-padding: 5px 10px; -fx-cursor: hand;");
        
        // Compteur de likes
        int likes = art.getLikes();
        Label likeCount = new Label(String.valueOf(likes));
        likeCount.setStyle("-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;");
        
        // Texte "likes"
        Label likesText = new Label("likes");
        likesText.setStyle("-fx-font-size: 12px; -fx-text-fill: #7f8c8d;");
        
        // Action simplifiée
        likeButton.setOnAction(e -> {
            try {
                if (serviceArt.incrementLikes(art.getId())) {
                    art.setLikes(art.getLikes() + 1);
                    likeCount.setText(String.valueOf(art.getLikes()));
                    System.out.println("Artwork " + art.getId() + " liked! Total likes: " + art.getLikes());
                }
            } catch (Exception ex) {
                System.err.println("Error liking artwork: " + ex.getMessage());
            }
        });
        
        likeContainer.getChildren().addAll(likeButton, likeCount, likesText);
        return likeContainer;
    }
    
    private Button createDeleteButton(Art art) {
        Button deleteButton = new Button("X");
        deleteButton.setStyle("-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #e74c3c; -fx-background-radius: 8; -fx-padding: 5px 8px; -fx-cursor: hand;");
        
        deleteButton.setOnAction(e -> {
            try {
                // Créer une alerte de confirmation
                Alert confirmAlert = new Alert(Alert.AlertType.CONFIRMATION);
                confirmAlert.setTitle("Supprimer l'œuvre");
                confirmAlert.setHeaderText("Voulez-vous vraiment supprimer cette œuvre ?");
                confirmAlert.setContentText("Cette action est irréversible.");
                
                // Personnaliser les boutons
                ButtonType yesButton = new ButtonType("Oui, supprimer");
                ButtonType noButton = new ButtonType("Non", ButtonBar.ButtonData.CANCEL_CLOSE);
                confirmAlert.getButtonTypes().setAll(yesButton, noButton);
                
                // Afficher l'alerte et attendre la réponse
                Optional<ButtonType> result = confirmAlert.showAndWait();
                
                if (result.isPresent() && result.get() == yesButton) {
                    // Supprimer l'œuvre de la base de données
                    if (serviceArt.deleteArt(art.getId())) {
                        System.out.println("Artwork " + art.getId() + " deleted from front office");
                        
                        // Rafraîchir l'affichage
                        loadMenuItems("All");
                        
                        // Afficher un message de succès
                        Alert successAlert = new Alert(Alert.AlertType.INFORMATION);
                        successAlert.setTitle("Succès");
                        successAlert.setHeaderText("Œuvre supprimée");
                        successAlert.setContentText("L'œuvre a été supprimée avec succès.");
                        successAlert.showAndWait();
                    } else {
                        System.err.println("Failed to delete artwork " + art.getId());
                        
                        Alert errorAlert = new Alert(Alert.AlertType.ERROR);
                        errorAlert.setTitle("Erreur");
                        errorAlert.setHeaderText("Échec de la suppression");
                        errorAlert.setContentText("Impossible de supprimer l'œuvre. Veuillez réessayer.");
                        errorAlert.showAndWait();
                    }
                }
                
            } catch (Exception ex) {
                System.err.println("Error deleting artwork: " + ex.getMessage());
                
                Alert errorAlert = new Alert(Alert.AlertType.ERROR);
                errorAlert.setTitle("Erreur");
                errorAlert.setHeaderText("Erreur technique");
                errorAlert.setContentText("Une erreur est survenue lors de la suppression.");
                errorAlert.showAndWait();
            }
        });
        
        // Pas d'effet de survol pour éviter les bugs
        
        return deleteButton;
    }
    
    private Button createEditButton(Art art) {
        Button editButton = new Button("EDIT");
        editButton.setStyle("-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: white; -fx-background-color: #3498db; -fx-background-radius: 8; -fx-padding: 5px 8px; -fx-cursor: hand;");
        
        editButton.setOnAction(e -> {
            try {
                // Créer une boîte de dialogue pour modifier
                Dialog<ButtonType> editDialog = new Dialog<>();
                editDialog.setTitle("Modifier l'œuvre");
                editDialog.setHeaderText("Modifier les informations de l'œuvre");
                
                // Définir les boutons
                ButtonType saveButtonType = new ButtonType("Enregistrer", ButtonBar.ButtonData.OK_DONE);
                ButtonType cancelButtonType = new ButtonType("Annuler", ButtonBar.ButtonData.CANCEL_CLOSE);
                editDialog.getDialogPane().getButtonTypes().addAll(saveButtonType, cancelButtonType);
                
                // Créer les champs de saisie
                GridPane grid = new GridPane();
                grid.setHgap(10);
                grid.setVgap(10);
                grid.setPadding(new Insets(20, 150, 10, 10));
                
                TextField titleField = new TextField(art.getTitle());
                TextArea descField = new TextArea(art.getDescription());
                descField.setPrefRowCount(3);
                TextField urlField = new TextField(art.getImageUrl());
                
                grid.add(new Label("Titre:"), 0, 0);
                grid.add(titleField, 1, 0);
                grid.add(new Label("Description:"), 0, 1);
                grid.add(descField, 1, 1);
                grid.add(new Label("URL Image:"), 0, 2);
                grid.add(urlField, 1, 2);
                
                editDialog.getDialogPane().setContent(grid);
                
                // Activer/désactiver le bouton Enregistrer
                Node saveButton = editDialog.getDialogPane().lookupButton(saveButtonType);
                saveButton.setDisable(false);
                
                // Afficher et attendre la réponse
                Optional<ButtonType> result = editDialog.showAndWait();
                
                if (result.isPresent() && result.get() == saveButtonType) {
                    // Récupérer les nouvelles valeurs
                    String newTitle = titleField.getText().trim();
                    String newDesc = descField.getText().trim();
                    String newUrl = urlField.getText().trim();
                    
                    // Valider les champs
                    if (newTitle.isEmpty() || newDesc.isEmpty()) {
                        Alert alert = new Alert(Alert.AlertType.ERROR);
                        alert.setTitle("Erreur");
                        alert.setHeaderText("Champs obligatoires");
                        alert.setContentText("Le titre et la description sont obligatoires.");
                        alert.showAndWait();
                        return;
                    }
                    
                    // Mettre à jour l'œuvre
                    art.setTitle(newTitle);
                    art.setDescription(newDesc);
                    art.setImageUrl(newUrl);
                    
                    // Sauvegarder dans la base de données
                    if (serviceArt.updateArt(art)) {
                        System.out.println("Artwork " + art.getId() + " updated successfully");
                        
                        // Rafraîchir l'affichage
                        loadMenuItems("All");
                        
                        // Afficher un message de succès
                        Alert successAlert = new Alert(Alert.AlertType.INFORMATION);
                        successAlert.setTitle("Succès");
                        successAlert.setHeaderText("Œuvre modifiée");
                        successAlert.setContentText("L'œuvre a été mise à jour avec succès.");
                        successAlert.showAndWait();
                    } else {
                        System.err.println("Failed to update artwork " + art.getId());
                        
                        Alert errorAlert = new Alert(Alert.AlertType.ERROR);
                        errorAlert.setTitle("Erreur");
                        errorAlert.setHeaderText("Échec de la modification");
                        errorAlert.setContentText("Impossible de modifier l'œuvre. Veuillez réessayer.");
                        errorAlert.showAndWait();
                    }
                }
                
            } catch (Exception ex) {
                System.err.println("Error editing artwork: " + ex.getMessage());
                
                Alert errorAlert = new Alert(Alert.AlertType.ERROR);
                errorAlert.setTitle("Erreur");
                errorAlert.setHeaderText("Erreur technique");
                errorAlert.setContentText("Une erreur est survenue lors de la modification.");
                errorAlert.showAndWait();
            }
        });
        
        // Pas d'effet de survol pour éviter les bugs
        
        return editButton;
    }
    
    private VBox createRecommendationWidget(Art art) {
        VBox widget = new VBox(5);
        widget.setStyle("-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 8px;");
        
        // Titre du widget
        Label titleLabel = new Label("Les gens qui aiment ça aiment aussi :");
        titleLabel.setStyle("-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;");
        
        // Conteneur pour les recommandations
        HBox recommendationsContainer = new HBox(5);
        recommendationsContainer.setAlignment(javafx.geometry.Pos.CENTER_LEFT);
        
        try {
            // Obtenir les recommandations (limité à 2 pour ne pas surcharger)
            List<Art> recommendations = recommendationService.getSimilarArtworks(art.getId(), 2);
            
            for (Art recommendedArt : recommendations) {
                VBox miniCard = createMiniRecommendationCard(recommendedArt);
                recommendationsContainer.getChildren().add(miniCard);
            }
            
        } catch (Exception e) {
            // Si erreur, afficher un message simple
            Label errorLabel = new Label("Chargement...");
            errorLabel.setStyle("-fx-font-size: 10px; -fx-text-fill: #999;");
            recommendationsContainer.getChildren().add(errorLabel);
        }
        
        widget.getChildren().addAll(titleLabel, recommendationsContainer);
        return widget;
    }
    
    private VBox createMiniRecommendationCard(Art art) {
        VBox miniCard = new VBox(3);
        miniCard.setStyle("-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 5px; -fx-border-color: #ddd; -fx-border-width: 1; -fx-border-radius: 5;");
        miniCard.setPrefSize(80, 60);
        
        // Titre réduit
        Label title = new Label(art.getTitle().length() > 15 ? art.getTitle().substring(0, 12) + "..." : art.getTitle());
        title.setStyle("-fx-font-size: 9px; -fx-font-weight: bold; -fx-wrap-text: true;");
        
        // Likes
        Label likes = new Label("COEUR " + art.getLikes());
        likes.setStyle("-fx-font-size: 8px; -fx-text-fill: #e74c3c;");
        
        miniCard.getChildren().addAll(title, likes);
        
        // Au clic, afficher les détails de cette œuvre recommandée
        miniCard.setOnMouseClicked(e -> {
            System.out.println("Recommandation cliquée: " + art.getTitle());
        });
        
        return miniCard;
    }
    
    private VBox createSpotifyWidget(Art art) {
        VBox widget = new VBox(8);
        widget.setStyle("-fx-background-color: transparent; -fx-padding: 5px;");
        
        // Bouton Spotify simple et compact
        Button listenButton = new Button("� Spotify");
        listenButton.setStyle("-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #1db954; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8px 16px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
        
        // Effet de survol simple
        listenButton.setOnMouseEntered(e -> {
            listenButton.setStyle("-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #1ed760; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8px 16px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
        });
        
        listenButton.setOnMouseExited(e -> {
            listenButton.setStyle("-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #1db954; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8px 16px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
        });
        
        listenButton.setOnAction(e -> {
            try {
                // Créer une alerte avec options
                Alert spotifyAlert = new Alert(Alert.AlertType.CONFIRMATION);
                spotifyAlert.setTitle("Spotify Playlist");
                spotifyAlert.setHeaderText("Playlist pour: " + art.getTitle());
                spotifyAlert.setContentText("Cette playlist est parfaite pour apprecier cette œuvre!\n\n" +
                    "Recommandations:\n" + spotifyService.getRecommendations("default") + 
                    "\n\nVeux-tu ouvrir Spotify pour écouter ?");
                
                // Boutons personnalisés
                ButtonType openSpotify = new ButtonType("Ouvrir Spotify");
                ButtonType cancel = new ButtonType("Annuler", ButtonBar.ButtonData.CANCEL_CLOSE);
                spotifyAlert.getButtonTypes().setAll(openSpotify, cancel);
                
                // Attendre la réponse
                Optional<ButtonType> result = spotifyAlert.showAndWait();
                
                if (result.isPresent() && result.get() == openSpotify) {
                    // Ouvrir Spotify dans le navigateur
                    java.awt.Desktop.getDesktop().browse(
                        new java.net.URI("https://open.spotify.com/search/" + 
                        java.net.URLEncoder.encode(art.getTitle() + " " + art.getArtist(), "UTF-8"))
                    );
                }
                
            } catch (Exception ex) {
                System.err.println("Error opening Spotify: " + ex.getMessage());
            }
        });
        
        // Container pour les boutons
        HBox buttonsContainer = new HBox(8);
        buttonsContainer.setAlignment(Pos.CENTER);
        buttonsContainer.setStyle("-fx-padding: 5px;");
        
        buttonsContainer.getChildren().add(listenButton);
        
        // Bouton Suggestions
        Button suggestionsButton = new Button("💡 Suggestions");
        suggestionsButton.setStyle("-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8px 16px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
        
        // Effet de survol pour suggestions
        suggestionsButton.setOnMouseEntered(e -> {
            suggestionsButton.setStyle("-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #5a6268; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8px 16px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
        });
        
        suggestionsButton.setOnMouseExited(e -> {
            suggestionsButton.setStyle("-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8px 16px; -fx-cursor: hand; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
        });
        
        // Action pour le bouton suggestions
        suggestionsButton.setOnAction(e -> {
            showSuggestionsDialog(art);
        });
        
        buttonsContainer.getChildren().add(suggestionsButton);
        
        // Assembler le widget compact
        widget.getChildren().add(buttonsContainer);
        return widget;
    }
    
    private void showSuggestionsDialog(Art art) {
        try {
            // Créer une fenêtre de dialogue personnalisée
            Dialog<Void> dialog = new Dialog<>();
            dialog.setTitle("💡 Suggestions pour: " + art.getTitle());
            dialog.setHeaderText("Les gens qui aiment cette œuvre aiment aussi...");
            
            // Créer le contenu personnalisé
            VBox content = new VBox(15);
            content.setStyle("-fx-padding: 20px; -fx-background-color: #f8f9fa;");
            
            // Titre de l'œuvre actuelle
            Label currentArtLabel = new Label("🎨 Œuvre actuelle: " + art.getTitle());
            currentArtLabel.setStyle("-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
            
            // Séparateur
            Separator separator = new Separator();
            separator.setStyle("-fx-opacity: 0.3;");
            
            // Section des recommandations
            Label recommendationsTitle = new Label("🔥 Recommandations similaires:");
            recommendationsTitle.setStyle("-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
            
            // Container pour les recommandations
            ScrollPane scrollPane = new ScrollPane();
            scrollPane.setStyle("-fx-background: transparent; -fx-background-color: transparent;");
            scrollPane.setFitToWidth(true);
            scrollPane.setPrefHeight(300);
            
            VBox recommendationsContainer = new VBox(10);
            recommendationsContainer.setStyle("-fx-padding: 10px;");
            
            try {
                // Obtenir les recommandations depuis l'API locale
                List<Art> recommendations = recommendationService.getSimilarArtworks(art.getId(), 10);
                
                if (recommendations.isEmpty()) {
                    Label noRecommendations = new Label("Aucune recommandation disponible pour le moment.");
                    noRecommendations.setStyle("-fx-font-size: 12px; -fx-text-fill: #6c757d; -fx-font-style: italic;");
                    recommendationsContainer.getChildren().add(noRecommendations);
                } else {
                    for (Art recommendedArt : recommendations) {
                        VBox recommendationCard = createRecommendationCard(recommendedArt);
                        recommendationsContainer.getChildren().add(recommendationCard);
                    }
                }
                
            } catch (Exception e) {
                Label errorLabel = new Label("Erreur lors du chargement des suggestions...");
                errorLabel.setStyle("-fx-font-size: 12px; -fx-text-fill: #dc3545; -fx-font-style: italic;");
                recommendationsContainer.getChildren().add(errorLabel);
            }
            
            scrollPane.setContent(recommendationsContainer);
            
            // Assembler le contenu
            content.getChildren().addAll(currentArtLabel, separator, recommendationsTitle, scrollPane);
            
            // Configurer le dialogue
            dialog.getDialogPane().setContent(content);
            dialog.getDialogPane().getButtonTypes().addAll(ButtonType.OK);
            
            // Personnaliser le bouton OK
            Button okButton = (Button) dialog.getDialogPane().lookupButton(ButtonType.OK);
            okButton.setStyle("-fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8px 16px;");
            
            // Afficher la fenêtre
            dialog.showAndWait();
            
        } catch (Exception e) {
            System.err.println("Erreur lors de l'affichage des suggestions: " + e.getMessage());
            
            // Afficher une alerte simple en cas d'erreur
            Alert errorAlert = new Alert(Alert.AlertType.ERROR);
            errorAlert.setTitle("Erreur");
            errorAlert.setHeaderText("Impossible d'afficher les suggestions");
            errorAlert.setContentText("Une erreur est survenue. Veuillez réessayer.");
            errorAlert.showAndWait();
        }
    }
    
    private VBox createRecommendationCard(Art art) {
        VBox card = new VBox(8);
        card.setStyle("-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12px; -fx-border-color: #dee2e6; -fx-border-width: 1; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);");
        card.setPrefWidth(400);
        
        // Titre de l'œuvre recommandée
        Label titleLabel = new Label("🎨 " + art.getTitle());
        titleLabel.setStyle("-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI', Arial, sans-serif; -fx-wrap-text: true;");
        
        // Artiste
        Label artistLabel = new Label("👤 " + art.getArtist());
        artistLabel.setStyle("-fx-font-size: 12px; -fx-text-fill: #6c757d; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
        
        // Description (tronquée si trop longue)
        String description = art.getDescription();
        if (description != null && description.length() > 100) {
            description = description.substring(0, 100) + "...";
        }
        Label descriptionLabel = new Label(description);
        descriptionLabel.setStyle("-fx-font-size: 11px; -fx-text-fill: #495057; -fx-font-family: 'Segoe UI', Arial, sans-serif; -fx-wrap-text: true;");
        
        // Similarité et likes
        HBox statsContainer = new HBox(10);
        statsContainer.setAlignment(Pos.CENTER_LEFT);
        
        // Similarité - basée sur le vrai score
        String similarityText;
        String similarityColor;
        
        // Pour l'instant, on vérifie si c'est du même artiste
        if (art.getArtist() != null) {
            similarityText = "🎨 Même artiste: " + art.getArtist();
            similarityColor = "#28a745"; // Vert
        } else {
            similarityText = "🔍 Œuvre recommandée";
            similarityColor = "#6c757d"; // Gris
        }
        
        Label similarityLabel = new Label(similarityText);
        similarityLabel.setStyle("-fx-font-size: 11px; -fx-text-fill: " + similarityColor + "; -fx-font-weight: bold; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
        
        // Likes
        Label likesLabel = new Label("❤️ " + art.getLikes() + " likes");
        likesLabel.setStyle("-fx-font-size: 11px; -fx-text-fill: #e74c3c; -fx-font-family: 'Segoe UI', Arial, sans-serif;");
        
        statsContainer.getChildren().addAll(similarityLabel, likesLabel);
        
        card.getChildren().addAll(titleLabel, artistLabel, descriptionLabel, statsContainer);
        
        // Effet de survol
        card.setOnMouseEntered(e -> {
            card.setStyle("-fx-background-color: #f8f9fa; -fx-background-radius: 8; -fx-padding: 12px; -fx-border-color: #007bff; -fx-border-width: 2; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 3);");
        });
        
        card.setOnMouseExited(e -> {
            card.setStyle("-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12px; -fx-border-color: #dee2e6; -fx-border-width: 1; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2);");
        });
        
        return card;
    }
    
    @FXML
    private void handleAddArtwork() {
        try {
            System.out.println("Ouverture du formulaire d'ajout d'oeuvre...");
            
            // Créer un dialogue simple qui fonctionne
            DialogPane dialogPane = new DialogPane();
            dialogPane.setHeaderText("Ajouter une nouvelle oeuvre");
            
            // Créer les champs
            TextField titleField = new TextField();
            titleField.setPromptText("Titre de l'oeuvre");
            
            TextArea descArea = new TextArea();
            descArea.setPromptText("Description de l'oeuvre");
            descArea.setPrefRowCount(3);
            
            TextField urlField = new TextField();
            urlField.setPromptText("URL de l'image");
            
            VBox content = new VBox(10, 
                new Label("Titre:"), titleField,
                new Label("Description:"), descArea,
                new Label("URL Image:"), urlField
            );
            content.setStyle("-fx-padding: 20px;");
            
            dialogPane.setContent(content);
            
            // Créer la boîte de dialogue
            Dialog<ButtonType> dialog = new Dialog<>();
            dialog.setTitle("Ajouter une oeuvre");
            dialog.setDialogPane(dialogPane);
            
            // Ajouter les boutons
            ButtonType publishButton = new ButtonType("Publier", ButtonBar.ButtonData.OK_DONE);
            ButtonType cancelButton = new ButtonType("Annuler", ButtonBar.ButtonData.CANCEL_CLOSE);
            dialog.getDialogPane().getButtonTypes().addAll(publishButton, cancelButton);
            
            // Afficher et attendre la réponse
            Optional<ButtonType> result = dialog.showAndWait();
            
            if (result.isPresent() && result.get() == publishButton) {
                // Validation simple
                if (titleField.getText().trim().isEmpty() || 
                    descArea.getText().trim().isEmpty() || 
                    urlField.getText().trim().isEmpty()) {
                    
                    Alert alert = new Alert(Alert.AlertType.WARNING);
                    alert.setTitle("Champs manquants");
                    alert.setHeaderText("Veuillez remplir tous les champs");
                    alert.setContentText("Le titre, la description et l'URL sont obligatoires.");
                    alert.showAndWait();
                    return;
                }
                
                // Confirmation
                Alert confirmAlert = new Alert(Alert.AlertType.CONFIRMATION);
                confirmAlert.setTitle("Confirmation de publication");
                confirmAlert.setHeaderText("Êtes-vous sûr de vouloir publier cette oeuvre ?");
                confirmAlert.setContentText("Une fois publiée, votre oeuvre sera soumise à validation par l'administrateur.");
                
                if (confirmAlert.showAndWait().orElse(ButtonType.CANCEL) == ButtonType.OK) {
                    // Créer l'objet Art 
                    Art newArt = new Art();
                    newArt.setTitle(titleField.getText().trim());
                    newArt.setDescription(descArea.getText().trim());
                    newArt.setImageUrl(urlField.getText().trim());
                    newArt.setStatus("pending");
                    newArt.setCreatedAt(LocalDateTime.now());
                    
                    // Sauvegarder avec retry
                    boolean success = false;
                        }
                    }
                    
                    if (success) {
                        Alert successAlert = new Alert(Alert.AlertType.INFORMATION);
                        successAlert.setTitle("Publication réussie");
                        successAlert.setHeaderText("Oeuvre soumise avec succès !");
                        successAlert.setContentText("Votre publication sera publiée dès que l'administrateur l'acceptera.");
                        successAlert.showAndWait();
                        
                        refreshGallery();
                    } else {
                        Alert errorAlert = new Alert(Alert.AlertType.ERROR);
                        errorAlert.setTitle("Erreur de sauvegarde");
                        errorAlert.setHeaderText("Impossible de sauvegarder l'oeuvre");
                        errorAlert.setContentText("Vérifiez que MySQL est démarré et que la base de données 'artwork' existe.");
                        errorAlert.showAndWait();
                    }
                }
            }
            
        } catch (Exception e) {
            System.err.println("Erreur dans handleAddArtwork: " + e.getMessage());
            e.printStackTrace();
            
            // Message plus clair pour l'utilisateur
            String errorMessage = "Une erreur est survenue. Veuillez réessayer.";
            if (e.getMessage() != null && e.getMessage().contains("Communications link failure")) {
                errorMessage = "Problème de connexion à la base de données. Vérifiez que MySQL est démarré.";
            }
            
            showError(errorMessage);
        }
    }
    
    private void refreshGallery() {
        // Reload the gallery items to show the newly added artwork
        loadMenuItems("All");
    }
    
    private void showError(String message) {
        Alert alert = new Alert(Alert.AlertType.ERROR);
        alert.setTitle("Erreur");
        alert.setHeaderText("Une erreur est survenue");
        alert.setContentText(message);
        alert.showAndWait();
    }
    
    @FXML
    private void handleOpenGallery() {
        try {
            SceneNavigator.goToGallery();
        } catch (IOException e) {
            System.err.println("Error loading gallery view: " + e.getMessage());
            e.printStackTrace();
        }
    }
    
    // Inner class to represent menu items
    public static class MenuItem {
        private String name;
        private String description;
        private double price;
        private String imageName;
        private String category;
        
        public MenuItem(String name, String description, double price, String imageName) {
            this.name = name;
            this.description = description;
            this.price = price;
            this.imageName = imageName;
            this.category = determineCategory(imageName);
        }
        
        private String determineCategory(String imageName) {
            if (imageName.toLowerCase().contains("pizza")) return "Pizza";
            if (imageName.toLowerCase().contains("burger")) return "Burger";
            if (imageName.toLowerCase().contains("pasta")) return "Pasta";
            if (imageName.toLowerCase().contains("fries")) return "Fries";
            return "Other";
        }
        
        // Getters
        public String getName() { return name; }
        public String getDescription() { return description; }
        public double getPrice() { return price; }
        public String getImageName() { return imageName; }
        public String getCategory() { return category; }
    }
}
