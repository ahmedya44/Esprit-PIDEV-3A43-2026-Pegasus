<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>

<AnchorPane prefHeight="620.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.pegasus.controllers.front.CoursesContentController"
            styleClass="content-surface">

    <children>
        <Label layoutX="35.0" layoutY="20.0" text="Published Courses" styleClass="page-title" />

        <ScrollPane layoutX="28.0" layoutY="70.0" prefHeight="520.0" prefWidth="1040.0"
                    fitToWidth="true" hbarPolicy="NEVER">
            <content>
                <FlowPane fx:id="coursesContainer"
                          prefWidth="1000.0"
                          hgap="20.0" vgap="20.0"
                          style="-fx-padding: 20;" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>