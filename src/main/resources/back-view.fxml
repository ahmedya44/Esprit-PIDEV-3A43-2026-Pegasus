<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="pegasus.gui.BackController" prefWidth="1100" prefHeight="850" 
            style="-fx-background-color: #f4f6f8;">

    <!-- Zone principale au centre -->
    <center>
        <VBox alignment="CENTER" spacing="20">
            <Label text="Bienvenue dans l'interface d'Administration" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI';" />
            <Label text="Sélectionnez une rubrique dans le menu à droite pour commencer" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;" />
            
            <HBox alignment="CENTER" spacing="30" style="-fx-padding: 40 0 0 0;">
                <VBox alignment="CENTER" spacing="15" 
                      style="-fx-background-color: white; -fx-padding: 30; -fx-border-radius: 20; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);"
                      prefWidth="220" prefHeight="180">
                    <Label text="📅" style="-fx-font-size: 45px;" />
                    <Label text="Événements" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                </VBox>
                <VBox alignment="CENTER" spacing="15" 
                      style="-fx-background-color: white; -fx-padding: 30; -fx-border-radius: 20; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);"
                      prefWidth="220" prefHeight="180">
                    <Label text="👥" style="-fx-font-size: 45px;" />
                    <Label text="Participants" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                </VBox>
                <VBox alignment="CENTER" spacing="15" 
                      style="-fx-background-color: white; -fx-padding: 30; -fx-border-radius: 20; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);"
                      prefWidth="220" prefHeight="180">
                    <Label text="💼" style="-fx-font-size: 45px;" />
                    <Label text="Sponsors" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                </VBox>
            </HBox>
        </VBox>
    </center>

    <!-- Menu latéral à Droite -->
    <right>
        <VBox spacing="20" alignment="TOP_CENTER" prefWidth="300" 
              style="-fx-background-color: #2c3e50; -fx-padding: 40 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 15, 0, -5, 0);">
            
            <Label text="PEGASUS DASHBOARD" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Segoe UI Semibold';" wrapText="true" alignment="CENTER" />
            <VBox style="-fx-padding: 0 0 30 0;" /> <!-- Espaceur -->
            
            <Button text="📅  Événements" onAction="#allerVersEvenements" 
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-alignment: BASELINE_LEFT; -fx-padding: 15 25; -fx-background-radius: 10;" 
                    prefWidth="260" />
                    
            <Button text="👥  Participants" onAction="#allerVersParticipants" 
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-alignment: BASELINE_LEFT; -fx-padding: 15 25; -fx-background-radius: 10;" 
                    prefWidth="260" />
                    
            <Button text="💼  Sponsors" onAction="#allerVersSponsors" 
                    style="-fx-background-color: rgba(255,255,255,0.05); -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-alignment: BASELINE_LEFT; -fx-padding: 15 25; -fx-background-radius: 10;" 
                    prefWidth="260" />

            <VBox VBox.vgrow="ALWAYS" /> <!-- Pousse le bouton quitter vers le bas -->
            
            <Button text="🚪 Fermer" onAction="#quitter" 
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 20; -fx-padding: 12 20;" 
                    prefWidth="200" />
        </VBox>
    </right>

</BorderPane>
