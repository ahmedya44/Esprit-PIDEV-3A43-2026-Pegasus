<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.pegasus.controllers.LoginController"
            prefHeight="400.0" prefWidth="600.0">

    <VBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <Label text="Pegasus - Login" style="-fx-font-size: 24; -fx-font-weight: bold;"/>

        <TextField fx:id="usernameField" promptText="Username" maxWidth="300"/>

        <PasswordField fx:id="passwordField" promptText="Password" maxWidth="300"/>

        <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>

        <Button text="Se connecter" onAction="#handleLogin" maxWidth="300"/>
        <Button text="Back Home" onAction="#handleBackHome" maxWidth="300"/>

    </VBox>

</AnchorPane>
