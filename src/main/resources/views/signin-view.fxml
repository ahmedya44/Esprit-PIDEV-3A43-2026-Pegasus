<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="26.0" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.SignInController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="28.0" styleClass="top-nav">
            <children>
                <Label styleClass="brand-label" text="Pegasus" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onBackHome" styleClass="home-button" text="HOME" />
                <Button mnemonicParsing="false" onAction="#onGoToSignIn" styleClass="secondary-button" text="SIGN IN" />
                <Button mnemonicParsing="false" onAction="#onGoToSignUp" styleClass="gold-button" text="SIGN UP" />
            </children>
        </HBox>
        <VBox alignment="CENTER" spacing="12.0" styleClass="card">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <Label styleClass="card-title" text="Sign In" />
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="90.0" styleClass="form-label" text="Email" />
                        <TextField fx:id="emailField" prefWidth="260.0" styleClass="input-field" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="90.0" styleClass="form-label" text="Password" />
                        <PasswordField fx:id="passwordField" prefWidth="260.0" styleClass="input-field" />
                    </children>
                </HBox>
                <Button mnemonicParsing="false" onAction="#onSignIn" prefWidth="220.0" styleClass="gold-button" text="Sign In" />
                <Button mnemonicParsing="false" onAction="#onSignInWithGoogle" prefWidth="220.0" styleClass="secondary-button" text="Continue with Google" />
                <Hyperlink onAction="#onGoToSignUp" text="Sign Up" />
                <Hyperlink onAction="#onGoToEmailVerification" text="Verify Email" />
                <Hyperlink onAction="#onResendVerificationEmail" text="Resend Verification Email" />
                <Button mnemonicParsing="false" onAction="#onBackHome" prefWidth="220.0" styleClass="secondary-button" text="Back Home" />
            </children>
        </VBox>
    </children>
</VBox>
