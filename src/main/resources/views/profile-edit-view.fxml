<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="24.0" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.EditProfileController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="28.0" styleClass="top-nav">
            <children>
                <Label styleClass="brand-label" text="Pegasus" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onBackHome" styleClass="home-button" text="HOME" />
                <Button mnemonicParsing="false" onAction="#onSaveProfile" styleClass="gold-button" text="SAVE" />
                <Button mnemonicParsing="false" onAction="#onLogout" styleClass="secondary-button" text="LOG OUT" />
            </children>
        </HBox>

        <VBox alignment="CENTER" spacing="10.0" styleClass="card">
            <padding>
                <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
            </padding>
            <children>
                <Label styleClass="card-title" text="Edit Profile" />
                <Label styleClass="light-text" text="Email and role are locked." />

                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="Email" />
                        <TextField fx:id="emailField" editable="false" prefWidth="320.0" styleClass="input-field" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="Role" />
                        <TextField fx:id="roleField" editable="false" prefWidth="320.0" styleClass="input-field" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="Username" />
                        <TextField fx:id="usernameField" prefWidth="320.0" styleClass="input-field" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="Phone" />
                        <TextField fx:id="phoneField" prefWidth="320.0" styleClass="input-field" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="Avatar URL" />
                        <TextField fx:id="avatarUrlField" prefWidth="320.0" styleClass="input-field" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="New Password" />
                        <PasswordField fx:id="newPasswordField" prefWidth="260.0" styleClass="input-field" />
                        <TextField fx:id="newPasswordVisibleField" managed="false" prefWidth="260.0" styleClass="input-field" visible="false" />
                        <Button fx:id="toggleNewPasswordButton" mnemonicParsing="false" onAction="#onToggleNewPassword" prefWidth="70.0" styleClass="eye-button" text="Show" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="Confirm Password" />
                        <PasswordField fx:id="confirmPasswordField" prefWidth="260.0" styleClass="input-field" />
                        <TextField fx:id="confirmPasswordVisibleField" managed="false" prefWidth="260.0" styleClass="input-field" visible="false" />
                        <Button fx:id="toggleConfirmPasswordButton" mnemonicParsing="false" onAction="#onToggleConfirmPassword" prefWidth="70.0" styleClass="eye-button" text="Show" />
                    </children>
                </HBox>

                <Button mnemonicParsing="false" onAction="#onSaveProfile" prefWidth="220.0" styleClass="gold-button" text="Save Profile" />
                <Button mnemonicParsing="false" onAction="#onBackHome" prefWidth="220.0" styleClass="secondary-button" text="Back Home" />
            </children>
        </VBox>
    </children>
</VBox>
