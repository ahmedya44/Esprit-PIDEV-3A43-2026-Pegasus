<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="26.0" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.front.RoleSelectionController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="28.0" styleClass="top-nav">
            <children>
                <Label styleClass="brand-label" text="Pegasus" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onGoHome" styleClass="home-button" text="HOME" />
                <Button mnemonicParsing="false" onAction="#onGoToSignIn" styleClass="secondary-button" text="SIGN IN" />
                <Button mnemonicParsing="false" onAction="#onGoToSignUp" styleClass="gold-button" text="SIGN UP" />
            </children>
        </HBox>
        <VBox alignment="CENTER" spacing="14.0" styleClass="card">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <Label styleClass="card-title" text="Choose Role" />
                <Label styleClass="light-text" text="Select your account type to continue." />
                <ComboBox fx:id="roleCombo" prefWidth="260.0" />
                <Button mnemonicParsing="false" onAction="#onContinueToSignUp" prefWidth="220.0" styleClass="gold-button" text="Continue" />
                <Button mnemonicParsing="false" onAction="#onBackToSignIn" prefWidth="220.0" styleClass="secondary-button" text="Back to Sign In" />
            </children>
        </VBox>
    </children>
</VBox>
