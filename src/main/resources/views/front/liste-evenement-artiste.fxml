<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.front.ListeEvenementArtisteController" prefWidth="1100" prefHeight="850" styleClass="app-root gallery-root">
    <HBox styleClass="top-nav" alignment="CENTER_LEFT" spacing="14" maxWidth="Infinity">
        <children>
            <Label text="Pegasus" styleClass="brand-label" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox styleClass="nav-center" HBox.hgrow="ALWAYS">
                <children>
                    <Button text="Home" styleClass="secondary-button" onAction="#goHome" />
                    <Button text="Gallery" styleClass="secondary-button" onAction="#goGallery" />
                    <Button text="Courses" styleClass="secondary-button" onAction="#goCourses" />
                    <Button text="Events" styleClass="gold-button" onAction="#goEvents" />
                    <Button text="Products" styleClass="secondary-button" onAction="#goProducts" />
                    <Button text="Forum" styleClass="secondary-button" onAction="#goForum" />
                </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox styleClass="nav-actions">
                <children>
                    <Button fx:id="navProfileButton" managed="false" visible="false" text="Profile" styleClass="secondary-button" onAction="#goProfile" />
                    <Button fx:id="navAuthButton" text="Sign In" styleClass="gold-button" onAction="#handleAuth" />
                    <MenuButton fx:id="navAccountMenu" managed="false" mnemonicParsing="false" styleClass="account-menu-button" text="Account" visible="false">
                        <items>
                            <MenuItem mnemonicParsing="false" onAction="#goProfile" text="Profile" />
                            <MenuItem mnemonicParsing="false" onAction="#handleAuth" text="Log Out" />
                        </items>
                    </MenuButton>
                </children>
            </HBox>
        </children>
    </HBox>

    <VBox alignment="CENTER" spacing="20">
        <Label text="Nos Evenements" style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-family: 'Segoe UI Semibold';" />
        <Button text="+ Ajouter un Evenement" onAction="#allerVersGestion"
                style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 30; -fx-background-radius: 25;" />
        <HBox alignment="CENTER" spacing="20" maxWidth="800">
            <TextField fx:id="searchField" promptText="Rechercher un evenement par titre..."
                       style="-fx-background-color: white; -fx-border-color: #6c5ce7; -fx-border-radius: 25; -fx-background-radius: 25; -fx-padding: 12 20 12 40; -fx-font-size: 14px;"
                       HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="sortCombo" promptText="Trier par"
                      style="-fx-background-color: white; -fx-border-color: #6c5ce7; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5 10;"
                      prefWidth="170" />
        </HBox>
    </VBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <content>
            <StackPane>
                <FlowPane fx:id="eventsFlowPane" hgap="30" vgap="40" alignment="TOP_CENTER" style="-fx-padding: 20; -fx-background-color: transparent;" />
            </StackPane>
        </content>
    </ScrollPane>
</VBox>
