<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="24.0" styleClass="app-root"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pegasus.controllers.front.RoleRequestController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="28.0" styleClass="top-nav">
            <children>
                <Label styleClass="brand-label" text="Pegasus" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onBackToProfile" styleClass="secondary-button" text="PROFILE" />
                <Button mnemonicParsing="false" onAction="#onGoHome" styleClass="home-button" text="HOME" />
            </children>
        </HBox>

        <VBox alignment="CENTER" maxWidth="880.0" prefWidth="880.0" spacing="12.0" styleClass="card">
            <padding>
                <Insets top="28.0" right="28.0" bottom="28.0" left="28.0" />
            </padding>
            <children>
                <Label styleClass="card-title" text="Request Role Change" />
                <Label styleClass="light-text" text="Submit your request to become an artist or sponsor. Admin approval is required." wrapText="true" />

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label prefWidth="170.0" styleClass="form-label" text="Target Role" />
                        <ComboBox fx:id="requestedRoleBox" prefWidth="300.0" onAction="#onRoleSelectionChanged" />
                    </children>
                </HBox>

                <VBox fx:id="artistFieldsBox" alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label styleClass="section-title" text="Artist Information" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="170.0" styleClass="form-label" text="Bio" />
                                <TextArea fx:id="artistBioField" prefWidth="620.0" prefHeight="80.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="170.0" styleClass="form-label" text="Styles" />
                                <TextField fx:id="artistStylesField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="170.0" styleClass="form-label" text="Portfolio URL" />
                                <TextField fx:id="artistPortfolioField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox fx:id="sponsorFieldsBox" alignment="CENTER_LEFT" spacing="10.0" managed="false" visible="false">
                    <children>
                        <Label styleClass="section-title" text="Sponsor Information" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="170.0" styleClass="form-label" text="Company Name" />
                                <TextField fx:id="sponsorCompanyField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="170.0" styleClass="form-label" text="Website" />
                                <TextField fx:id="sponsorWebsiteField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="170.0" styleClass="form-label" text="Address" />
                                <TextField fx:id="sponsorAddressField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="170.0" styleClass="form-label" text="Description" />
                                <TextArea fx:id="sponsorDescriptionField" prefWidth="620.0" prefHeight="80.0" styleClass="input-field" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onSubmitRequest" prefWidth="220.0" styleClass="gold-button" text="Submit Request" />
                        <Button mnemonicParsing="false" onAction="#onBackToProfile" prefWidth="220.0" styleClass="secondary-button" text="Back" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
