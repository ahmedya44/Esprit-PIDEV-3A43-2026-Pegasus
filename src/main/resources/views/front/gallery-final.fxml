<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.front.GalleryControllerFinal" styleClass="app-root gallery-root" spacing="16" alignment="TOP_CENTER">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="top-nav" maxWidth="Infinity">
            <children>
                <Label text="Pegasus" styleClass="brand-label" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Home" onAction="#goHome" styleClass="secondary-button" />
                <Button text="Gallery" onAction="#handleBack" styleClass="gold-button" />
            </children>
        </HBox>

        <ScrollPane prefHeight="600" fitToWidth="true" styleClass="gallery-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox fx:id="galleryContainer" spacing="12" alignment="TOP_CENTER" styleClass="section-card">
                    <padding><Insets top="18" right="18" bottom="18" left="18" /></padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
