<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="24.0" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.front.EditProfileController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="28.0" styleClass="top-nav">
            <children>
                <Label styleClass="brand-label" text="Pegasus" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onBackHome" styleClass="home-button" text="HOME" />
                <Button mnemonicParsing="false" onAction="#onSaveProfile" styleClass="gold-button" text="SAVE" />
                <Button mnemonicParsing="false" onAction="#onLogout" styleClass="secondary-button" text="LOG OUT" />
            </children>
        </HBox>

        <VBox alignment="CENTER" maxWidth="900.0" prefWidth="900.0" spacing="12.0" styleClass="card">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <children>
                <Label styleClass="card-title" text="Edit Profile" />

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label prefWidth="160.0" styleClass="form-label" text="Email" />
                        <Label fx:id="emailField" prefWidth="620.0" styleClass="light-text" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label prefWidth="160.0" styleClass="form-label" text="Role" />
                        <Label fx:id="roleField" prefWidth="620.0" styleClass="light-text" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label prefWidth="160.0" styleClass="form-label" text="Username" />
                        <TextField fx:id="usernameField" prefWidth="620.0" styleClass="input-field" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label prefWidth="160.0" styleClass="form-label" text="Phone" />
                        <TextField fx:id="phoneField" prefWidth="620.0" styleClass="input-field" />
                    </children>
                </HBox>

                <VBox fx:id="artistFieldsBox" spacing="10.0" managed="false" visible="false">
                    <children>
                        <Label styleClass="section-title" text="Artist Fields" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="160.0" styleClass="form-label" text="Bio *" />
                                <TextField fx:id="artistBioField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="160.0" styleClass="form-label" text="Styles *" />
                                <TextField fx:id="artistStylesField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="160.0" styleClass="form-label" text="Portfolio URL *" />
                                <TextField fx:id="artistPortfolioField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="160.0" styleClass="form-label" text="Facebook" />
                                <TextField fx:id="artistFacebookField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="160.0" styleClass="form-label" text="Instagram" />
                                <TextField fx:id="artistInstagramField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox fx:id="sponsorFieldsBox" spacing="10.0" managed="false" visible="false">
                    <children>
                        <Label styleClass="section-title" text="Sponsor Fields" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="160.0" styleClass="form-label" text="Company Name *" />
                                <TextField fx:id="sponsorCompanyNameField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="160.0" styleClass="form-label" text="Website *" />
                                <TextField fx:id="sponsorWebsiteField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="160.0" styleClass="form-label" text="Address *" />
                                <TextField fx:id="sponsorAddressField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="160.0" styleClass="form-label" text="Description *" />
                                <TextField fx:id="sponsorDescriptionField" prefWidth="620.0" styleClass="input-field" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox fx:id="normalUserFieldsBox" spacing="10.0" managed="false" visible="false">
                    <children>
                        <Label styleClass="section-title" text="Normal User Fields" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label prefWidth="160.0" styleClass="form-label" text="Birth Date *" />
                                <DatePicker fx:id="normalUserBirthDatePicker" prefWidth="300.0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onSaveProfile" prefWidth="220.0" styleClass="gold-button" text="Save Profile" />
                        <Button mnemonicParsing="false" onAction="#onGoToResetPasswordPage" prefWidth="220.0" styleClass="secondary-button" text="Reset Password" />
                        <Button mnemonicParsing="false" onAction="#onBackToProfile" prefWidth="220.0" styleClass="secondary-button" text="Back" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
