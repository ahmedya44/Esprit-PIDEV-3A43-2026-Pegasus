<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="26.0" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.front.ResetPasswordController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="28.0" styleClass="top-nav">
            <children>
                <Label styleClass="brand-label" text="Pegasus" />
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#onGoHome" styleClass="home-button" text="HOME" />
                <Button mnemonicParsing="false" onAction="#onGoToSignIn" styleClass="secondary-button" text="SIGN IN" />
                <Button mnemonicParsing="false" onAction="#onGoToSignUp" styleClass="gold-button" text="SIGN UP" />
            </children>
        </HBox>
        <VBox alignment="CENTER" spacing="12.0" styleClass="card">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <Label styleClass="card-title" text="Forgot Password" />
                <Label styleClass="light-text" text="Enter your email to receive a reset code, then set a new password." wrapText="true" />
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="Email" />
                        <TextField fx:id="emailField" prefWidth="320.0" styleClass="input-field" />
                    </children>
                </HBox>
                <Button mnemonicParsing="false" onAction="#onSendResetCode" prefWidth="220.0" styleClass="secondary-button" text="Send Reset Code" />
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="Reset Code" />
                        <TextField fx:id="resetCodeField" prefWidth="320.0" styleClass="input-field" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="New Password" />
                        <PasswordField fx:id="newPasswordField" prefWidth="320.0" styleClass="input-field" />
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label prefWidth="130.0" styleClass="form-label" text="Confirm Password" />
                        <PasswordField fx:id="confirmPasswordField" prefWidth="320.0" styleClass="input-field" />
                    </children>
                </HBox>
                <Button mnemonicParsing="false" onAction="#onResetPassword" prefWidth="220.0" styleClass="gold-button" text="Reset Password" />
                <Button mnemonicParsing="false" onAction="#onBackToSignIn" prefWidth="220.0" styleClass="secondary-button" text="Back to Sign In" />
            </children>
        </VBox>
    </children>
</VBox>
