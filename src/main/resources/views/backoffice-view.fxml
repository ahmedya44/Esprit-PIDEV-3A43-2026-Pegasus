<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #f8f9fa; -fx-padding: 20px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.BackofficeController">
   <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 15px; -fx-background-radius: 10;">
         <children>
            <Text text="BACKOFFICE" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-fill: white;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="returnButton" text="Retour" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" onAction="#goToHome" />
         </children>
      </HBox>
      
      <!-- Title -->
      <Text text="Gestion des Oeuvres" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #2c3e50;" />
      
      <!-- Filter Section -->
      <HBox alignment="CENTER_LEFT" spacing="15">
         <children>
            <Text text="Filtrer par statut:" style="-fx-font-size: 14px; -fx-fill: #7f8c8d;" />
            <ComboBox fx:id="statusFilter" prefWidth="150" />
            <Button fx:id="refreshButton" text="Actualiser" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" onAction="#refreshTable" />
         </children>
      </HBox>
      
      <!-- Table -->
      <TableView fx:id="artworksTable" prefHeight="400" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
         <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60" />
            <TableColumn fx:id="colTitle" text="Titre" prefWidth="200" />
            <TableColumn fx:id="colDescription" text="Description" prefWidth="250" />
            <TableColumn fx:id="colImageUrl" text="Image URL" prefWidth="200" />
            <TableColumn fx:id="colStatus" text="Statut" prefWidth="100" />
            <TableColumn fx:id="colCreatedAt" text="Date" prefWidth="120" />
            <TableColumn fx:id="colActions" text="Actions" prefWidth="150" />
         </columns>
      </TableView>
      
      <!-- Status Label -->
      <Label fx:id="statusLabel" text="Chargement..." style="-fx-font-size: 14px; -fx-fill: #7f8c8d;" />
      
   </children>
</VBox>
