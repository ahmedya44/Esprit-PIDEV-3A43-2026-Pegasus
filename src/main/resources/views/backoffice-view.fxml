<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="16" styleClass="app-root gallery-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.BackofficeController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="14" styleClass="top-nav">
         <children>
            <Label text="Pegasus" styleClass="brand-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="returnButton" text="Home" styleClass="home-button" onAction="#goToHome" />
            <Button text="Gallery" styleClass="gold-button" onAction="#goToGallery" />
         </children>
         <padding><Insets top="14" right="24" bottom="14" left="24" /></padding>
      </HBox>

      <Label text="Gestion des oeuvres" styleClass="workspace-title" />

      <HBox alignment="CENTER_LEFT" spacing="10" styleClass="section-card">
         <children>
            <Label text="Filtrer par statut" styleClass="subtitle" />
            <ComboBox fx:id="statusFilter" prefWidth="170" />
            <Button fx:id="refreshButton" text="Actualiser" styleClass="secondary-button" onAction="#refreshTable" />
         </children>
      </HBox>

      <TableView fx:id="artworksTable" prefHeight="430" VBox.vgrow="ALWAYS" styleClass="users-table backoffice-table">
         <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60" />
            <TableColumn fx:id="colTitle" text="Titre" prefWidth="200" />
            <TableColumn fx:id="colDescription" text="Description" prefWidth="250" />
            <TableColumn fx:id="colImageUrl" text="Image URL" prefWidth="200" />
            <TableColumn fx:id="colStatus" text="Statut" prefWidth="100" />
            <TableColumn fx:id="colCreatedAt" text="Date" prefWidth="120" />
            <TableColumn fx:id="colActions" text="Actions" prefWidth="150" />
         </columns>
      </TableView>

      <Label fx:id="statusLabel" text="Chargement..." styleClass="subtitle" />
   </children>
</VBox>
