<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.web.WebView?>

<VBox alignment="TOP_CENTER" spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pegasus.controllers.DetailsEvenementArtisteController" prefWidth="1050" prefHeight="900" style="-fx-background-color: #f8f9fa;">
    
    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 40; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
        <Button text="← Retour au catalogue" onAction="#retourCatalogue" 
                style="-fx-background-color: transparent; -fx-text-fill: #6c5ce7; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;" />
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: #f8f9fa; -fx-border-color: transparent;">
        <VBox alignment="TOP_CENTER" spacing="0">
            <HBox spacing="50" alignment="CENTER" style="-fx-padding: 40;">
                <!-- Left: Image Section -->
                <StackPane minWidth="600" maxWidth="600">
                    <ImageView fx:id="bigImageView" fitWidth="600" fitHeight="350" preserveRatio="false" />
                    <Rectangle fx:id="imageClip" width="600" height="350" arcWidth="40" arcHeight="40" visible="false" />
                </StackPane>

                <!-- Right: Content Section -->
                <VBox spacing="25" HBox.hgrow="ALWAYS" maxWidth="500">
                    <Label fx:id="titreLabel" text="Event Title" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-family: 'Segoe UI Semibold';" />
                    
                    <Label fx:id="descLabel" text="Event description goes here..." wrapText="true" 
                           style="-fx-font-size: 16px; -fx-text-fill: #636e72; -fx-line-spacing: 5;" />

                    <!-- Info Card -->
                    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 30, 0, 0, 10);">
                        <GridPane hgap="40" vgap="25">
                            <columnConstraints>
                                <ColumnConstraints minWidth="180" />
                                <ColumnConstraints minWidth="180" />
                            </columnConstraints>
                            
                            <!-- Row 0 -->
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="DATE" style="-fx-text-fill: #fdcb6e; -fx-font-weight: bold; -fx-font-size: 12px; -fx-letter-spacing: 1;" />
                                <Label fx:id="dateLabel" text="19 March 2026" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="HEURE" style="-fx-text-fill: #fdcb6e; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label fx:id="heureLabel" text="09:01" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                            </VBox>

                            <!-- Row 1 -->
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="LIEU" style="-fx-text-fill: #fdcb6e; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label fx:id="lieuLabel" text="sfax" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="PRIX" style="-fx-text-fill: #fdcb6e; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label fx:id="prixLabel" text="12.00 DT" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                            </VBox>

                            <!-- Row 2 -->
                            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <Label text="CAPACITÉ" style="-fx-text-fill: #fdcb6e; -fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label fx:id="capaciteLabel" text="8 Personnes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                            </VBox>

                        </GridPane>
                    </VBox>

                    <!-- Action Buttons -->
                    <VBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
                        <HBox spacing="15">
                            <Button text="Modifier ✏️" onAction="#modifier" 
                                    style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 25; -fx-background-radius: 30; -fx-font-size: 14px;" />
                            <Button text="Supprimer 🗑️" onAction="#supprimer" 
                                    style="-fx-background-color: #eb4d4b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 25; -fx-background-radius: 30; -fx-font-size: 14px;" />
                        </HBox>
                        <HBox spacing="15">
                            <Button text="Pack Sponsoring 🤝" onAction="#packSponsoring" 
                                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 25; -fx-background-radius: 30; -fx-font-size: 14px;" />
                            <Button text="Espace Participant 👤" onAction="#participant" 
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 25; -fx-background-radius: 30; -fx-font-size: 14px;" />
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Map Section -->
            <VBox spacing="15" alignment="CENTER" style="-fx-padding: 20 40 40 40;">
                <Label text="📍 Localisation sur la carte" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d3436;" />
                <StackPane style="-fx-background-color: white; -fx-background-radius: 25; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 25; -fx-border-width: 1;">
                    <WebView fx:id="mapWebView" minHeight="350" prefHeight="350" />
                </StackPane>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>
