<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="24" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.MainController">
    <padding><Insets top="24" right="24" bottom="24" left="24" /></padding>
    <children>
        <VBox spacing="12" styleClass="section-card" maxWidth="620" prefWidth="620">
            <children>
                <Label text="Create User" styleClass="workspace-title" />
                <HBox spacing="12" alignment="CENTER_LEFT"><children><Label text="Email" prefWidth="120" styleClass="subtitle" /><TextField fx:id="emailField" prefWidth="420" styleClass="input-field" /></children></HBox>
                <HBox spacing="12" alignment="CENTER_LEFT"><children><Label text="Password" prefWidth="120" styleClass="subtitle" /><PasswordField fx:id="passwordField" prefWidth="420" styleClass="input-field" /></children></HBox>
                <HBox spacing="12" alignment="CENTER_LEFT"><children><Label text="Username" prefWidth="120" styleClass="subtitle" /><TextField fx:id="usernameField" prefWidth="420" styleClass="input-field" /></children></HBox>
                <HBox spacing="12" alignment="CENTER_LEFT"><children><Label text="Role" prefWidth="120" styleClass="subtitle" /><ComboBox fx:id="roleCombo" prefWidth="220" /></children></HBox>
                <Button fx:id="saveButton" mnemonicParsing="false" onAction="#onTestClick" text="Save" styleClass="gold-button" prefWidth="180" />
            </children>
            <padding><Insets top="18" right="18" bottom="18" left="18" /></padding>
        </VBox>
    </children>
</VBox>
