<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox alignment="TOP_CENTER" spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pegasus.controllers.ListeParticipantsController" prefWidth="1000" prefHeight="750" style="-fx-background-color: #f8f9fa;">
    
    <!-- Top Bar -->
    <HBox alignment="CENTER_LEFT" style="-fx-padding: 20 40; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
        <Button text="← Retour aux Détails" onAction="#retour" 
                style="-fx-background-color: transparent; -fx-text-fill: #6c5ce7; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;" />
    </HBox>

    <VBox spacing="30" style="-fx-padding: 40;" VBox.vgrow="ALWAYS">
        <!-- Header Info -->
        <HBox spacing="20" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Participants Inscrits 👥" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-family: 'Segoe UI Semibold';" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Événement :" style="-fx-font-size: 16px; -fx-text-fill: #636e72;" />
                    <Label fx:id="evenementTitreLabel" text="Loading..." style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #6c5ce7;" />
                </HBox>
            </VBox>
            <Button text="📄 Exporter PDF" onAction="#exporterPDF" 
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 25; -fx-background-radius: 30; -fx-font-size: 14px; -fx-effect: dropshadow(three-pass-box, rgba(39, 174, 96, 0.3), 15, 0, 0, 8);" />
        </HBox>

        <!-- Table Container Card -->
        <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 5);">
            <TableView fx:id="participantsTable" VBox.vgrow="ALWAYS" 
                       style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #f1f2f6; -fx-border-width: 0 0 1 0;">
                <columns>
                    <TableColumn fx:id="nomCol" text="Nom" prefWidth="150" />
                    <TableColumn fx:id="prenomCol" text="Prénom" prefWidth="150" />
                    <TableColumn fx:id="emailCol" text="Email" prefWidth="280" />
                    <TableColumn fx:id="telCol" text="Téléphone" prefWidth="150" />
                    <TableColumn fx:id="actionCol" text="Action" prefWidth="150" style="-fx-alignment: CENTER;" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Footer -->
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 20 0 0;">
            <Label fx:id="totalLabel" text="Total : 0 inscrits" 
                   style="-fx-background-color: #e8f5e9; -fx-text-fill: #27ae60; -fx-padding: 10 20; -fx-background-radius: 15; -fx-font-weight: bold; -fx-font-size: 15px;" />
        </HBox>
    </VBox>
</VBox>
