<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Circle?>

<VBox spacing="25.0" styleClass="admin-module-root"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pegasus.controllers.back.BackEventStatsController">
    
    <!-- Toolbar -->
    <HBox spacing="12.0" alignment="CENTER_LEFT" styleClass="admin-toolbar">
        <VBox spacing="4.0">
            <Label text="Event Performance &amp; Insights" styleClass="admin-workspace-title" />
            <Label text="Detailed analytical overview of your events, participants and sponsorship revenue." styleClass="admin-workspace-subtitle" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Mini Cards Row -->
    <HBox spacing="20.0" alignment="CENTER">
        <VBox styleClass="admin-mini-card, admin-mini-card-accent" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <StackPane prefWidth="10" prefHeight="10">
                    <Circle radius="5" fill="#0ea5e9" />
                </StackPane>
                <Label text="TOTAL EVENTS" styleClass="admin-mini-card-label" />
            </HBox>
            <Label fx:id="totalEventsLabel" text="0" styleClass="admin-mini-card-value" />
            <Label text="Active ecosystem" styleClass="admin-mini-card-copy" />
        </VBox>
        
        <VBox styleClass="admin-mini-card, admin-mini-card-warm" HBox.hgrow="ALWAYS">
             <HBox spacing="10" alignment="CENTER_LEFT">
                <StackPane prefWidth="10" prefHeight="10">
                    <Circle radius="5" fill="#f97316" />
                </StackPane>
                <Label text="TOTAL PARTICIPANTS" styleClass="admin-mini-card-label" />
            </HBox>
            <Label fx:id="totalParticipantsLabel" text="0" styleClass="admin-mini-card-value" />
            <Label text="Total engagement" styleClass="admin-mini-card-copy" />
        </VBox>
        
        <VBox styleClass="admin-mini-card" style="-fx-background-color: linear-gradient(to bottom right, #f5f3ff, #ffffff); -fx-border-color: #ddd6fe;" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <StackPane prefWidth="10" prefHeight="10">
                    <Circle radius="5" fill="#8b5cf6" />
                </StackPane>
                <Label text="TOTAL SPONSORS" styleClass="admin-mini-card-label" />
            </HBox>
            <Label fx:id="totalSponsorsLabel" text="0" styleClass="admin-mini-card-value" />
            <Label text="Partner network" styleClass="admin-mini-card-copy" />
        </VBox>
        
        <VBox styleClass="admin-mini-card" style="-fx-background-color: linear-gradient(to bottom right, #f0fdf4, #ffffff); -fx-border-color: #bbf7d0;" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <StackPane prefWidth="10" prefHeight="10">
                    <Circle radius="5" fill="#10b981" />
                </StackPane>
                <Label text="TOTAL REVENUE" styleClass="admin-mini-card-label" />
            </HBox>
            <Label fx:id="totalRevenueLabel" text="0.00" styleClass="admin-mini-card-value" />
            <Label text="Sponsorship (DT)" styleClass="admin-mini-card-copy" />
        </VBox>
    </HBox>

    <!-- Main Content: Optimized for Long Labels -->
    <HBox spacing="25.0" VBox.vgrow="ALWAYS">
        <!-- Left Column: Statistics with Vertical and Horizontal Charts -->
        <VBox spacing="25.0" HBox.hgrow="ALWAYS">
            <!-- 1. Top Events (Vertical Bar Chart) -->
            <VBox styleClass="admin-panel" spacing="15">
                <VBox spacing="4">
                    <Label text="Top 5 Events by Participants" styleClass="admin-panel-title" />
                    <Label text="Comparative attendance volume across major events." styleClass="admin-page-subtitle" />
                </VBox>
                <HBox spacing="20" alignment="CENTER">
                    <BarChart fx:id="participantsChart" legendVisible="false" verticalGridLinesVisible="false" animated="false" styleClass="admin-chart" prefHeight="300" HBox.hgrow="ALWAYS">
                        <xAxis><CategoryAxis fx:id="eventXAxis" label="Event Name" tickLabelRotation="30" /></xAxis>
                        <yAxis><NumberAxis label="Attendees" /></yAxis>
                    </BarChart>
                    <VBox fx:id="participantsDetailList" spacing="10" prefWidth="250" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                        <Label text="QUICK BREAKDOWN" style="-fx-font-size: 10; -fx-font-weight: 800; -fx-text-fill: #94a3b8;" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- 2. Pack Distribution (Horizontal Bar Chart - Better for long labels) -->
            <VBox styleClass="admin-panel" spacing="15">
                <VBox spacing="4">
                    <Label text="Sponsoring Pack Popularity" styleClass="admin-panel-title" />
                    <Label text="Detailed volume of sponsorship packages reserved by partners." styleClass="admin-page-subtitle" />
                </VBox>
                <HBox spacing="20" alignment="CENTER">
                    <!-- Horizontal BarChart (swapped axes) -->
                    <BarChart fx:id="packsChart" legendVisible="false" horizontalGridLinesVisible="false" animated="false" styleClass="admin-chart" prefHeight="300" HBox.hgrow="ALWAYS">
                        <xAxis><NumberAxis label="Quantity Sold" /></xAxis>
                        <yAxis><CategoryAxis label="Pack Type" tickLabelsVisible="false" /></yAxis>
                    </BarChart>
                    <VBox fx:id="packsDetailList" spacing="10" prefWidth="250" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12;">
                        <Label text="PACK SALES" style="-fx-font-size: 10; -fx-font-weight: 800; -fx-text-fill: #94a3b8;" />
                    </VBox>
                </HBox>
            </VBox>
        </VBox>

        <!-- Right Column: Geographic Distribution -->
        <VBox styleClass="admin-panel" prefWidth="480" spacing="20">
            <VBox spacing="4">
                <Label text="Geographic Distribution" styleClass="admin-panel-title" />
                <Label text="Events breakdown by venue location." styleClass="admin-page-subtitle" />
            </VBox>
            <PieChart fx:id="venuePieChart" labelsVisible="true" styleClass="admin-chart" prefHeight="400" VBox.vgrow="ALWAYS" />
            
            <VBox spacing="15" style="-fx-background-color: #f1f5f9; -fx-padding: 20; -fx-background-radius: 15;">
                <Label text="LOCATION INSIGHTS" style="-fx-font-size: 11; -fx-font-weight: 900; -fx-text-fill: #64748b;" />
                <VBox fx:id="venueDetailList" spacing="10" />
            </VBox>
        </VBox>
    </HBox>

</VBox>
