<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1280.0" prefHeight="820.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pegasus.controllers.back.AdminLayoutController"
            styleClass="admin-root">
    <stylesheets>
        <URL value="@/css/admin.css" />
        <URL value="@/css/courses.css" />
        <URL value="@/css/style.css" />
    </stylesheets>

    <left>
        <VBox fx:id="adminSidebar" styleClass="admin-sidebar">
            <HBox spacing="12.0" alignment="CENTER_LEFT">
                <StackPane styleClass="admin-brand-mark" />
                <VBox fx:id="adminBrandTextBox" spacing="2.0">
                    <Label text="Pegasus" styleClass="admin-brand-title" />
                    <Label text="Admin Backoffice" styleClass="admin-brand-subtitle" />
                </VBox>
            </HBox>

            <Label fx:id="workspaceSectionLabel" text="WORKSPACE" styleClass="admin-section-label" />
            <Button fx:id="homeNavButton" text="Home Dashboard" maxWidth="Infinity" onAction="#showHome" styleClass="admin-nav-button" />
            <Button fx:id="usersNavButton" text="Users Dashboard" maxWidth="Infinity" onAction="#showUsers" styleClass="admin-nav-button" />
            <Button fx:id="eventsNavButton" text="Event Dashboard" maxWidth="Infinity" onAction="#showEvents" styleClass="admin-nav-button" />
            <Button fx:id="coursesNavButton" text="Course Dashboard" maxWidth="Infinity" onAction="#showCourses" styleClass="admin-nav-button" />
            <VBox fx:id="courseSubmenu" visible="false" managed="false" spacing="6.0" styleClass="admin-subnav">
                <Button fx:id="courseCoursesNavButton" text="Course" maxWidth="Infinity" onAction="#showCourseCourses" styleClass="admin-subnav-button" />
                <Button fx:id="courseQuizzesNavButton" text="Quizzes" maxWidth="Infinity" onAction="#showCourseQuizzes" styleClass="admin-subnav-button" />
                <Button fx:id="courseStatsNavButton" text="Statistique" maxWidth="Infinity" onAction="#showCourseStatistics" styleClass="admin-subnav-button" />
            </VBox>
            <Button fx:id="galleryNavButton" text="Gallery Dashboard" maxWidth="Infinity" onAction="#showGallery" styleClass="admin-nav-button" />
            <Button fx:id="forumNavButton" text="Forum Dashboard" maxWidth="Infinity" onAction="#showForum" styleClass="admin-nav-button" />
            <Button fx:id="productsNavButton" text="Product Dashboard" maxWidth="Infinity" onAction="#showProducts" styleClass="admin-nav-button" />

            <Label fx:id="systemSectionLabel" text="SYSTEM" styleClass="admin-section-label" />
            <Button fx:id="settingsNavButton" text="Settings" maxWidth="Infinity" onAction="#showSettings" styleClass="admin-nav-button" />
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="frontOfficeButton" text="View Front Office" maxWidth="Infinity" onAction="#openFrontOffice" styleClass="admin-frontoffice-button" />
            <Button fx:id="logoutButton" text="Log Out" maxWidth="Infinity" onAction="#logout" styleClass="admin-logout-button" />
        </VBox>
    </left>

    <center>
        <BorderPane styleClass="admin-main">
            <top>
                <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="admin-topbar">
                    <Button fx:id="sidebarToggleButton" text="Close" onAction="#toggleSidebar" styleClass="admin-sidebar-toggle" />
                    <VBox spacing="4.0">
                        <Label fx:id="pageTitleLabel" text="Home Dashboard" styleClass="admin-page-title" />
                        <Label fx:id="pageSubtitleLabel" text="Operational overview across Pegasus modules." styleClass="admin-page-subtitle" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT" spacing="3.0" styleClass="admin-user-pill">
                        <Label fx:id="adminNameLabel" text="Admin" styleClass="admin-user-name" />
                        <Label fx:id="adminRoleLabel" text="Administrator workspace" styleClass="admin-muted-label" />
                    </VBox>
                </HBox>
            </top>
            <center>
                <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="admin-content-scroll">
                    <content>
                        <StackPane fx:id="contentPane" styleClass="admin-content-pane" />
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
