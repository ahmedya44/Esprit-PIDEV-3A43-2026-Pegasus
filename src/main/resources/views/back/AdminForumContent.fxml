<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pegasus.controllers.back.AdminForumController">
    <HBox spacing="16.0">
        <VBox spacing="14.0" HBox.hgrow="ALWAYS" styleClass="admin-placeholder-card">
            <Label text="Community Moderation" styleClass="admin-panel-title" />
            <Label text="Open the forum workspace from here to review conversations, moderation state, comments and community content." wrapText="true" styleClass="admin-panel-copy" />
            <Button text="Open Forum Workspace" onAction="#openForumModeration" styleClass="admin-primary-button" />
            <Label fx:id="statusLabel" text="Ready." styleClass="admin-page-subtitle" />
        </VBox>
        <VBox spacing="12.0" prefWidth="300.0" styleClass="admin-panel">
            <Label text="Admin Notes" styleClass="admin-panel-title" />
            <Label text="Forum runs in a dedicated JavaFX window today. This shell keeps a stable admin entry point while preserving the existing forum module." wrapText="true" styleClass="admin-panel-copy" />
        </VBox>
    </HBox>
    <Region prefHeight="300.0" />
</VBox>
