<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pegasus.controllers.back.AdminUsersController">
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="admin-toolbar">
        <TextField fx:id="searchField" promptText="Search users..." prefWidth="280.0" styleClass="admin-search-field" />
        <ComboBox fx:id="roleFilter" prefWidth="160.0" styleClass="admin-combo" />
        <ComboBox fx:id="statusFilter" prefWidth="190.0" styleClass="admin-combo" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="summaryLabel" text="Loading..." styleClass="admin-page-subtitle" />
        <Button text="Refresh" onAction="#refreshUsers" styleClass="admin-secondary-button" />
    </HBox>

    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" prefHeight="560.0" styleClass="admin-table admin-data-table">
        <columns>
            <TableColumn fx:id="colUsername" text="User" prefWidth="180" />
            <TableColumn fx:id="colEmail" text="Email" prefWidth="260" />
            <TableColumn fx:id="colRole" text="Role" prefWidth="130" />
            <TableColumn fx:id="colStatus" text="Status" prefWidth="170" />
            <TableColumn fx:id="colProvider" text="Provider" prefWidth="120" />
            <TableColumn fx:id="colCreated" text="Created" prefWidth="160" />
            <TableColumn fx:id="colActions" text="Actions" prefWidth="260" />
        </columns>
    </TableView>

    <Label fx:id="statusLabel" text="Loading users..." styleClass="admin-page-subtitle" />
</VBox>
