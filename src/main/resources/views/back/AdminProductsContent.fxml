<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pegasus.controllers.back.AdminProductsController">
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="admin-toolbar">
        <TextField fx:id="searchField" promptText="Search products..." prefWidth="280.0" styleClass="admin-search-field" />
        <ComboBox fx:id="statusFilter" prefWidth="170.0" styleClass="admin-combo" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Refresh" onAction="#refreshProducts" styleClass="admin-secondary-button" />
    </HBox>

    <TableView fx:id="productsTable" VBox.vgrow="ALWAYS" prefHeight="560.0" styleClass="admin-table">
        <columns>
            <TableColumn fx:id="colName" text="Product" prefWidth="210" />
            <TableColumn fx:id="colCategory" text="Category" prefWidth="160" />
            <TableColumn fx:id="colPrice" text="Price" prefWidth="100" />
            <TableColumn fx:id="colStock" text="Stock" prefWidth="90" />
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120" />
            <TableColumn fx:id="colActions" text="Actions" prefWidth="260" />
        </columns>
    </TableView>

    <Label fx:id="statusLabel" text="Loading..." styleClass="admin-page-subtitle" />
</VBox>
