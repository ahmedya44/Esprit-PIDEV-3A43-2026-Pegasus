<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pegasus.controllers.back.AdminForumStatsController">
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Forum Statistics" styleClass="admin-panel-title" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Refresh Stats" onAction="#refreshStats" styleClass="admin-secondary-button" />
    </HBox>
    <Label fx:id="statusLabel" text="Loading forum stats..." styleClass="admin-page-subtitle" />

    <HBox spacing="12.0">
        <VBox spacing="6.0" styleClass="admin-panel" HBox.hgrow="ALWAYS">
            <Label text="Total Posts" styleClass="admin-page-subtitle" />
            <Label fx:id="totalPostsLabel" text="0" styleClass="admin-panel-title" />
        </VBox>
        <VBox spacing="6.0" styleClass="admin-panel" HBox.hgrow="ALWAYS">
            <Label text="Total Comments" styleClass="admin-page-subtitle" />
            <Label fx:id="totalCommentsLabel" text="0" styleClass="admin-panel-title" />
        </VBox>
        <VBox spacing="6.0" styleClass="admin-panel" HBox.hgrow="ALWAYS">
            <Label text="Total Ratings" styleClass="admin-page-subtitle" />
            <Label fx:id="totalRatingsLabel" text="0" styleClass="admin-panel-title" />
        </VBox>
        <VBox spacing="6.0" styleClass="admin-panel" HBox.hgrow="ALWAYS">
            <Label text="Average Rating" styleClass="admin-page-subtitle" />
            <Label fx:id="avgRatingLabel" text="0.00 / 5" styleClass="admin-panel-title" />
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="forum-cards-scroll">
        <content>
            <VBox spacing="14.0">
                <HBox spacing="12.0">
                    <VBox spacing="8.0" styleClass="admin-panel" HBox.hgrow="ALWAYS">
                        <Label text="Posts By Status" styleClass="admin-panel-title" />
                        <PieChart fx:id="statusPieChart" title="" styleClass="admin-chart" prefHeight="300.0" />
                    </VBox>
                    <VBox spacing="8.0" styleClass="admin-panel" HBox.hgrow="ALWAYS">
                        <Label text="Moderation &amp; Requests" styleClass="admin-panel-title" />
                        <PieChart fx:id="moderationPieChart" title="" styleClass="admin-chart" prefHeight="300.0" />
                    </VBox>
                </HBox>

                <VBox spacing="8.0" styleClass="admin-panel">
                    <Label text="Top Posts By Comments" styleClass="admin-panel-title" />
                    <BarChart fx:id="topCommentsChart" styleClass="admin-chart" prefHeight="320.0" legendVisible="false">
                        <xAxis>
                            <NumberAxis label="Comments" />
                        </xAxis>
                        <yAxis>
                            <CategoryAxis label="Post title" />
                        </yAxis>
                    </BarChart>
                    <VBox fx:id="topCommentsDetailsBox" spacing="4.0" />
                </VBox>

                <VBox spacing="8.0" styleClass="admin-panel">
                    <Label text="Top Posts By Rating" styleClass="admin-panel-title" />
                    <BarChart fx:id="topRatingsChart" styleClass="admin-chart" prefHeight="320.0" legendVisible="false">
                        <xAxis>
                            <NumberAxis label="Rating / 5" lowerBound="0.0" upperBound="5.0" tickUnit="1.0" />
                        </xAxis>
                        <yAxis>
                            <CategoryAxis label="Post title" />
                        </yAxis>
                    </BarChart>
                    <VBox fx:id="topRatingsDetailsBox" spacing="4.0" />
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
