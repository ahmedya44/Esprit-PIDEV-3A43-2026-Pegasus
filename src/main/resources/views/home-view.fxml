<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="30" style="-fx-background-color: #f8f9fa; -fx-padding: 50px;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.HomeController">
   <children>
      <Text text="PI GALLERY" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-fill: #2c3e50;" />
      <Text text="Système de gestion d'œuvres d'art" style="-fx-font-size: 18px; -fx-fill: #7f8c8d;" />
      
      <HBox alignment="CENTER" spacing="50">
         <children>
            <Button fx:id="frontButton" text="FRONTOFFICE" prefWidth="250" prefHeight="120" 
                    onAction="#goToFrontOffice"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-background-radius: 15; -fx-cursor: hand;">
               <font>
                  <Font size="20" />
               </font>
            </Button>
            
            <Button fx:id="backButton" text="BACKOFFICE" prefWidth="250" prefHeight="120" 
                    onAction="#goToBackOffice"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-background-radius: 15; -fx-cursor: hand;">
               <font>
                  <Font size="20" />
               </font>
            </Button>
         </children>
      </HBox>
      
      <Text text="Choisissez votre interface" style="-fx-font-size: 14px; -fx-fill: #95a5a6;" />
   </children>
</VBox>
