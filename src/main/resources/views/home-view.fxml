<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="28.0" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.HomeController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="28.0" styleClass="top-nav">
            <children>
                <Label styleClass="brand-label" text="Pegasus" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="nav-link active-link" text="HOME" />
                <Button mnemonicParsing="false" onAction="#onGoToGallery" styleClass="secondary-button" text="Gallery" />
                <Button mnemonicParsing="false" onAction="#onGoToCourses" styleClass="secondary-button" text="Courses" />
                <Button mnemonicParsing="false" onAction="#onGoToEvents" styleClass="secondary-button" text="Events" />
                <Button fx:id="navCoursesDashboardButton" managed="false" mnemonicParsing="false" onAction="#onGoToCoursesDashboard" styleClass="secondary-button" text="Courses Dashboard" visible="false" />
                <Button fx:id="navBackofficeButton" managed="false" mnemonicParsing="false" onAction="#onGoToBackoffice" styleClass="secondary-button" text="Backoffice" visible="false" />
                <Button fx:id="navProfileButton" managed="false" mnemonicParsing="false" onAction="#onGoToProfile" styleClass="secondary-button" text="Profile" visible="false" />
                <Button fx:id="navAuthButton" mnemonicParsing="false" onAction="#onGoToSignIn" styleClass="gold-button" text="Sign In" />
            </children>
        </HBox>
        <VBox alignment="CENTER" spacing="14.0">
            <padding>
                <Insets bottom="40.0" left="20.0" right="20.0" top="40.0" />
            </padding>
            <children>
                <Label styleClass="hero-title" text="Welcome to Pegasus" />
                <Label styleClass="subtitle" text="Creative platform for admins, artistes and normal users." />
                <Label fx:id="userStatusLabel" styleClass="subtitle" text="You are not connected." />
                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button fx:id="signInButton" mnemonicParsing="false" onAction="#onGoToSignIn" prefWidth="160.0" styleClass="gold-button" text="Sign In" />
                        <Button fx:id="signUpButton" mnemonicParsing="false" onAction="#onGoToSignUp" prefWidth="160.0" styleClass="secondary-button" text="Sign Up" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
