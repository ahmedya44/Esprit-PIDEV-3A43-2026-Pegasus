<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="28.0" styleClass="app-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.HomeController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="28.0" styleClass="top-nav">
            <children>
                <Label styleClass="brand-label" text="Pegasus" />
                <Region HBox.hgrow="ALWAYS" />
                <Label styleClass="nav-link active-link" text="HOME" />
                <Button fx:id="navAuthButton" mnemonicParsing="false" onAction="#onGoToSignIn" styleClass="gold-button" text="Sign In" />
            </children>
        </HBox>
        <VBox alignment="CENTER" spacing="14.0">
            <padding>
                <Insets bottom="40.0" left="20.0" right="20.0" top="40.0" />
            </padding>
            <children>
                <Label styleClass="hero-title" text="Welcome to Pegasus" />
                <Label styleClass="subtitle" text="Creative platform for admins, artistes and normal users." />
                <Label fx:id="userStatusLabel" styleClass="subtitle" text="You are not connected." />
                <VBox fx:id="profileBox" alignment="CENTER" managed="false" spacing="6.0" visible="false">
                    <children>
                        <StackPane alignment="TOP_RIGHT" maxWidth="96.0" prefWidth="96.0">
                            <children>
                                <ImageView fx:id="profileImageView" fitHeight="96.0" fitWidth="96.0" managed="false" pickOnBounds="true" preserveRatio="true" styleClass="profile-image" visible="false" />
                                <Button fx:id="expandProfileButton" managed="false" mnemonicParsing="false" onAction="#onExpandProfileImage" styleClass="expand-avatar-button" text="⤢" visible="false" />
                            </children>
                        </StackPane>
                        <Label fx:id="profileImageHintLabel" styleClass="subtitle" text="No profile picture" />
                    </children>
                </VBox>
                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button fx:id="signInButton" mnemonicParsing="false" onAction="#onGoToSignIn" prefWidth="160.0" styleClass="gold-button" text="Sign In" />
                        <Button fx:id="signUpButton" mnemonicParsing="false" onAction="#onGoToSignUp" prefWidth="160.0" styleClass="secondary-button" text="Sign Up" />
                        <Button fx:id="editProfileButton" managed="false" mnemonicParsing="false" onAction="#onGoToEditProfile" prefWidth="160.0" styleClass="secondary-button" text="Edit Profile" visible="false" />
                        <Button fx:id="logoutButton" managed="false" mnemonicParsing="false" onAction="#onLogout" prefWidth="160.0" styleClass="ghost-button" text="Log Out" visible="false" />
                    </children>
                </HBox>
                <VBox fx:id="adminUsersBox" alignment="CENTER" managed="false" spacing="10.0" visible="false">
                    <children>
                        <Label styleClass="section-title" text="All Users (Admin)" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <TextField fx:id="searchField" onAction="#onSearchUsers" prefWidth="220.0" promptText="Search user..." styleClass="input-field" />
                                <ComboBox fx:id="sortByCombo" onAction="#onSortUsers" prefWidth="130.0" />
                                <ComboBox fx:id="sortOrderCombo" onAction="#onSortUsers" prefWidth="130.0" />
                                <Button mnemonicParsing="false" onAction="#onResetUsersFilter" styleClass="secondary-button" text="Reset" />
                            </children>
                        </HBox>
                        <TableView fx:id="usersTable" prefHeight="260.0" prefWidth="720.0">
                            <columns>
                                <TableColumn fx:id="colUsername" prefWidth="170.0" text="Username" />
                                <TableColumn fx:id="colEmail" prefWidth="260.0" text="Email" />
                                <TableColumn fx:id="colRole" prefWidth="100.0" text="Role" />
                                <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                            </columns>
                        </TableView>
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label styleClass="form-label" text="New Status" />
                                <ComboBox fx:id="statusUpdateCombo" prefWidth="180.0" />
                                <Button fx:id="applyStatusButton" mnemonicParsing="false" onAction="#onChangeSelectedUserStatus" styleClass="gold-button" text="Change Status" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>
