<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="16" styleClass="app-root gallery-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.BackofficeSimpleController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="14" styleClass="top-nav">
         <children>
            <Label text="Pegasus" styleClass="brand-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="returnButton" text="Home" styleClass="home-button" onAction="#goToHome" />
            <Button text="Gallery" styleClass="gold-button" onAction="#goToGallery" />
         </children>
         <padding><Insets top="14" right="24" bottom="14" left="24" /></padding>
      </HBox>

      <Label text="BACKOFFICE" style="-fx-background-color: #2f4156; -fx-text-fill: white; -fx-font-size: 34px; -fx-font-weight: 800; -fx-padding: 12 18 12 18; -fx-background-radius: 8;" maxWidth="1.7976931348623157E308" alignment="CENTER_LEFT" />
      <Label text="Gestion des Oeuvres" styleClass="workspace-title" />
      <Label fx:id="statusLabel" text="Chargement..." styleClass="subtitle" />

      <HBox alignment="CENTER" spacing="10" styleClass="section-card">
         <children>
            <Button fx:id="sortRecentButton" text="Plus recent" styleClass="success-button" onAction="#sortRecent" />
            <Button fx:id="sortOlderButton" text="Plus ancien" styleClass="chip-button" onAction="#sortOlder" />
            <Button fx:id="refreshButton" text="Actualiser" styleClass="secondary-button" onAction="#refreshTable" />
         </children>
      </HBox>

      <ScrollPane prefHeight="430" VBox.vgrow="ALWAYS" styleClass="gallery-scroll">
         <content>
            <VBox fx:id="artworksContainer" spacing="10" styleClass="section-card">
               <padding><Insets top="16" right="16" bottom="16" left="16" /></padding>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
