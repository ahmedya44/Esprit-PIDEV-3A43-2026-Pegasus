<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox alignment="CENTER" spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pegasus.controllers.AjouterEvenementController" prefWidth="900" prefHeight="850" style="-fx-background-color: #f8f9fa;">
    
    <!-- Header Section -->
    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40 0;">
        <Label text="Gestion des Événements" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-family: 'Segoe UI Semibold';" />
        <Label text="Créez et organisez vos événements en toute simplicité" style="-fx-font-size: 16px; -fx-text-fill: #636e72;" />
    </VBox>
    
    <!-- Form Card -->
    <VBox spacing="30" maxWidth="700" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 30, 0, 0, 10);">
        
        <GridPane hgap="30" vgap="20">
            <columnConstraints>
                <ColumnConstraints minWidth="120" prefWidth="150" hgrow="SOMETIMES" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            
            <!-- Titre -->
            <Label text="Titre" style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14px;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="titreField" promptText="Nom de l'événement" 
                       style="-fx-background-radius: 10; -fx-padding: 10; -fx-border-color: #dfe6e9; -fx-border-radius: 10; -fx-background-color: white;" 
                       GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <!-- Date & Heure Row -->
            <Label text="Date &amp; Heure" style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14px;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <HBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <DatePicker fx:id="dateField" promptText="Sélectionner" maxWidth="Infinity" HBox.hgrow="ALWAYS" 
                            style="-fx-background-radius: 10; -fx-padding: 5; -fx-border-color: #dfe6e9; -fx-border-radius: 10; -fx-background-color: white;" />
                <TextField fx:id="heureField" promptText="HH:mm" prefWidth="120" 
                           style="-fx-background-radius: 10; -fx-padding: 10; -fx-border-color: #dfe6e9; -fx-border-radius: 10; -fx-background-color: white;" />
            </HBox>

            <!-- Lieu -->
            <Label text="Lieu" style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14px;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="lieuField" promptText="Localisation de l'événement" 
                       style="-fx-background-radius: 10; -fx-padding: 10; -fx-border-color: #dfe6e9; -fx-border-radius: 10; -fx-background-color: white;" 
                       GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <!-- Capacité & Prix Row -->
            <Label text="Logistique" style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14px;" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <HBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <TextField fx:id="capaciteField" promptText="Capacité (ex: 500)" HBox.hgrow="ALWAYS" 
                           style="-fx-background-radius: 10; -fx-padding: 10; -fx-border-color: #dfe6e9; -fx-border-radius: 10; -fx-background-color: white;" />
                <TextField fx:id="prixField" promptText="Prix (DT)" HBox.hgrow="ALWAYS" 
                           style="-fx-background-radius: 10; -fx-padding: 10; -fx-border-color: #dfe6e9; -fx-border-radius: 10; -fx-background-color: white;" />
            </HBox>

            <!-- Affiche -->
            <Label text="Affiche (Image)" style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14px;" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <TextField fx:id="imageField" promptText="Sélectionner un fichier..." HBox.hgrow="ALWAYS" 
                           style="-fx-background-radius: 10; -fx-padding: 10; -fx-border-color: #dfe6e9; -fx-border-radius: 10; -fx-background-color: white;" />
                <Button text="📁" onAction="#choisirImage" 
                        style="-fx-background-color: #f1f2f6; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 10 15;" />
            </HBox>

            <!-- Description -->
            <VBox spacing="10" alignment="TOP_LEFT" GridPane.columnIndex="0" GridPane.rowIndex="5">
                <Label text="Description" style="-fx-font-weight: bold; -fx-text-fill: #2d3436; -fx-font-size: 14px;" />
                <Button text="Générer avec IA" onAction="#genererDescription" 
                        style="-fx-background-color: #0984e3; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand; -fx-padding: 8 15; -fx-font-size: 12px; -fx-font-weight: bold;" />
            </VBox>
            <TextArea fx:id="descField" prefRowCount="3" promptText="Parlez-nous de l'événement..." wrapText="true" 
                      style="-fx-background-radius: 10; -fx-padding: 5; -fx-border-color: #dfe6e9; -fx-border-radius: 10; -fx-background-color: white;" 
                      GridPane.columnIndex="1" GridPane.rowIndex="5" />
        </GridPane>

        <!-- Actions -->
        <VBox spacing="20" alignment="CENTER">
            <HBox spacing="15" alignment="CENTER">
                <Button text="Ajouter l'Événement" onAction="#ajouterEvenement" 
                        style="-fx-background-color: #6c5ce7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 40; -fx-background-radius: 25; -fx-font-size: 16px; -fx-effect: dropshadow(three-pass-box, rgba(108, 92, 231, 0.3), 15, 0, 0, 8);" />
                
                <Button text="Vider" onAction="#viderChamps" 
                        style="-fx-background-color: #dfe6e9; -fx-text-fill: #636e72; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 30; -fx-background-radius: 25; -fx-font-size: 14px;" />
                        
                <Button text="Rentrer" onAction="#fermer" 
                        style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-border-color: #e74c3c; -fx-border-radius: 25; -fx-border-width: 2px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 30; -fx-background-radius: 25; -fx-font-size: 14px;" />
            </HBox>

            <Label fx:id="messageLabel" wrapText="true" alignment="CENTER" maxWidth="Infinity" style="-fx-font-weight: bold;" />
        </VBox>
    </VBox>
    
    <padding>
        <Insets bottom="50" />
    </padding>
</VBox>
