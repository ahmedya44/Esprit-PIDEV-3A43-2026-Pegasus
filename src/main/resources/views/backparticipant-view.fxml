<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pegasus.controllers.BackParticipantController" prefWidth="1200" prefHeight="850"
            styleClass="root">

    <stylesheets>
        <java.net.URL value="@css/style-back.css"/>
    </stylesheets>

    <top>
        <VBox spacing="0">
            <HBox styleClass="top-nav" alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 12 20;">
                <children>
                    <Label text="Pegasus" styleClass="brand-label" />
                    <Pane HBox.hgrow="ALWAYS" />
                    <Button text="Home" styleClass="home-button" onAction="#goHome" />
                    <Button text="Gallery" styleClass="secondary-button" onAction="#goGallery" />
                    <Button text="Events" styleClass="gold-button" onAction="#goEvents" />
                    <Button text="Backoffice" styleClass="secondary-button" onAction="#goBackoffice" />
                </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar" style="-fx-padding: 20 30;">
                <VBox>
                    <Label text="Gestion des Participants" style="-fx-font-size: 28px; -fx-text-fill: white; -fx-font-weight: bold;" />
                    <Label text="Administration Master-Detail" style="-fx-text-fill: #bdc3c7; -fx-font-size: 14px;" />
                </VBox>
                <Pane HBox.hgrow="ALWAYS" />
                <Button text="Retour Dashboard" onAction="#retourDashboard" styleClass="btn-danger" />
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.35" style="-fx-background-color: transparent; -fx-padding: 20;">
            <items>
                <VBox spacing="15" style="-fx-padding: 0 15 0 0;">
                    <VBox spacing="8">
                        <Label text="1. Liste des Evenements" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <TextField fx:id="searchEventField" promptText="Rechercher un evenement..." styleClass="text-field" />
                    </VBox>
                    <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colEventTitre" text="Evenement" prefWidth="250">
                                <cellValueFactory><PropertyValueFactory property="titre" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colEventDate" text="Date" prefWidth="100">
                                <cellValueFactory><PropertyValueFactory property="date" /></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="15" style="-fx-padding: 0 0 0 15;">
                    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="2. Participants Inscrits" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                            <Label fx:id="selectedEventLabel" text="Selectionnez un evenement a gauche" style="-fx-font-size: 14px; -fx-text-fill: #6c5ce7; -fx-font-weight: bold;" />
                        </VBox>
                    </HBox>

                    <TableView fx:id="participantsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colUserNom" text="Nom" prefWidth="150">
                                <cellValueFactory><PropertyValueFactory property="nom" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colUserPrenom" text="Prenom" prefWidth="150">
                                <cellValueFactory><PropertyValueFactory property="prenom" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colUserEmail" text="Email" prefWidth="250">
                                <cellValueFactory><PropertyValueFactory property="email" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colUserTel" text="Telephone" prefWidth="150">
                                <cellValueFactory><PropertyValueFactory property="telephone" /></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>
            </items>
        </SplitPane>
    </center>

</BorderPane>
