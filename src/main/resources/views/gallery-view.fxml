<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pegasus.controllers.GalleryController">
    
    <!-- Header -->
    <HBox styleClass="header" alignment="CENTER_LEFT">
        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Feane" styleClass="logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="HOME" styleClass="nav-button"/>
            <Button text="GALLERY" styleClass="nav-button"/>
            <Button text="ABOUT" styleClass="nav-button"/>
            <Button text="BOOK TABLE" styleClass="nav-button"/>
            <ImageView fitHeight="24" fitWidth="24" styleClass="icon"/>
            <ImageView fitHeight="24" fitWidth="24" styleClass="icon"/>
            <ImageView fitHeight="24" fitWidth="24" styleClass="icon"/>
            <Button text="Order Online" styleClass="order-button"/>
        </HBox>
        <padding>
            <Insets top="15" right="20" bottom="15" left="20"/>
        </padding>
    </HBox>
    
    <!-- Main Content -->
    <VBox styleClass="main-content" VBox.vgrow="ALWAYS">
        
        <!-- Title -->
        <Label text="Art Gallery" styleClass="page-title"/>
        
        <!-- Gallery Grid -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            <TilePane fx:id="galleryGrid" prefColumns="4" hgap="20" vgap="20" styleClass="gallery-grid">
                <!-- Gallery items will be added dynamically -->
            </TilePane>
            <padding>
                <Insets top="20"/>
            </padding>
        </ScrollPane>
        
    </VBox>
    
</VBox>
