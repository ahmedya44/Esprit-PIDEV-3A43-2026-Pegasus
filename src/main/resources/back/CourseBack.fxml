<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.pegasus.controllers.back.CourseBackController">

    <children>
        <Label layoutX="36.0" layoutY="24.0" text="Back Office - Courses"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <Label layoutX="38.0" layoutY="84.0" text="Title" />
        <TextField fx:id="tfTitle" layoutX="38.0" layoutY="108.0"
                   prefHeight="35.0" prefWidth="280.0" promptText="Enter course title" />

        <Label layoutX="38.0" layoutY="158.0" text="Description" />
        <TextArea fx:id="taDescription" layoutX="38.0" layoutY="182.0"
                  prefHeight="110.0" prefWidth="280.0" wrapText="true"
                  promptText="Enter course description" />

        <Label layoutX="38.0" layoutY="309.0" text="Thumbnail URL" />
        <TextField fx:id="tfThumbnail" layoutX="38.0" layoutY="333.0"
                   prefHeight="35.0" prefWidth="280.0"
                   promptText="Optional thumbnail URL" />

        <Label layoutX="38.0" layoutY="385.0" text="Status" />
        <ComboBox fx:id="cbStatus" layoutX="38.0" layoutY="409.0"
                  prefHeight="35.0" prefWidth="280.0" promptText="Choose status" />

        <Label layoutX="38.0" layoutY="460.0" text="Artist ID" />
        <TextField fx:id="tfArtistId" layoutX="38.0" layoutY="484.0"
                   prefHeight="35.0" prefWidth="280.0" promptText="ex: 2" />

        <Button layoutX="38.0" layoutY="545.0" mnemonicParsing="false"
                onAction="#addCourse" prefHeight="36.0" prefWidth="130.0"
                text="Add Course" />

        <Button layoutX="188.0" layoutY="545.0" mnemonicParsing="false"
                onAction="#clearFields" prefHeight="36.0" prefWidth="130.0"
                text="Clear" />

        <Button layoutX="113.0" layoutY="595.0" mnemonicParsing="false"
                onAction="#loadCourses" prefHeight="36.0" prefWidth="130.0"
                text="Refresh" />

        <TableView fx:id="tvCourses" layoutX="356.0" layoutY="84.0"
                   prefHeight="540.0" prefWidth="610.0">
            <columns>
                <TableColumn fx:id="colTitle" prefWidth="130.0" text="Title" />
                <TableColumn fx:id="colDescription" prefWidth="220.0" text="Description" />
                <TableColumn fx:id="colThumbnail" prefWidth="120.0" text="Thumbnail" />
                <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
                <TableColumn fx:id="colArtistId" prefWidth="70.0" text="Artist" />
            </columns>
        </TableView>
    </children>
</AnchorPane>