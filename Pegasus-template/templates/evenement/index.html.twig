{% extends 'back/base.html.twig' %}

{% block title %}Liste des Événements - Kaiadmin{% endblock %}

{% block body %}
<div class="page-header">
    <h4 class="page-title">Gestion des Événements</h4>
    <ul class="breadcrumbs">
        <li class="nav-home">
            <a href="{{ path('back_page', {path: 'index'}) }}">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_evenement_index') }}">Événements</a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Liste</a>
        </li>
    </ul>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card card-round">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Catalogue des Événements</h4>
                     <div class="ms-auto">
                        <div class="d-inline-block me-2">
                            <select id="sort-control" class="form-select form-select-sm border-primary">
                                <option value="" selected disabled>Classer par...</option>
                                <option value="alpha">Ordre Alphabétique (A-Z)</option>
                                <option value="date_asc">Date (Le plus proche)</option>
                                <option value="date_desc">Date (Le plus loin)</option>
                                <option value="prix_asc">Prix (Croissant)</option>
                                <option value="prix_desc">Prix (Décroissant)</option>
                            </select>
                        </div>
                        <a href="{{ path('app_evenement_export_pdf') }}" class="btn btn-danger btn-round me-2">
                            <i class="fas fa-file-pdf"></i> Exporter PDF
                        </a>
                        <a href="{{ path('app_evenement_new') }}" class="btn btn-primary btn-round">
                            <i class="fa fa-plus"></i> Créer un Événement
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="basic-datatables" class="display table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Aperçu</th>
                                <th>Titre</th>
                                <th>Date & Heure</th>
                                <th>Lieu</th>
                                <th>Capacité</th>
                                <th>Prix</th>
                                <th style="width: 15%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for evenement in evenements %}
                            <tr>
                                <td>
                                    <div class="avatar-lg">
                                        {% if evenement.image %}
                                            <img src="{{ asset('uploads/images/' ~ evenement.image) }}" alt="{{ evenement.titre }}" class="avatar-img rounded">
                                        {% else %}
                                            <div class="avatar-title rounded bg-secondary">
                                                <i class="fa fa-image"></i>
                                            </div>
                                        {% endif %}
                                    </div>
                                </td>
                                <td><span class="fw-bold">{{ evenement.titre }}</span></td>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="date-val" data-order="{{ evenement.date ? evenement.date|date('Ymd') : '0' }}">
                                            <i class="far fa-calendar-alt me-1 text-primary"></i> {{ evenement.date ? evenement.date|date('d/m/Y') : 'N/A' }}
                                        </span>
                                        <small class="text-muted"><i class="far fa-clock me-1"></i> {{ evenement.heure ? evenement.heure|date('H:i') : 'N/A' }}</small>
                                    </div>
                                </td>
                                <td>{{ evenement.lieu }}</td>
                                <td>
                                    <span class="badge badge-info">{{ evenement.nbInscritsActifs }} / {{ evenement.capaciteMax }}</span>
                                </td>
                                <td data-order="{{ evenement.prix }}">
                                    <span class="text-success fw-bold">{{ evenement.prix }} DT</span>
                                </td>
                                <td>
                                    <div class="form-button-action">
                                        <a href="{{ path('app_evenement_show', {'id': evenement.id}) }}" class="btn btn-link btn-secondary p-2" data-bs-toggle="tooltip" title="Voir">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-link btn-primary p-2" data-bs-toggle="tooltip" title="Modifier">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_evenement_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');" style="display:inline-block;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                                            <button class="btn btn-link btn-danger p-2" data-bs-toggle="tooltip" title="Supprimer">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">Aucun événement n'a été créé pour le moment.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    $(document).ready(function() {
        var table = $('#basic-datatables').DataTable({
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/French.json"
            },
            "order": [[1, "asc"]]
        });

        // Dropdown Sorting
        $('#sort-control').on('change', function() {
            var val = $(this).val();
            switch(val) {
                case 'alpha':
                    table.order([1, 'asc']).draw();
                    break;
                case 'date_asc':
                    table.order([2, 'asc']).draw();
                    break;
                case 'date_desc':
                    table.order([2, 'desc']).draw();
                    break;
                case 'prix_asc':
                    table.order([5, 'asc']).draw();
                    break;
                case 'prix_desc':
                    table.order([5, 'desc']).draw();
                    break;
            }
        });
    });
</script>
{% endblock %}
