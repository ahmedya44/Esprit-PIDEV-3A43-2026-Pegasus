{% extends 'back/base.html.twig' %}

{% block title %}Détails de l'Événement - Kaiadmin{% endblock %}

{% block body %}
<div class="page-header">
    <h4 class="page-title">Gestion des Événements</h4>
    <ul class="breadcrumbs">
        <li class="nav-home">
            <a href="{{ path('back_page', {path: 'index'}) }}">
                <i class="icon-home"></i>
            </a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_evenement_index') }}">Événements</a>
        </li>
        <li class="separator">
            <i class="icon-arrow-right"></i>
        </li>
        <li class="nav-item">
            <a href="#">Détails</a>
        </li>
    </ul>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card card-round">
            <div class="card-header">
                <div class="d-flex align-items-center">
                    <h4 class="card-title">Informations sur l'Événement</h4>
                    <div class="ms-auto">
                        <a href="{{ path('app_evenement_edit', {'id': evenement.id}) }}" class="btn btn-primary btn-round btn-sm me-2">
                            <i class="fa fa-edit me-1"></i> Modifier
                        </a>
                        <a href="{{ path('app_evenement_index') }}" class="btn btn-secondary btn-round btn-sm">
                            <i class="fa fa-arrow-left me-1"></i> Retour
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-12 text-center mb-4">
                        {% if evenement.image %}
                            <img src="{{ asset('uploads/images/' ~ evenement.image) }}" alt="{{ evenement.titre }}" class="img-fluid rounded-lg shadow-sm" style="max-height: 400px; width: 100%; object-fit: cover;">
                        {% else %}
                            <div class="bg-light rounded text-center py-5">
                                <i class="fa fa-image fa-5x text-silver mb-3"></i>
                                <p class="text-muted">Aucune image pour cet événement</p>
                            </div>
                        {% endif %}
                    </div>
                    <div class="col-md-12">
                        <h2 class="fw-bold text-dark mb-4 text-center">{{ evenement.titre }}</h2>
                        <div class="row g-4">
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center p-3 bg-light rounded shadow-xs mb-3">
                                    <div class="icon-preview bg-primary text-white rounded me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                        <i class="far fa-calendar-alt"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Date</div>
                                        <div class="fw-bold">{{ evenement.date ? evenement.date|date('d F Y') : 'N/A' }}</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center p-3 bg-light rounded shadow-xs mb-3">
                                    <div class="icon-preview bg-info text-white rounded me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                        <i class="far fa-clock"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Heure</div>
                                        <div class="fw-bold">{{ evenement.heure ? evenement.heure|date('H:i') : 'N/A' }}</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center p-3 bg-light rounded shadow-xs mb-3">
                                    <div class="icon-preview bg-danger text-white rounded me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                        <i class="fa fa-map-marker-alt"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Lieu</div>
                                        <div class="fw-bold">{{ evenement.lieu }}</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center p-3 bg-light rounded shadow-xs mb-3">
                                    <div class="icon-preview bg-success text-white rounded me-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                        <i class="fa fa-tag"></i>
                                    </div>
                                    <div>
                                        <div class="text-muted small">Prix</div>
                                        <div class="fw-bold">{{ evenement.prix }} DT</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-4 p-4 bg-white border rounded">
                            <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary"><i class="fa fa-info-circle me-2"></i> Description</h5>
                            <p class="text-muted" style="line-height: 1.6;">{{ evenement.description|nl2br }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card card-round">
            <div class="card-header">
                <h4 class="card-title">Statistiques & Capacité</h4>
            </div>
            <div class="card-body">
                {% set occupied = evenement.nbInscritsActifs %}
                {% set total = evenement.capaciteMax %}
                {% set remaining = total - occupied %}
                {% set percentage = (total > 0) ? (occupied / total * 100)|round : 0 %}

                <div class="text-center mb-4">
                    <div class="display-3 fw-bold text-primary">{{ remaining }}</div>
                    <div class="text-muted text-uppercase fw-bold">Places restantes</div>
                </div>
                
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Taux de remplissage</span>
                        <span class="text-muted small fw-bold">{{ percentage }}%</span>
                    </div>
                    <div class="progress" style="height: 10px;">
                        <div class="progress-bar {% if percentage > 90 %}bg-danger{% elseif percentage > 70 %}bg-warning{% else %}bg-success{% endif %}" role="progressbar" style="width: {{ percentage }}%"></div>
                    </div>
                </div>
                
                <ul class="list-group list-group-flush border-top">
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                        <span class="text-muted">Capacité totale</span>
                        <span class="badge badge-secondary badge-pill fw-bold">{{ total }}</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                        <span class="text-muted">Inscrits actuellement</span>
                        <span class="badge badge-primary badge-pill fw-bold">{{ occupied }}</span>
                    </li>
                </ul>

                <hr>
                
                <div class="d-grid mt-4">
                    {{ include('evenement/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
        
        <div class="card card-round mt-4 bg-primary text-white">
            <div class="card-body py-4">
                <div class="d-flex align-items-center">
                    <div class="me-3">
                        <i class="fa fa-users fa-3x opacity-50"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1">Participants</h5>
                        <p class="mb-0 small opacity-75">Voir les inscrits à cet événement</p>
                    </div>
                    <a href="{{ path('app_participant_index') }}?evenement={{ evenement.id }}" class="ms-auto text-white">
                        <i class="fa fa-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
