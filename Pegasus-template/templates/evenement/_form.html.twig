{{ form_start(form) }}
    <div class="row">
        <div class="col-md-12">
            <h5 class="fw-bold mb-3 text-primary"><i class="fa fa-info-circle me-1"></i> Informations Générales</h5>
        </div>
        <div class="col-md-12">
            <div class="form-group mb-3">
                {{ form_label(form.titre, 'Titre de l\'événement', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Soirée Gastronomique'}}) }}
                {{ form_errors(form.titre) }}
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group mb-4">
                {{ form_label(form.description, 'Description détaillée', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '4', 'placeholder': 'Présentez votre événement...'}}) }}
                {{ form_errors(form.description) }}
            </div>
        </div>

        <div class="col-md-12">
            <h5 class="fw-bold mb-3 text-primary mt-3"><i class="fa fa-calendar-alt me-1"></i> Date & Lieu</h5>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                {{ form_label(form.date, 'Date', {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group">
                    <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                    {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                </div>
                {{ form_errors(form.date) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                {{ form_label(form.heure, 'Heure', {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group">
                    <span class="input-group-text"><i class="far fa-clock"></i></span>
                    {{ form_widget(form.heure, {'attr': {'class': 'form-control'}}) }}
                </div>
                {{ form_errors(form.heure) }}
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group mb-4">
                {{ form_label(form.lieu, 'Lieu de l\'événement', {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-map-marker-alt"></i></span>
                    {{ form_widget(form.lieu, {'attr': {'class': 'form-control', 'placeholder': 'Adresse, Ville...'}}) }}
                </div>
                {{ form_errors(form.lieu) }}
            </div>
        </div>

        <div class="col-md-12">
            <h5 class="fw-bold mb-3 text-primary mt-3"><i class="fa fa-cogs me-1"></i> Paramètres & Media</h5>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                {{ form_label(form.capacite_max, 'Capacité maximale', {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-users"></i></span>
                    {{ form_widget(form.capacite_max, {'attr': {'class': 'form-control', 'min': '1'}}) }}
                </div>
                {{ form_errors(form.capacite_max) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                {{ form_label(form.prix, 'Prix (DT)', {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group">
                    <span class="input-group-text fw-bold">DT</span>
                    {{ form_widget(form.prix, {'attr': {'class': 'form-control', 'step': '0.01'}}) }}
                </div>
                {{ form_errors(form.prix) }}
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group mb-3">
                {{ form_label(form.image, 'Image de couverture', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.image, {'attr': {'class': 'form-control-file'}}) }}
                <small class="form-text text-muted">Formats acceptés: JPG, PNG, WebP. Max 2Mo.</small>
                {{ form_errors(form.image) }}
            </div>
        </div>
    </div>
    <div class="mt-5 border-top pt-4 text-end">
        <button class="btn btn-primary btn-round px-5">
            <i class="fa fa-save me-2"></i> {{ button_label|default('Enregistrer les modifications') }}
        </button>
    </div>
{{ form_end(form) }}
