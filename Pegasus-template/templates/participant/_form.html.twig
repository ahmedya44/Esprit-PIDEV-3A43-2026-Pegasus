{{ form_start(form) }}
    <div class="row">
        <div class="col-md-12">
            <h5 class="fw-bold mb-3 text-primary"><i class="fa fa-user me-1"></i> Identité du Participant</h5>
        </div>
        <div class="col-md-12">
            <div class="form-group mb-3">
                {{ form_label(form.nom, 'Nom Complet', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-user"></i></span>
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Ahmed Ben Salah'}}) }}
                </div>
                {{ form_errors(form.nom) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                {{ form_label(form.email, 'Email professionnelle/personnelle', {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group">
                    <span class="input-group-text"><i class="far fa-envelope"></i></span>
                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@domaine.com'}}) }}
                </div>
                {{ form_errors(form.email) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                {{ form_label(form.telephone, 'Téléphone', {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-phone-alt"></i></span>
                    {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': '+216 -- --- ---'}}) }}
                </div>
                {{ form_errors(form.telephone) }}
            </div>
        </div>

        <div class="col-md-12">
            <h5 class="fw-bold mb-3 text-primary mt-3"><i class="fa fa-calendar-check me-1"></i> Détails de l'Inscription</h5>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                {{ form_label(form.evenement, 'Événement concerné', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.evenement, {'attr': {'class': 'form-select select2-init'}}) }}
                {{ form_errors(form.evenement) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                {{ form_label(form.statut, 'Statut de l\'inscription', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.statut) }}
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group mb-4">
                {{ form_label(form.date_inscription, 'Date d\'inscription', {'label_attr': {'class': 'form-label'}}) }}
                <div class="input-group">
                    <span class="input-group-text"><i class="far fa-clock"></i></span>
                    {{ form_widget(form.date_inscription, {'attr': {'class': 'form-control'}}) }}
                </div>
                {{ form_errors(form.date_inscription) }}
            </div>
        </div>
    </div>
    <div class="mt-4 border-top pt-4 text-end">
        <button class="btn btn-primary btn-round px-5">
            <i class="fa fa-save me-2"></i> {{ button_label|default('Enregistrer le participant') }}
        </button>
    </div>
{{ form_end(form) }}
