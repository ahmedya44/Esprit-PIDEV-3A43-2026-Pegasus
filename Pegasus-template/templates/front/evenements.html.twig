  {% block content %}
  <section class="food_section layout_padding bg-light">
    <div class="container">
      <div class="heading_container heading_center mb-5">
        <h2 style="font-weight: bold; position: relative; padding-bottom: 15px;">
          Nos Événements
          <span style="position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 80px; height: 4px; background: #ffbe33; border-radius: 2px;"></span>
        </h2>
      </div>

      <div class="filters-content">
        <div class="row">
          {% for evenement in evenements %}
            <div class="col-sm-6 col-lg-4 mb-4 stagger-in">
              <div class="event-card">
                <div class="event-img-container">
                  <a href="{{ path('front_evenement_show', {'id': evenement.id}) }}">
                    {% if evenement.image %}
                      <img src="/uploads/images/{{ evenement.image }}" alt="{{ evenement.titre }}" class="event-img">
                    {% else %}
                      <img src="{{ asset('front/images/hero-bg.jpg') }}" alt="Default Image" class="event-img">
                    {% endif %}
                  </a>
                  <div class="event-price-tag">{{ evenement.prix }} DT</div>
                </div>

                <div class="event-details">
                  <h5 class="event-title">
                     <a href="{{ path('front_evenement_show', {'id': evenement.id}) }}" style="color: inherit; text-decoration: none;">
                        {{ evenement.titre }}
                     </a>
                  </h5>
                  
                  <p class="text-muted small mb-3">
                      {{ evenement.description|length > 100 ? evenement.description|slice(0, 100) ~ '...' : evenement.description }}
                  </p>

                  <div class="event-meta">
                      <div class="mb-1"><i class="fa fa-calendar"></i> {{ evenement.date ? evenement.date|date('d/m/Y') : 'N/A' }}</div>
                      <div class="mb-1"><i class="fa fa-map-marker"></i> {{ evenement.lieu }}</div>
                  </div>

                  {% set remaining = evenement.capaciteMax - evenement.participants|length %}
                  <div class="seats-badge {{ remaining > 5 ? 'badge-available' : 'badge-limited' }}">
                      <i class="fa fa-ticket mr-1"></i> {{ remaining }} places restantes
                  </div>

                  <a href="{{ path('front_evenement_show', {'id': evenement.id}) }}" class="btn btn-sm btn-warning mt-4 font-weight-bold py-2 text-white" style="border-radius: 10px;">
                      Détails & Réservation
                  </a>
                </div>
              </div>
            </div>
          {% else %}
            <div class="col-12 text-center py-5">
              <div class="premium-card p-5">
                  <i class="fa fa-calendar-o fa-3x text-muted mb-3"></i>
                  <p class="lead">Aucun événement disponible pour le moment.</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
  {% endblock %}

